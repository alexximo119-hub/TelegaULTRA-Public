@@ -0,0 +1,39 @@
+import UIKit
+
+@main
+final class UltraStartupPreviewApp: UIResponder, UIApplicationDelegate {
+    var window: UIWindow?
+
+    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil) -> Bool {
+        UltraStartupDiagnostics.shared.begin()
+        if CommandLine.arguments.contains("--preview-progress") {
+            UltraStartupDiagnostics.shared.mark("PRESENTATION_LOADING")
+            return true
+        }
+        if CommandLine.arguments.contains("--preview-no-consent") {
+            UltraStartupDiagnostics.shared.showFailure(message: "Не удалось настроить защищённое хранилище ключей. Разблокируйте iPhone и проверьте параметры подписи приложения. Защита кодом и шифрование не отключались.", code: "KEYCHAIN_UNAVAILABLE", enableLocalStorage: nil)
+            return true
+        }
+        UltraStartupDiagnostics.shared.showFailure(message: "Подпись приложения не даёт доступ к общему контейнеру App Group. Для новой установки можно выбрать отдельное локальное хранилище ULTRA. Расширения, виджеты и общий доступ к данным будут недоступны. Данные из прежнего общего контейнера не будут перенесены. Если вы уже входили в аккаунт в этой установке, сначала восстановите прежнюю подпись.", code: "APP_GROUP_UNAVAILABLE", enableLocalStorage: {})
+        return true
+    }
+
+    func application(_ application: UIApplication, configurationForConnecting connectingSceneSession: UISceneSession, options: UIScene.ConnectionOptions) -> UISceneConfiguration {
+        let configuration = UISceneConfiguration(name: "Default Configuration", sessionRole: connectingSceneSession.role)
+        configuration.delegateClass = UltraPreviewSceneDelegate.self
+        return configuration
+    }
+}
+
+@objc(UltraPreviewSceneDelegate) final class UltraPreviewSceneDelegate: UIResponder, UIWindowSceneDelegate {
+    var window: UIWindow?
+
+    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
+        guard let scene = scene as? UIWindowScene else { return }
+        let window = UIWindow(windowScene: scene)
+        window.rootViewController = UIViewController()
+        self.window = window
+        window.makeKeyAndVisible()
+        UltraStartupDiagnostics.shared.attach(scene: scene, mainWindow: window)
+    }
+}
