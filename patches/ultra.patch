index 00000000..0c02e07e
--- /dev/null
+++ b/Tests/UltraSessionImportTests/UltraSessionSQLiteReaderTests.swift
@@ -0,0 +1,107 @@
+import Foundation
+import SQLite3
+import XCTest
+@testable import UltraSessionFormats
+
+final class UltraSessionSQLiteReaderTests: XCTestCase {
+    private func image(pyrogram: Bool = false, rows: Int = 1, version: Int? = nil, extraSQL: String = "") throws -> Data {
+        var handle: OpaquePointer?
+        XCTAssertEqual(sqlite3_open(":memory:", &handle), SQLITE_OK)
+        let database = try XCTUnwrap(handle)
+        defer { sqlite3_close(database) }
+        let key = String(repeating: "11", count: 256) // Synthetic fixture key.
+        let schema: String
+        if pyrogram {
+            schema = "CREATE TABLE version(number INTEGER PRIMARY KEY); INSERT INTO version VALUES(\(version ?? 3)); CREATE TABLE sessions(dc_id INTEGER PRIMARY KEY, api_id INTEGER, test_mode INTEGER, auth_key BLOB, date INTEGER, user_id INTEGER, is_bot INTEGER);"
+        } else {
+            schema = "CREATE TABLE version(version INTEGER PRIMARY KEY); INSERT INTO version VALUES(\(version ?? 8)); CREATE TABLE sessions(dc_id INTEGER PRIMARY KEY, server_address TEXT, port INTEGER, auth_key BLOB, takeout_id INTEGER, tmp_auth_key BLOB);"
+        }
+        XCTAssertEqual(sqlite3_exec(database, schema, nil, nil, nil), SQLITE_OK)
+        for index in 0 ..< rows {
+            let sql = pyrogram
+                ? "INSERT INTO sessions VALUES(\(index + 2),12345,0,X'\(key)',0,4294967300,0)"
+                : "INSERT INTO sessions VALUES(\(index + 2),'149.154.167.50',443,X'\(key)',NULL,NULL)"
+            XCTAssertEqual(sqlite3_exec(database, sql, nil, nil, nil), SQLITE_OK)
+        }
+        if !extraSQL.isEmpty { XCTAssertEqual(sqlite3_exec(database, extraSQL, nil, nil, nil), SQLITE_OK) }
+        var length: Int64 = 0
+        let bytes = try XCTUnwrap(sqlite3_serialize(database, "main", &length, 0))
+        defer { sqlite3_free(bytes) }
+        return Data(bytes: bytes, count: Int(length))
+    }
+
+    func testNamedTelethonColumnsIgnoreTemporaryAuthKeyAndTakeoutState() throws {
+        let candidate = try UltraSessionSQLiteReader.parse(self.image(), testingEnvironment: false)
+        XCTAssertEqual(candidate.format, .telethonFile)
+        XCTAssertEqual(candidate.datacenterId, 2)
+        XCTAssertEqual(candidate.authKey, Data(repeating: 0x11, count: 256))
+        XCTAssertNil(candidate.claimedUserId)
+    }
+
+    func testPyrogramIdentityAndEnvironmentAreReadWithoutNarrowing() throws {
+        let candidate = try UltraSessionSQLiteReader.parse(self.image(pyrogram: true), testingEnvironment: false)
+        XCTAssertEqual(candidate.format, .pyrogramFile)
+        XCTAssertEqual(candidate.claimedUserId, 4294967300)
+        XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(self.image(pyrogram: true), testingEnvironment: true))
+    }
+
+    func testEmptyAndMultipleSessionRowsFailInsteadOfSelectingOne() throws {
+        for count in [0, 2] {
+            XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(self.image(rows: count), testingEnvironment: false))
+        }
+    }
+
+    func testUnknownDatabaseVersionsAreNotMigrated() throws {
+        for pyrogram in [false, true] {
+            XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(self.image(pyrogram: pyrogram, version: 999), testingEnvironment: false))
+        }
+    }
+
+    func testViewsCannotStandInForTheSessionTable() throws {
+        let data = try self.image(extraSQL: "ALTER TABLE sessions RENAME TO hidden; CREATE VIEW sessions AS SELECT * FROM hidden;")
+        XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(data, testingEnvironment: false))
+    }
+
+    func testKeysMustBeBlobsAndBotFlagsMustBeStrict() throws {
+        let textKey = try self.image(extraSQL: "UPDATE sessions SET auth_key=CAST(auth_key AS TEXT)")
+        XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(textKey, testingEnvironment: false))
+        for value in [1, 2] {
+            let data = try self.image(pyrogram: true, extraSQL: "UPDATE sessions SET is_bot=\(value)")
+            XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(data, testingEnvironment: false))
+        }
+    }
+
+    func testWALAndOversizedOrTruncatedImagesAreRejected() throws {
+        var wal = try self.image()
+        wal[18] = 2
+        wal[19] = 2
+        for data in [Data(), Data(wal.prefix(99)), wal, Data(repeating: 0, count: UltraSessionSQLiteReader.maximumBytes + 1)] {
+            XCTAssertThrowsError(try UltraSessionSQLiteReader.parse(data, testingEnvironment: false))
+        }
+    }
+
+    func testSourceFileBytesAndDirectoryContentsRemainUnchanged() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-synthetic-session-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = directory.appendingPathComponent("synthetic.session")
+        let original = try self.image()
+        try original.write(to: url)
+        try FileManager.default.setAttributes([.posixPermissions: 0o400], ofItemAtPath: url.path)
+        _ = try UltraSessionSQLiteReader.read(at: url, testingEnvironment: false)
+        XCTAssertEqual(try Data(contentsOf: url), original)
+        XCTAssertEqual(try FileManager.default.contentsOfDirectory(atPath: directory.path), ["synthetic.session"])
+    }
+
+    func testDirectoriesAndSymlinksAreRejected() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-session-policy-\(UUID().uuidString).session")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        XCTAssertThrowsError(try UltraSessionSQLiteReader.read(at: directory, testingEnvironment: false))
+        let source = directory.appendingPathComponent("source.session")
+        try self.image().write(to: source)
+        let link = directory.appendingPathComponent("link.session")
+        try FileManager.default.createSymbolicLink(at: link, withDestinationURL: source)
+        XCTAssertThrowsError(try UltraSessionSQLiteReader.read(at: link, testingEnvironment: false))
+    }
+}
