diff --git a/submodules/TelegramCore/Tests/UltraVideoUploadSourceTests.swift b/submodules/TelegramCore/Tests/UltraVideoUploadSourceTests.swift
new file mode 100644
index 00000000..ba651c88
--- /dev/null
+++ b/submodules/TelegramCore/Tests/UltraVideoUploadSourceTests.swift
@@ -0,0 +1,33 @@
+import Foundation
+import XCTest
+import Postbox
+@testable import TelegramCore
+
+final class UltraVideoUploadSourceTests: XCTestCase {
+    func testOnlyOrdinaryMP4IsEligibleAndStickerAnimationIsExcluded() {
+        XCTAssertTrue(ultraVideoUploadEligible(mimeType: "video/mp4", attributes: []))
+        for mime in ["video/quicktime", "image/jpeg", "application/octet-stream", "VIDEO/MP4", "video/mp4; codecs=avc1"] {
+            XCTAssertFalse(ultraVideoUploadEligible(mimeType: mime, attributes: []))
+        }
+        XCTAssertFalse(ultraVideoUploadEligible(mimeType: "video/mp4", attributes: [.Animated]))
+        XCTAssertFalse(ultraVideoUploadEligible(mimeType: "video/mp4", attributes: [.Sticker(displayText: "synthetic", packReference: nil, maskData: nil)]))
+    }
+
+    func testEnabledVideoAlwaysWrapsEvenInvalidBytesAndDisabledModePreservesSource() {
+        let data = Data("synthetic invalid MP4".utf8)
+        guard case let .sanitizedVideo(.data(payload)) = ultraFileUploadSource(.data(data), privacy: .disabled, videoPrivacy: true, mimeType: "video/mp4") else { return XCTFail("No uploader may see the original bytes before verification") }
+        XCTAssertEqual(payload, data)
+        guard case let .data(unchanged) = ultraFileUploadSource(.data(data), privacy: .disabled, videoPrivacy: false, mimeType: "video/mp4") else { return XCTFail("Off preserves the native source") }
+        XCTAssertEqual(unchanged, data)
+    }
+
+    func testNewFileNameAndCodecHintsDoNotReuseOriginalContainerMetadata() {
+        let dimensions = PixelDimensions(width: 1920, height: 1080)
+        let video = TelegramMediaFileAttribute.Video(duration: 10, size: dimensions, flags: [], preloadSize: 500, coverTime: 2, videoCodec: "hvc1")
+        let attributes: [TelegramMediaFileAttribute] = [.FileName(fileName: "personal.mp4"), video, .FileName(fileName: "second.mp4")]
+        let cleaned = ultraFileUploadAttributes(attributes, mimeType: "video/mp4", privacy: .disabled, videoPrivacy: true)
+        XCTAssertEqual(cleaned, [.Video(duration: 10, size: dimensions, flags: [], preloadSize: nil, coverTime: 2, videoCodec: nil), .FileName(fileName: "ULTRA-clean.mp4")])
+        XCTAssertEqual(ultraFileUploadAttributes(attributes, mimeType: "video/mp4", privacy: .disabled, videoPrivacy: false), attributes)
+        XCTAssertEqual(attributes.count, 3)
+    }
+}
