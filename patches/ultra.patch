+- (void)prepareUltraHighQualityVideoForItems:(NSArray *)items
+{
+    if (!self.ultraHighQualityVideo)
+        return;
+    for (NSObject *candidate in items)
+    {
+        if (![candidate conformsToProtocol:@protocol(TGMediaEditableItem)] || ![candidate respondsToSelector:@selector(originalSize)])
+            continue;
+        NSObject<TGMediaEditableItem> *item = (NSObject<TGMediaEditableItem> *)candidate;
+        if (!item.isVideo)
+            continue;
+        if ([candidate isKindOfClass:[TGCameraCapturedVideo class]] && ((TGCameraCapturedVideo *)candidate).isAnimation)
+            continue;
+        NSObject<TGMediaEditAdjustments> *rawAdjustments = [self adjustmentsForItem:item];
+        if (rawAdjustments != nil && ![rawAdjustments isKindOfClass:[TGVideoEditAdjustments class]])
+            continue;
+        TGVideoEditAdjustments *adjustments = (TGVideoEditAdjustments *)rawAdjustments;
+        // An explicit quality choice or animation must not be overwritten by the default.
+        if (adjustments != nil && (adjustments.preset != TGMediaVideoConversionPresetCompressedDefault || adjustments.sendAsGif))
+            continue;
+        CGSize size = item.originalSize;
+        if (!isfinite(size.width) || !isfinite(size.height) || size.width <= 0 || size.height <= 0)
+            continue;
+        TGVideoEditAdjustments *updated;
+        if (adjustments != nil)
+        {
+            updated = [adjustments editAdjustmentsWithPreset:TGMediaVideoConversionPresetCompressedVeryHigh videoStartValue:adjustments.videoStartValue trimStartValue:adjustments.trimStartValue trimEndValue:adjustments.trimEndValue];
+        }
+        else
+        {
+            updated = [TGVideoEditAdjustments editAdjustmentsWithOriginalSize:size preset:TGMediaVideoConversionPresetCompressedVeryHigh];
+        }
+        [self setAdjustments:updated forItem:item];
+    }
+}
