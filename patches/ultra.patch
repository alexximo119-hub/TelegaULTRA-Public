@@ -0,0 +1,131 @@
+import Foundation
+import CoreGraphics
+import ImageIO
+import UniformTypeIdentifiers
+import XCTest
+@testable import UltraImageSanitizing
+
+final class UltraImageSanitizerTests: XCTestCase {
+    private func fixture(type: UTType = .jpeg, orientation: Int = 1, frames: Int = 1) throws -> Data {
+        let space = try XCTUnwrap(CGColorSpace(name: CGColorSpace.sRGB))
+        let context = try XCTUnwrap(CGContext(data: nil, width: 16, height: 8, bitsPerComponent: 8, bytesPerRow: 64, space: space, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue))
+        context.setFillColor(CGColor(red: 0.8, green: 0.2, blue: 0.1, alpha: type == .png ? 0.5 : 1.0))
+        context.fill(CGRect(x: 0, y: 0, width: 16, height: 8))
+        let image = try XCTUnwrap(context.makeImage())
+        let data = NSMutableData()
+        let destination = try XCTUnwrap(CGImageDestinationCreateWithData(data as CFMutableData, type.identifier as CFString, frames, nil))
+        let properties: [String: Any] = [
+            kCGImagePropertyOrientation as String: orientation,
+            kCGImagePropertyGPSDictionary as String: [
+                kCGImagePropertyGPSLatitude as String: 51.5,
+                kCGImagePropertyGPSLatitudeRef as String: "N",
+                kCGImagePropertyGPSLongitude as String: 0.1,
+                kCGImagePropertyGPSLongitudeRef as String: "W"
+            ],
+            kCGImagePropertyExifDictionary as String: [kCGImagePropertyExifDateTimeOriginal as String: "2001:01:02 03:04:05"],
+            kCGImagePropertyTIFFDictionary as String: [kCGImagePropertyTIFFArtist as String: "synthetic author", kCGImagePropertyTIFFMake as String: "synthetic camera"],
+            kCGImagePropertyPNGDictionary as String: [kCGImagePropertyPNGAuthor as String: "synthetic author"]
+        ]
+        for _ in 0 ..< frames { CGImageDestinationAddImage(destination, image, properties as CFDictionary) }
+        XCTAssertTrue(CGImageDestinationFinalize(destination))
+        return data as Data
+    }
+
+    private func properties(_ data: Data) throws -> [String: Any] {
+        let source = try XCTUnwrap(CGImageSourceCreateWithData(data as CFData, nil))
+        return try XCTUnwrap(CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any])
+    }
+
+    func testJPEGRemovesRealGPSCameraAuthorAndCaptureDateTags() throws {
+        let original = try self.fixture()
+        let before = try self.properties(original)
+        XCTAssertNotNil(before[kCGImagePropertyGPSDictionary as String])
+        XCTAssertEqual((before[kCGImagePropertyTIFFDictionary as String] as? [String: Any])?[kCGImagePropertyTIFFArtist as String] as? String, "synthetic author")
+        XCTAssertNotNil((before[kCGImagePropertyExifDictionary as String] as? [String: Any])?[kCGImagePropertyExifDateTimeOriginal as String])
+        let output = try UltraImageSanitizer.sanitize(original)
+        let after = try self.properties(output.data)
+        XCTAssertNil(after[kCGImagePropertyGPSDictionary as String])
+        XCTAssertNil((after[kCGImagePropertyTIFFDictionary as String] as? [String: Any])?[kCGImagePropertyTIFFArtist as String])
+        XCTAssertNil((after[kCGImagePropertyTIFFDictionary as String] as? [String: Any])?[kCGImagePropertyTIFFMake as String])
+        XCTAssertNil((after[kCGImagePropertyExifDictionary as String] as? [String: Any])?[kCGImagePropertyExifDateTimeOriginal as String])
+        XCTAssertEqual(output.fileName, "ULTRA-clean.jpg")
+        XCTAssertEqual(output.mimeType, "image/jpeg")
+    }
+
+    func testPNGRemovesTextualAuthorAndPreservesAlpha() throws {
+        let original = try self.fixture(type: .png)
+        let before = try self.properties(original)
+        XCTAssertEqual((before[kCGImagePropertyPNGDictionary as String] as? [String: Any])?[kCGImagePropertyPNGAuthor as String] as? String, "synthetic author")
+        let output = try UltraImageSanitizer.sanitize(original)
+        let after = try self.properties(output.data)
+        XCTAssertNil((after[kCGImagePropertyPNGDictionary as String] as? [String: Any])?[kCGImagePropertyPNGAuthor as String])
+        XCTAssertEqual(after[kCGImagePropertyHasAlpha as String] as? Bool, true)
+        XCTAssertEqual(output.fileName, "ULTRA-clean.png")
+        XCTAssertEqual(output.mimeType, "image/png")
+    }
+
+    func testOrientationAndPixelDimensionsArePreserved() throws {
+        for orientation in [1, 3, 6, 8] {
+            let output = try UltraImageSanitizer.sanitize(self.fixture(orientation: orientation))
+            let properties = try self.properties(output.data)
+            XCTAssertEqual(output.width, 16)
+            XCTAssertEqual(output.height, 8)
+            XCTAssertEqual((properties[kCGImagePropertyOrientation as String] as? NSNumber)?.intValue ?? 1, orientation)
+        }
+    }
+
+    func testUnsupportedAnimatedCorruptAndOversizedInputsAreRejected() throws {
+        let animation = try self.fixture(type: .gif, frames: 2)
+        for data in [Data(), Data("not an image".utf8), animation, Data(repeating: 0, count: UltraImageSanitizer.maximumSourceBytes + 1)] {
+            XCTAssertThrowsError(try UltraImageSanitizer.sanitize(data))
+        }
+    }
+
+    func testReadingAndSanitizingDoesNotModifyTheSourceFile() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-synthetic-photo-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = directory.appendingPathComponent("source.jpg")
+        let original = try self.fixture()
+        try original.write(to: url)
+        try FileManager.default.setAttributes([.posixPermissions: 0o400], ofItemAtPath: url.path)
+        _ = try UltraImageSanitizer.sanitize(UltraImageSanitizer.read(at: url))
+        XCTAssertEqual(try Data(contentsOf: url), original)
+        XCTAssertEqual(try FileManager.default.contentsOfDirectory(atPath: directory.path), ["source.jpg"])
+    }
+
+    func testDirectoriesAndSymlinksAreRejected() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-photo-policy-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        XCTAssertThrowsError(try UltraImageSanitizer.read(at: directory))
+        let source = directory.appendingPathComponent("source.jpg")
+        try self.fixture().write(to: source)
+        let link = directory.appendingPathComponent("link.jpg")
+        try FileManager.default.createSymbolicLink(at: link, withDestinationURL: source)
+        XCTAssertThrowsError(try UltraImageSanitizer.read(at: link))
+    }
+
+    func testUploadPreparationConvertsSingleTIFFWithoutExpandingTheManualCommand() throws {
+        let original = try self.fixture(type: .tiff)
+        XCTAssertThrowsError(try UltraImageSanitizer.sanitize(original))
+        let cleaned = try UltraImageSanitizer.sanitizeForUpload(original, expectedMimeType: nil)
+        XCTAssertEqual(cleaned.mimeType, "image/jpeg")
+        XCTAssertEqual(cleaned.width, 16)
+        XCTAssertEqual(cleaned.height, 8)
+        let properties = try self.properties(cleaned.data)
+        XCTAssertNil(properties[kCGImagePropertyGPSDictionary as String])
+        XCTAssertNil((properties[kCGImagePropertyTIFFDictionary as String] as? [String: Any])?[kCGImagePropertyTIFFArtist as String])
+    }
+
+    func testDeclaredFileTypeMismatchBlocksPreparationInsteadOfReturningTheOriginal() throws {
+        let png = try self.fixture(type: .png)
+        XCTAssertThrowsError(try UltraImageSanitizer.sanitizeForUpload(png, expectedMimeType: "image/jpeg"))
+        XCTAssertThrowsError(try UltraImageSanitizer.sanitizeForUpload(Data("synthetic non-image".utf8), expectedMimeType: nil))
+        XCTAssertEqual(try UltraImageSanitizer.sanitizeForUpload(png, expectedMimeType: "image/png").mimeType, "image/png")
