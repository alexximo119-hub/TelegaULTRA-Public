+import Foundation
+import CryptoKit
+import Security
+import Postbox
+import SwiftSignalKit
+
+private struct UltraLocalHistoryEnvelope: Codable { let sealed: Data }
+
+private func ultraTimedInlineHistory(_ snapshot: UltraLocalHistorySnapshot, peerId: Int64) -> Signal<[Int32: UltraLocalHistoryInlinePreview], NoError> {
+    guard snapshot.records.contains(where: { $0.kind == .edited }) else { return .single([:]) }
+    // Re-evaluate retention while an unchanged chat remains open. This only filters
+    // the already decoded peer snapshot; it performs no decryption, disk or network work.
+    let tick = (Signal<Bool, NoError>.single(true) |> then(Signal<Bool, NoError>.complete() |> delay(60.0, queue: .concurrentDefaultQueue()))) |> restart
+    return tick |> map { _ in
+        return snapshot.inlinePreviews(peerId: peerId, now: Int64(Date().timeIntervalSince1970))
+    } |> distinctUntilChanged
+}
+
+private enum UltraHistoryKey {
+    static func load(accountPeerId: PeerId, create: Bool) throws -> SymmetricKey {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: "app.telegaultra.local-history.v1",
+            kSecAttrAccount as String: String(accountPeerId.toInt64()),
+            kSecAttrSynchronizable as String: false
+        ]
+        var lookup = query
+        lookup[kSecReturnData as String] = true
+        lookup[kSecMatchLimit as String] = kSecMatchLimitOne
+        var item: CFTypeRef?
+        let status = SecItemCopyMatching(lookup as CFDictionary, &item)
+        if status == errSecSuccess, let data = item as? Data, data.count == 32 {
+            return SymmetricKey(data: data)
+        }
+        guard status == errSecItemNotFound, create else { throw CocoaError(.fileReadNoPermission) }
+        var bytes = Data(count: 32)
+        let randomStatus = bytes.withUnsafeMutableBytes { buffer in
+            SecRandomCopyBytes(kSecRandomDefault, buffer.count, buffer.baseAddress!)
+        }
+        guard randomStatus == errSecSuccess else { throw CocoaError(.fileWriteUnknown) }
+        var insertion = query
+        insertion[kSecValueData as String] = bytes
+        insertion[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        let inserted = SecItemAdd(insertion as CFDictionary, nil)
+        if inserted == errSecDuplicateItem { return try self.load(accountPeerId: accountPeerId, create: false) }
+        guard inserted == errSecSuccess else { throw CocoaError(.fileWriteNoPermission) }
+        return SymmetricKey(data: bytes)
+    }
+}
+
+private func ultraHistoryEntry(_ discriminator: UInt8) -> ItemCacheEntryId {
+    let key = ValueBoxKey(length: 1)
+    key.setUInt8(0, value: discriminator)
+    return ItemCacheEntryId(collectionId: Namespaces.CachedItemCollection.ultraLocalHistory, key: key)
+}
+
+private func ultraHistoryTextSpans(_ attributes: [MessageAttribute]) -> [UltraLocalHistoryTextSpan] {
+    guard let entities = attributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute else { return [] }
+    return entities.entities.prefix(256).compactMap { entity in
+        let style: UltraLocalHistoryTextSpan.Style
+        switch entity.type {
+        case .Bold: style = .bold
+        case .Italic: style = .italic
+        case .Code: style = .code
+        case .Pre: style = .pre
+        case .Underline: style = .underline
+        case .Strikethrough: style = .strikethrough
+        case .BlockQuote: style = .quote
+        default: return nil
+        }
+        return UltraLocalHistoryTextSpan(offset: entity.range.lowerBound, length: entity.range.count, style: style)
+    }
+}
+
+/// One buffer per replay transaction; server mutations proceed even if the optional archive is unavailable.
+final class UltraLocalHistoryCapture {
+    let policy: UltraLocalHistoryPolicy
+    private let accountPeerId: PeerId
+    private let now = Int64(Date().timeIntervalSince1970)
+    private var contents: UltraLocalHistoryContents?
+    private var key: SymmetricKey?
+    private var changed = false
+    private var unavailable = false
+
+    init(transaction: Transaction, accountPeerId: PeerId, readDisabled: Bool = false) {
+        self.accountPeerId = accountPeerId
+        self.policy = transaction.retrieveItemCacheEntry(id: ultraHistoryEntry(0))?.get(UltraLocalHistoryPolicy.self) ?? UltraLocalHistoryPolicy()
+        guard self.policy.isEnabled || readDisabled else { return }
+        do {
+            let raw = transaction.retrieveItemCacheEntry(id: ultraHistoryEntry(1))
+            let envelope = raw?.get(UltraLocalHistoryEnvelope.self)
+            guard raw == nil || envelope != nil else { self.unavailable = true; return }
+            let key = try UltraHistoryKey.load(accountPeerId: accountPeerId, create: envelope == nil)
+            self.key = key
+            if let envelope {
+                self.contents = try UltraLocalHistoryCipher.open(envelope.sealed, key: key)
+            } else {
+                self.contents = UltraLocalHistoryContents()
+            }
+            self.changed = self.contents?.prune(now: self.now) ?? false
+        } catch {
+            self.unavailable = true
+            // No payload, key or error description is sent to logs.
+        }
+    }
+
+    /// Called only by the explicit deletion entry point, never by TTL/cache cleanup.
+    static func captureExplicitDeletions(transaction: Transaction, accountPeerId: PeerId, ids: [MessageId]) {
+        self.explicitDeletionHandler(transaction: transaction, accountPeerId: accountPeerId)?(ids)
+    }
+
+    /// Share the bounded budget across every removal in one explicit clear action.
+    static func explicitDeletionHandler(transaction: Transaction, accountPeerId: PeerId?) -> (([MessageId]) -> Void)? {
+        guard let accountPeerId else { return nil }
+        let policy = transaction.retrieveItemCacheEntry(id: ultraHistoryEntry(0))?.get(UltraLocalHistoryPolicy.self) ?? UltraLocalHistoryPolicy()
+        guard policy.deleted && policy.localDeletions else { return nil }
+        var capture: UltraLocalHistoryCapture?
+        var remaining = 1000
+        var seen = Set<MessageId>()
+        return { ids in
+            guard remaining > 0, !ids.isEmpty else { return }
+            // The native operation already determined its exact removal set. Never
+            // enumerate the chat a second time or read more than 1000 candidates.
+            let candidates = ids.prefix(remaining)
+            remaining -= candidates.count
+            for id in candidates where seen.insert(id).inserted {
+                guard id.namespace == Namespaces.Message.Cloud, id.peerId.namespace != Namespaces.Peer.SecretChat else { continue }
+                if capture == nil { capture = UltraLocalHistoryCapture(transaction: transaction, accountPeerId: accountPeerId) }
+                if let message = transaction.getMessage(id) {
+                    capture?.capture(message, kind: .deleted, locallyDeleted: true)
+                }
+            }
+            capture?.commit(transaction: transaction)
+        }
+    }
+
+    func capture(_ message: Message, kind: UltraLocalHistoryRecord.Kind, locallyDeleted: Bool = false) {
+        guard self.contents != nil, message.id.namespace == Namespaces.Message.Cloud,
+              message.id.peerId.namespace != Namespaces.Peer.SecretChat,
+              message.autoclearAttribute == nil, message.autoremoveAttribute == nil else { return }
+        let isOwn = message.author?.id == self.accountPeerId || !message.flags.contains(.Incoming)
+        guard self.policy.allowsCapture(kind: kind, isOwn: isOwn, locallyDeleted: locallyDeleted) else { return }
+        let captured = ultraHistoryMessageText(text: message.text, attributes: message.attributes)
+        guard !captured.text.isEmpty else { return }
+        let appended = self.contents?.append(UltraLocalHistoryRecord(peerId: message.id.peerId.toInt64(), messageId: message.id.id, authorId: message.author?.id.toInt64(), messageTimestamp: message.timestamp, capturedAt: self.now, kind: kind, text: captured.text, spans: captured.usesEntities ? ultraHistoryTextSpans(message.attributes) : [], isOwn: isOwn, sourceTruncated: captured.truncated), now: self.now) ?? false
+        self.changed = self.changed || appended
+    }
+
+    func captureEdit(_ previous: Message, updated: StoreMessage) {
+        guard self.contents != nil, previous.id.namespace == Namespaces.Message.Cloud,
+              previous.id.peerId.namespace != Namespaces.Peer.SecretChat,
+              previous.autoclearAttribute == nil, previous.autoremoveAttribute == nil,
+              self.policy.allowsCapture(kind: .edited, isOwn: previous.author?.id == self.accountPeerId || !previous.flags.contains(.Incoming)) else { return }
+        let previousEntities = (previous.attributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute)?.entities ?? []
+        let updatedEntities = (updated.attributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute)?.entities ?? []
+        let previousText = ultraHistoryMessageText(text: previous.text, attributes: previous.attributes)
+        let updatedText = ultraHistoryMessageText(text: updated.text, attributes: updated.attributes)
+        if previousText.text != updatedText.text || previousText.truncated != updatedText.truncated || previousEntities != updatedEntities { self.capture(previous, kind: .edited) }
+    }
+
+    func commit(transaction: Transaction) {
+        guard self.changed, let contents = self.contents, let key = self.key else { return }
+        do {
+            let sealed = try UltraLocalHistoryCipher.seal(contents, key: key)
+            guard let entry = CodableEntry(UltraLocalHistoryEnvelope(sealed: sealed)) else { self.unavailable = true; return }
+            transaction.putItemCacheEntry(id: ultraHistoryEntry(1), entry: entry)
+            self.changed = false
+        } catch {
+            self.unavailable = true
+        }
+    }
+
+    var snapshot: UltraLocalHistorySnapshot {
+        return UltraLocalHistorySnapshot(policy: self.policy, records: self.contents?.records.reversed().map { $0 } ?? [], unavailable: self.unavailable).hidingOwn(accountPeerId: self.accountPeerId.toInt64())
+    }
+}
+
+public extension TelegramEngine.Messages {
+    func ultraLocalHistoryInlinePreviews(peerId: PeerId?) -> Signal<[Int32: UltraLocalHistoryInlinePreview], NoError> {
+        guard let peerId = peerId, peerId.namespace != Namespaces.Peer.SecretChat else { return .single([:]) }
+        let policyKey = PostboxViewKey.cachedItem(ultraHistoryEntry(0))
+        let archiveKey = PostboxViewKey.cachedItem(ultraHistoryEntry(1))
+        let policy = self.account.postbox.combinedView(keys: [policyKey])
+        |> map { views -> UltraLocalHistoryPolicy in
+            return (views.views[policyKey] as? CachedItemView)?.value?.get(UltraLocalHistoryPolicy.self) ?? UltraLocalHistoryPolicy()
+        }
+        |> distinctUntilChanged
+        let previews = policy |> mapToSignal { policy -> Signal<[Int32: UltraLocalHistoryInlinePreview], NoError> in
+            guard policy.inlineEdits else { return .single([:]) }
+            return self.account.postbox.combinedView(keys: [archiveKey])
+            |> map { views -> Data? in
+                return (views.views[archiveKey] as? CachedItemView)?.value?.get(UltraLocalHistoryEnvelope.self)?.sealed
+            }
+            |> distinctUntilChanged
+            |> mapToSignal { sealed -> Signal<[Int32: UltraLocalHistoryInlinePreview], NoError> in
+                guard let sealed = sealed else { return .single([:]) }
+                return self.account.postbox.transaction { _ -> UltraLocalHistorySnapshot? in
+                    do {
+                        // Observation must not create keys, migrate, prune or rewrite the archive.
+                        let key = try UltraHistoryKey.load(accountPeerId: self.account.peerId, create: false)
+                        let contents = try UltraLocalHistoryCipher.open(sealed, key: key)
+                        let snapshot = UltraLocalHistorySnapshot(policy: policy, records: Array(contents.records.reversed()), unavailable: false)
+                        return snapshot.hidingOwn(accountPeerId: self.account.peerId.toInt64()).filtered(peerId: peerId.toInt64())
+                    } catch { return nil }
+                }
+                |> mapToSignal { snapshot -> Signal<[Int32: UltraLocalHistoryInlinePreview], NoError> in
+                    guard let snapshot = snapshot else { return .single([:]) }
+                    return ultraTimedInlineHistory(snapshot, peerId: peerId.toInt64())
+                }
+            }
+        }
+        // Never block the native first history frame on Keychain/decryption.
+        return .single([:]) |> then(previews) |> distinctUntilChanged
+    }
+
+    func ultraLocalHistory() -> Signal<UltraLocalHistorySnapshot, NoError> {
+        return self.account.postbox.transaction { transaction in
+            let capture = UltraLocalHistoryCapture(transaction: transaction, accountPeerId: self.account.peerId, readDisabled: true)
+            capture.commit(transaction: transaction)
+            return capture.snapshot
+        }
+    }
+
+    func updateUltraLocalHistoryPolicy(_ update: @escaping (UltraLocalHistoryPolicy) -> UltraLocalHistoryPolicy) -> Signal<Bool, NoError> {
+        return self.account.postbox.transaction { transaction in
+            let previous = transaction.retrieveItemCacheEntry(id: ultraHistoryEntry(0))?.get(UltraLocalHistoryPolicy.self) ?? UltraLocalHistoryPolicy()
+            let policy = update(previous)
+            if policy.isEnabled {
+                do { _ = try UltraHistoryKey.load(accountPeerId: self.account.peerId, create: transaction.retrieveItemCacheEntry(id: ultraHistoryEntry(1)) == nil) }
+                catch { return false }
+            }
+            guard let entry = CodableEntry(policy) else { return false }
+            transaction.putItemCacheEntry(id: ultraHistoryEntry(0), entry: entry)
+            return true
+        }
+    }
+
+    func clearUltraLocalHistory() -> Signal<Void, NoError> {
+        return self.account.postbox.transaction { transaction in
+            transaction.removeItemCacheEntry(id: ultraHistoryEntry(1))
+        }
+    }
+}
