+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public func ultraAddAccountSlot(accountManager: AccountManager<TelegramAccountManagerTypes>, testingEnvironment: Bool) -> Signal<Bool, NoError> {
+    return accountManager.transaction { transaction -> Bool in
+        let records = transaction.getRecords().filter { record in
+            return !record.attributes.contains(where: { if case .loggedOut = $0 { return true }; return false })
+        }
+        guard records.count < UltraAccountLoadPolicy.catalogLimit else { return false }
+        // Reuse the native auth-record path. It is distinct from all authorized records.
+        let _ = transaction.createAuth([.environment(AccountEnvironmentAttribute(environment: testingEnvironment ? .test : .production))])
+        return true
+    }
+}
+
+/// Covers dormant records too; the UI's resident AccountContext array is not a complete directory.
+func ultraExistingAccountUserIds(transaction: AccountManagerModifier<TelegramAccountManagerTypes>, testingEnvironment: Bool, excluding: AccountRecordId) -> Set<Int64> {
+    let directory = Dictionary(uniqueKeysWithValues: UltraAccountDirectoryStore.entries().map { ($0.recordId, $0) })
+    var result = Set<Int64>()
+    for record in transaction.getRecords() where record.id != excluding {
+        if record.attributes.contains(where: { if case .loggedOut = $0 { return true }; return false }) { continue }
+        let testing = record.attributes.contains(where: { attribute in
+            if case let .environment(environment) = attribute, case .test = environment.environment { return true }
+            return false
+        })
+        guard testing == testingEnvironment else { continue }
+        for attribute in record.attributes {
+            if case let .backupData(backup) = attribute, let data = backup.data {
+                let peerId = PeerId(data.peerId)
+                let userId = peerId.id._internalGetInt64Value()
+                if peerId.namespace == Namespaces.Peer.CloudUser && userId > 0 { result.insert(userId) }
+            }
+        }
+        if let entry = directory[record.id.int64], entry.testingEnvironment == testingEnvironment { result.insert(entry.userId) }
+    }
+    return result
+}
