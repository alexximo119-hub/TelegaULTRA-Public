+import Foundation
+import Postbox
+
+struct UltraLocalHistoryCapturedText {
+    let text: String
+    let truncated: Bool
+    let usesEntities: Bool
+}
+
+private enum UltraHistoryTextWork {
+    case block(InstantPageBlock)
+    case text(RichText)
+    case caption(InstantPageCaption)
+    case list(InstantPageListItem)
+    case row(InstantPageTableRow)
+    case cell(InstantPageTableCell)
+    case button(InstantPageButton)
+    case article(InstantPageRelatedArticle)
+    case blocks([InstantPageBlock], Int)
+    case texts([RichText], Int)
+    case listItems([InstantPageListItem], Int)
+    case rows([InstantPageTableRow], Int)
+    case cells([InstantPageTableCell], Int)
+    case buttons([InstantPageButton], Int)
+    case articles([InstantPageRelatedArticle], Int)
+    case separator
+}
+
+/// Iterative and bounded: neither deep nesting nor a broad page can recursively
+/// expand the optional archive. Only visible labels are retained, never actions.
+func ultraHistoryRichText(_ page: InstantPage) -> UltraLocalHistoryCapturedText {
+    var stack: [UltraHistoryTextWork] = []
+    var visited = 0
+    var truncated = !page.isComplete
+    var stopped = false
+    var separator = false
+    var result = ""
+
+    func sequence(_ values: [UltraHistoryTextWork]) {
+        guard stack.count + values.count <= 2048 else { truncated = true; stopped = true; return }
+        stack.append(contentsOf: values.reversed())
+    }
+    func raw(_ value: String) {
+        guard !stopped, !value.isEmpty else { return }
+        let remaining = max(0, 16 * 1024 - result.utf8.count)
+        var bytes = Array(value.utf8.prefix(remaining + 1))
+        if bytes.count > remaining { bytes.removeLast(); truncated = true; stopped = true }
+        while String(bytes: bytes, encoding: .utf8) == nil, !bytes.isEmpty { bytes.removeLast() }
+        result += String(bytes: bytes, encoding: .utf8) ?? ""
+    }
+    func append(_ value: String) {
+        guard !value.isEmpty else { return }
+        if separator && !result.isEmpty && !result.hasSuffix("\n") { raw("\n") }
+        separator = false
+        raw(value)
+    }
+
+    sequence([.blocks(page.blocks, 0)])
+    while !stopped, visited < 2048, let item = stack.popLast() {
+        visited += 1
+        switch item {
+        // Cursors retain the existing arrays without eagerly queuing every sibling.
+        // This leaves budget for the first child's descendants even on a huge page.
+        case let .blocks(items, index):
+            if index < items.count { sequence([.block(items[index]), .blocks(items, index + 1)]) }
+        case let .texts(items, index):
+            if index < items.count { sequence([.text(items[index]), .texts(items, index + 1)]) }
+        case let .listItems(items, index):
+            if index < items.count { sequence([.list(items[index]), .listItems(items, index + 1)]) }
+        case let .rows(items, index):
+            if index < items.count { sequence([.row(items[index]), .rows(items, index + 1)]) }
+        case let .cells(items, index):
+            if index < items.count { sequence([.cell(items[index]), .cells(items, index + 1)]) }
+        case let .buttons(items, index):
+            if index < items.count { sequence([.button(items[index]), .buttons(items, index + 1)]) }
+        case let .articles(items, index):
+            if index < items.count { sequence([.article(items[index]), .articles(items, index + 1)]) }
+        case .separator: separator = true
+        case let .caption(caption): sequence([.text(caption.text), .separator, .text(caption.credit), .separator])
+        case let .row(row):
+            sequence([.cells(row.cells, 0), .separator])
+        case let .cell(cell): sequence([.text(cell.text ?? .empty), .separator])
+        case let .button(button): sequence([.text(button.text), .separator])
+        case let .article(article):
+            sequence([.text(.plain(article.title ?? "")), .separator, .text(.plain(article.description ?? "")), .separator, .text(.plain(article.author ?? "")), .separator])
+        case let .list(item):
+            switch item {
+            case let .text(text, _, _): sequence([.text(text), .separator])
+            case let .blocks(blocks, _, _): sequence([.blocks(blocks, 0)])
+            case .unknown: truncated = true
+            }
+        case let .block(block):
+            switch block {
+            case let .title(text), let .subtitle(text), let .header(text), let .subheader(text), let .heading(text, _), let .paragraph(text), let .preformatted(text, _), let .footer(text), let .kicker(text), let .thinking(text), let .authorDate(text, _):
+                sequence([.text(text), .separator])
+            case let .formula(latex): sequence([.text(.plain(latex)), .separator])
+            case let .list(items, _): sequence([.listItems(items, 0)])
+            case let .blockQuote(blocks, caption, _):
+                sequence([.blocks(blocks, 0), .text(caption), .separator])
+            case let .pullQuote(text, caption): sequence([.text(text), .separator, .text(caption), .separator])
+            case let .image(_, caption, _, _, _), let .video(_, caption, _, _, _), let .audio(_, caption), let .document(_, caption), let .webEmbed(_, _, _, caption, _, _, _), let .map(_, _, _, _, caption):
+                truncated = true // The media/embed itself is not copied into this text archive.
+                sequence([.caption(caption)])
+            case let .cover(block): sequence([.block(block)])
+            case let .postEmbed(_, _, _, author, _, blocks, caption):
+                sequence([.text(.plain(author)), .separator, .blocks(blocks, 0), .caption(caption)])
+            case let .collage(items, caption), let .slideshow(items, caption):
+                sequence([.blocks(items, 0), .caption(caption)])
+            case let .details(title, blocks, _):
+                sequence([.text(title), .separator, .blocks(blocks, 0)])
+            case let .table(title, rows, _, _, _):
+                sequence([.text(title), .separator, .rows(rows, 0)])
+            case let .relatedArticles(title, articles):
+                sequence([.text(title), .separator, .articles(articles, 0)])
+            case let .buttonRow(_, buttons): sequence([.buttons(buttons, 0)])
+            case .unsupported, .channelBanner: truncated = true
+            case .divider: separator = true
+            case .anchor: break
+            }
+        case let .text(text):
+            switch text {
+            case .empty: break
+            case let .plain(value), let .formula(value), let .textCustomEmoji(_, value): append(value)
+            case let .concat(items): sequence([.texts(items, 0)])
+            case let .bold(value), let .italic(value), let .underline(value), let .strikethrough(value), let .fixed(value), let .url(value, _, _), let .email(value, _), let .subscript(value), let .superscript(value), let .marked(value), let .phone(value, _), let .anchor(value, _), let .textAutoEmail(value), let .textAutoPhone(value), let .textAutoUrl(value), let .textBankCard(value), let .textTonAddress(value), let .textBotCommand(value), let .textCashtag(value), let .textHashtag(value), let .textMention(value), let .textMentionName(value, _), let .textSpoiler(value), let .textDate(value, _, _):
+                sequence([.text(value)])
+            case let .textButton(button): sequence([.text(button.text)])
+            case .image: truncated = true
+            }
+        }
+    }
+    if !stack.isEmpty { truncated = true }
+    return UltraLocalHistoryCapturedText(text: result, truncated: truncated, usesEntities: false)
+}
+
+func ultraHistoryMessageText(text: String, attributes: [MessageAttribute]) -> UltraLocalHistoryCapturedText {
+    if let rich = attributes.first(where: { $0 is RichTextMessageAttribute }) as? RichTextMessageAttribute {
+        let captured = ultraHistoryRichText(rich.fullInstantPage ?? rich.instantPage)
+        if !captured.text.isEmpty { return captured }
+        return UltraLocalHistoryCapturedText(text: text, truncated: captured.truncated, usesEntities: true)
+    }
+    return UltraLocalHistoryCapturedText(text: text, truncated: false, usesEntities: true)
+}
