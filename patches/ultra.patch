diff --git a/submodules/Display/Source/UltraFontFilePolicy.swift b/submodules/Display/Source/UltraFontFilePolicy.swift
new file mode 100644
index 00000000..d0778166
--- /dev/null
+++ b/submodules/Display/Source/UltraFontFilePolicy.swift
@@ -0,0 +1,33 @@
+import Foundation
+
+public enum UltraFontFilePolicy {
+    public static let maximumBytes = 10 * 1024 * 1024
+
+    public static func readFont(at url: URL) throws -> Data {
+        guard ["ttf", "otf"].contains(url.pathExtension.lowercased()) else {
+            throw CocoaError(.fileReadUnsupportedScheme)
+        }
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard values.isRegularFile == true, values.isSymbolicLink != true,
+              let size = values.fileSize, size > 0, size <= self.maximumBytes else {
+            throw CocoaError(.fileReadTooLarge)
+        }
+        let handle = try FileHandle(forReadingFrom: url)
+        defer { try? handle.close() }
+        var data = Data()
+        while data.count <= self.maximumBytes {
+            let chunk = try handle.read(upToCount: min(65536, self.maximumBytes + 1 - data.count)) ?? Data()
+            if chunk.isEmpty { break }
+            data.append(chunk)
+        }
+        guard data.count >= 12, data.count <= self.maximumBytes else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        // Only single-face TrueType/OpenType SFNT files; collections and archives are separate formats.
+        let signature = Array(data.prefix(4))
+        guard signature == [0, 1, 0, 0] || signature == Array("OTTO".utf8) || signature == Array("true".utf8) else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        return data
+    }
+}
diff --git a/submodules/Display/Source/UltraFontRegistry.swift b/submodules/Display/Source/UltraFontRegistry.swift
new file mode 100644
index 00000000..4e2443db
--- /dev/null
+++ b/submodules/Display/Source/UltraFontRegistry.swift
@@ -0,0 +1,87 @@
+import Foundation
+import UIKit
+import CoreText
+
+public final class UltraFontRegistry {
+    public static let shared = UltraFontRegistry()
+    private let key = "ultra.font.selection.v1"
+    private let queue = DispatchQueue(label: "app.telegaultra.fonts")
+    private var activeFont: CGFont?
+    private var activeName: String?
+
+    private var directory: URL {
+        return URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true).appendingPathComponent("Library/Application Support/ULTRA-Font", isDirectory: true)
+    }
+
+    private func selectedURL() -> URL? {
+        guard let name = UserDefaults.standard.string(forKey: self.key), ["selected.ttf", "selected.otf"].contains(name) else { return nil }
+        return self.directory.appendingPathComponent(name)
+    }
+
+    private func inspect(_ data: Data) throws -> (CGFont, String) {
+        guard let provider = CGDataProvider(data: data as CFData), let font = CGFont(provider), let rawName = font.postScriptName else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        let name = rawName as String
+        guard !name.isEmpty, name.utf8.count <= 128, name.rangeOfCharacter(from: .controlCharacters) == nil else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        return (font, name)
+    }
+
+    public func selectedName() -> String? {
+        return self.queue.sync {
+            guard let url = self.selectedURL(), let data = try? UltraFontFilePolicy.readFont(at: url), let result = try? self.inspect(data) else { return nil }
+            return result.1
+        }
+    }
+
+    /// Called once before creating Telegram's UI. Invalid/missing files fall back to system fonts.
+    public func activateAtStartup() {
+        self.queue.sync {
+            guard self.activeFont == nil, let url = self.selectedURL(),
+                  let data = try? UltraFontFilePolicy.readFont(at: url),
+                  let (font, name) = try? self.inspect(data) else { return }
+            guard CTFontManagerRegisterGraphicsFont(font, nil), UIFont(name: name, size: 17) != nil else { return }
+            self.activeFont = font
+            self.activeName = name
+            Font.setUltraTypefaceName(name)
+        }
+    }
+
+    public func importFont(from url: URL) throws {
+        try self.queue.sync {
+            let data = try UltraFontFilePolicy.readFont(at: url)
+            let (_, name) = try self.inspect(data)
+            // Don't shadow an already installed system/bundled typeface with the same PostScript name.
+            guard UIFont(name: name, size: 17) == nil || name == self.activeName else {
+                throw CocoaError(.fileWriteFileExists)
+            }
+            try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+            var directory = self.directory
+            var values = URLResourceValues()
+            values.isExcludedFromBackup = true
+            try directory.setResourceValues(values)
+            let fileName = "selected." + url.pathExtension.lowercased()
+            let destination = self.directory.appendingPathComponent(fileName)
+            try data.write(to: destination, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            UserDefaults.standard.set(fileName, forKey: self.key)
+            for other in ["selected.ttf", "selected.otf"] where other != fileName {
+                try? FileManager.default.removeItem(at: self.directory.appendingPathComponent(other))
+            }
+        }
+    }
+
+    public func reset() throws {
+        try self.queue.sync {
+            for name in ["selected.ttf", "selected.otf"] {
+                let url = self.directory.appendingPathComponent(name)
+                if FileManager.default.fileExists(atPath: url.path) {
+                    try FileManager.default.removeItem(at: url)
+                }
+            }
+            UserDefaults.standard.removeObject(forKey: self.key)
+            // The current process retains its registered font until the explicit relaunch.
+        }
+    }
+}
