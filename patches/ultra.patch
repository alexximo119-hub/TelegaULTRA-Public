+import Foundation
+
+public enum AccountPresencePolicy: Int32, Equatable {
+    case automatic = 0
+    case offline = 1
+    case onlineWhileRunning = 2
+
+    public func resolve(automaticallyOnline: Bool) -> Bool {
+        switch self {
+        case .automatic: return automaticallyOnline
+        case .offline: return false
+        case .onlineWhileRunning: return true
+        }
+    }
+
+    public func forAccount(isPrimary: Bool) -> AccountPresencePolicy {
+        // Don't mark all loaded accounts online when the user enables the primary account's mode.
+        return self == .onlineWhileRunning && !isPrimary ? .automatic : self
+    }
+}
