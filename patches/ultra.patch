@@ -0,0 +1,65 @@
+import Foundation
+import XCTest
+@testable import UltraFontPolicy
+
+final class UltraFontFilePolicyTests: XCTestCase {
+    private var directory: URL!
+    override func setUpWithError() throws {
+        self.directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+    }
+    override func tearDownWithError() throws {
+        try FileManager.default.removeItem(at: self.directory)
+    }
+
+    private func file(_ name: String, _ data: Data) throws -> URL {
+        let url = self.directory.appendingPathComponent(name)
+        try data.write(to: url)
+        return url
+    }
+
+    func testSingleFontHeadersReachCoreTextValidationUnmodified() throws {
+        for (name, signature) in [("font.TTF", Data([0, 1, 0, 0])), ("font.otf", Data("OTTO".utf8))] {
+            var data = signature
+            data.append(Data(repeating: 0, count: 100))
+            XCTAssertEqual(try UltraFontFilePolicy.readFont(at: self.file(name, data)), data)
+        }
+    }
+
+    func testArchiveOrOtherExtensionIsRejected() throws {
+        let url = try self.file("font.zip", Data([0, 1, 0, 0] + [UInt8](repeating: 0, count: 100)))
+        XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: url))
+    }
+
+    func testRenamedArchiveOrCollectionIsRejected() throws {
+        for signature in [Array("PK\u{3}\u{4}".utf8), Array("ttcf".utf8)] {
+            let url = try self.file("font.ttf", Data(signature + [UInt8](repeating: 0, count: 100)))
+            XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: url))
+        }
+    }
+
+    func testEmptyOrTruncatedFileIsRejected() throws {
+        for data in [Data(), Data([0, 1, 0, 0])] {
+            let url = try self.file("font.ttf", data)
+            XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: url))
+        }
+    }
+
+    func testOversizedFileIsRejected() throws {
+        let url = try self.file("font.ttf", Data(repeating: 0, count: UltraFontFilePolicy.maximumBytes + 1))
+        XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: url))
+    }
+
+    func testDirectoryIsRejected() throws {
+        let url = self.directory.appendingPathComponent("font.ttf", isDirectory: true)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: url))
+    }
+
+    func testSymbolicLinkIsRejected() throws {
+        let original = try self.file("original.ttf", Data([0, 1, 0, 0] + [UInt8](repeating: 0, count: 100)))
+        let link = self.directory.appendingPathComponent("link.ttf")
+        try FileManager.default.createSymbolicLink(at: link, withDestinationURL: original)
+        XCTAssertThrowsError(try UltraFontFilePolicy.readFont(at: link))
+    }
+}
diff --git a/Tests/UltraHistoryTests/UltraLocalHistoryCipherTests.swift b/Tests/UltraHistoryTests/UltraLocalHistoryCipherTests.swift
new file mode 100644
index 00000000..49fa8c9a
--- /dev/null
+++ b/Tests/UltraHistoryTests/UltraLocalHistoryCipherTests.swift
@@ -0,0 +1,61 @@
+import Foundation
+import CryptoKit
+import XCTest
+@testable import UltraHistoryModels
+
+final class UltraLocalHistoryCipherTests: XCTestCase {
+    func testAuthenticatedArchiveWithMalformedOwnershipFlagIsRejected() throws {
+        var contents = UltraLocalHistoryContents()
+        contents.records = [UltraLocalHistoryRecord(peerId: 1, messageId: 2, authorId: nil, messageTimestamp: 3, capturedAt: 4, kind: .deleted, text: "synthetic", isOwn: true)]
+        var object = try XCTUnwrap(JSONSerialization.jsonObject(with: JSONEncoder().encode(contents)) as? [String: Any])
+        var records = try XCTUnwrap(object["records"] as? [[String: Any]])
+        records[0]["isOwn"] = "unverified"
+        object["records"] = records
+        let malformed = try JSONSerialization.data(withJSONObject: object)
+        let sealed = try XCTUnwrap(AES.GCM.seal(malformed, using: self.key).combined)
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.open(sealed, key: self.key))
+    }
+    private let key = SymmetricKey(data: Data(repeating: 0x11, count: 32)) // Synthetic test key.
+    func testRoundTripUsesDistinctNonces() throws {
+        var contents = UltraLocalHistoryContents()
+        contents.records = [UltraLocalHistoryRecord(peerId: 1, messageId: 2, authorId: nil, messageTimestamp: 3, capturedAt: 4, kind: .edited, text: "synthetic private text")]
+        let first = try UltraLocalHistoryCipher.seal(contents, key: self.key)
+        let second = try UltraLocalHistoryCipher.seal(contents, key: self.key)
+        XCTAssertNotEqual(first, second)
+        XCTAssertEqual(try UltraLocalHistoryCipher.open(first, key: self.key), contents)
+    }
+    func testWrongKeyAndTamperingAreRejected() throws {
+        let sealed = try UltraLocalHistoryCipher.seal(UltraLocalHistoryContents(), key: self.key)
+        let wrong = SymmetricKey(data: Data(repeating: 0x22, count: 32))
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.open(sealed, key: wrong))
+        var modified = sealed
+        modified[modified.count - 1] ^= 1
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.open(modified, key: self.key))
+    }
+    func testUnknownVersionIsRejectedBeforeReadOrWrite() throws {
+        var contents = UltraLocalHistoryContents()
+        contents.version = 2
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.seal(contents, key: self.key))
+        let sealed = try XCTUnwrap(AES.GCM.seal(JSONEncoder().encode(contents), using: self.key).combined)
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.open(sealed, key: self.key))
+    }
+    func testInvalidAndOversizedCiphertextAreRejected() {
+        for bytes in [Data(), Data(repeating: 0, count: 28), Data(repeating: 0, count: 4 * 1024 * 1024 + 29)] {
+            XCTAssertThrowsError(try UltraLocalHistoryCipher.open(bytes, key: self.key))
+        }
+    }
+
+    func testAuthenticatedEnvelopeWithInvalidFormattingRangesIsRejected() throws {
+        let record = UltraLocalHistoryRecord(peerId: 1, messageId: 2, authorId: nil, messageTimestamp: 3, capturedAt: 4, kind: .edited, text: "🙂", spans: [UltraLocalHistoryTextSpan(offset: 0, length: 2, style: .bold)])
+        var contents = UltraLocalHistoryContents()
+        contents.records = [record]
+        let encoded = try JSONEncoder().encode(contents)
+        var object = try XCTUnwrap(JSONSerialization.jsonObject(with: encoded) as? [String: Any])
+        var records = try XCTUnwrap(object["records"] as? [[String: Any]])
+        records[0]["spans"] = [["offset": 1, "length": 1, "style": "bold"]]
+        object["records"] = records
+        let malformed = try JSONSerialization.data(withJSONObject: object)
+        let sealed = try XCTUnwrap(AES.GCM.seal(malformed, using: self.key).combined)
+        XCTAssertThrowsError(try UltraLocalHistoryCipher.open(sealed, key: self.key))
+    }
+}
diff --git a/Tests/UltraHistoryTests/UltraLocalHistoryInlineTests.swift b/Tests/UltraHistoryTests/UltraLocalHistoryInlineTests.swift
new file mode 100644
index 00000000..ddf8a8e7
--- /dev/null
+++ b/Tests/UltraHistoryTests/UltraLocalHistoryInlineTests.swift
@@ -0,0 +1,87 @@
+import Foundation
+import XCTest
+@testable import UltraHistoryModels
+
+final class UltraLocalHistoryInlineTests: XCTestCase {
+    private let now: Int64 = 5_000_000
+    private func record(_ text: String, peerId: Int64 = 1, messageId: Int32 = 10, at: Int64 = 5_000_000, kind: UltraLocalHistoryRecord.Kind = .edited) -> UltraLocalHistoryRecord {
+        return UltraLocalHistoryRecord(peerId: peerId, messageId: messageId, authorId: 2, messageTimestamp: 42, capturedAt: at, kind: kind, text: text)
+    }
+    private func snapshot(_ records: [UltraLocalHistoryRecord], enabled: Bool = true, unavailable: Bool = false, strike: Bool = true) -> UltraLocalHistorySnapshot {
+        var policy = UltraLocalHistoryPolicy()
+        policy.inlineEdits = enabled
+        policy.strikeOriginals = strike
+        return UltraLocalHistorySnapshot(policy: policy, records: records, unavailable: unavailable)
+    }
+
+    func testLegacyPolicyDoesNotEnableInlineRenderingOrCapture() throws {
+        let legacy = Data(#"{"edited":true,"excludeOwn":false,"strikeOriginals":false}"#.utf8)
+        let policy = try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: legacy)
+        XCTAssertFalse(policy.inlineEdits)
+        XCTAssertTrue(policy.edited)
+        XCTAssertFalse(policy.excludeOwn)
+        XCTAssertFalse(policy.strikeOriginals)
+        var displayOnly = UltraLocalHistoryPolicy()
+        displayOnly.inlineEdits = true
+        XCTAssertFalse(displayOnly.isEnabled, "Displaying local copies must not silently turn recording on")
+        XCTAssertEqual(try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: JSONEncoder().encode(displayOnly)), displayOnly)
+    }
+
+    func testChoosesEarliestRetainedEditAndPreservesFullMessageIdentity() {
+        let oldest = self.record("A", at: self.now - 2)
+        let newer = self.record("B", at: self.now - 1)
+        let received = self.record("C", kind: .received)
+        let otherChat = self.record("Other", peerId: 2)
+        let previews = self.snapshot([received, otherChat, newer, oldest]).inlinePreviews(peerId: 1, now: self.now)
+        XCTAssertEqual(previews.count, 1)
+        XCTAssertEqual(previews[10]?.recordId, oldest.id)
+        XCTAssertEqual(previews[10]?.text, "A")
+        XCTAssertEqual(previews[10]?.peerId, 1)
+        XCTAssertEqual(previews[10]?.messageId, 10)
+        XCTAssertEqual(self.snapshot([otherChat]).inlinePreviews(peerId: 2, now: self.now)[10]?.peerId, 2)
+    }
+
+    func testOffUnavailableDeletedAndReceivedStatesNeverProduceAnInlineEdit() {
+        let edited = self.record("Edit")
+        XCTAssertTrue(self.snapshot([edited], enabled: false).inlinePreviews(peerId: 1, now: self.now).isEmpty)
+        XCTAssertTrue(self.snapshot([edited], unavailable: true).inlinePreviews(peerId: 1, now: self.now).isEmpty)
+        let deleted = self.record("Deleted", kind: .deleted)
+        let received = self.record("Received", kind: .received)
+        XCTAssertTrue(self.snapshot([deleted, received]).inlinePreviews(peerId: 1, now: self.now).isEmpty)
+    }
+
+    func testPreviewTruncationKeepsUnicodeAndDoesNotChangeTheArchivedRecord() {
+        let text = String(repeating: "🙂я", count: 300)
+        let record = self.record(text)
+        let snapshot = self.snapshot([record])
+        let preview = snapshot.inlinePreviews(peerId: 1, now: self.now)[10]
+        XCTAssertEqual(preview?.text.count, 400)
+        XCTAssertTrue(preview?.truncated == true)
+        XCTAssertTrue(text.hasPrefix(preview?.text ?? ""))
+        XCTAssertEqual(snapshot.records.first?.text, text)
+        XCTAssertEqual(snapshot.records.first?.id, record.id)
+    }
+
+    func testExpiredFutureEmptyAndInvalidIdsAreExcluded() {
+        let expired = self.record("Expired", at: self.now - 30 * 86400 - 1)
+        let future = self.record("Future", at: self.now + 301)
+        let empty = self.record("")
+        let invalid = self.record("Invalid", messageId: 0)
+        XCTAssertTrue(self.snapshot([expired, future, empty, invalid]).inlinePreviews(peerId: 1, now: self.now).isEmpty)
+        XCTAssertTrue(self.snapshot([expired]).inlinePreviews(peerId: 999, now: self.now).isEmpty)
+    }
+
+    func testStrikePreferenceChangesPresentationWithoutChangingTheLocalCopy() {
+        let record = self.record("Same")
+        let struck = self.snapshot([record]).inlinePreviews(peerId: 1, now: self.now)[10]
+        let plain = self.snapshot([record], strike: false).inlinePreviews(peerId: 1, now: self.now)[10]
+        XCTAssertTrue(struck?.strike == true)
+        XCTAssertFalse(plain?.strike ?? true)
+        XCTAssertEqual(struck?.recordId, plain?.recordId)
+        XCTAssertNotEqual(struck, plain)
+    }
+
+    func testCorruptInlinePolicyTypeFailsClosedInsteadOfTreatingItAsEnabled() {
+        XCTAssertThrowsError(try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: Data(#"{"inlineEdits":"true"}"#.utf8)))
+    }
+}
