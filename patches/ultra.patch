diff --git a/submodules/TelegramUIPreferences/Sources/UltraSettings.swift b/submodules/TelegramUIPreferences/Sources/UltraSettings.swift
new file mode 100644
index 00000000..76bcf686
--- /dev/null
+++ b/submodules/TelegramUIPreferences/Sources/UltraSettings.swift
@@ -0,0 +1,40 @@
+import Foundation
+import TelegramCore
+
+public struct UltraSettings: Codable, Equatable {
+    public var showCharacterCount: Bool = false
+    public var hideTyping: Bool = false
+    public var hideRecording: Bool = false
+    public var rearCamera: Bool = false
+    public var hideGalleryCamera: Bool = false
+    public var highQualityPhotos: Bool = false
+    public var confirmCalls: Bool = false
+    public var disableCameraSwipe: Bool = false
+
+    public init() {
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: StringCodingKey.self)
+        self.showCharacterCount = try container.decodeIfPresent(Bool.self, forKey: "showCharacterCount") ?? false
+        self.hideTyping = try container.decodeIfPresent(Bool.self, forKey: "hideTyping") ?? false
+        self.hideRecording = try container.decodeIfPresent(Bool.self, forKey: "hideRecording") ?? false
+        self.rearCamera = try container.decodeIfPresent(Bool.self, forKey: "rearCamera") ?? false
+        self.hideGalleryCamera = try container.decodeIfPresent(Bool.self, forKey: "hideGalleryCamera") ?? false
+        self.highQualityPhotos = try container.decodeIfPresent(Bool.self, forKey: "highQualityPhotos") ?? false
+        self.confirmCalls = try container.decodeIfPresent(Bool.self, forKey: "confirmCalls") ?? false
+        self.disableCameraSwipe = try container.decodeIfPresent(Bool.self, forKey: "disableCameraSwipe") ?? false
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: StringCodingKey.self)
+        try container.encode(self.showCharacterCount, forKey: "showCharacterCount")
+        try container.encode(self.hideTyping, forKey: "hideTyping")
+        try container.encode(self.hideRecording, forKey: "hideRecording")
+        try container.encode(self.rearCamera, forKey: "rearCamera")
+        try container.encode(self.hideGalleryCamera, forKey: "hideGalleryCamera")
+        try container.encode(self.highQualityPhotos, forKey: "highQualityPhotos")
+        try container.encode(self.confirmCalls, forKey: "confirmCalls")
+        try container.encode(self.disableCameraSwipe, forKey: "disableCameraSwipe")
+    }
+}
