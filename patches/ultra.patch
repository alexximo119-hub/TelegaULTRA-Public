+import Foundation
+import CoreLocation
+import Display
+import SwiftSignalKit
+import TelegramUIPreferences
+import TelegramPresentationData
+import ItemListUI
+import LocationUI
+import AccountContext
+
+private final class UltraLocationArguments {
+    var select: () -> Void = {}
+    var reset: () -> Void = {}
+}
+
+private enum UltraLocationEntry: ItemListNodeEntry {
+    case current(String)
+    case select
+    case reset
+    case footer
+    var stableId: Int32 {
+        switch self { case .current: return 0; case .select: return 1; case .reset: return 2; case .footer: return 3 }
+    }
+    var section: ItemListSectionId { return 0 }
+    static func < (lhs: UltraLocationEntry, rhs: UltraLocationEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraLocationArguments
+        switch self {
+        case let .current(text): return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case .select: return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Выбрать точку на карте", kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: arguments.select)
+        case .reset: return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Сбросить выбранную точку", kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: arguments.reset)
+        case .footer: return ItemListTextItem(presentationData: presentationData, text: .plain("Сохранённая точка будет выбрана при следующем открытии отправки геопозиции в чате. Перед отправкой её видно на карте и можно изменить. Выбор здесь ничего не отправляет. Настройка общая для аккаунтов этого клиента. Координаты сохраняются локально до сброса. Live Location использует реальную геолокацию устройства; системный GPS и другие приложения не меняются."), sectionId: self.section)
+        }
+    }
+}
+
+func ultraLocationController(context: AccountContext) -> ViewController {
+    let arguments = UltraLocationArguments()
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    var pushImpl: (ViewController) -> Void = { _ in }
+    arguments.select = {
+        let selected = UltraLocationSelection.current().map { CLLocationCoordinate2D(latitude: $0.latitude, longitude: $0.longitude) }
+        let picker = LocationPickerController(context: context, style: .glass, mode: .pick, initialLocation: selected, selectInitialLocation: selected != nil, completion: { location, _, _, _, _ in
+            if let selected = UltraSelectedLocation(latitude: location.latitude, longitude: location.longitude) {
+                UltraLocationSelection.save(selected)
+                revision.set(0)
+            }
+        })
+        pushImpl(picker)
+    }
+    arguments.reset = { UltraLocationSelection.save(nil); revision.set(0) }
+    let signal = combineLatest(context.sharedContext.presentationData, revision.get()) |> deliverOnMainQueue |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let text: String
+        if let point = UltraLocationSelection.current() { text = String(format: "Выбранная точка: %.5f, %.5f", point.latitude, point.longitude) }
+        else { text = "Выбранная точка не задана. Используется обычный выбор Telegram." }
+        let entries: [UltraLocationEntry] = [.current(text), .select, .reset, .footer]
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Отправляемая геопозиция"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    pushImpl = { [weak controller] in controller?.push($0) }
+    return controller
+}
