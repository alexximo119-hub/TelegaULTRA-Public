+import Foundation
+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraUploadModeTests: XCTestCase {
+    func testAutomaticModePreservesBothNativePaths() {
+        XCTAssertNil(AccountUploadMode.automatic.parallelPartsOverride(isEncrypted: false))
+        XCTAssertEqual(AccountUploadMode.boundedPartCount(nil, nativeFast: false), 3)
+        XCTAssertEqual(AccountUploadMode.boundedPartCount(nil, nativeFast: true), 30)
+    }
+    func testExplicitModesDoNotChangeEncryptedUploads() {
+        for mode in [AccountUploadMode.three, .six, .twelve] {
+            XCTAssertNil(mode.parallelPartsOverride(isEncrypted: true))
+            XCTAssertEqual(mode.parallelPartsOverride(isEncrypted: false), Int(mode.rawValue))
+        }
+    }
