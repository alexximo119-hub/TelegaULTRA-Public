+import UIKit
+import TelegramPresentationData
+
+/// Uses the native auth.exportLoginToken flow. Tokens are kept in memory only.
+final class UltraLoginQRController: UIViewController {
+    private let theme: PresentationTheme
+    private let imageView = UIImageView()
+    private let statusLabel = UILabel()
+    private let retryButton = UIButton(type: .system)
+    private var observers: [NSObjectProtocol] = []
+    var refreshRequested: () -> Void = {}
+    var suspended: () -> Void = {}
+    var closed: () -> Void = {}
+    var permitsTokenDisplay: Bool { return UIApplication.shared.applicationState == .active }
+
+    init(theme: PresentationTheme) {
+        self.theme = theme
+        super.init(nibName: nil, bundle: nil)
+        self.modalPresentationStyle = .pageSheet
+    }
+    required init?(coder: NSCoder) { return nil }
+
+    deinit {
+        for observer in self.observers { NotificationCenter.default.removeObserver(observer) }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = self.theme.list.plainBackgroundColor
+        let title = UILabel()
+        title.text = "Вход по QR-коду"
+        title.font = .preferredFont(forTextStyle: .title2)
+        title.textColor = self.theme.list.itemPrimaryTextColor
+        title.textAlignment = .center
+        title.adjustsFontForContentSizeCategory = true
+        title.numberOfLines = 0
+        let help = UILabel()
+        help.text = "На другом устройстве откройте Telegram → Настройки → Устройства → Подключить устройство и отсканируйте код. Может потребоваться пароль двухэтапной проверки."
+        help.font = .preferredFont(forTextStyle: .body)
+        help.textColor = self.theme.list.itemSecondaryTextColor
+        help.numberOfLines = 0
+        help.adjustsFontForContentSizeCategory = true
+        self.imageView.contentMode = .scaleAspectFit
+        self.imageView.backgroundColor = .white
+        self.imageView.isAccessibilityElement = true
+        self.imageView.accessibilityLabel = "QR-код для входа в Telegram"
+        self.statusLabel.numberOfLines = 0
+        self.statusLabel.font = .preferredFont(forTextStyle: .footnote)
+        self.statusLabel.textColor = self.theme.list.itemSecondaryTextColor
+        self.statusLabel.textAlignment = .center
+        self.statusLabel.adjustsFontForContentSizeCategory = true
+        self.retryButton.setTitle("Обновить код", for: .normal)
+        self.retryButton.addAction(UIAction { [weak self] _ in self?.refreshRequested() }, for: .touchUpInside)
+        let close = UIButton(type: .system)
+        close.setTitle("Закрыть", for: .normal)
+        close.addAction(UIAction { [weak self] _ in self?.dismiss(animated: true) }, for: .touchUpInside)
+        let stack = UIStackView(arrangedSubviews: [title, help, self.imageView, self.statusLabel, self.retryButton, close])
+        stack.axis = .vertical
+        stack.spacing = 18
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        let scroll = UIScrollView()
+        scroll.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(scroll)
+        scroll.addSubview(stack)
+        let safe = self.view.safeAreaLayoutGuide
+        NSLayoutConstraint.activate([
+            scroll.leadingAnchor.constraint(equalTo: safe.leadingAnchor), scroll.trailingAnchor.constraint(equalTo: safe.trailingAnchor),
+            scroll.topAnchor.constraint(equalTo: safe.topAnchor), scroll.bottomAnchor.constraint(equalTo: safe.bottomAnchor),
+            stack.topAnchor.constraint(equalTo: scroll.contentLayoutGuide.topAnchor, constant: 24),
+            stack.bottomAnchor.constraint(equalTo: scroll.contentLayoutGuide.bottomAnchor, constant: -24),
+            stack.centerXAnchor.constraint(equalTo: scroll.frameLayoutGuide.centerXAnchor),
+            stack.widthAnchor.constraint(equalTo: scroll.frameLayoutGuide.widthAnchor, constant: -48),
+            self.imageView.heightAnchor.constraint(equalToConstant: 240),
+            self.retryButton.heightAnchor.constraint(greaterThanOrEqualToConstant: 44), close.heightAnchor.constraint(greaterThanOrEqualToConstant: 44)
+        ])
+        self.observers = [
+            NotificationCenter.default.addObserver(forName: UIApplication.willResignActiveNotification, object: nil, queue: .main) { [weak self] _ in
+                self?.imageView.image = nil
+                self?.statusLabel.text = "Код скрыт, пока приложение неактивно."
+                self?.retryButton.isEnabled = false
+                self?.suspended()
+            },
+            NotificationCenter.default.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main) { [weak self] _ in
+                guard let self = self, self.view.window != nil else { return }
+                self.refreshRequested()
+            }
+        ]
+        self.setLoading()
+    }
+
+    func setLoading() {
+        self.loadViewIfNeeded()
+        self.imageView.image = nil
+        self.statusLabel.text = "Получение кода…"
+        self.retryButton.isEnabled = false
+    }
+    func setImage(_ image: UIImage) {
+        guard self.permitsTokenDisplay else { return }
+        self.imageView.image = image
+        self.statusLabel.text = "Код обновляется автоматически. Не передавайте его другим людям."
+        self.retryButton.isEnabled = true
+    }
+    func setFailed() {
+        self.imageView.image = nil
+        self.statusLabel.text = "Не удалось получить код. Проверьте подключение и повторите попытку."
+        self.retryButton.isEnabled = true
+    }
+    override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        self.imageView.image = nil
+        self.closed()
+    }
+}
