@@ -0,0 +1,44 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public let ultraLocalStickerLimit = 5000
+
+func _internal_ultraLocalStickers(postbox: Postbox) -> Signal<[TelegramMediaFile], NoError> {
+    return postbox.transaction { transaction in
+        return transaction.getOrderedListItems(collectionId: Namespaces.OrderedItemList.UltraLocalStickers).compactMap { entry in
+            return entry.contents.get(SavedStickerItem.self)?.file._parse()
+        }
+    }
+}
+
+func _internal_saveUltraLocalSticker(transaction: Transaction, file: TelegramMediaFile) -> Bool {
+    guard file.isSticker, file.resource is CloudDocumentMediaResource else { return false }
+    let id = RecentMediaItemId(file.fileId).rawValue
+    let collection = Namespaces.OrderedItemList.UltraLocalStickers
+    let exists = transaction.getOrderedItemListItem(collectionId: collection, itemId: id) != nil
+    guard exists || transaction.getOrderedListItems(collectionId: collection).count < ultraLocalStickerLimit,
+          let entry = CodableEntry(SavedStickerItem(file: file, stringRepresentations: TelegramMediaFile.Accessor(file).stickerDisplayText.map { [$0] } ?? [])) else { return false }
+    transaction.addOrMoveToFirstPositionOrderedItemListItem(collectionId: collection, item: OrderedItemListEntry(id: id, contents: entry), removeTailIfCountExceeds: nil)
+    // Deliberately no SynchronizeSavedStickers operation: this collection belongs to this installation.
+    return true
+}
+
+func _internal_setUltraLocalStickerSaved(postbox: Postbox, file: TelegramMediaFile, saved: Bool) -> Signal<Bool, NoError> {
+    return postbox.transaction { transaction in
+        if saved { return _internal_saveUltraLocalSticker(transaction: transaction, file: file) }
+        transaction.removeOrderedItemListItem(collectionId: Namespaces.OrderedItemList.UltraLocalStickers, itemId: RecentMediaItemId(file.fileId).rawValue)
+        return true
+    }
+}
+
+func _internal_copySavedStickersToUltra(postbox: Postbox) -> Signal<Int, NoError> {
+    return postbox.transaction { transaction in
+        let cloud = transaction.getOrderedListItems(collectionId: Namespaces.OrderedItemList.CloudSavedStickers)
+        var copied = 0
+        for entry in cloud.reversed() {
+            if let file = entry.contents.get(SavedStickerItem.self)?.file._parse(), _internal_saveUltraLocalSticker(transaction: transaction, file: file) { copied += 1 }
+        }
+        return copied
+    }
+}
