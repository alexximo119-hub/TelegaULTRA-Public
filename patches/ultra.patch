diff --git a/submodules/SettingsUI/Sources/UltraAccountsController.swift b/submodules/SettingsUI/Sources/UltraAccountsController.swift
new file mode 100644
index 00000000..794dd77d
--- /dev/null
+++ b/submodules/SettingsUI/Sources/UltraAccountsController.swift
@@ -0,0 +1,176 @@
+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import PresentationDataUtils
+
+private final class UltraAccountsArguments {
+    var query: (String) -> Void = { _ in }
+    var alias: (String) -> Void = { _ in }
+    var action: (Int32) -> Void = { _ in }
+    var select: (Int64) -> Void = { _ in }
+    let request = MetaDisposable()
+    deinit { self.request.dispose() }
+}
+
+private enum UltraAccountsEntry: ItemListNodeEntry {
+    case query(String)
+    case summary(String)
+    case explanation
+    case status(String)
+    case alias(String)
+    case action(Int32, String)
+    case account(Int32, Int, Int64, String, String)
+    var stableId: Int32 {
+        switch self {
+        case .query: return 0
+        case .summary: return 1
+        case .explanation: return 2
+        case .status: return 3
+        case .alias: return 10
+        case let .action(id, _): return id
+        case let .account(id, _, _, _, _): return id
+        }
+    }
+    var section: ItemListSectionId {
+        if self.stableId < 10 { return 0 }
+        return self.stableId < 100 ? 1 : 2
+    }
+    static func < (lhs: UltraAccountsEntry, rhs: UltraAccountsEntry) -> Bool {
+        if case let .account(_, left, _, _, _) = lhs, case let .account(_, right, _, _, _) = rhs { return left < right }
+        return lhs.stableId < rhs.stableId
+    }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraAccountsArguments
+        switch self {
+        case let .query(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: "Поиск по имени или ID из каталога", type: .regular(capitalization: false, autocorrection: false), clearType: .always, maxLength: 64, sectionId: self.section, textUpdated: arguments.query, action: {})
+        case let .alias(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: "Локальная подпись этого аккаунта", type: .regular(capitalization: false, autocorrection: false), clearType: .always, maxLength: 64, sectionId: self.section, textUpdated: arguments.alias, action: {})
+        case let .summary(text), let .status(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case .explanation:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Экспериментальный каталог до 999 локальных записей. При 5 и более аккаунтах главное приложение обычно держит загруженными до четырёх; аккаунты с отправкой, загрузкой файлов, звонком, аудио, геопозицией, открытым интерфейсом или незавершённым чтением очередей удерживаются при необходимости. Остальные загружаются после выбора здесь.\n\nПосле перезапуска отложенные операции спящих аккаунтов возобновляются при их открытии. Фоновое обновление, счётчики и звонки спящих аккаунтов не гарантируются; системные push зависят от подписи и расширений. В штатном переключателе видны загруженные записи. Большой каталог ещё требует проверки RAM и сети на устройстве. Подписи и имена хранятся локально, ключи сессий в этот кэш не записываются."), sectionId: self.section)
+        case let .action(id, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: id == 13 ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.action(id) })
+        case let .account(_, _, recordId, title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: label, sectionId: self.section, style: .blocks, action: { arguments.select(recordId) })
+        }
+    }
+}
+
+func ultraAccountsController(context: AccountContext) -> ViewController {
+    let manager = context.sharedContext.accountManager
+    let arguments = UltraAccountsArguments()
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    var query = ""
+    var directory = UltraAccountDirectoryStore.entries()
+    var alias = directory.first(where: { $0.recordId == context.account.id.int64 })?.alias ?? ""
+    var status = "Имя появляется после загрузки профиля. Локальная подпись не меняет имя в Telegram; пустое поле сбрасывает подпись."
+    var adding = false
+    var lastProfiles: [UltraAccountDirectoryEntry] = []
+    var lastValidIds = Set<Int64>()
+    var rowIds: [Int64: Int32] = [:]
+    var nextRowId: Int32 = 100
+    var presentImpl: (ViewController) -> Void = { _ in }
+
+    arguments.query = { query = $0; revision.set(0) }
+    arguments.alias = { alias = $0; revision.set(0) }
+    arguments.select = { recordId in
+        context.sharedContext.switchToAccount(id: AccountRecordId(rawValue: recordId), fromSettingsController: nil, withChatListController: nil)
+    }
+    arguments.action = { [weak arguments] action in
+        guard let arguments = arguments else { return }
+        switch action {
+        case 11:
+            if UltraAccountDirectoryStore.setAlias(alias, recordId: context.account.id.int64) {
+                directory = UltraAccountDirectoryStore.entries()
+                alias = directory.first(where: { $0.recordId == context.account.id.int64 })?.alias ?? ""
+                status = "Локальная подпись сохранена."
+            } else {
+                status = "Подпись не сохранена: дождитесь загрузки профиля. Повреждённый или неизвестный кэш автоматически не заменяется."
+            }
+            revision.set(0)
+        case 12:
+            guard !adding else { return }
+            adding = true
+            status = "Открываем штатный вход…"
+            revision.set(0)
+            arguments.request.set((ultraAddAccountSlot(accountManager: manager, testingEnvironment: context.account.testingEnvironment) |> deliverOnMainQueue).start(next: { added in
+                adding = false
+                status = added ? "Вход открыт. Доступны телефон, QR и импорт собственной сессии." : "Достигнут лимит 999 записей. Используйте уже добавленный аккаунт."
+                revision.set(0)
+            }))
+        case 13:
+            presentImpl(textAlertController(context: context, title: "Сбросить подписи каталога?", text: "Удалится только кэш имён и локальных подписей каталога. Аккаунты, сессии и переписки не удаляются. Имена спящих записей появятся после их открытия.", actions: [
+                TextAlertAction(type: .genericAction, title: "Отмена", action: {}),
+                TextAlertAction(type: .destructiveAction, title: "Сбросить подписи", action: {
+                    UltraAccountDirectoryStore.resetLabels()
+                    directory = []
+                    alias = ""
+                    lastProfiles = []
+                    lastValidIds = []
+                    status = "Подписи сброшены."
+                    revision.set(0)
+                })
+            ]))
+        default: break
+        }
+    }
+    let signal = combineLatest(context.sharedContext.presentationData, manager.accountRecords(), context.sharedContext.activeAccountsWithInfo, context.sharedContext.activeAccountContexts, revision.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, recordView, accountInfos, contexts, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let records = recordView.records.filter { record in
+            return !record.attributes.contains(where: { if case .loggedOut = $0 { return true }; return false })
+        }.sorted { lhs, rhs in
+            func order(_ attributes: [TelegramAccountManagerTypes.Attribute]) -> Int32 {
+                for attribute in attributes { if case let .sortOrder(value) = attribute { return value.order } }
+                return 0
+            }
+            let left = order(lhs.attributes), right = order(rhs.attributes)
+            return left == right ? lhs.id < rhs.id : left < right
+        }
+        let validIds = Set(records.map { $0.id.int64 })
+        let profiles = accountInfos.accounts.map { info in
+            return UltraAccountDirectoryEntry(recordId: info.account.id.int64, userId: info.account.peerId.id._internalGetInt64Value(), testingEnvironment: info.account.testingEnvironment, title: info.peer.debugDisplayTitle)
+        }
+        if profiles != lastProfiles || validIds != lastValidIds {
+            UltraAccountDirectoryStore.merge(profiles, validRecordIds: validIds)
+            directory = UltraAccountDirectoryStore.entries()
+            lastProfiles = profiles
+            lastValidIds = validIds
+        }
+        let byId = Dictionary(uniqueKeysWithValues: directory.map { ($0.recordId, $0) })
+        let residentIds = Set(contexts.accounts.map { $0.0.int64 })
+        var entries: [UltraAccountsEntry] = [
+            .query(query), .summary("В каталоге: \(records.count) / \(UltraAccountLoadPolicy.catalogLimit). Загружено в главном приложении: \(residentIds.count)."), .explanation, .status(status),
+            .alias(alias), .action(11, "Сохранить подпись этого аккаунта"), .action(12, adding ? "Открываем вход…" : "Добавить аккаунт"), .action(13, "Сбросить подписи каталога")
+        ]
+        let search = query.trimmingCharacters(in: .whitespacesAndNewlines)
+        for (index, record) in records.enumerated() {
+            let id = record.id.int64
+            let info = byId[id]
+            let title = info?.displayTitle ?? "Аккаунт \(index + 1)"
+            if !search.isEmpty && !title.localizedCaseInsensitiveContains(search) && !(info.map { String($0.userId).contains(search) } ?? false) { continue }
+            let rowId: Int32
+            if let existing = rowIds[id] { rowId = existing }
+            else { rowId = nextRowId; nextRowId += 1; rowIds[id] = rowId }
+            let selected = recordView.currentRecord?.id == record.id
+            let state = selected ? (contexts.primary?.account.id == record.id ? "Текущий" : "Загрузка…") : (residentIds.contains(id) ? "Загружен" : "Спит")
+            let testing = record.attributes.contains(where: { attribute in
+                if case let .environment(value) = attribute, case .test = value.environment { return true }
+                return false
+            })
+            entries.append(.account(rowId, index, id, title, testing ? "Тест · \(state)" : state))
+        }
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Аккаунты ULTRA"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentImpl = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
