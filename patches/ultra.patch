+import XCTest
+@testable import UltraSettingsPolicies
+
+final class AccountImageUploadPrivacyTests: XCTestCase {
+    func testDisabledModePreservesEveryDocumentTypeAndName() {
+        for mime in ["image/jpeg", "image/png", "image/heic", "video/mp4", "application/pdf"] {
+            XCTAssertFalse(AccountImageUploadPrivacy.disabled.sanitizesDocument(mimeType: mime))
+            XCTAssertNil(AccountImageUploadPrivacy.disabled.neutralFileName(mimeType: mime))
+        }
+    }
+
+    func testOnlyExplicitJPEGAndPNGDocumentsAreEligible() {
+        XCTAssertTrue(AccountImageUploadPrivacy.images.sanitizesDocument(mimeType: "image/jpeg"))
+        XCTAssertTrue(AccountImageUploadPrivacy.images.sanitizesDocument(mimeType: "image/png"))
+        for mime in ["image/heic", "image/gif", "image/webp", "video/mp4", "application/pdf", "application/octet-stream", "text/plain", "", "image/jpeg; private=value"] {
+            XCTAssertFalse(AccountImageUploadPrivacy.images.sanitizesDocument(mimeType: mime))
+        }
+    }
+
+    func testNeutralNamesDoNotContainAnyOriginalName() {
+        XCTAssertEqual(AccountImageUploadPrivacy.images.neutralFileName(mimeType: "image/jpeg"), "ULTRA-clean.jpg")
+        XCTAssertEqual(AccountImageUploadPrivacy.images.neutralFileName(mimeType: "image/png"), "ULTRA-clean.png")
+        XCTAssertNil(AccountImageUploadPrivacy.images.neutralFileName(mimeType: "video/mp4"))
+    }
+}
diff --git a/Tests/UltraSettingsTests/UltraAccountDirectoryStoreTests.swift b/Tests/UltraSettingsTests/UltraAccountDirectoryStoreTests.swift
new file mode 100644
index 00000000..6022bda5
--- /dev/null
+++ b/Tests/UltraSettingsTests/UltraAccountDirectoryStoreTests.swift
@@ -0,0 +1,104 @@
+import Foundation
+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraAccountDirectoryStoreTests: XCTestCase {
+    private func isolated(_ body: (UserDefaults) throws -> Void) throws {
+        let name = "ULTRA-Synthetic-Account-Directory-\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: name))
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    func testProfileRefreshKeepsAliasButChangedAccountIdentityDoesNot() throws {
+        try self.isolated { defaults in
+            let original = UltraAccountDirectoryEntry(recordId: 1, userId: 1001, testingEnvironment: false, title: "Synthetic A")
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([original], validRecordIds: [1], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.setAlias("Work", recordId: 1, defaults: defaults))
+            let refreshed = UltraAccountDirectoryEntry(recordId: 1, userId: 1001, testingEnvironment: false, title: "Updated A")
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([refreshed], validRecordIds: [1], defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).first?.displayTitle, "Work")
+            let replacement = UltraAccountDirectoryEntry(recordId: 1, userId: 1002, testingEnvironment: false, title: "Different account")
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([replacement], validRecordIds: [1], defaults: defaults))
+            XCTAssertNil(UltraAccountDirectoryStore.entries(defaults: defaults).first?.alias)
+        }
+    }
+
+    func testPruningOnlyAffectsMetadataForRecordsNoLongerInTheDirectory() throws {
+        try self.isolated { defaults in
+            let profiles = (1 ... 2).map { UltraAccountDirectoryEntry(recordId: Int64($0), userId: Int64(1000 + $0), testingEnvironment: false, title: "Synthetic \($0)") }
+            XCTAssertTrue(UltraAccountDirectoryStore.merge(profiles, validRecordIds: [1, 2], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([], validRecordIds: [2], defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).map { $0.recordId }, [2])
+        }
+    }
+
+    func test999MaxLengthNamesFitAndThe1000thDoesNotOverwriteTheStore() throws {
+        try self.isolated { defaults in
+            let name = String(repeating: "🌟", count: 64)
+            let profiles = (1 ... 999).map { UltraAccountDirectoryEntry(recordId: Int64($0), userId: Int64(1000 + $0), testingEnvironment: false, title: name, alias: name) }
+            let valid = Set((1 ... 1000).map(Int64.init))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge(profiles, validRecordIds: valid, defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).count, 999)
+            let before = defaults.data(forKey: "ultra.accountDirectory.v1")
+            XCTAssertFalse(UltraAccountDirectoryStore.merge([UltraAccountDirectoryEntry(recordId: 1000, userId: 2000, testingEnvironment: false, title: "Extra")], validRecordIds: valid, defaults: defaults))
+            XCTAssertEqual(defaults.data(forKey: "ultra.accountDirectory.v1"), before)
+        }
+    }
+
+    func testUnknownOrCorruptMetadataIsPreservedUntilExplicitReset() throws {
+        try self.isolated { defaults in
+            for data in [Data("broken synthetic JSON".utf8), Data("{\"version\":99,\"entries\":[]}".utf8)] {
+                defaults.set(data, forKey: "ultra.accountDirectory.v1")
+                XCTAssertTrue(UltraAccountDirectoryStore.entries(defaults: defaults).isEmpty)
+                XCTAssertFalse(UltraAccountDirectoryStore.merge([], validRecordIds: [], defaults: defaults))
+                XCTAssertFalse(UltraAccountDirectoryStore.setAlias("A", recordId: 1, defaults: defaults))
+                XCTAssertEqual(defaults.data(forKey: "ultra.accountDirectory.v1"), data)
+                UltraAccountDirectoryStore.resetLabels(defaults: defaults)
+                XCTAssertNil(defaults.data(forKey: "ultra.accountDirectory.v1"))
+            }
+        }
+    }
+
+    func testEmptyAliasRestoresProfileNameAndNamesAreBoundedPlainText() throws {
+        try self.isolated { defaults in
+            let profile = UltraAccountDirectoryEntry(recordId: 1, userId: 1001, testingEnvironment: false, title: "  Synthetic\n A  ")
+            XCTAssertFalse(profile.title.contains("\n"))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([profile], validRecordIds: [1], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.setAlias(String(repeating: "🌟", count: 100), recordId: 1, defaults: defaults))
+            let alias = try XCTUnwrap(UltraAccountDirectoryStore.entries(defaults: defaults).first?.alias)
+            XCTAssertLessThanOrEqual(alias.count, 64)
+            XCTAssertLessThanOrEqual(alias.utf8.count, 256)
+            XCTAssertTrue(UltraAccountDirectoryStore.setAlias(" \n ", recordId: 1, defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).first?.displayTitle, profile.title)
+        }
+    }
+
+    func testMetadataSchemaContainsOnlyDirectoryFieldsAndIsolatedDefaults() throws {
+        try self.isolated { first in
+            try self.isolated { second in
+                let profile = UltraAccountDirectoryEntry(recordId: 1, userId: 1001, testingEnvironment: true, title: "Synthetic", alias: "Test")
+                let object = try XCTUnwrap(JSONSerialization.jsonObject(with: JSONEncoder().encode(profile)) as? [String: Any])
+                XCTAssertEqual(Set(object.keys), Set(["recordId", "userId", "testingEnvironment", "title", "alias"]))
+                XCTAssertTrue(UltraAccountDirectoryStore.merge([profile], validRecordIds: [1], defaults: first))
+                XCTAssertTrue(UltraAccountDirectoryStore.entries(defaults: second).isEmpty)
+                UltraAccountDirectoryStore.resetLabels(defaults: first)
+                XCTAssertTrue(UltraAccountDirectoryStore.entries(defaults: first).isEmpty)
+            }
+        }
+    }
+
+    func testStaleUISnapshotsCannotEraseNewLabelsOrRestoreRemovedRecords() throws {
+        try self.isolated { defaults in
+            let profiles = (1 ... 3).map { UltraAccountDirectoryEntry(recordId: Int64($0), userId: Int64(1000 + $0), testingEnvironment: false, title: "Synthetic \($0)") }
+            XCTAssertTrue(UltraAccountDirectoryStore.reconcile(validRecordIds: [1, 2, 3], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge(profiles, validRecordIds: [1, 2, 3], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.setAlias("Keep", recordId: 3, defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([], validRecordIds: [1, 2], defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).first(where: { $0.recordId == 3 })?.alias, "Keep")
+            XCTAssertTrue(UltraAccountDirectoryStore.reconcile(validRecordIds: [2, 3], defaults: defaults))
+            XCTAssertTrue(UltraAccountDirectoryStore.merge([profiles[0]], validRecordIds: [1, 2, 3], defaults: defaults))
+            XCTAssertEqual(UltraAccountDirectoryStore.entries(defaults: defaults).map { $0.recordId }, [2, 3])
+        }
+    }
+}
