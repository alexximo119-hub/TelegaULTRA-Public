diff --git a/submodules/TelegramUIPreferences/Sources/UltraDiagnosticsStore.swift b/submodules/TelegramUIPreferences/Sources/UltraDiagnosticsStore.swift
new file mode 100644
index 00000000..c7fdc1ac
--- /dev/null
+++ b/submodules/TelegramUIPreferences/Sources/UltraDiagnosticsStore.swift
@@ -0,0 +1,142 @@
+import Foundation
+
+// Deliberately accepts no free-form text, identifiers, settings values or credentials.
+public final class UltraDiagnosticsStore {
+    public enum Event: String, Codable {
+        case startupBegan
+        case startupReady
+        case startupBlocked
+        case foreground
+        case background
+        case memoryWarning
+        case settingsOpened
+        case optionChanged
+        case recordingEnabled
+        case appDelegateEntered = "APP_DELEGATE_ENTERED"
+        case crashReportingReady = "CRASH_REPORTING_READY"
+        case windowHostCreating = "WINDOW_HOST_CREATING"
+        case metalInitializing = "METAL_INITIALIZING"
+        case metalReady = "METAL_READY"
+        case storageResolving = "STORAGE_RESOLVING"
+        case storageLocal = "STORAGE_LOCAL"
+        case storageShared = "STORAGE_SHARED"
+        case keychainReady = "KEYCHAIN_READY"
+        case databaseKeysInitializing = "DATABASE_KEYS_INITIALIZING"
+        case databaseKeysReady = "DATABASE_KEYS_READY"
+        case accountManagerInitializing = "ACCOUNT_MANAGER_INITIALIZING"
+        case accountManagerReady = "ACCOUNT_MANAGER_READY"
+        case presentationLoading = "PRESENTATION_LOADING"
+        case presentationReady = "PRESENTATION_READY"
+        case accountUIReady = "ACCOUNT_UI_READY"
+        case authUIReady = "AUTH_UI_READY"
+    }
+
+    private struct Entry: Codable, Equatable {
+        let time: Date
+        let event: Event
+    }
+
+    private struct State: Codable {
+        var enabled = false
+        var entries: [Entry] = []
+    }
+
+    public static let shared = UltraDiagnosticsStore(directory: URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true).appendingPathComponent("Library/Application Support/ULTRA-EventLog", isDirectory: true))
+    private let directory: URL
+    private let now: () -> Date
+    private let queue = DispatchQueue(label: "app.telegaultra.diagnostics")
+    private let limit = 500
+    private let maximumBytes = 65536
+
+    public init(directory: URL, now: @escaping () -> Date = Date.init) {
+        self.directory = directory
+        self.now = now
+    }
+
+    private var file: URL { self.directory.appendingPathComponent("events.json") }
+
+    private func read() throws -> State {
+        guard FileManager.default.fileExists(atPath: self.file.path) else { return State() }
+        let size = try self.file.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+        guard size <= self.maximumBytes else { throw CocoaError(.fileReadTooLarge) }
+        return try JSONDecoder().decode(State.self, from: Data(contentsOf: self.file))
+    }
+
+    private func prune(_ state: inout State) {
+        let now = self.now()
+        state.entries = Array(state.entries.filter {
+            $0.time >= now.addingTimeInterval(-3 * 24 * 60 * 60) && $0.time <= now.addingTimeInterval(300)
+        }.suffix(self.limit))
+    }
+
+    private func write(_ state: State) throws {
+        let data = try JSONEncoder().encode(state)
+        guard data.count <= self.maximumBytes else { throw CocoaError(.fileWriteOutOfSpace) }
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+        var directory = self.directory
+        var values = URLResourceValues()
+        values.isExcludedFromBackup = true
+        try directory.setResourceValues(values)
+        #if os(iOS)
+        try data.write(to: self.file, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        #else
+        try data.write(to: self.file, options: .atomic)
+        #endif
+    }
+
+    public func isEnabled() throws -> Bool {
+        return try self.queue.sync { try self.read().enabled }
+    }
+
+    public func setEnabled(_ enabled: Bool) throws {
+        try self.queue.sync {
+            var state = try self.read()
+            let wasEnabled = state.enabled
+            state.enabled = enabled
+            self.prune(&state)
+            if enabled && !wasEnabled { state.entries.append(Entry(time: self.now(), event: .recordingEnabled)) }
+            self.prune(&state)
+            try self.write(state)
+        }
+    }
+
+    // Diagnostics must never prevent the app from starting if its own file is unavailable.
+    public func record(_ event: Event) {
+        try? self.queue.sync {
+            var state = try self.read()
+            let previous = state.entries
+            if state.enabled { state.entries.append(Entry(time: self.now(), event: event)) }
+            self.prune(&state)
+            if state.entries != previous { try self.write(state) }
+        }
+    }
+
+    public func export() throws -> Data {
+        return try self.queue.sync {
+            var state = try self.read()
+            self.prune(&state)
+            try self.write(state)
+            // Re-encode typed data; never export the original file's unrecognised fields.
+            let formatter = ISO8601DateFormatter()
+            let lines = state.entries.map { "\(formatter.string(from: $0.time)) \($0.event.rawValue)" }
+            return Data((["ULTRA local diagnostics v1", "recording=\(state.enabled)", "retention=3 days; maximum=500 events / 64 KiB", ""] + lines).joined(separator: "\n").utf8)
+        }
+    }
+
+    public func clear() throws {
+        try self.queue.sync {
+            // Clearing also recovers a corrupt or oversized journal, retaining consent when readable.
+            let enabled = (try? self.read().enabled) ?? false
+            var state = State()
+            state.enabled = enabled
+            try self.write(state)
+        }
+    }
+
+    public static func clearTemporaryExports() {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ULTRA-Export", isDirectory: true)
+        for name in ["ULTRA-diagnostics.txt", "ULTRA-crash-reports.txt"] {
+            try? FileManager.default.removeItem(at: directory.appendingPathComponent(name))
+        }
+    }
+}
