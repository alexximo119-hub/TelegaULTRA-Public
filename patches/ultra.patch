+    private static func ultraTypeface(size: CGFloat, weight: Weight, traits: Traits = []) -> UIFont? {
+        guard let name = self.cache.customName() else { return nil }
+        let key = "ultra_\(name)_\(size)_\(weight.key)_\(traits.rawValue)"
+        if let font = self.cache.get(key) { return font }
+        guard let base = UIFont(name: name, size: size) else { return nil }
+        var descriptor = base.fontDescriptor.addingAttributes([.traits: [UIFontDescriptor.TraitKey.weight: weight.weight]])
