diff --git a/submodules/TelegramUI/Sources/UltraAppStorage.swift b/submodules/TelegramUI/Sources/UltraAppStorage.swift
new file mode 100644
index 00000000..d1042b6b
--- /dev/null
+++ b/submodules/TelegramUI/Sources/UltraAppStorage.swift
@@ -0,0 +1,48 @@
+import Foundation
+
+enum UltraAppStorageMode: String {
+    case shared
+    case local
+}
+
+enum UltraAppStorageError: Error {
+    case sharedContainerUnavailable
+    case localStorageConsentRequired
+    case localStorageUnavailable
+    case invalidSavedMode
+}
+
+struct UltraAppStorage {
+    static let modeKey = "ultra.appStorageMode.v1"
+
+    let mode: UltraAppStorageMode
+    let url: URL
+
+    // Never switch an existing installation to another database when signing changes.
+    static func resolve(sharedURL: URL?, localURL: URL?, savedMode: String?, allowLocalStorage: Bool) throws -> UltraAppStorage {
+        if let savedMode {
+            guard let mode = UltraAppStorageMode(rawValue: savedMode) else {
+                throw UltraAppStorageError.invalidSavedMode
+            }
+            switch mode {
+            case .shared:
+                guard let sharedURL else {
+                    throw UltraAppStorageError.sharedContainerUnavailable
+                }
+                return UltraAppStorage(mode: .shared, url: sharedURL)
+            case .local:
+                guard allowLocalStorage, let localURL else {
+                    throw UltraAppStorageError.localStorageUnavailable
+                }
+                return UltraAppStorage(mode: .local, url: localURL)
+            }
+        }
+        if let sharedURL {
+            return UltraAppStorage(mode: .shared, url: sharedURL)
+        }
+        if allowLocalStorage {
+            throw UltraAppStorageError.localStorageConsentRequired
+        }
+        throw UltraAppStorageError.sharedContainerUnavailable
+    }
+}
diff --git a/submodules/TelegramUI/Sources/UltraStartupDiagnostics.swift b/submodules/TelegramUI/Sources/UltraStartupDiagnostics.swift
new file mode 100644
index 00000000..ed20c24f
--- /dev/null
+++ b/submodules/TelegramUI/Sources/UltraStartupDiagnostics.swift
@@ -0,0 +1,191 @@
+import UIKit
+#if canImport(TelegramUIPreferences)
+import TelegramUIPreferences
+#endif
+
+// Startup metadata only: no API credentials, account IDs, messages or database paths.
+final class UltraStartupDiagnostics {
+    static let shared = UltraStartupDiagnostics()
+
+    private let started = Date()
+    private var events: [String] = []
+    private var previousStage: String?
+    private var stage = "NOT_STARTED"
+    private var finished = false
+    private var failureController: UIViewController?
+    private weak var mainWindow: UIWindow?
+    private var diagnosticWindow: UIWindow?
+    private var progressController: UltraStartupProgressViewController?
+    private var lifecycleObservers: [NSObjectProtocol] = []
+
+    private var reportURL: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("ULTRA-Diagnostics", isDirectory: true)
+            .appendingPathComponent("startup.txt")
+    }
+
+    func begin() {
+        #if canImport(TelegramUIPreferences)
+        UltraDiagnosticsStore.clearTemporaryExports()
+        UltraDiagnosticsStore.shared.record(.startupBegan)
+        if self.lifecycleObservers.isEmpty {
+            let events: [(Notification.Name, UltraDiagnosticsStore.Event)] = [
+                (UIApplication.willEnterForegroundNotification, .foreground),
+                (UIApplication.didEnterBackgroundNotification, .background),
+                (UIApplication.didReceiveMemoryWarningNotification, .memoryWarning)
+            ]
+            for (name, event) in events {
+                self.lifecycleObservers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: nil) { _ in
+                    UltraDiagnosticsStore.shared.record(event)
+                })
+            }
+        }
+        #endif
+        if let url = self.reportURL, let report = try? String(contentsOf: url, encoding: .utf8) {
+            self.previousStage = report.components(separatedBy: "\n").first(where: { $0.hasPrefix("stage=") })
+        }
+        self.mark("APP_DELEGATE_ENTERED")
+    }
+
+    func mark(_ stage: String) {
+        precondition(Thread.isMainThread)
+        guard !self.finished else { return }
+        self.stage = stage
+        #if canImport(TelegramUIPreferences)
+        if let event = UltraDiagnosticsStore.Event(rawValue: stage) {
+            UltraDiagnosticsStore.shared.record(event)
+        }
+        #endif
+        self.events.append(String(format: "%.3fs %@", Date().timeIntervalSince(self.started), stage))
+        if self.events.count > 40 { self.events.removeFirst() }
+        if let url = self.reportURL {
+            do {
+                try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+                try self.report().write(to: url, atomically: true, encoding: .utf8)
+            } catch {
+                NSLog("ULTRA startup: report could not be saved")
+            }
+        }
+        NSLog("ULTRA startup: %@", stage)
+        self.progressController?.update(report: self.report())
+    }
+
+    func report() -> String {
+        let bundle = Bundle.main
+        return [
+            "ULTRA startup diagnostics v1",
+            "build=\(bundle.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "unknown")",
+            "bundle=\(bundle.bundleIdentifier ?? "unknown")",
+            "iOS=\(UIDevice.current.systemVersion)",
+            "stage=\(self.stage)",
+            "previous_\(self.previousStage ?? "stage=unavailable")",
+        ].joined(separator: "\n") + "\n" + self.events.joined(separator: "\n")
+    }
+
+    func showFailure(message: String, code: String, enableLocalStorage: (() -> Void)?) {
+        #if canImport(TelegramUIPreferences)
+        UltraDiagnosticsStore.shared.record(.startupBlocked)
+        #endif
+        self.mark(code)
+        self.failureController = UltraStartupFailureViewController(
+            message: message, diagnosticCode: code, enableLocalStorage: enableLocalStorage,
+            diagnostics: self.report()
+        )
+        self.presentIfAttached()
+    }
+
+    func attach(scene: UIWindowScene, mainWindow: UIWindow) {
+        self.mainWindow = mainWindow
+        guard !self.finished else { return }
+        // Use the same scene as Telegram, but don't rely on its custom host controller.
+        let window = UIWindow(windowScene: scene)
+        window.windowLevel = UIWindow.Level(rawValue: UIWindow.Level.normal.rawValue + 1.0)
+        self.diagnosticWindow = window
+        self.presentIfAttached()
+    }
+
+    private func presentIfAttached() {
+        guard let window = self.diagnosticWindow else { return }
+        if let failureController = self.failureController {
+            window.rootViewController = failureController
+        } else {
+            let controller = UltraStartupProgressViewController(report: self.report())
+            self.progressController = controller
+            window.rootViewController = controller
+        }
+        window.makeKeyAndVisible()
+    }
+
+    func complete(_ stage: String) {
+        guard self.failureController == nil, !self.finished else { return }
+        self.mark(stage)
+        self.finished = true
+        #if canImport(TelegramUIPreferences)
+        UltraDiagnosticsStore.shared.record(.startupReady)
+        #endif
+        self.diagnosticWindow?.isHidden = true
+        self.diagnosticWindow = nil
+        self.progressController = nil
+        self.mainWindow?.makeKeyAndVisible()
+    }
+}
+
+private final class UltraStartupProgressViewController: UIViewController {
+    private var report: String
+    private let reportLabel = UILabel()
+
+    init(report: String) {
+        self.report = report
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func update(report: String) {
+        self.report = report
+        self.reportLabel.text = report
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        let title = UILabel()
+        title.text = "ULTRA: запуск"
+        title.font = .preferredFont(forTextStyle: .title1)
+        title.numberOfLines = 0
+        let explanation = UILabel()
+        explanation.text = "Если запуск не завершается, скопируйте диагностику. Отчёт содержит только этапы запуска, версию iOS и номер сборки."
+        explanation.numberOfLines = 0
+        self.reportLabel.text = self.report
+        self.reportLabel.font = .monospacedSystemFont(ofSize: 12.0, weight: .regular)
+        self.reportLabel.numberOfLines = 0
+        let copy = UIButton(type: .system)
