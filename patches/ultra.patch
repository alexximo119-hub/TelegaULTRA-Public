diff --git a/Tests/UltraSessionImportTests/UltraSessionImportDataTests.swift b/Tests/UltraSessionImportTests/UltraSessionImportDataTests.swift
new file mode 100644
index 00000000..ae6f4c03
--- /dev/null
+++ b/Tests/UltraSessionImportTests/UltraSessionImportDataTests.swift
@@ -0,0 +1,111 @@
+import Foundation
+import XCTest
+@testable import UltraSessionFormats
+
+final class UltraSessionImportDataTests: XCTestCase {
+    // All keys in this suite are synthetic repetitions, never real session credentials.
+    private let key = [UInt8](repeating: 0x11, count: 256)
+
+    private func base64(_ bytes: [UInt8], padded: Bool = false) -> String {
+        let value = Data(bytes).base64EncodedString().replacingOccurrences(of: "+", with: "-").replacingOccurrences(of: "/", with: "_")
+        return padded ? value : value.replacingOccurrences(of: "=", with: "")
+    }
+
+    private func integer(_ value: UInt64, width: Int) -> [UInt8] {
+        return (0 ..< width).reversed().map { UInt8(truncatingIfNeeded: value >> ($0 * 8)) }
+    }
+
+    private func pyrogram(modern: Bool = true, width: Int = 8, test: UInt8 = 0, bot: UInt8 = 0, userId: UInt64 = 4294967300) -> [UInt8] {
+        return [2] + (modern ? self.integer(12345, width: 4) : []) + [test] + self.key + self.integer(userId, width: width) + [bot]
+    }
+
+    private func expect(_ expected: UltraSessionImportError, _ operation: () throws -> Void, file: StaticString = #filePath, line: UInt = #line) {
+        XCTAssertThrowsError(try operation(), file: file, line: line) { error in
+            XCTAssertEqual(error as? UltraSessionImportError, expected, file: file, line: line)
+        }
+    }
+
+    func testTelethonIPv4AndIPv6UseFixedKeyOffsets() throws {
+        for address in [[149, 154, 167, 50].map({ UInt8($0) }), [UInt8](repeating: 0x20, count: 16)] {
+            let value = "1" + self.base64([2] + address + [1, 187] + self.key, padded: true)
+            let candidate = try UltraSessionImportData.parseStringSession(value, testingEnvironment: false)
+            XCTAssertEqual(candidate.format, .telethonString)
+            XCTAssertEqual(candidate.datacenterId, 2)
+            XCTAssertEqual(candidate.authKey, Data(self.key))
+            XCTAssertNil(candidate.claimedUserId)
+        }
+    }
+
+    func testPyrogramModernAndBothLegacyWidths() throws {
+        let formats: [(Bool, Int, UInt64)] = [(true, 8, 4294967300), (false, 8, 4294967300), (false, 4, 12345)]
+        for (modern, width, userId) in formats {
+            for padded in [false, true] {
+                let candidate = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(modern: modern, width: width, userId: userId), padded: padded), testingEnvironment: false)
+                XCTAssertEqual(candidate.format, .pyrogramString)
+                XCTAssertEqual(candidate.claimedUserId, Int64(userId))
+                XCTAssertEqual(candidate.authKey, Data(self.key))
+            }
+        }
+    }
+
+    func testEnvironmentAndBotFlagsMustMatchExactly() {
+        self.expect(.environmentMismatch) { _ = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(test: 1)), testingEnvironment: false) }
+        self.expect(.botAccount) { _ = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(bot: 1)), testingEnvironment: false) }
+        self.expect(.invalidFormat) { _ = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(test: 2)), testingEnvironment: false) }
+        self.expect(.invalidFormat) { _ = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(bot: 2)), testingEnvironment: false) }
+    }
+
+    func testTelethonRejectsEmptyKeysBadDCAndZeroPorts() {
+        let address: [UInt8] = [149, 154, 167, 50]
+        let invalid: [[UInt8]] = [
+            [6] + address + [1, 187] + self.key,
+            [2] + address + [0, 0] + self.key,
+            [2] + address + [1, 187] + [UInt8](repeating: 0, count: 256)
+        ]
+        for bytes in invalid {
+            XCTAssertThrowsError(try UltraSessionImportData.parseStringSession("1" + self.base64(bytes, padded: true), testingEnvironment: false))
+        }
+    }
+
+    func testZeroAndOverflowingUserIdsAreRejected() {
+        for userId in [UInt64(0), UInt64.max] {
+            self.expect(.invalidFormat) { _ = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram(userId: userId)), testingEnvironment: false) }
+        }
+    }
+
+    func testAuthKeyHexAndDatacenterValidation() throws {
+        let candidate = try UltraSessionImportData.parseAuthKey(" \n" + String(repeating: "aF", count: 256) + "\n", datacenterId: 5, testingEnvironment: false)
+        XCTAssertEqual(candidate.authKey, Data(repeating: 0xaf, count: 256))
+        for invalid in [String(repeating: "00", count: 256), String(repeating: "11", count: 255), String(repeating: "gg", count: 256)] {
+            self.expect(.invalidKey) { _ = try UltraSessionImportData.parseAuthKey(invalid, datacenterId: 2, testingEnvironment: false) }
+        }
+        self.expect(.invalidDatacenter) { _ = try UltraSessionImportData.parseAuthKey(String(repeating: "11", count: 256), datacenterId: 6, testingEnvironment: false) }
+        self.expect(.invalidDatacenter) { _ = try UltraSessionImportData.parseAuthKey(String(repeating: "11", count: 256), datacenterId: 4, testingEnvironment: true) }
+    }
+
+    func testMalformedBase64AndOversizedInputAreRejected() {
+        let value = self.base64(self.pyrogram())
+        for invalid in ["", value + "===", String(value.dropLast()) + "!", value + "\nextra", String(repeating: "A", count: 4097)] {
+            XCTAssertThrowsError(try UltraSessionImportData.parseStringSession(invalid, testingEnvironment: false))
+        }
+        // A non-canonical final character with ignored padding bits must not be accepted.
+        let legacy = self.base64(self.pyrogram(modern: false, width: 4, userId: 12345))
+        XCTAssertEqual(legacy.last, "A")
+        XCTAssertThrowsError(try UltraSessionImportData.parseStringSession(String(legacy.dropLast()) + "B", testingEnvironment: false))
+    }
+
+    func testImportedValuesCannotOverrideServerIdentityOrDuplicateAnAccount() throws {
+        let candidate = try UltraSessionImportData.parseStringSession(self.base64(self.pyrogram()), testingEnvironment: false)
+        try candidate.validateServerUserId(4294967300, alreadyAdded: [1])
+        self.expect(.accountMismatch) { try candidate.validateServerUserId(123, alreadyAdded: []) }
+        self.expect(.alreadyAdded) { try candidate.validateServerUserId(4294967300, alreadyAdded: [4294967300]) }
+        self.expect(.authorizationFailed) { try candidate.validateServerUserId(0, alreadyAdded: []) }
+    }
+
+    func testDescriptionAndReflectionDoNotExposeCredentials() throws {
+        let candidate = try UltraSessionImportData.parseAuthKey(String(repeating: "11", count: 256), datacenterId: 2, testingEnvironment: false)
+        XCTAssertEqual(String(describing: candidate), "UltraSessionImportData(<redacted>)")
+        XCTAssertEqual(String(reflecting: candidate), "UltraSessionImportData(<redacted>)")
+        XCTAssertTrue(Mirror(reflecting: candidate).children.isEmpty)
+    }
+}
diff --git a/Tests/UltraSessionImportTests/UltraSessionSQLiteReaderTests.swift b/Tests/UltraSessionImportTests/UltraSessionSQLiteReaderTests.swift
