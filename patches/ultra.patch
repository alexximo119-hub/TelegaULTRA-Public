+++ b/submodules/SettingsUI/Sources/UltraImageSanitizerController.swift
@@ -0,0 +1,183 @@
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import AsyncDisplayKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+
+private final class UltraImageSanitizerController: ViewController, UIDocumentPickerDelegate {
+    private let context: AccountContext
+    private var presentationData: PresentationData
+    private let scroll = UIScrollView()
+    private let status = UILabel()
+    private let help = UILabel()
+    private let pick = UIButton(type: .system)
+    private let share = UIButton(type: .system)
+    private let disposable = MetaDisposable()
+    private var presentationDisposable: Disposable?
+    private var preparedFile: TelegramMediaFile?
+    private var generation = 0
+
+    init(context: AccountContext) {
+        self.context = context
+        self.presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: self.presentationData))
+        self.navigationPresentation = .modal
+        self.title = "Очистка фото"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: self.presentationData.strings.Common_Close, style: .plain, target: self, action: #selector(self.closePressed))
+        self.help.text = "Выберите одиночное JPEG- или PNG-изображение из «Файлов». Будет создана отдельная копия без GPS, даты съёмки, модели камеры, автора и исходного имени файла. Оригинал не меняется.\n\nФото заново кодируется в стандартный sRGB: цвет и размер файла могут измениться, JPEG проходит повторное сжатие. Разрешение и ориентация сохраняются. HDR, Live Photo и анимация не сохраняются; HEIC, RAW и видео здесь не поддерживаются. До 32 МБ и 20 мегапикселей.\n\nПосле проверки можно выбрать чат и отправить копию файлом. При ошибке очистки оригинал не отправляется. Надписи и сведения, видимые на самой картинке, не удаляются. Эта команда не включает автоматическую очистку остальных вложений."
+        for label in [self.help, self.status] {
+            label.numberOfLines = 0
+            label.font = .preferredFont(forTextStyle: .body)
+            label.adjustsFontForContentSizeCategory = true
+        }
+        self.pick.setTitle("Выбрать фото в Файлах", for: .normal)
+        self.pick.addTarget(self, action: #selector(self.pickPressed), for: .touchUpInside)
+        self.share.setTitle("Отправить очищенную копию", for: .normal)
+        self.share.addTarget(self, action: #selector(self.sharePressed), for: .touchUpInside)
+        self.share.isEnabled = false
+        self.status.text = "Файл ещё не выбран."
+        self.presentationDisposable = (context.sharedContext.presentationData |> deliverOnMainQueue).start(next: { [weak self] data in
+            guard let self = self else { return }
+            self.presentationData = data
+            self.navigationBar?.updatePresentationData(NavigationBarPresentationData(presentationData: data))
+            self.updateColors()
+        })
+    }
+
+    required init(coder: NSCoder) { preconditionFailure("init(coder:) is not supported") }
+    deinit {
+        self.disposable.dispose()
+        self.presentationDisposable?.dispose()
+    }
+
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        self.displayNode.view.addSubview(self.scroll)
+        let stack = UIStackView(arrangedSubviews: [self.help, self.pick, self.status, self.share])
+        stack.axis = .vertical
+        stack.spacing = 20
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.scroll.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.topAnchor.constraint(equalTo: self.scroll.contentLayoutGuide.topAnchor, constant: 20),
+            stack.bottomAnchor.constraint(equalTo: self.scroll.contentLayoutGuide.bottomAnchor, constant: -20),
+            stack.widthAnchor.constraint(equalTo: self.scroll.frameLayoutGuide.widthAnchor, constant: -32),
+            stack.centerXAnchor.constraint(equalTo: self.scroll.frameLayoutGuide.centerXAnchor)
+        ])
+        for button in [self.pick, self.share] {
+            button.heightAnchor.constraint(greaterThanOrEqualToConstant: 44).isActive = true
+            button.titleLabel?.font = .preferredFont(forTextStyle: .body)
+            button.titleLabel?.adjustsFontForContentSizeCategory = true
+            button.titleLabel?.numberOfLines = 0
+            button.titleLabel?.textAlignment = .center
+        }
+        self.updateColors()
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        let top = self.navigationLayout(layout: layout).navigationFrame.maxY
+        transition.updateFrame(view: self.scroll, frame: CGRect(x: layout.safeInsets.left, y: top, width: max(0, layout.size.width - layout.safeInsets.left - layout.safeInsets.right), height: max(0, layout.size.height - top)))
+        self.scroll.contentInset.bottom = layout.insets(options: [.input]).bottom
+    }
+
+    private func updateColors() {
+        guard self.isNodeLoaded else { return }
+        self.displayNode.backgroundColor = self.presentationData.theme.list.blocksBackgroundColor
+        self.help.textColor = self.presentationData.theme.list.itemSecondaryTextColor
+        self.status.textColor = self.presentationData.theme.list.itemPrimaryTextColor
+        self.pick.tintColor = self.presentationData.theme.list.itemAccentColor
+        self.share.tintColor = self.presentationData.theme.list.itemAccentColor
+    }
+
+    @objc private func closePressed() {
+        self.generation += 1
+        self.disposable.set(nil)
+        self.preparedFile = nil
+        self.dismiss()
+    }
+
+    @objc private func pickPressed() {
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.jpeg, .png], asCopy: false)
+        picker.allowsMultipleSelection = false
+        picker.delegate = self
+        self.context.sharedContext.applicationBindings.presentNativeController(picker)
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard urls.count == 1, let url = urls.first else { return }
+        self.generation += 1
+        let generation = self.generation
+        self.preparedFile = nil
+        self.share.isEnabled = false
+        self.pick.isEnabled = false
+        self.status.text = "Подготовка и проверка отдельной копии…"
+        let context = self.context
+        let signal = Signal<(TelegramMediaFile, Int, Int), UltraImageSanitizerError> { subscriber in
+            let cancelled = Atomic<Bool>(value: false)
+            Queue.concurrentDefaultQueue().async {
+                let access = url.startAccessingSecurityScopedResource()
+                defer { if access { url.stopAccessingSecurityScopedResource() } }
+                var coordinationError: NSError?
+                NSFileCoordinator().coordinate(readingItemAt: url, options: [], error: &coordinationError) { coordinatedURL in
+                    do {
+                        guard !cancelled.with({ $0 }) else { return }
+                        let image = try UltraImageSanitizer.sanitize(UltraImageSanitizer.read(at: coordinatedURL))
+                        guard !cancelled.with({ $0 }) else { return }
+                        let id = Int64.random(in: Int64.min ... Int64.max)
+                        let resource = LocalFileMediaResource(fileId: id)
+                        context.engine.resources.storeResourceData(id: EngineMediaResource.Id(resource.id), data: image.data, synchronous: true)
+                        let file = TelegramMediaFile(fileId: EngineMedia.Id(namespace: Namespaces.Media.LocalFile, id: id), partialReference: nil, resource: resource, previewRepresentations: [], videoThumbnails: [], immediateThumbnailData: nil, mimeType: image.mimeType, size: Int64(image.data.count), attributes: [.FileName(fileName: image.fileName)], alternativeRepresentations: [])
+                        subscriber.putNext((file, image.width, image.height))
+                        subscriber.putCompletion()
+                    } catch {
+                        subscriber.putError(error as? UltraImageSanitizerError ?? .unavailable)
+                    }
+                }
+                if coordinationError != nil { subscriber.putError(.unavailable) }
+            }
+            return ActionDisposable { let _ = cancelled.swap(true) }
+        }
+        |> mapToSignal { file, width, height -> Signal<(TelegramMediaFile, Int, Int), UltraImageSanitizerError> in
+            return context.engine.resources.data(resource: EngineMediaResource(file.resource), attemptSynchronously: true)
+            |> take(1)
+            |> castError(UltraImageSanitizerError.self)
+            |> mapToSignal { data in
+                guard let expectedSize = file.size, data.isComplete, data.availableSize == expectedSize else { return .fail(.unavailable) }
+                return .single((file, width, height))
+            }
+        }
+        self.disposable.set((signal |> deliverOnMainQueue).start(next: { [weak self] file, width, height in
+            guard let self = self, self.generation == generation else { return }
+            self.pick.isEnabled = true
+            self.preparedFile = file
+            self.share.isEnabled = true
+            self.status.text = "Копия проверена: \(width) × \(height). Для отправки используйте кнопку ниже. Исходник сохранён."
+        }, error: { [weak self] error in
+            guard let self = self, self.generation == generation else { return }
+            self.pick.isEnabled = true
+            self.preparedFile = nil
+            self.share.isEnabled = false
+            switch error {
+            case .tooLarge: self.status.text = "Превышен лимит 32 МБ / 20 мегапикселей. Исходник не отправлен."
+            case .unsupported: self.status.text = "Нужен одиночный JPEG или PNG. Формат не поддерживается либо файл повреждён. Исходник не отправлен."
+            case .conversionFailed, .verificationFailed: self.status.text = "Не удалось создать и проверить очищенную копию. Исходник не отправлен."
+            case .unavailable: self.status.text = "Не удалось прочитать или сохранить файл. Проверьте доступ и свободное место. Исходник не отправлен."
+            }
+        }))
+    }
+
+    @objc private func sharePressed() {
+        guard let file = self.preparedFile else { return }
+        let share = self.context.sharedContext.makeShareScreen(context: self.context, params: ShareControllerParams(subject: .media(.standalone(media: file), nil), externalShare: false))
+        self.present(share, in: .window(.root))
+    }
+}
+
+func ultraImageSanitizerController(context: AccountContext) -> ViewController {
+    return UltraImageSanitizerController(context: context)
+}
diff --git a/submodules/SettingsUI/Sources/UltraLocalDisplayController.swift b/submodules/SettingsUI/Sources/UltraLocalDisplayController.swift
