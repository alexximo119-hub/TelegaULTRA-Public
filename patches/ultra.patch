+import Foundation
+import XCTest
+@testable import UltraFolderLayout
+
+final class UltraFolderTabsLayoutTests: XCTestCase {
+    func testStripSitsAboveTabBarAndReservesItsOwnHeight() throws {
+        let layout = try XCTUnwrap(UltraFolderTabsLayout.calculate(size: CGSize(width: 390, height: 844), leftInset: 0, rightInset: 0, bottomInset: 83, tabsHeight: 48, topClearance: 140))
+        XCTAssertEqual(layout.frame, CGRect(x: 0, y: 705, width: 390, height: 48))
+        XCTAssertEqual(layout.reservedHeight, 56)
+        XCTAssertEqual(layout.frame.maxY + 8 + 83, 844)
+    }
+    func testAsymmetricSafeInsetsAreRespected() throws {
+        let layout = try XCTUnwrap(UltraFolderTabsLayout.calculate(size: CGSize(width: 844, height: 390), leftInset: 59, rightInset: 21, bottomInset: 70, tabsHeight: 48, topClearance: 88))
+        XCTAssertEqual(layout.frame.minX, 59)
+        XCTAssertEqual(layout.frame.maxX, 823)
+        XCTAssertGreaterThanOrEqual(layout.frame.minY, 88)
+    }
+    func testInsufficientHeightFallsBackToNativeHeader() {
+        XCTAssertNil(UltraFolderTabsLayout.calculate(size: CGSize(width: 320, height: 200), leftInset: 0, rightInset: 0, bottomInset: 83, tabsHeight: 48, topClearance: 100))
+    }
+    func testEmptyWidthAndNonFiniteGeometryAreRejected() {
+        XCTAssertNil(UltraFolderTabsLayout.calculate(size: CGSize(width: 100, height: 800), leftInset: 60, rightInset: 60, bottomInset: 0, tabsHeight: 48, topClearance: 88))
+        XCTAssertNil(UltraFolderTabsLayout.calculate(size: CGSize(width: 390, height: 844), leftInset: 0, rightInset: 0, bottomInset: 83, tabsHeight: .nan, topClearance: 88))
+    }
+}
