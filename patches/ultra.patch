@@ -0,0 +1,50 @@
+import Foundation
+
+public struct AccountLoadReadiness: Equatable {
+    public let initialized: Bool
+    public let hasPending: Bool
+    public init(initialized: Bool, hasPending: Bool) {
+        self.initialized = initialized
+        self.hasPending = hasPending
+    }
+    public func protectsResident(hasOtherWork: Bool) -> Bool {
+        return !self.initialized || self.hasPending || hasOtherWork
+    }
+}
+
+public struct UltraAccountLoadRecord {
+    public let id: Int64
+    public let order: Int32
+    public init(id: Int64, order: Int32) { self.id = id; self.order = order }
+}
+
+/// Four ordinary resident accounts plus accounts protected by actual work/initialization.
+/// The catalog limit is a storage/UI limit, not a claim that 999 networks fit in iOS memory.
+public enum UltraAccountLoadPolicy {
+    public static let catalogLimit = 999
+    public static let ordinaryResidentLimit = 4
+
+    /// Newly published contexts are not safe to evict until their first task snapshot.
+    public static func protectedIds(resident: Set<Int64>, evaluated: Set<Int64>, busy: Set<Int64>) -> Set<Int64> {
+        return busy.union(resident.subtracting(evaluated))
+    }
+
+    public static func residentIds(records: [UltraAccountLoadRecord], current: Int64?, recent: [Int64], protected: Set<Int64>) -> Set<Int64> {
+        let valid = Set(records.map { $0.id })
+        if valid.count <= self.ordinaryResidentLimit { return valid }
+        let ordered = records.sorted { lhs, rhs in
+            return lhs.order == rhs.order ? lhs.id < rhs.id : lhs.order < rhs.order
+        }.map { $0.id }
+        var result = protected.intersection(valid)
+        if let current = current, valid.contains(current) {
+            result.insert(current)
+        } else if let first = ordered.first {
+            result.insert(first)
+        }
+        for id in recent + ordered {
+            if result.count >= self.ordinaryResidentLimit { break }
+            if valid.contains(id) { result.insert(id) }
+        }
+        return result
+    }
+}
