+import PresentationDataUtils
+
+private final class UltraStickerCell: UICollectionViewCell {
+    private let imageView = UIImageView()
+    private let fallback = UILabel()
+    private let imageDisposable = MetaDisposable()
+    private var fileId: EngineMedia.Id?
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.fallback.textAlignment = .center
+        self.fallback.font = .systemFont(ofSize: 30)
+        self.imageView.contentMode = .scaleAspectFit
+        self.contentView.addSubview(self.fallback)
+        self.contentView.addSubview(self.imageView)
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = .button
+    }
+    required init?(coder: NSCoder) { return nil }
+    deinit { self.imageDisposable.dispose() }
+    override func prepareForReuse() {
+        super.prepareForReuse()
+        self.imageDisposable.set(nil)
+        self.fileId = nil
+        self.imageView.image = nil
+    }
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.imageView.frame = self.contentView.bounds.insetBy(dx: 6, dy: 6)
+        self.fallback.frame = self.contentView.bounds
+    }
+    func update(context: AccountContext, file: TelegramMediaFile) {
+        self.fileId = file.fileId
+        self.imageView.image = nil
+        let displayText = TelegramMediaFile.Accessor(file).stickerDisplayText
+        self.fallback.text = displayText ?? "★"
+        self.fallback.isHidden = false
+        self.accessibilityLabel = "Стикер \(displayText ?? "")"
+        self.accessibilityHint = "Нажмите для отправки. Дополнительные действия — удаление из локальной коллекции."
+        let dimensions = file.dimensions?.cgSize ?? CGSize(width: 80, height: 80)
+        let size = dimensions.aspectFitted(CGSize(width: 80, height: 80))
+        self.imageDisposable.set((chatMessageSticker(account: context.account, userLocation: .other, file: file, small: true, thumbnail: true) |> deliverOnMainQueue).start(next: { [weak self] draw in
+            guard let self, self.fileId == file.fileId else { return }
+            let image = draw(TransformImageArguments(corners: ImageCorners(), imageSize: size, boundingSize: CGSize(width: 80, height: 80), intrinsicInsets: .zero))?.generateImage()
+            self.imageView.image = image
+            self.fallback.isHidden = image != nil
+        }))
+    }
+}
+
+private final class UltraLocalStickersController: ViewController, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+    private let context: AccountContext
+    private let sendSticker: ((TelegramMediaFile) -> Bool)?
+    private var presentationData: PresentationData
+    private let collection: UICollectionView
+    private let descriptionLabel = UILabel()
+    private var files: [TelegramMediaFile] = []
+    private let loadDisposable = MetaDisposable()
+    private let actionDisposable = MetaDisposable()
+    private var presentationDisposable: Disposable?
+
+    init(context: AccountContext, sendSticker: ((TelegramMediaFile) -> Bool)?) {
+        self.context = context
+        self.sendSticker = sendSticker
+        self.presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let layout = UICollectionViewFlowLayout()
+        layout.minimumInteritemSpacing = 8
+        layout.minimumLineSpacing = 8
+        self.collection = UICollectionView(frame: .zero, collectionViewLayout: layout)
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: self.presentationData))
+        self.navigationPresentation = .modal
+        self.title = "Локальные стикеры ULTRA"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: self.presentationData.strings.Common_Close, style: .plain, target: self, action: #selector(self.closePressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "Импорт", style: .plain, target: self, action: #selector(self.importPressed))
+        self.collection.dataSource = self
+        self.collection.delegate = self
+        self.collection.alwaysBounceVertical = true
+        self.collection.register(UltraStickerCell.self, forCellWithReuseIdentifier: "sticker")
+        self.collection.register(UICollectionReusableView.self, forSupplementaryViewOfKind: UICollectionView.elementKindSectionHeader, withReuseIdentifier: "description")
+        self.descriptionLabel.numberOfLines = 0
+        self.descriptionLabel.font = .preferredFont(forTextStyle: .footnote)
+        self.descriptionLabel.adjustsFontForContentSizeCategory = true
+        self.descriptionLabel.text = "Отдельная коллекция этого аккаунта на устройстве, до \(ultraLocalStickerLimit) стикеров. Серверное избранное и Premium не меняются. Импорт копирует избранное Telegram. Нажатие — отправка, удержание — удаление."
+        self.presentationDisposable = (context.sharedContext.presentationData |> deliverOnMainQueue).start(next: { [weak self] data in
+            guard let self else { return }
+            self.presentationData = data
+            self.navigationBar?.updatePresentationData(NavigationBarPresentationData(presentationData: data))
+            self.updateColors()
+        })
+        self.reload()
+    }
+    required init(coder: NSCoder) { preconditionFailure("init(coder:) is not supported") }
+    deinit {
+        self.loadDisposable.dispose()
+        self.actionDisposable.dispose()
+        self.presentationDisposable?.dispose()
+    }
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        self.displayNode.view.addSubview(self.collection)
+        self.updateColors()
+    }
+    private func updateColors() {
+        guard self.isNodeLoaded else { return }
+        self.displayNode.backgroundColor = self.presentationData.theme.list.blocksBackgroundColor
+        self.collection.backgroundColor = .clear
+        self.descriptionLabel.textColor = self.presentationData.theme.list.itemSecondaryTextColor
+    }
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        let top = self.navigationLayout(layout: layout).navigationFrame.maxY
+        let width = max(0, layout.size.width - layout.safeInsets.left - layout.safeInsets.right)
+        let header = self.descriptionLabel.sizeThatFits(CGSize(width: max(0, width - 32), height: .greatestFiniteMagnitude))
+        (self.collection.collectionViewLayout as? UICollectionViewFlowLayout)?.headerReferenceSize = CGSize(width: width, height: header.height + 24)
+        transition.updateFrame(view: self.collection, frame: CGRect(x: layout.safeInsets.left, y: top, width: width, height: max(0, layout.size.height - top)))
+        self.collection.contentInset.bottom = layout.insets(options: [.input]).bottom
+        self.collection.collectionViewLayout.invalidateLayout()
+    }
+    private func reload() {
+        self.loadDisposable.set((self.context.engine.stickers.ultraLocalStickers() |> deliverOnMainQueue).start(next: { [weak self] files in
+            self?.files = files
+            self?.collection.reloadData()
+        }))
+    }
+    private func alert(_ text: String) {
+        self.present(textAlertController(context: self.context, title: "Локальные стикеры", text: text, actions: [TextAlertAction(type: .defaultAction, title: "OK", action: {})]), in: .window(.root))
+    }
+    @objc private func closePressed() { self.dismiss() }
+    @objc private func importPressed() {
+        self.actionDisposable.set((self.context.engine.stickers.copySavedStickersToUltra() |> deliverOnMainQueue).start(next: { [weak self] count in
+            self?.reload()
+            self?.alert("Скопировано или обновлено: \(count). Для добавления других стикеров откройте меню сообщения со стикером → «Сохранить в ULTRA».")
+        }))
+    }
+    func collectionView(_ collectionView: UICollectionView, numberOfItemsInSection section: Int) -> Int { return self.files.count }
+    func collectionView(_ collectionView: UICollectionView, viewForSupplementaryElementOfKind kind: String, at indexPath: IndexPath) -> UICollectionReusableView {
+        let header = collectionView.dequeueReusableSupplementaryView(ofKind: kind, withReuseIdentifier: "description", for: indexPath)
+        if self.descriptionLabel.superview !== header { header.addSubview(self.descriptionLabel) }
+        self.descriptionLabel.frame = header.bounds.insetBy(dx: 16, dy: 12)
+        self.descriptionLabel.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        return header
+    }
+    func collectionView(_ collectionView: UICollectionView, cellForItemAt indexPath: IndexPath) -> UICollectionViewCell {
+        let cell = collectionView.dequeueReusableCell(withReuseIdentifier: "sticker", for: indexPath) as! UltraStickerCell
+        cell.update(context: self.context, file: self.files[indexPath.item])
+        return cell
+    }
+    func collectionView(_ collectionView: UICollectionView, layout collectionViewLayout: UICollectionViewLayout, sizeForItemAt indexPath: IndexPath) -> CGSize {
+        let columns = max(3, Int(collectionView.bounds.width / 88))
+        let side = floor((collectionView.bounds.width - CGFloat(columns - 1) * 8) / CGFloat(columns))
+        return CGSize(width: side, height: side)
+    }
+    func collectionView(_ collectionView: UICollectionView, didSelectItemAt indexPath: IndexPath) {
+        guard self.files.indices.contains(indexPath.item) else { return }
+        let file = self.files[indexPath.item]
+        if let sendSticker = self.sendSticker {
+            if sendSticker(file) { self.dismiss() }
+            else { self.alert("Telegram не разрешил отправку в этот чат. Проверьте права чата и доступность стикера для аккаунта.") }
+        } else {
+            let share = self.context.sharedContext.makeShareScreen(context: self.context, params: ShareControllerParams(subject: .media(stickerPackFileReference(file).abstract, nil), externalShare: false))
+            self.present(share, in: .window(.root))
+        }
+    }
+    func collectionView(_ collectionView: UICollectionView, contextMenuConfigurationForItemAt indexPath: IndexPath, point: CGPoint) -> UIContextMenuConfiguration? {
+        guard self.files.indices.contains(indexPath.item) else { return nil }
+        let file = self.files[indexPath.item]
+        return UIContextMenuConfiguration(identifier: nil, previewProvider: nil, actionProvider: { [weak self] _ in
+            return UIMenu(children: [UIAction(title: "Удалить из ULTRA", attributes: .destructive, handler: { [weak self] _ in
+                guard let self else { return }
+                self.actionDisposable.set((self.context.engine.stickers.setUltraLocalStickerSaved(file: file, saved: false) |> deliverOnMainQueue).start(next: { [weak self] _ in self?.reload() }))
+            })])
+        })
+    }
+}
+
+public func ultraLocalStickersController(context: AccountContext, sendSticker: ((TelegramMediaFile) -> Bool)? = nil) -> ViewController {
+    return UltraLocalStickersController(context: context, sendSticker: sendSticker)
+}
