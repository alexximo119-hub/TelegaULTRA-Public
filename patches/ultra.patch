+import XCTest
+@testable import Postbox
+
+final class UltraItemCacheIsolationTests: XCTestCase {
+    func testNegativeForkCollectionDoesNotReadOrClearNativeAgentOrAppCollections() {
+        let fixture = PostboxFixture(name: "UltraItemCacheIsolationTests")
+        defer { fixture.close() }
+        fixture.transaction { transaction in
+            let key = ValueBoxKey(length: 1)
+            key.setUInt8(0, value: 1)
+            let fork = ItemCacheEntryId(collectionId: -128, key: key)
+            let nativeAgent = ItemCacheEntryId(collectionId: 63, key: key)
+            let app = ItemCacheEntryId(collectionId: 64, key: key)
+            for (id, value) in [(fork, "fork"), (nativeAgent, "native"), (app, "app")] {
+                guard let entry = CodableEntry(["value": value]) else { return XCTFail("Synthetic value must encode") }
+                transaction.putItemCacheEntry(id: id, entry: entry)
+            }
+            XCTAssertEqual(transaction.retrieveItemCacheEntry(id: fork)?.get([String: String].self), ["value": "fork"])
+            transaction.clearItemCacheCollection(collectionId: -128)
+            XCTAssertNil(transaction.retrieveItemCacheEntry(id: fork))
+            XCTAssertEqual(transaction.retrieveItemCacheEntry(id: nativeAgent)?.get([String: String].self), ["value": "native"])
+            XCTAssertEqual(transaction.retrieveItemCacheEntry(id: app)?.get([String: String].self), ["value": "app"])
+        }
+    }
+}
