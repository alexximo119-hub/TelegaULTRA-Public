@@ -0,0 +1,45 @@
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import AccountContext
+
+private final class UltraUploadArguments {
+    let update: (UltraUploadMode) -> Void
+    init(update: @escaping (UltraUploadMode) -> Void) { self.update = update }
+}
+private enum UltraUploadEntry: ItemListNodeEntry {
+    case mode(UltraUploadMode, Bool)
+    case footer
+    var stableId: Int32 { switch self { case let .mode(mode, _): return mode.rawValue; case .footer: return 100 } }
+    var section: ItemListSectionId { return 0 }
+    static func < (lhs: UltraUploadEntry, rhs: UltraUploadEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraUploadArguments
+        switch self {
+        case let .mode(mode, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: mode.title, style: .right, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: { arguments.update(mode) })
+        case .footer:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Экспериментальная настройка числа одновременно загружаемых частей одного файла. Это не множитель скорости: результат зависит от сети, iPhone и Telegram. Большее значение может увеличить расход памяти, энергии и число ошибок. «Как в Telegram» сохраняет штатные 3 или 30 частей в зависимости от пути отправки. Настройка действует на следующие загрузки главного приложения; текущие передачи и секретные чаты не изменяются. Серверные лимиты, повторные попытки и FLOOD_WAIT сохраняются. Начните со штатного режима и сравните одинаковый файл в одной сети."), sectionId: self.section)
+        }
+    }
+}
+func ultraUploadController(context: AccountContext) -> ViewController {
+    let arguments = UltraUploadArguments(update: { mode in
+        let _ = updateExperimentalUISettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+            var settings = settings
+            settings.ultra.uploadMode = mode
+            return settings
+        }).startStandalone()
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, context.sharedContext.accountManager.sharedData(keys: [ApplicationSpecificSharedDataKeys.experimentalUISettings])) |> deliverOnMainQueue |> map { presentationData, sharedData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let settings = sharedData.entries[ApplicationSpecificSharedDataKeys.experimentalUISettings]?.get(ExperimentalUISettings.self) ?? .defaultSettings
+        var entries = UltraUploadMode.allCases.map { UltraUploadEntry.mode($0, $0 == settings.ultra.uploadMode) }
+        entries.append(.footer)
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Параллельность отправки"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
diff --git a/submodules/SettingsUI/Sources/UltraVideoSanitizerController.swift b/submodules/SettingsUI/Sources/UltraVideoSanitizerController.swift
