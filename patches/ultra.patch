+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraInteractionPolicyTests: XCTestCase {
+    func testMediaSpoilerSettingPreservesProtectedOverlays() {
+        XCTAssertTrue(UltraInteractionPolicy.shouldRevealMediaSpoiler(enabled: true, isSecretMedia: false, hasPaidMedia: false, isSensitive: false))
+        XCTAssertFalse(UltraInteractionPolicy.shouldRevealMediaSpoiler(enabled: false, isSecretMedia: false, hasPaidMedia: false, isSensitive: false))
+        for flags in [(true, false, false), (false, true, false), (false, false, true), (true, true, true)] {
+            XCTAssertFalse(UltraInteractionPolicy.shouldRevealMediaSpoiler(enabled: true, isSecretMedia: flags.0, hasPaidMedia: flags.1, isSensitive: flags.2))
+        }
+    }
+
+    func testTranslationCanBeOfferedWhenLanguageRecognitionHidesIt() {
+        XCTAssertTrue(UltraInteractionPolicy.shouldOfferTranslation(normallyAvailable: false, force: true, hasText: true, serviceAvailable: true, isSecretChat: false))
+    }
+
+    func testForcedTranslationNeverExposesSecretChatsOrEmptyMessages() {
+        XCTAssertFalse(UltraInteractionPolicy.shouldOfferTranslation(normallyAvailable: true, force: true, hasText: true, serviceAvailable: true, isSecretChat: true))
+        XCTAssertFalse(UltraInteractionPolicy.shouldOfferTranslation(normallyAvailable: true, force: true, hasText: false, serviceAvailable: true, isSecretChat: false))
+    }
+
+    func testUnavailableTranslationServiceCannotBeForced() {
+        XCTAssertFalse(UltraInteractionPolicy.shouldOfferTranslation(normallyAvailable: false, force: true, hasText: true, serviceAvailable: false, isSecretChat: false))
+    }
+
+    func testDisablingTranslationOverrideRetainsNormalAvailability() {
+        for available in [false, true] {
+            XCTAssertEqual(UltraInteractionPolicy.shouldOfferTranslation(normallyAvailable: available, force: false, hasText: true, serviceAvailable: true, isSecretChat: false), available)
+        }
+    }
+
+    func testDoubleTapCanEditAnEditableOwnMessage() {
+        XCTAssertTrue(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: true, canEdit: true, hasSelection: false, isPinnedView: false, isMigrated: false))
+    }
+
+    func testDoubleTapDoesNotGrantEditPermissionOrEditOtherAuthors() {
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: false, canEdit: true, hasSelection: false, isPinnedView: false, isMigrated: false))
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: true, canEdit: false, hasSelection: false, isPinnedView: false, isMigrated: false))
+    }
+
+    func testDoubleTapPreservesSelectionAndReadOnlyHistoryViews() {
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: false, isOwnMessage: true, canEdit: true, hasSelection: false, isPinnedView: false, isMigrated: false))
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: true, canEdit: true, hasSelection: true, isPinnedView: false, isMigrated: false))
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: true, canEdit: true, hasSelection: false, isPinnedView: true, isMigrated: false))
+        XCTAssertFalse(UltraInteractionPolicy.shouldEditOnDoubleTap(enabled: true, isOwnMessage: true, canEdit: true, hasSelection: false, isPinnedView: false, isMigrated: true))
+    }
+}
