+import Foundation
+import XCTest
+@testable import Postbox
+
+final class MessageIdRangeQueryTests: XCTestCase {
+    private var fixture: PostboxFixture!
+    private let peerId = MessageHistoryTableFixture.peerId(940)
+    private let namespace = PostboxFixture.messageNamespace
+
+    override func setUp() {
+        super.setUp()
+        self.fixture = PostboxFixture(name: "MessageIdRangeQueryTests")
+    }
+
+    override func tearDown() {
+        self.fixture.close()
+        self.fixture = nil
+        super.tearDown()
+    }
+
+    private func message(_ id: Int32, peerId: PeerId? = nil, namespace: MessageId.Namespace? = nil) -> StoreMessage {
+        return StoreMessage(id: MessageId(peerId: peerId ?? self.peerId, namespace: namespace ?? self.namespace, id: id), customStableId: nil, globallyUniqueId: nil, groupingKey: nil, threadId: nil, timestamp: 10000 - id, flags: [.Incoming], tags: [], globalTags: [], localTags: [], forwardInfo: nil, authorId: nil, text: "Synthetic \(id)", attributes: [], media: [])
+    }
+
+    func testInclusiveSparseRangeIsOrderedByIdAndIsolatesPeersAndNamespaces() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(1), self.message(5), self.message(9), self.message(10), self.message(5, peerId: MessageHistoryTableFixture.peerId(941)), self.message(5, namespace: self.namespace + 1)], location: .Random)
+            let messages = transaction.getMessagesInIdRange(peerId: self.peerId, namespace: self.namespace, minId: 5, maxId: 9, limit: 1000)
+            XCTAssertEqual(messages.map { $0.id.id }, [9, 5])
+            XCTAssertTrue(messages.allSatisfy { $0.id.peerId == self.peerId && $0.id.namespace == self.namespace })
+            XCTAssertNotNil(transaction.getMessage(MessageId(peerId: self.peerId, namespace: self.namespace, id: 5)), "A read must not remove or mutate a message")
+        }
+    }
+
+    func testLargeRangesReadAtMostTheRequestedNewestThousandRecords() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages((1 ... 1100).map { self.message(Int32($0)) }, location: .Random)
+            let messages = transaction.getMessagesInIdRange(peerId: self.peerId, namespace: self.namespace, minId: 1, maxId: Int32.max - 1, limit: Int.max)
+            XCTAssertEqual(messages.count, 1000)
+            XCTAssertEqual(messages.first?.id.id, 1100)
+            XCTAssertEqual(messages.last?.id.id, 101)
+            XCTAssertEqual(transaction.getMessagesInIdRange(peerId: self.peerId, namespace: self.namespace, minId: 1, maxId: 1100, limit: 2).map { $0.id.id }, [1100, 1099])
+        }
+    }
+
+    func testInvalidAndEmptyRangesDoNotReadAdjacentRecords() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(5)], location: .Random)
+            let cases: [(Int32, Int32, Int)] = [(6, 4, 10), (1, 10, 0), (1, 10, -1), (6, 10, 10)]
+            for (lower, upper, limit) in cases {
+                XCTAssertTrue(transaction.getMessagesInIdRange(peerId: self.peerId, namespace: self.namespace, minId: lower, maxId: upper, limit: limit).isEmpty)
+            }
+        }
+    }
+}
