@@ -0,0 +1,105 @@
+import UIKit
+import Display
+import ComponentFlow
+import ChatInputAccessoryPanel
+import ChatInputTextNode
+import TelegramPresentationData
+
+enum UltraFormattingAction: Int, CaseIterable {
+    case bold, italic, underline, strikethrough, monospace, spoiler, quote, link
+    var nativeFormat: ChatRichTextFormatAction? {
+        switch self {
+        case .bold: return .bold
+        case .italic: return .italic
+        case .underline: return .underline
+        case .strikethrough: return .strikethrough
+        case .monospace: return .monospace
+        case .spoiler: return .spoiler
+        case .quote: return .quote
+        case .link: return nil
+        }
+    }
+    func title(_ strings: PresentationStrings) -> String {
+        switch self {
+        case .bold: return strings.TextFormat_Bold
+        case .italic: return strings.TextFormat_Italic
+        case .underline: return strings.TextFormat_Underline
+        case .strikethrough: return strings.TextFormat_Strikethrough
+        case .monospace: return strings.TextFormat_Monospace
+        case .spoiler: return strings.TextFormat_Spoiler
+        case .quote: return strings.TextFormat_Quote
+        case .link: return strings.TextFormat_Link
+        }
+    }
+    var symbol: String {
+        switch self {
+        case .bold: return "B"
+        case .italic: return "I"
+        case .underline: return "U"
+        case .strikethrough: return "S̶"
+        case .monospace: return "<>"
+        case .spoiler: return "•••"
+        case .quote: return "❞"
+        case .link: return "↗"
+        }
+    }
+}
+
+final class UltraFormattingPanelComponent: Component {
+    typealias EnvironmentType = ChatInputAccessoryPanelEnvironment
+    let actions: [UltraFormattingAction]
+    let perform: (UltraFormattingAction) -> Void
+    init(actions: [UltraFormattingAction], perform: @escaping (UltraFormattingAction) -> Void) {
+        self.actions = actions
+        self.perform = perform
+    }
+    static func == (lhs: UltraFormattingPanelComponent, rhs: UltraFormattingPanelComponent) -> Bool { return lhs.actions == rhs.actions }
+
+    final class View: UIView, ChatInputAccessoryPanelView {
+        let contentTintView = UIView()
+        var storedFrameBeforeDismissed: CGRect?
+        var transitionData: ChatInputAccessoryPanelTransitionData? { return nil }
+        private let scroll = UIScrollView()
+        private var buttons: [UltraFormattingAction: UIButton] = [:]
+        private var component: UltraFormattingPanelComponent?
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.scroll.showsHorizontalScrollIndicator = false
+            self.scroll.delaysContentTouches = false
+            self.addSubview(self.scroll)
+        }
+        required init?(coder: NSCoder) { return nil }
+        func update(component: UltraFormattingPanelComponent, availableSize: CGSize, environment: Environment<EnvironmentType>) -> CGSize {
+            self.component = component
+            let environment = environment[EnvironmentType.self].value
+            for action in Array(self.buttons.keys) where !component.actions.contains(action) {
+                self.buttons.removeValue(forKey: action)?.removeFromSuperview()
+            }
+            var x: CGFloat = 4
+            for action in component.actions {
+                let button: UIButton
+                if let current = self.buttons[action] { button = current }
+                else {
+                    button = UIButton(type: .system)
+                    button.addAction(UIAction { [weak self] _ in self?.component?.perform(action) }, for: .touchUpInside)
+                    self.buttons[action] = button
+                    self.scroll.addSubview(button)
+                }
+                button.setTitle(action.symbol, for: .normal)
+                button.titleLabel?.font = action == .italic ? Font.italic(17) : Font.semibold(17)
+                button.tintColor = environment.theme.list.itemAccentColor
+                button.accessibilityLabel = action.title(environment.strings)
+                button.frame = CGRect(x: x, y: 4, width: 44, height: 44)
+                x += 44
+            }
+            self.scroll.frame = CGRect(origin: .zero, size: CGSize(width: availableSize.width, height: 52))
+            self.scroll.contentSize = CGSize(width: x + 4, height: 52)
+            return CGSize(width: availableSize.width, height: 52)
+        }
+    }
+    func makeView() -> View { return View(frame: .zero) }
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<EnvironmentType>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, environment: environment)
+    }
+}
