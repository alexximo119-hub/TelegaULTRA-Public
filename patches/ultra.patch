diff --git a/submodules/TelegramCore/Sources/Settings/UltraAccountDirectoryStore.swift b/submodules/TelegramCore/Sources/Settings/UltraAccountDirectoryStore.swift
new file mode 100644
index 00000000..4e6c06c1
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Settings/UltraAccountDirectoryStore.swift
@@ -0,0 +1,125 @@
+import Foundation
+
+public struct UltraAccountDirectoryEntry: Codable, Equatable {
+    public let recordId: Int64
+    public let userId: Int64
+    public let testingEnvironment: Bool
+    public let title: String
+    public var alias: String?
+
+    public init(recordId: Int64, userId: Int64, testingEnvironment: Bool, title: String, alias: String? = nil) {
+        self.recordId = recordId
+        self.userId = userId
+        self.testingEnvironment = testingEnvironment
+        self.title = UltraAccountDirectoryStore.boundedName(title) ?? "Аккаунт"
+        self.alias = alias.flatMap(UltraAccountDirectoryStore.boundedName)
+    }
+    public var displayTitle: String { return self.alias ?? self.title }
+}
+
+/// Local directory metadata only. No auth keys, access hashes, sessions, contacts or messages.
+public enum UltraAccountDirectoryStore {
+    private struct Contents: Codable, Equatable {
+        var version: Int = 1
+        var entries: [UltraAccountDirectoryEntry] = []
+    }
+    private static let key = "ultra.accountDirectory.v1"
+    private static let lock = NSLock()
+    private static let maximumBytes = 1024 * 1024
+    private final class Authority {
+        weak var defaults: UserDefaults?
+        let ids: Set<Int64>
+        init(defaults: UserDefaults, ids: Set<Int64>) { self.defaults = defaults; self.ids = ids }
+    }
+    private static var authorities: [ObjectIdentifier: Authority] = [:]
+
+    private static func authoritativeIds(_ defaults: UserDefaults) -> Set<Int64>? {
+        guard let authority = self.authorities[ObjectIdentifier(defaults)], authority.defaults === defaults else { return nil }
+        return authority.ids
+    }
+
+    static func boundedName(_ text: String) -> String? {
+        var result = String(text.filter { character in
+            return !character.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) })
+        }.trimmingCharacters(in: .whitespacesAndNewlines).prefix(64))
+        while result.utf8.count > 256 { result.removeLast() }
+        return result.isEmpty ? nil : result
+    }
+
+    private static func load(_ defaults: UserDefaults) -> Contents? {
+        guard let data = defaults.data(forKey: self.key) else { return Contents() }
+        guard data.count <= self.maximumBytes,
+              let contents = try? JSONDecoder().decode(Contents.self, from: data), contents.version == 1,
+              contents.entries.count <= UltraAccountLoadPolicy.catalogLimit else { return nil }
+        var ids = Set<Int64>()
+        for entry in contents.entries {
+            guard entry.userId > 0, ids.insert(entry.recordId).inserted,
+                  self.boundedName(entry.title) == entry.title else { return nil }
+            if let alias = entry.alias, self.boundedName(alias) != alias { return nil }
+        }
+        return contents
+    }
+
+    public static func entries(defaults: UserDefaults = .standard) -> [UltraAccountDirectoryEntry] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.load(defaults)?.entries ?? []
+    }
+
+    /// Only the ordered full-record stream establishes membership. Partial UI snapshots must not
+    /// erase labels for newly added records or resurrect labels for removed records.
+    @discardableResult public static func reconcile(validRecordIds: Set<Int64>, defaults: UserDefaults = .standard) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        self.authorities = self.authorities.filter { $0.value.defaults != nil }
+        self.authorities[ObjectIdentifier(defaults)] = Authority(defaults: defaults, ids: validRecordIds)
+        guard var contents = self.load(defaults) else { return false }
+        let previous = contents.entries
+        contents.entries.removeAll(where: { !validRecordIds.contains($0.recordId) })
+        if contents.entries == previous { return true }
+        guard let data = try? JSONEncoder().encode(contents), data.count <= self.maximumBytes else { return false }
+        defaults.set(data, forKey: self.key)
+        return true
+    }
+
+    /// Preserve unknown/corrupt stores rather than replacing the owner's labels automatically.
+    @discardableResult public static func merge(_ profiles: [UltraAccountDirectoryEntry], validRecordIds: Set<Int64>, defaults: UserDefaults = .standard) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard let previous = self.load(defaults) else { return false }
+        let authoritative = self.authoritativeIds(defaults) ?? validRecordIds
+        let allowed = validRecordIds.intersection(authoritative)
+        var byId = Dictionary(uniqueKeysWithValues: previous.entries.filter { authoritative.contains($0.recordId) }.map { ($0.recordId, $0) })
+        for profile in profiles where allowed.contains(profile.recordId) && profile.userId > 0 {
+            guard self.boundedName(profile.title) == profile.title else { return false }
+            if let alias = profile.alias, self.boundedName(alias) != alias { return false }
+            var updated = profile
+            if let old = byId[profile.recordId], old.userId == profile.userId, old.testingEnvironment == profile.testingEnvironment {
+                updated.alias = old.alias
+            }
+            byId[profile.recordId] = updated
+        }
+        guard byId.count <= UltraAccountLoadPolicy.catalogLimit else { return false }
+        let next = Contents(entries: byId.values.sorted { $0.recordId < $1.recordId })
+        if next == previous { return true }
+        guard let data = try? JSONEncoder().encode(next), data.count <= self.maximumBytes else { return false }
+        defaults.set(data, forKey: self.key)
+        return true
+    }
+
+    @discardableResult public static func setAlias(_ alias: String, recordId: Int64, defaults: UserDefaults = .standard) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard var contents = self.load(defaults), let index = contents.entries.firstIndex(where: { $0.recordId == recordId }) else { return false }
+        contents.entries[index].alias = self.boundedName(alias)
+        guard let data = try? JSONEncoder().encode(contents), data.count <= self.maximumBytes else { return false }
+        defaults.set(data, forKey: self.key)
+        return true
+    }
+
+    public static func resetLabels(defaults: UserDefaults = .standard) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        defaults.removeObject(forKey: self.key)
+    }
+}
