+        XCTAssertEqual(settings.uploadMode, .automatic)
+        XCTAssertFalse(settings.saveViewOnceMedia)
+        XCTAssertFalse(settings.sanitizeUploadedImages)
+    }
+
+    func testEmptyLegacySettingsUseDefaults() throws {
+        XCTAssertEqual(try JSONDecoder().decode(UltraSettings.self, from: Data("{}".utf8)), UltraSettings())
+    }
+
+    func testNewOptionsAndExistingValuesSurviveRoundTrip() throws {
+        var settings = UltraSettings()
+        settings.showPeerId = true
+        settings.showAvatarDatacenter = true
+        settings.showMessageSeconds = true
+        settings.showFullViewCounts = true
+        settings.showMutualContact = true
+        settings.confirmCalls = true
+        settings.highQualityPhotos = true
+        settings.doubleTapToEdit = true
+        settings.alwaysShowTranslate = true
+        settings.hideBusinessBot = true
+        settings.hideSponsoredMessages = true
+        settings.revealTextSpoilers = true
+        settings.presenceMode = .offline
+        settings.highQualityVideos = true
+        settings.revealMediaSpoilers = true
+        settings.showAvatarOnline = true
+        settings.showFormattingToolbar = true
+        settings.showChatDates = true
