+/// Attach display-only history to ordinary text rows. Server messages and stable IDs are unchanged.
+func ultraHistoryEntriesWithInlinePreviews(_ entries: [ChatHistoryEntry], previews: [Int32: UltraLocalHistoryInlinePreview]) -> [ChatHistoryEntry] {
+    guard !previews.isEmpty else { return entries }
+    return entries.map { entry in
+        guard case let .MessageEntry(message, presentation, read, location, selection, attributes) = entry,
+              case .none = selection, case .generic = attributes.contentTypeHint,
+              !presentation.isPreview, message.id.namespace == Namespaces.Message.Cloud,
+              message.id.peerId.namespace != Namespaces.Peer.SecretChat, message.media.isEmpty,
+              message.autoclearAttribute == nil, message.autoremoveAttribute == nil,
+              !message.text.isEmpty, let preview = previews[message.id.id],
+              preview.peerId == message.id.peerId.toInt64(), preview.messageId == message.id.id else { return entry }
+        var attributes = attributes
+        attributes.ultraHistoryPreview = preview
+        return .MessageEntry(message, presentation, read, location, selection, attributes)
+    }
+}
