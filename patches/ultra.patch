+
+private enum UltraHistoryOption: Int32, CaseIterable {
+    case deleted, edited, received, excludeOwn, strikeOriginals, inlineEdits, localDeletions
+    var title: String {
+        switch self {
+        case .deleted: return "Сохранять удалённый текст"
+        case .edited: return "Сохранять предыдущие редакции"
+        case .received: return "Сохранять полученный текст"
+        case .excludeOwn: return "Исключать мои сообщения"
+        case .strikeOriginals: return "Зачёркивать предыдущие редакции"
+        case .inlineEdits: return "Редакция внутри сообщения"
+        case .localDeletions: return "Архивировать при моём удалении"
+        }
+    }
+    var keyPath: WritableKeyPath<UltraLocalHistoryPolicy, Bool> {
+        switch self {
+        case .deleted: return \.deleted
+        case .edited: return \.edited
+        case .received: return \.received
+        case .excludeOwn: return \.excludeOwn
+        case .strikeOriginals: return \.strikeOriginals
+        case .inlineEdits: return \.inlineEdits
+        case .localDeletions: return \.localDeletions
+        }
+    }
+}
+
+private func ultraHistoryKindTitle(_ kind: UltraLocalHistoryRecord.Kind) -> String {
+    switch kind {
+    case .deleted: return "Удалённое"
+    case .edited: return "Предыдущая редакция"
+    case .received: return "Полученное"
+    }
+}
+
+private final class UltraHistoryArguments {
+    var toggle: (UltraHistoryOption, Bool) -> Void = { _, _ in }
+    var open: (UltraLocalHistoryRecord) -> Void = { _ in }
+    var more: () -> Void = {}
+    var clear: () -> Void = {}
+    var refresh: () -> Void = {}
+    var query: (String) -> Void = { _ in }
+}
+
+private enum UltraHistoryEntry: ItemListNodeEntry {
+    case toggle(UltraHistoryOption, Bool)
+    case action(Int32, String)
+    case record(Int32, UltraLocalHistoryRecord)
+    case footer(String)
+    case query(String)
+    var stableId: Int32 {
+        switch self {
+        case let .toggle(option, _): return option.rawValue
+        case let .action(id, _): return id
+        case let .record(index, _): return 100 + index
+        case .footer: return 10000
+        case .query: return 9
+        }
+    }
+    var section: ItemListSectionId {
+        switch self { case .toggle: return 0; case .action, .query: return 1; case .record, .footer: return 2 }
+    }
+    static func < (lhs: UltraHistoryEntry, rhs: UltraHistoryEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraHistoryArguments
+        switch self {
+        case let .toggle(option, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: option.title, value: value, sectionId: self.section, style: .blocks, updated: { arguments.toggle(option, $0) })
+        case let .action(id, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: id == 11 ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { if id == 10 { arguments.refresh() } else if id == 11 { arguments.clear() } else { arguments.more() } })
+        case let .record(_, record):
+            let preview = String(record.text.replacingOccurrences(of: "\n", with: " ").prefix(80))
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: preview, label: ultraHistoryKindTitle(record.kind), sectionId: self.section, style: .blocks, action: { arguments.open(record) })
+        case let .footer(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .query(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: "Поиск копии по тексту или ID", type: .regular(capitalization: false, autocorrection: false), clearType: .always, maxLength: 64, sectionId: self.section, textUpdated: arguments.query, action: {})
+        }
+    }
+}
+
+private func ultraHistoryRecordController(context: AccountContext, record: UltraLocalHistoryRecord, strike: Bool) -> ViewController {
+    let signal = context.sharedContext.presentationData |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(ultraHistoryKindTitle(record.kind)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let entities = record.validatedSpans.map { span -> MessageTextEntity in
+            let type: MessageTextEntityType
+            switch span.style {
+            case .bold: type = .Bold
+            case .italic: type = .Italic
+            case .code: type = .Code
+            case .pre: type = .Pre(language: nil)
+            case .underline: type = .Underline
+            case .strikethrough: type = .Strikethrough
+            case .quote: type = .BlockQuote(isCollapsed: false)
+            }
+            return MessageTextEntity(range: span.offset ..< span.offset + span.length, type: type)
+        }
+        let color = presentationData.theme.list.itemPrimaryTextColor
+        let text = NSMutableAttributedString(attributedString: stringWithAppliedEntities(record.text, entities: entities, baseColor: color, linkColor: color, baseFont: Font.regular(17), linkFont: Font.regular(17), boldFont: Font.semibold(17), italicFont: Font.italic(17), boldItalicFont: Font.semiboldItalic(17), fixedFont: Font.monospace(17), blockQuoteFont: Font.regular(17), message: nil))
+        if strike && record.kind == .edited { text.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue, range: NSRange(location: 0, length: text.length)) }
+        let date = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(record.messageTimestamp)), dateStyle: .medium, timeStyle: .medium)
+        let capturedDate = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(record.capturedAt)), dateStyle: .medium, timeStyle: .medium)
+        let metadata = "Локальная копия\nСообщение: \(date)\nСохранено на устройстве: \(capturedDate)\nID чата: \(record.peerId), сообщения: \(record.messageId)" + (record.truncated ? "\nСохранена текстовая часть или доступный фрагмент содержимого." : "")
+        let entries: [UltraHistoryDetailEntry] = [.body(context, text), .metadata(metadata)]
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), Void()))
+    }
+    return ItemListController(context: context, state: signal)
+}
+
+private enum UltraHistoryDetailEntry: ItemListNodeEntry {
+    case body(AccountContext, NSAttributedString)
+    case metadata(String)
+    var stableId: Int32 { switch self { case .body: return 0; case .metadata: return 1 } }
+    var section: ItemListSectionId { return 0 }
+    static func == (lhs: UltraHistoryDetailEntry, rhs: UltraHistoryDetailEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.body(_, a), .body(_, b)): return a.isEqual(to: b)
+        case let (.metadata(a), .metadata(b)): return a == b
+        default: return false
+        }
+    }
+    static func < (lhs: UltraHistoryDetailEntry, rhs: UltraHistoryDetailEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        switch self {
+        case let .body(context, text): return ItemListTextItem(presentationData: presentationData, text: .custom(context: context, string: text), sectionId: self.section)
+        case let .metadata(text): return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+public func ultraLocalHistoryController(context: AccountContext, peerId: Int64? = nil, messageId: Int32? = nil) -> ViewController {
+    let arguments = UltraHistoryArguments()
+    let snapshot = Promise<UltraLocalHistorySnapshot>()
+    let limit = ValuePromise<Int>(50, ignoreRepeated: true)
+    let query = ValuePromise<String>("", ignoreRepeated: true)
+    var count = 50
+    var currentPolicy = UltraLocalHistoryPolicy()
+    var pushImpl: (ViewController) -> Void = { _ in }
+    var presentImpl: (ViewController) -> Void = { _ in }
+    arguments.refresh = {
+        snapshot.set(context.engine.messages.ultraLocalHistory() |> map { snapshot in
+            if let peerId = peerId { return snapshot.filtered(peerId: peerId, messageId: messageId) }
+            return snapshot
+        })
+    }
+    arguments.toggle = { [weak arguments] option, enabled in
+        let _ = (context.engine.messages.updateUltraLocalHistoryPolicy { policy in
+            var policy = policy
+            policy[keyPath: option.keyPath] = enabled
+            return policy
+        } |> deliverOnMainQueue).startStandalone(next: { success in
+            if !success { presentImpl(textAlertController(context: context, title: "Локальная история", text: "Не удалось сохранить настройку или открыть ключ шифрования. Существующий архив не изменён.", actions: [TextAlertAction(type: .defaultAction, title: "OK", action: {})])) }
+            arguments?.refresh()
+        })
+    }
+    arguments.open = { record in pushImpl(ultraHistoryRecordController(context: context, record: record, strike: currentPolicy.strikeOriginals)) }
+    arguments.more = { count = min(1000, count + 50); limit.set(count) }
+    arguments.query = { text in count = 50; limit.set(count); query.set(text) }
+    arguments.clear = { [weak arguments] in
+        presentImpl(textAlertController(context: context, title: "Очистить локальную историю?", text: "Удалится только архив ULTRA этого аккаунта. Сообщения на сервере и настройки записи не изменятся.", actions: [
+            TextAlertAction(type: .genericAction, title: "Отмена", action: {}),
+            TextAlertAction(type: .destructiveAction, title: "Очистить", action: { let _ = (context.engine.messages.clearUltraLocalHistory() |> deliverOnMainQueue).startStandalone(completed: { arguments?.refresh() }) })
+        ]))
+    }
+    arguments.refresh()
+    let signal = combineLatest(context.sharedContext.presentationData, snapshot.get(), limit.get(), query.get()) |> deliverOnMainQueue |> map { presentationData, snapshot, limit, query -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let snapshot = snapshot.searching(query)
+        currentPolicy = snapshot.policy
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        var entries = peerId == nil ? UltraHistoryOption.allCases.map { UltraHistoryEntry.toggle($0, snapshot.policy[keyPath: $0.keyPath]) } : []
+        entries.append(.query(query))
+        entries.append(.action(10, "Обновить список"))
+        if peerId == nil { entries.append(.action(11, "Очистить локальную историю")) }
+        if snapshot.records.count > limit { entries.append(.action(12, "Показать ещё")) }
+        for (index, record) in snapshot.records.prefix(limit).enumerated() { entries.append(.record(Int32(index), record)) }
+        var footer = "Для блока редакции включите «Сохранять предыдущие редакции» и «Редакция внутри сообщения». Отображается первая из ещё сохранённых редакций обычного текстового сообщения: до 400 символов и ограниченного числа строк, полный архив открывается нажатием. Это не гарантия наличия самой первой серверной версии. Альбомы, медиа, секретные/таймерные сообщения, поиск, предпросмотр и выделение исключены. Удалённый текст остаётся в этом отдельном архиве и не возвращается в серверную ленту.\n\nТолько для текущего аккаунта. Архив содержит полученный текст и подписи. Сложные документы сохраняются как обычный текст: до 16 КБ и ограниченного числа элементов, без действий ссылок/кнопок и без медиафайлов. Неполный источник и сокращённый фрагмент отмечаются отдельно. Запись начинается после включения; недоступная ранее история не восстанавливается. Секретные чаты и сообщения с таймером исключены. Копии зашифрованы отдельным ключом устройства и остаются доступны здесь после удаления или потери доступа к чату. До 1000 записей, консервативный лимит 2 МБ сериализации, 30 дней; старые копии очищаются при следующем обращении. Удаление приложения или утрата ключа может сделать архив недоступным."
+        if peerId != nil {
+            footer = "Только сохранённые копии выбранного сообщения или чата. Настройки записи находятся в ULTRA → Сообщения → Локальная история. Время сохранения — время на этом устройстве, а не подтверждённое сервером время правки.\n\n" + footer
+        }
+        if peerId == nil {
+            footer += "\n\n«Архивировать при моём удалении» действует вместе с «Сохранять удалённый текст» и по умолчанию выключено. Сохраняется доступный текст перед удалением выбранных сообщений, очисткой истории чата, диапазона дат, сообщений автора или его пересылок, а также при удалении личного чата или старой группы. До 1000 проверяемых сообщений за действие; при удалении нескольких чатов лимит общий. Исключение моих сообщений действует независимо: блокирует новую запись и скрывает ранее сохранённые копии с известным авторством. Сами копии не стираются. Для старых записей без признака исходящего сообщения авторство не всегда определяется. Таймеры и техническая очистка этой опцией не охвачены. Для удаления, пришедшего с сервера, инициатор не определяется. Выключение записи не стирает уже сохранённые копии; для этого используйте очистку архива."
+        }
+        if snapshot.records.isEmpty { footer = (query.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? "Сохранённых копий пока нет." : "В локальных копиях ничего не найдено.") + "\n\n" + footer }
+        if snapshot.unavailable { footer = "Архив недоступен: ключ, формат или целостность данных не подтверждены. Существующие данные сохранены; автоматическая перезапись отключена.\n\n" + footer }
+        entries.append(.footer(footer))
+        let title = peerId == nil ? "Локальная история" : (messageId == nil ? "История чата ULTRA" : "История сообщения ULTRA")
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    pushImpl = { [weak controller] in controller?.push($0) }
+    presentImpl = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
