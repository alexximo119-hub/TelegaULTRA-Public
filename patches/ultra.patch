+import Foundation
+
+public struct UltraSelectedLocation: Codable, Equatable {
+    public let latitude: Double
+    public let longitude: Double
+    public init?(latitude: Double, longitude: Double) {
+        guard latitude.isFinite, longitude.isFinite, (-90 ... 90).contains(latitude), (-180 ... 180).contains(longitude) else { return nil }
+        self.latitude = latitude
+        self.longitude = longitude
+    }
+}
+
+public enum UltraLocationSelection {
+    private static let key = "ultra.selectedLocation.v1"
+    public static func current(defaults: UserDefaults = .standard) -> UltraSelectedLocation? {
+        guard let data = defaults.data(forKey: self.key), data.count <= 1024,
+              let value = try? JSONDecoder().decode(UltraSelectedLocation.self, from: data) else { return nil }
+        return UltraSelectedLocation(latitude: value.latitude, longitude: value.longitude)
+    }
+    public static func save(_ value: UltraSelectedLocation?, defaults: UserDefaults = .standard) {
+        if let value, let checked = UltraSelectedLocation(latitude: value.latitude, longitude: value.longitude), let data = try? JSONEncoder().encode(checked) {
+            defaults.set(data, forKey: self.key)
+        } else {
+            defaults.removeObject(forKey: self.key)
+        }
+    }
+}
