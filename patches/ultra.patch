+++ b/submodules/TelegramCore/Sources/Network/UltraPreparedVideoUpload.swift
@@ -0,0 +1,117 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+private enum UltraVideoUploadInput: Sendable {
+    case data(Data)
+    case file(URL)
+}
+
+final class UltraPreparedVideoUpload {
+    let file: TempBoxFile
+    let size: Int64
+
+    init(workspace: UltraVideoPreparationWorkspace, size: Int64) throws {
+        let file = TempBox.shared.file(path: workspace.output.path, fileName: "ULTRA-clean.mp4")
+        let values = try? URL(fileURLWithPath: file.path).resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard values?.isRegularFile == true, values?.isSymbolicLink != true,
+              let linkedSize = values?.fileSize, Int64(linkedSize) == size else {
+            TempBox.shared.dispose(file)
+            throw UltraVideoPreparationError.verificationFailed
+        }
+        self.file = file
+        self.size = size
+    }
+
+    deinit { TempBox.shared.dispose(self.file) }
+}
+
+func ultraVideoUploadEnabled(network: Network, peerId: PeerId, mimeType: String, attributes: [TelegramMediaFileAttribute]) -> Bool {
+    return peerId.namespace != Namespaces.Peer.SecretChat && network.ultraSanitizeVideoUploads.with { $0 }
+        && ultraVideoUploadEligible(mimeType: mimeType, attributes: attributes)
+}
+
+func ultraVideoUploadEligible(mimeType: String, attributes: [TelegramMediaFileAttribute]) -> Bool {
+    return mimeType == "video/mp4" && !attributes.contains { attribute in
+        switch attribute { case .Sticker, .Animated: return true; default: return false }
+    }
+}
+
+func ultraThumbnailUploadPrivacy(network: Network, peerId: PeerId) -> AccountImageUploadPrivacy {
+    guard peerId.namespace != Namespaces.Peer.SecretChat else { return .disabled }
+    return network.ultraImageUploadPrivacy.with({ $0.isEnabled }) || network.ultraSanitizeVideoUploads.with({ $0 }) ? .images : .disabled
+}
+
+func ultraFileUploadSource(_ source: MultipartUploadSource, privacy: AccountImageUploadPrivacy, videoPrivacy: Bool, mimeType: String) -> MultipartUploadSource {
+    if videoPrivacy { return .sanitizedVideo(source) }
+    return ultraImageUploadSource(source, privacy: privacy, expectedMimeType: mimeType)
+}
+
+func ultraFileUploadAttributes(_ attributes: [TelegramMediaFileAttribute], mimeType: String, privacy: AccountImageUploadPrivacy, videoPrivacy: Bool) -> [TelegramMediaFileAttribute] {
+    guard videoPrivacy else { return ultraImageUploadFileAttributes(attributes, mimeType: mimeType, privacy: privacy) }
+    return attributes.compactMap { attribute -> TelegramMediaFileAttribute? in
+        switch attribute {
+        case .FileName: return nil
+        case let .Video(duration, size, flags, _, coverTime, _):
+            // Original byte offsets/codec labels no longer describe the exported file.
+            return .Video(duration: duration, size: size, flags: flags, preloadSize: nil, coverTime: coverTime, videoCodec: nil)
+        default: return attribute
+        }
+    } + [.FileName(fileName: "ULTRA-clean.mp4")]
+}
+
+/// Only a verified complete MP4 reaches multipart; failures never expose original bytes.
+func ultraPreparedVideoUpload(postbox: Postbox, source: MultipartUploadSource) -> Signal<UltraPreparedVideoUpload, MultipartUploadError> {
+    guard #available(iOS 26.0, macOS 26.0, *) else { return .fail(.generic) }
+    func resourceInput(_ data: MediaResourceData) -> Signal<UltraVideoUploadInput, MultipartUploadError> {
+        guard data.offset == 0, data.size > 0, data.size <= UltraVideoPreparationPolicy.maximumInputBytes else { return .fail(.generic) }
+        return .single(.file(URL(fileURLWithPath: data.path)))
+    }
+    let input: Signal<UltraVideoUploadInput, MultipartUploadError>
+    switch source {
+    case let .data(data):
+        guard !data.isEmpty, Int64(data.count) <= UltraVideoPreparationPolicy.maximumInputBytes else { return .fail(.generic) }
+        input = .single(.data(data))
+    case let .tempFile(file): input = .single(.file(URL(fileURLWithPath: file.path)))
+    case let .custom(data): input = data |> filter { $0.complete } |> take(1) |> castError(MultipartUploadError.self) |> mapToSignal(resourceInput)
+    case let .resource(reference):
+        input = Signal { subscriber in
+            let disposables = DisposableSet()
+            disposables.add((postbox.mediaBox.resourceData(reference.resource, option: .complete(waitUntilFetchStatus: true))
+            |> filter { $0.complete } |> take(1) |> castError(MultipartUploadError.self) |> mapToSignal(resourceInput)).start(next: subscriber.putNext, error: subscriber.putError, completed: subscriber.putCompletion))
+            disposables.add(fetchedMediaResource(mediaBox: postbox.mediaBox, userLocation: .other, userContentType: .video, reference: reference).start(error: { _ in subscriber.putError(.generic) }))
+            return disposables
+        }
+    case .sanitizedImage, .sanitizedVideo: return .fail(.generic)
+    }
+    return input
+    |> timeout(120.0, queue: .concurrentDefaultQueue(), alternate: .fail(.generic))
+    |> mapToSignal { input -> Signal<UltraPreparedVideoUpload, MultipartUploadError> in
+        return Signal { subscriber in
+            let task = Task { @MainActor in
+                do {
+                    try await UltraVideoPreparationGate.shared.acquire(UUID())
+                    defer { Task { await UltraVideoPreparationGate.shared.release() } }
+                    try Task.checkCancellation()
+                    let copy = Task.detached(priority: .utility) { () throws -> UltraVideoPreparationWorkspace in
+                        let workspace = try UltraVideoPreparationWorkspace()
+                        switch input {
+                        case let .data(data): try workspace.writeInput(data, cancelled: { Task.isCancelled })
+                        case let .file(url): try workspace.copyInput(from: url, cancelled: { Task.isCancelled })
+                        }
+                        try Task.checkCancellation()
+                        return workspace
+                    }
+                    let workspace = try await withTaskCancellationHandler(operation: { try await copy.value }, onCancel: { copy.cancel() })
+                    let size = try await UltraVideoSanitizer.prepare(workspace, preserveDimensions: true)
+                    try Task.checkCancellation()
+                    let prepared = try UltraPreparedVideoUpload(workspace: workspace, size: size)
+                    subscriber.putNext(prepared)
+                    subscriber.putCompletion()
+                } catch { subscriber.putError(.generic) }
+            }
+            return ActionDisposable { withExtendedLifetime(source) { task.cancel() } }
+        }
+    }
+    |> timeout(900.0, queue: .concurrentDefaultQueue(), alternate: .fail(.generic))
+}
