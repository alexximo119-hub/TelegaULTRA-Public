+import Foundation
+
+/// Applies to newly created chat uploads, not existing cloud media or completed transfers.
+public enum AccountImageUploadPrivacy: Int32 {
+    case disabled = 0
+    case images = 1
+
+    public var isEnabled: Bool { return self == .images }
+
+    public func sanitizesDocument(mimeType: String) -> Bool {
+        guard self.isEnabled else { return false }
+        return mimeType == "image/jpeg" || mimeType == "image/png"
+    }
+
+    public func neutralFileName(mimeType: String) -> String? {
+        guard self.sanitizesDocument(mimeType: mimeType) else { return nil }
+        return mimeType == "image/png" ? "ULTRA-clean.png" : "ULTRA-clean.jpg"
+    }
+}
