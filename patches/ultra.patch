+import Foundation
+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraPresenceAndIdentityTests: XCTestCase {
+    func testAutomaticPresencePreservesBothNativeStates() {
+        XCTAssertFalse(AccountPresencePolicy.automatic.resolve(automaticallyOnline: false))
+        XCTAssertTrue(AccountPresencePolicy.automatic.resolve(automaticallyOnline: true))
+    }
+    func testOfflineNeverRequestsOnline() {
+        for native in [false, true] { XCTAssertFalse(AccountPresencePolicy.offline.resolve(automaticallyOnline: native)) }
+    }
+    func testOnlineModeDoesNotMarkSecondaryAccountsOnline() {
+        XCTAssertEqual(AccountPresencePolicy.onlineWhileRunning.forAccount(isPrimary: false), .automatic)
+        XCTAssertEqual(AccountPresencePolicy.onlineWhileRunning.forAccount(isPrimary: true), .onlineWhileRunning)
+        XCTAssertTrue(AccountPresencePolicy.onlineWhileRunning.resolve(automaticallyOnline: false))
+    }
+    func testUnknownFuturePresenceModeDefaultsWithoutLosingOtherSettings() throws {
+        let data = Data("{\"presenceMode\":999,\"confirmCalls\":true}".utf8)
+        let settings = try JSONDecoder().decode(UltraSettings.self, from: data)
+        XCTAssertEqual(settings.presenceMode, .automatic)
+        XCTAssertTrue(settings.confirmCalls)
+    }
+    func testIdentityNormalizesAndRejectsInvalidInput() {
+        XCTAssertEqual(UltraDeviceIdentity.normalized("  My device  "), "My device")
+        XCTAssertNil(UltraDeviceIdentity.normalized("\n "))
+        XCTAssertNil(UltraDeviceIdentity.normalized("Device\nOther"))
+        XCTAssertNil(UltraDeviceIdentity.normalized(String(repeating: "x", count: 65)))
+    }
+    func testIdentityCanBeSavedAndResetWithoutTouchingOtherDefaults() throws {
+        let suite = "ultra-test-\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        defaults.set("keep", forKey: "unrelated")
+        try UltraDeviceIdentity.save(" Custom device ", defaults: defaults)
+        XCTAssertEqual(UltraDeviceIdentity.current(defaults: defaults), "Custom device")
+        XCTAssertThrowsError(try UltraDeviceIdentity.save("bad\u{0}name", defaults: defaults))
+        XCTAssertEqual(UltraDeviceIdentity.current(defaults: defaults), "Custom device")
+        try UltraDeviceIdentity.save("", defaults: defaults)
+        XCTAssertNil(UltraDeviceIdentity.current(defaults: defaults))
+        XCTAssertEqual(defaults.string(forKey: "unrelated"), "keep")
+    }
+}
