diff --git a/Tests/UltraAppStorageTests/UltraAppStorageTests.swift b/Tests/UltraAppStorageTests/UltraAppStorageTests.swift
new file mode 100644
index 00000000..2db2f509
--- /dev/null
+++ b/Tests/UltraAppStorageTests/UltraAppStorageTests.swift
@@ -0,0 +1,42 @@
+import Foundation
+import XCTest
+@testable import UltraStartupPolicy
+
+final class UltraAppStorageTests: XCTestCase {
+    private let sharedURL = URL(fileURLWithPath: "/test/shared")
+    private let localURL = URL(fileURLWithPath: "/test/local")
+
+    func testNewInstallationUsesAvailableAppGroup() throws {
+        let result = try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: nil, allowLocalStorage: true)
+        XCTAssertEqual(result.mode, .shared)
+        XCTAssertEqual(result.url, self.sharedURL)
+    }
+
+    func testMissingGroupRequiresExplicitLocalConsent() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: nil, allowLocalStorage: true)) { error in
+            guard case UltraAppStorageError.localStorageConsentRequired = error else {
+                return XCTFail("Expected local storage consent, got \(error)")
+            }
+        }
+    }
+
+    func testSharedInstallationNeverSilentlySwitchesToEmptyLocalStore() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: "shared", allowLocalStorage: true)) { error in
+            guard case UltraAppStorageError.sharedContainerUnavailable = error else {
+                return XCTFail("Expected unavailable shared storage, got \(error)")
+            }
+        }
+    }
+
+    func testLocalChoiceStaysLocalAfterSigningChanges() throws {
+        let result = try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: "local", allowLocalStorage: true)
+        XCTAssertEqual(result.mode, .local)
+        XCTAssertEqual(result.url, self.localURL)
+    }
+
+    func testInvalidModeAndUnavailableLocalDirectoryFailClosed() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: "unknown", allowLocalStorage: true))
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: nil, savedMode: "local", allowLocalStorage: true))
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: "local", allowLocalStorage: false))
+    }
+}
