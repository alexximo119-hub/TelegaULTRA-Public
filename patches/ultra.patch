+        settings.ignoreIOSRestrictions = true
+        settings.uploadMode = .six
+        settings.saveViewOnceMedia = true
+        settings.sanitizeUploadedImages = true
+        settings.sanitizeUploadedVideos = true
+        let encoded = try JSONEncoder().encode(settings)
+        XCTAssertEqual(try JSONDecoder().decode(UltraSettings.self, from: encoded), settings)
+    }
+
+    func testWireKeysRemainCompatible() throws {
+        let encoded = try JSONEncoder().encode(UltraSettings())
+        let object = try XCTUnwrap(JSONSerialization.jsonObject(with: encoded) as? [String: Any])
+        let expected: Set<String> = [
+            "showCharacterCount", "hideTyping", "hideRecording", "rearCamera",
+            "hideGalleryCamera", "highQualityPhotos", "confirmCalls", "disableCameraSwipe",
+            "showPeerId", "showAvatarDatacenter", "showMessageSeconds", "showFullViewCounts", "showMutualContact",
+            "doubleTapToEdit", "alwaysShowTranslate", "hideBusinessBot", "hideSponsoredMessages", "revealTextSpoilers", "presenceMode", "highQualityVideos", "revealMediaSpoilers", "showAvatarOnline", "showFormattingToolbar", "showChatDates", "showRegistrationMonth", "ignoreIOSRestrictions", "uploadMode", "saveViewOnceMedia", "sanitizeUploadedImages"
+        ]
+        XCTAssertEqual(Set(object.keys), expected)
+        XCTAssertEqual(object["presenceMode"] as? Int, 0)
