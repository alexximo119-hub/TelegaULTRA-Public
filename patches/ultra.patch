+import UIKit
+
+final class UltraStartupFailureViewController: UIViewController {
+    private let message: String
+    private let diagnosticCode: String
+    private let enableLocalStorage: (() -> Void)?
+    private let diagnostics: String?
+    private let messageLabel = UILabel()
+    private let continueButton = UIButton(type: .system)
+
+    init(message: String, diagnosticCode: String, enableLocalStorage: (() -> Void)? = nil, diagnostics: String? = nil) {
+        self.message = message
+        self.diagnosticCode = diagnosticCode
+        self.enableLocalStorage = enableLocalStorage
+        self.diagnostics = diagnostics
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        let titleLabel = UILabel()
+        titleLabel.text = "ULTRA: запуск приостановлен"
+        titleLabel.font = .preferredFont(forTextStyle: .title2)
+        titleLabel.adjustsFontForContentSizeCategory = true
+        titleLabel.numberOfLines = 0
+        titleLabel.accessibilityTraits = .header
+
+        self.messageLabel.text = self.message
+        self.messageLabel.font = .preferredFont(forTextStyle: .body)
+        self.messageLabel.adjustsFontForContentSizeCategory = true
+        self.messageLabel.numberOfLines = 0
+
+        let diagnosticLabel = UILabel()
+        let bundleId = Bundle.main.bundleIdentifier ?? "unknown"
+        let build = Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "unknown"
+        diagnosticLabel.text = "Код: \(self.diagnosticCode)\n\(bundleId) · сборка \(build)"
+        diagnosticLabel.font = .preferredFont(forTextStyle: .caption1)
+        diagnosticLabel.adjustsFontForContentSizeCategory = true
+        diagnosticLabel.textColor = .secondaryLabel
+        diagnosticLabel.numberOfLines = 0
+
+        self.continueButton.setTitle("Использовать локальное хранилище", for: .normal)
+        self.continueButton.titleLabel?.numberOfLines = 0
+        self.continueButton.addTarget(self, action: #selector(self.chooseLocalStorage), for: .touchUpInside)
+        self.continueButton.isHidden = self.enableLocalStorage == nil
+
+        let stack = UIStackView(arrangedSubviews: [titleLabel, self.messageLabel, self.continueButton, diagnosticLabel])
+        if self.diagnostics != nil {
+            let copy = UIButton(type: .system)
+            copy.setTitle("Скопировать диагностику", for: .normal)
+            copy.addTarget(self, action: #selector(self.copyDiagnostics), for: .touchUpInside)
+            stack.addArrangedSubview(copy)
+        }
+        stack.axis = .vertical
+        stack.spacing = 20.0
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        let scrollView = UIScrollView()
+        scrollView.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(scrollView)
+        scrollView.addSubview(stack)
+        NSLayoutConstraint.activate([
+            scrollView.leadingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.leadingAnchor),
+            scrollView.trailingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.trailingAnchor),
+            scrollView.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor),
+            scrollView.bottomAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.bottomAnchor),
+            stack.leadingAnchor.constraint(equalTo: scrollView.contentLayoutGuide.leadingAnchor, constant: 24.0),
+            stack.trailingAnchor.constraint(equalTo: scrollView.contentLayoutGuide.trailingAnchor, constant: -24.0),
+            stack.topAnchor.constraint(equalTo: scrollView.contentLayoutGuide.topAnchor, constant: 32.0),
+            stack.bottomAnchor.constraint(equalTo: scrollView.contentLayoutGuide.bottomAnchor, constant: -32.0),
+            stack.widthAnchor.constraint(equalTo: scrollView.frameLayoutGuide.widthAnchor, constant: -48.0)
+        ])
+    }
+
+    @objc private func chooseLocalStorage() {
+        self.enableLocalStorage?()
+        self.continueButton.isHidden = true
+        self.messageLabel.text = "Локальное хранилище выбрано. Полностью закройте ULTRA через переключатель приложений и откройте снова. Существующие данные не удалены и не перенесены."
+    }
+
+    @objc private func copyDiagnostics() {
+        UIPasteboard.general.string = self.diagnostics
+    }
+}
