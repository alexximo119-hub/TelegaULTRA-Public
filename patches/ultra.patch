+import Foundation
+
+public enum UltraInteractionPolicy {
+    public static func shouldRevealMediaSpoiler(enabled: Bool, isSecretMedia: Bool, hasPaidMedia: Bool, isSensitive: Bool) -> Bool {
+        return enabled && !isSecretMedia && !hasPaidMedia && !isSensitive
+    }
+
+    public static func shouldOfferTranslation(normallyAvailable: Bool, force: Bool, hasText: Bool, serviceAvailable: Bool, isSecretChat: Bool) -> Bool {
+        guard hasText && !isSecretChat else { return false }
+        return force ? serviceAvailable : normallyAvailable
+    }
+
+    public static func shouldEditOnDoubleTap(enabled: Bool, isOwnMessage: Bool, canEdit: Bool, hasSelection: Bool, isPinnedView: Bool, isMigrated: Bool) -> Bool {
+        return enabled && isOwnMessage && canEdit && !hasSelection && !isPinnedView && !isMigrated
+    }
+}
