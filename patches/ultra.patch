@@ -0,0 +1,23 @@
+import Foundation
+import CryptoKit
+
+enum UltraLocalHistoryCipher {
+    static func seal(_ contents: UltraLocalHistoryContents, key: SymmetricKey) throws -> Data {
+        guard contents.version == 1 else { throw CocoaError(.fileWriteInapplicableStringEncoding) }
+        let plain = try JSONEncoder().encode(contents)
+        guard plain.count <= 4 * 1024 * 1024,
+              let sealed = try AES.GCM.seal(plain, using: key).combined else { throw CocoaError(.fileWriteUnknown) }
+        return sealed
+    }
+
+    static func open(_ sealed: Data, key: SymmetricKey) throws -> UltraLocalHistoryContents {
+        guard sealed.count >= 28, sealed.count <= 4 * 1024 * 1024 + 28 else { throw CocoaError(.fileReadCorruptFile) }
+        let plain = try AES.GCM.open(AES.GCM.SealedBox(combined: sealed), using: key)
+        let contents = try JSONDecoder().decode(UltraLocalHistoryContents.self, from: plain)
+        guard contents.version == 1, contents.records.count <= 1000,
+              contents.records.allSatisfy({ record in
+                  return record.text.utf8.count <= 16 * 1024 && (record.spans == nil || record.spans == record.validatedSpans)
+              }) else { throw CocoaError(.fileReadCorruptFile) }
+        return contents
+    }
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Messages/UltraLocalHistoryModels.swift b/submodules/TelegramCore/Sources/TelegramEngine/Messages/UltraLocalHistoryModels.swift
