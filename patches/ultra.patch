@@ -0,0 +1,160 @@
+import Foundation
+import CryptoKit
+import Postbox
+import SwiftSignalKit
+import MtProtoKit
+internal import TelegramApi
+
+private final class UltraImportMemoryKeychain {
+    private let lock = NSLock()
+    private var entries: [String: Data]
+    private var closed = false
+
+    init(candidate: UltraSessionImportData) throws {
+        let digest = Array(Insecure.SHA1.hash(data: candidate.authKey).suffix(8))
+        var fingerprint: UInt64 = 0
+        for (index, byte) in digest.enumerated() { fingerprint |= UInt64(byte) << (index * 8) }
+        guard let info = MTDatacenterAuthInfo(authKey: candidate.authKey, authKeyId: Int64(bitPattern: fingerprint), validUntilTimestamp: Int32.max, saltSet: [], authKeyAttributes: [:]) else {
+            throw UltraSessionImportError.invalidKey
+        }
+        let dictionary = NSDictionary(object: info, forKey: NSNumber(value: candidate.datacenterId))
+        self.entries = ["persistent:datacenterAuthInfoById": try NSKeyedArchiver.archivedData(withRootObject: dictionary, requiringSecureCoding: false)]
+    }
+
+    func makeKeychain() -> Keychain {
+        return Keychain(get: { [self] key in
+            self.lock.lock()
+            defer { self.lock.unlock() }
+            return self.entries[key]
+        }, set: { [self] key, value in
+            self.lock.lock()
+            defer { self.lock.unlock() }
+            if !self.closed { self.entries[key] = value }
+        }, remove: { [self] key in
+            self.lock.lock()
+            defer { self.lock.unlock() }
+            self.entries.removeValue(forKey: key)
+        })
+    }
+
+    func clear() {
+        self.lock.lock()
+        self.closed = true
+        self.entries.removeAll()
+        self.lock.unlock()
+    }
+}
+
+private final class UltraImportNetworkLifetime {
+    private let lock = NSLock()
+    private var cancelled = false
+    private var network: Network?
+
+    func install(_ network: Network) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard !self.cancelled else { return false }
+        self.network = network
+        network.shouldKeepConnection.set(.single(true))
+        return true
+    }
+
+    func cancel() {
+        self.lock.lock()
+        self.cancelled = true
+        let network = self.network
+        self.network = nil
+        self.lock.unlock()
+        network?.shouldKeepConnection.set(.single(false))
+    }
+}
+
+private func ultraImportRequestError(_ error: MTRpcError) -> UltraSessionImportError {
+    // Never expose the server's raw description, source credentials or RPC payload to the UI/logs.
+    return error.errorDescription.hasPrefix("FLOOD_WAIT") ? .limitExceeded : .authorizationFailed
+}
+
+private func ultraApproveImportedSession(network: Network, accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount, excludedUserIds: [PeerId.Id], syncContacts: Bool, approved: Bool = false, remainingSteps: Int = 5) -> Signal<ExportAuthTransferTokenResult, UltraSessionImportError> {
+    guard remainingSteps > 0 else { return .fail(.authorizationFailed) }
+    return _internal_exportAuthTransferToken(accountManager: accountManager, account: account, otherAccountUserIds: excludedUserIds, syncContacts: syncContacts)
+    |> mapError { error -> UltraSessionImportError in
+        switch error {
+        case .limitExceeded: return .limitExceeded
+        case .generic: return .authorizationFailed
+        }
+    }
+    |> mapToSignal { result -> Signal<ExportAuthTransferTokenResult, UltraSessionImportError> in
+        switch result {
+        case let .displayToken(token):
+            guard !approved, token.validUntil > Int32(Date().timeIntervalSince1970) else { return .fail(.authorizationFailed) }
+            return network.request(Api.functions.auth.acceptLoginToken(token: Buffer(data: token.value)), automaticFloodWait: false)
+            |> mapError(ultraImportRequestError)
+            |> mapToSignal { _ in
+                return ultraApproveImportedSession(network: network, accountManager: accountManager, account: account, excludedUserIds: excludedUserIds, syncContacts: syncContacts, approved: true, remainingSteps: remainingSteps - 1)
+            }
+        case let .changeAccountAndRetry(updatedAccount):
+            return ultraApproveImportedSession(network: network, accountManager: accountManager, account: updatedAccount, excludedUserIds: excludedUserIds, syncContacts: syncContacts, approved: approved, remainingSteps: remainingSteps - 1)
+        case .loggedIn, .passwordRequested:
+            return .single(result)
+        }
+    }
+}
+
+/// Approves a fresh native login; the imported authorization key is never written to Postbox/Keychain.
+/// Cancellation cannot undo a login already accepted by Telegram. Existing account records are not replaced.
+public func ultraImportOwnSession(accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount, candidate: UltraSessionImportData, excludedUserIds: [PeerId.Id], syncContacts: Bool) -> Signal<ExportAuthTransferTokenResult, UltraSessionImportError> {
+    guard candidate.testingEnvironment == account.testingEnvironment else { return .fail(.environmentMismatch) }
+    return Signal { subscriber in
+        let storage: UltraImportMemoryKeychain
+        let directory = URL(fileURLWithPath: NSTemporaryDirectory(), isDirectory: true).appendingPathComponent("ULTRA-Import-\(UUID().uuidString)", isDirectory: true)
+        do {
+            storage = try UltraImportMemoryKeychain(candidate: candidate)
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        } catch {
+            subscriber.putError(.fileUnavailable)
+            return EmptyDisposable
+        }
+        let sourceArguments = account.networkArguments
+        // No cloud sync, telemetry or external engine factory for the transient source session.
+        let arguments = NetworkInitializationArguments(apiId: sourceArguments.apiId, apiHash: sourceArguments.apiHash, languagesCategory: sourceArguments.languagesCategory, appVersion: sourceArguments.appVersion, voipMaxLayer: sourceArguments.voipMaxLayer, voipVersions: sourceArguments.voipVersions, appData: sourceArguments.appData, externalRequestVerificationStream: sourceArguments.externalRequestVerificationStream, externalRecaptchaRequestVerification: sourceArguments.externalRecaptchaRequestVerification, autolockDeadine: sourceArguments.autolockDeadine, encryptionProvider: sourceArguments.encryptionProvider, deviceModelName: sourceArguments.deviceModelName, useBetaFeatures: sourceArguments.useBetaFeatures, isICloudEnabled: false, networkEngineFactory: nil)
+        let lifetime = UltraImportNetworkLifetime()
+        let signal = accountManager.transaction { transaction -> (LocalizationSettings?, ProxySettings?, NetworkEngineInputs) in
+            return (transaction.getSharedData(SharedDataKeys.localizationSettings)?.get(LocalizationSettings.self), transaction.getSharedData(SharedDataKeys.proxySettings)?.get(ProxySettings.self), networkEngineInputs(transaction: transaction))
+        }
+        |> mapToSignal { localization, proxy, engine in
+            return initializedNetwork(accountId: account.id, arguments: arguments, supplementary: true, datacenterId: Int(candidate.datacenterId), keychain: storage.makeKeychain(), basePath: directory.path, testingEnvironment: candidate.testingEnvironment, languageCode: localization?.primaryComponent.languageCode, proxySettings: proxy, networkSettings: nil, networkEngine: engine, phoneNumber: nil, useRequestTimeoutTimers: true, appConfiguration: .defaultValue)
+        }
+        |> castError(UltraSessionImportError.self)
+        |> mapToSignal { network -> Signal<ExportAuthTransferTokenResult, UltraSessionImportError> in
+            guard lifetime.install(network) else { return .complete() }
+            return network.request(Api.functions.users.getUsers(id: [.inputUserSelf]), automaticFloodWait: false)
+            |> mapError(ultraImportRequestError)
+            |> mapToSignal { users -> Signal<ExportAuthTransferTokenResult, UltraSessionImportError> in
+                guard users.count == 1, let apiUser = users.first, case .user = apiUser else { return .fail(.authorizationFailed) }
+                let user = TelegramUser(user: apiUser)
+                guard user.botInfo == nil else { return .fail(.botAccount) }
+                let userId = user.id.id._internalGetInt64Value()
+                return accountManager.transaction { transaction -> Set<Int64> in
+                    return ultraExistingAccountUserIds(transaction: transaction, testingEnvironment: account.testingEnvironment, excluding: account.id).union(excludedUserIds.map { $0._internalGetInt64Value() })
+                }
+                |> castError(UltraSessionImportError.self)
+                |> mapToSignal { existingIds in
+                    do {
+                        try candidate.validateServerUserId(userId, alreadyAdded: Array(existingIds))
+                    } catch {
+                        return .fail(error as? UltraSessionImportError ?? .authorizationFailed)
+                    }
+                    return ultraApproveImportedSession(network: network, accountManager: accountManager, account: account, excludedUserIds: existingIds.map { PeerId.Id._internalFromInt64Value($0) }, syncContacts: syncContacts)
+                }
+            }
+        }
+        |> timeout(60.0, queue: .concurrentDefaultQueue(), alternate: .fail(.timedOut))
+        let disposable = signal.start(next: { subscriber.putNext($0) }, error: { subscriber.putError($0) }, completed: { subscriber.putCompletion() })
+        return ActionDisposable {
+            disposable.dispose()
+            lifetime.cancel()
+            storage.clear()
+            try? FileManager.default.removeItem(at: directory)
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionImportData.swift b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionImportData.swift
new file mode 100644
index 00000000..d36b1a0d
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionImportData.swift
@@ -0,0 +1,158 @@
+import Foundation
+
+public enum UltraSessionImportError: Error, Equatable {
+    case invalidFormat
+    case unsupportedFormat
+    case invalidDatacenter
+    case environmentMismatch
+    case botAccount
+    case invalidKey
+    case accountMismatch
+    case alreadyAdded
+    case authorizationFailed
+    case limitExceeded
+    case timedOut
+    case fileUnavailable
+    case unsupportedProtection
+    case invalidPasscodeOrData
+}
+
+/// Deliberately not Codable: imported credentials must never become account attributes or logs.
+public final class UltraSessionImportData: CustomStringConvertible, CustomDebugStringConvertible, CustomReflectable {
+    public enum Format: String {
+        case telethonString = "Telethon StringSession v1"
+        case pyrogramString = "Pyrogram StringSession"
+        case authKey = "auth_key"
+        case telethonFile = "Telethon .session"
+        case pyrogramFile = "Pyrogram .session"
+        case tdata = "Telegram Desktop TData"
+    }
+
+    public let format: Format
+    public let datacenterId: Int32
+    public let testingEnvironment: Bool
+    public let claimedUserId: Int64?
+    let authKey: Data
+
+    init(format: Format, datacenterId: Int32, testingEnvironment: Bool, claimedUserId: Int64?, authKey: Data) throws {
+        guard (testingEnvironment ? 1 ... 3 : 1 ... 5).contains(Int(datacenterId)) else {
+            throw UltraSessionImportError.invalidDatacenter
+        }
+        guard authKey.count == 256, authKey.contains(where: { $0 != 0 }) else {
+            throw UltraSessionImportError.invalidKey
+        }
+        if let claimedUserId = claimedUserId, claimedUserId <= 0 {
+            throw UltraSessionImportError.invalidFormat
+        }
+        self.format = format
+        self.datacenterId = datacenterId
+        self.testingEnvironment = testingEnvironment
+        self.claimedUserId = claimedUserId
+        self.authKey = authKey
+    }
+
+    public var description: String { return "UltraSessionImportData(<redacted>)" }
+    public var debugDescription: String { return self.description }
+    public var customMirror: Mirror { return Mirror(self, children: EmptyCollection<(label: String?, value: Any)>()) }
+
+    func validateServerUserId(_ userId: Int64, alreadyAdded: [Int64]) throws {
+        guard userId > 0 else { throw UltraSessionImportError.authorizationFailed }
+        if let claimedUserId = self.claimedUserId, claimedUserId != userId { throw UltraSessionImportError.accountMismatch }
+        guard !alreadyAdded.contains(userId) else { throw UltraSessionImportError.alreadyAdded }
+    }
+
+    public static func parseAuthKey(_ text: String, datacenterId: Int32, testingEnvironment: Bool) throws -> UltraSessionImportData {
+        guard text.utf8.count <= 4096 else { throw UltraSessionImportError.invalidFormat }
+        let value = Array(text.trimmingCharacters(in: .whitespacesAndNewlines).utf8)
+        guard value.count == 512 else { throw UltraSessionImportError.invalidKey }
+        func nibble(_ character: UInt8) -> UInt8? {
+            switch character {
+            case 48 ... 57: return character - 48
+            case 65 ... 70: return character - 65 + 10
+            case 97 ... 102: return character - 97 + 10
+            default: return nil
+            }
+        }
+        var bytes = Data(capacity: 256)
+        for index in stride(from: 0, to: value.count, by: 2) {
+            guard let high = nibble(value[index]), let low = nibble(value[index + 1]) else {
+                throw UltraSessionImportError.invalidKey
+            }
+            bytes.append(high << 4 | low)
+        }
+        return try UltraSessionImportData(format: .authKey, datacenterId: datacenterId, testingEnvironment: testingEnvironment, claimedUserId: nil, authKey: bytes)
+    }
+
+    public static func parseStringSession(_ text: String, testingEnvironment: Bool) throws -> UltraSessionImportData {
+        guard text.utf8.count <= 4096 else { throw UltraSessionImportError.invalidFormat }
+        let value = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        // Telethon v1 uses a version byte outside its URL-safe Base64 payload.
+        if (value.utf8.count == 353 || value.utf8.count == 369), value.first == "1" {
+            let bytes = try self.decodeBase64URL(String(value.dropFirst()))
+            guard bytes.count == 263 || bytes.count == 275 else { throw UltraSessionImportError.invalidFormat }
+            let addressLength = bytes.count == 263 ? 4 : 16
+            let portOffset = 1 + addressLength
+            guard bytes[portOffset] != 0 || bytes[portOffset + 1] != 0 else { throw UltraSessionImportError.invalidFormat }
+            // Addresses in the file are never used as connection endpoints.
+            return try UltraSessionImportData(format: .telethonString, datacenterId: Int32(bytes[0]), testingEnvironment: testingEnvironment, claimedUserId: nil, authKey: Data(bytes.suffix(256)))
+        }
+
+        let bytes = try self.decodeBase64URL(value)
+        let testOffset: Int
+        let keyOffset: Int
+        let userIdWidth: Int
+        switch bytes.count {
+        case 271:
+            testOffset = 5
+            keyOffset = 6
+            userIdWidth = 8
+            let apiId = self.readUnsigned(bytes, offset: 1, count: 4)
+            guard apiId > 0, apiId <= UInt64(Int32.max) else { throw UltraSessionImportError.invalidFormat }
+        case 263:
+            testOffset = 1
+            keyOffset = 2
+            userIdWidth = 4
+        case 267:
+            testOffset = 1
+            keyOffset = 2
+            userIdWidth = 8
+        default:
+            throw UltraSessionImportError.unsupportedFormat
+        }
+        guard bytes[testOffset] <= 1, bytes.last == 0 || bytes.last == 1 else { throw UltraSessionImportError.invalidFormat }
+        guard bytes.last == 0 else { throw UltraSessionImportError.botAccount }
+        guard (bytes[testOffset] == 1) == testingEnvironment else { throw UltraSessionImportError.environmentMismatch }
+        let userId = self.readUnsigned(bytes, offset: keyOffset + 256, count: userIdWidth)
+        guard userId > 0, userId <= UInt64(Int64.max) else { throw UltraSessionImportError.invalidFormat }
+        return try UltraSessionImportData(format: .pyrogramString, datacenterId: Int32(bytes[0]), testingEnvironment: testingEnvironment, claimedUserId: Int64(userId), authKey: Data(bytes[keyOffset ..< keyOffset + 256]))
+    }
+
+    private static func readUnsigned(_ bytes: [UInt8], offset: Int, count: Int) -> UInt64 {
+        var value: UInt64 = 0
+        for index in offset ..< offset + count { value = value << 8 | UInt64(bytes[index]) }
+        return value
+    }
+
+    private static func decodeBase64URL(_ value: String) throws -> [UInt8] {
+        let characters = Array(value.utf8)
+        guard !characters.isEmpty, characters.count <= 1024 else { throw UltraSessionImportError.invalidFormat }
+        var sawPadding = false
+        for character in characters {
+            switch character {
+            case 65 ... 90, 97 ... 122, 48 ... 57, 45, 95:
+                guard !sawPadding else { throw UltraSessionImportError.invalidFormat }
+            case 61: sawPadding = true
+            default: throw UltraSessionImportError.invalidFormat
+            }
+        }
+        let unpadded = value.replacingOccurrences(of: "=", with: "")
+        guard unpadded.utf8.count % 4 != 1 else { throw UltraSessionImportError.invalidFormat }
+        let padding = String(repeating: "=", count: (4 - unpadded.utf8.count % 4) % 4)
+        guard value == unpadded || value == unpadded + padding else { throw UltraSessionImportError.invalidFormat }
+        let standard = (unpadded + padding).replacingOccurrences(of: "-", with: "+").replacingOccurrences(of: "_", with: "/")
+        guard let data = Data(base64Encoded: standard) else { throw UltraSessionImportError.invalidFormat }
+        let canonical = data.base64EncodedString().replacingOccurrences(of: "+", with: "-").replacingOccurrences(of: "/", with: "_")
+        guard canonical == unpadded + padding else { throw UltraSessionImportError.invalidFormat }
+        return Array(data)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionSQLiteReader.swift b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionSQLiteReader.swift
new file mode 100644
index 00000000..f9c44d9c
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraSessionSQLiteReader.swift
@@ -0,0 +1,155 @@
+import Foundation
+#if canImport(sqlcipher)
+import sqlcipher
+#else
+import SQLite3
+#endif
+
+/// Reads a bounded, closed SQLite export in memory. No source-file writes, migrations or sidecars.
+public enum UltraSessionSQLiteReader {
+    public static let maximumBytes = 16 * 1024 * 1024
+
+    public static func read(at url: URL, testingEnvironment: Bool) throws -> UltraSessionImportData {
+        do {
+            guard url.isFileURL, url.pathExtension.lowercased() == "session" else { throw UltraSessionImportError.unsupportedFormat }
+            let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+            guard values.isRegularFile == true, values.isSymbolicLink != true,
+                  let size = values.fileSize, size >= 100, size <= self.maximumBytes else { throw UltraSessionImportError.fileUnavailable }
+            let handle = try FileHandle(forReadingFrom: url)
+            defer { try? handle.close() }
+            var data = Data()
+            defer { data.resetBytes(in: 0 ..< data.count) }
+            while data.count <= self.maximumBytes {
+                let chunk = try handle.read(upToCount: min(65536, self.maximumBytes + 1 - data.count)) ?? Data()
+                if chunk.isEmpty { break }
+                data.append(chunk)
+            }
+            return try self.parse(data, testingEnvironment: testingEnvironment)
+        } catch let error as UltraSessionImportError {
+            throw error
+        } catch {
+            throw UltraSessionImportError.fileUnavailable
+        }
+    }
+
+    static func parse(_ input: Data, testingEnvironment: Bool) throws -> UltraSessionImportData {
+        guard input.count >= 100, input.count <= self.maximumBytes,
+              input.starts(with: Array("SQLite format 3\0".utf8)) else { throw UltraSessionImportError.invalidFormat }
+        // An isolated WAL database is not a complete export. Require a checkpointed, closed source.
+        guard input[input.startIndex + 18] == 1, input[input.startIndex + 19] == 1 else { throw UltraSessionImportError.unsupportedFormat }
+        var image = input
+        defer { image.resetBytes(in: 0 ..< image.count) }
+        return try image.withUnsafeMutableBytes { (bytes: UnsafeMutableRawBufferPointer) throws -> UltraSessionImportData in
+            guard let address = bytes.baseAddress?.assumingMemoryBound(to: UInt8.self) else { throw UltraSessionImportError.invalidFormat }
+            var database: OpaquePointer?
+            guard sqlite3_open_v2(":memory:", &database, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_NOMUTEX, nil) == SQLITE_OK,
+                  let database = database else {
+                sqlite3_close(database)
+                throw UltraSessionImportError.fileUnavailable
+            }
+            defer { sqlite3_close(database) }
+            guard sqlite3_deserialize(database, "main", address, Int64(bytes.count), Int64(bytes.count), UInt32(SQLITE_DESERIALIZE_READONLY)) == SQLITE_OK else { throw UltraSessionImportError.invalidFormat }
+            sqlite3_limit(database, SQLITE_LIMIT_LENGTH, 1024 * 1024)
+            sqlite3_limit(database, SQLITE_LIMIT_SQL_LENGTH, 4096)
+            sqlite3_limit(database, SQLITE_LIMIT_COLUMN, 32)
+            sqlite3_limit(database, SQLITE_LIMIT_EXPR_DEPTH, 16)
+            sqlite3_limit(database, SQLITE_LIMIT_COMPOUND_SELECT, 2)
+            sqlite3_limit(database, SQLITE_LIMIT_VDBE_OP, 10000)
+            sqlite3_limit(database, SQLITE_LIMIT_ATTACHED, 0)
+            guard sqlite3_exec(database, "PRAGMA trusted_schema=OFF; PRAGMA query_only=ON; PRAGMA temp_store=MEMORY; PRAGMA cache_size=-1024", nil, nil, nil) == SQLITE_OK else { throw UltraSessionImportError.invalidFormat }
+            try self.requireOrdinaryTable(database, name: "sessions")
+            try self.requireOrdinaryTable(database, name: "version")
+            let columns = try self.withStatement(database, sql: "PRAGMA table_info(sessions)") { statement -> Set<String> in
+                var result = Set<String>()
+                var status = sqlite3_step(statement)
+                while status == SQLITE_ROW {
+                    guard result.count < 16 else { throw UltraSessionImportError.invalidFormat }
+                    result.insert(try self.text(statement, column: 1))
+                    status = sqlite3_step(statement)
+                }
+                guard status == SQLITE_DONE else { throw UltraSessionImportError.invalidFormat }
+                return result
+            }
+            if columns.isSuperset(of: ["dc_id", "server_address", "port", "auth_key"]),
+               columns.isSubset(of: ["dc_id", "server_address", "port", "auth_key", "takeout_id", "tmp_auth_key"]) {
+                try self.requireVersion(database, sql: "SELECT version FROM version LIMIT 2", allowed: 1 ... 8)
+                return try self.withStatement(database, sql: "SELECT dc_id, port, server_address, auth_key FROM sessions LIMIT 2") { statement in
+                    guard sqlite3_step(statement) == SQLITE_ROW else { throw UltraSessionImportError.invalidFormat }
+                    let dc = try self.integer(statement, column: 0)
+                    let port = try self.integer(statement, column: 1)
+                    guard dc >= 1, dc <= 5, port > 0, port <= 65535, !(try self.text(statement, column: 2)).isEmpty else { throw UltraSessionImportError.invalidFormat }
+                    let key = try self.key(statement, column: 3)
+                    guard sqlite3_step(statement) == SQLITE_DONE else { throw UltraSessionImportError.invalidFormat }
+                    return try UltraSessionImportData(format: .telethonFile, datacenterId: Int32(dc), testingEnvironment: testingEnvironment, claimedUserId: nil, authKey: key)
+                }
+            } else if columns.isSuperset(of: ["dc_id", "test_mode", "auth_key", "date", "user_id", "is_bot"]),
+                      columns.isSubset(of: ["dc_id", "api_id", "test_mode", "auth_key", "date", "user_id", "is_bot"]) {
+                try self.requireVersion(database, sql: "SELECT number FROM version LIMIT 2", allowed: 1 ... 3)
+                return try self.withStatement(database, sql: "SELECT dc_id, test_mode, auth_key, user_id, is_bot FROM sessions LIMIT 2") { statement in
+                    guard sqlite3_step(statement) == SQLITE_ROW else { throw UltraSessionImportError.invalidFormat }
+                    let dc = try self.integer(statement, column: 0)
+                    let test = try self.integer(statement, column: 1)
+                    let userId = try self.integer(statement, column: 3)
+                    let bot = try self.integer(statement, column: 4)
+                    guard dc >= 1, dc <= 5, test == 0 || test == 1, bot == 0 || bot == 1 else { throw UltraSessionImportError.invalidFormat }
+                    guard bot == 0 else { throw UltraSessionImportError.botAccount }
+                    guard (test == 1) == testingEnvironment else { throw UltraSessionImportError.environmentMismatch }
+                    let key = try self.key(statement, column: 2)
+                    guard sqlite3_step(statement) == SQLITE_DONE else { throw UltraSessionImportError.invalidFormat }
+                    return try UltraSessionImportData(format: .pyrogramFile, datacenterId: Int32(dc), testingEnvironment: testingEnvironment, claimedUserId: userId, authKey: key)
+                }
+            } else {
+                throw UltraSessionImportError.unsupportedFormat
+            }
+        }
+    }
+
+    private static func requireOrdinaryTable(_ database: OpaquePointer, name: String) throws {
+        // Only the two fixed names above are passed; bind even those instead of building SQL.
+        try self.withStatement(database, sql: "SELECT type, sql FROM sqlite_master WHERE name=? LIMIT 2") { statement in
+            guard name.withCString({ sqlite3_bind_text(statement, 1, $0, -1, unsafeBitCast(-1, to: sqlite3_destructor_type.self)) }) == SQLITE_OK,
+                  sqlite3_step(statement) == SQLITE_ROW,
+                  try self.text(statement, column: 0) == "table",
+                  try self.text(statement, column: 1).trimmingCharacters(in: .whitespacesAndNewlines).lowercased().hasPrefix("create table"),
+                  sqlite3_step(statement) == SQLITE_DONE else { throw UltraSessionImportError.invalidFormat }
+        }
+    }
+
+    private static func requireVersion(_ database: OpaquePointer, sql: String, allowed: ClosedRange<Int64>) throws {
+        try self.withStatement(database, sql: sql) { statement in
+            guard sqlite3_step(statement) == SQLITE_ROW,
+                  allowed.contains(try self.integer(statement, column: 0)),
+                  sqlite3_step(statement) == SQLITE_DONE else { throw UltraSessionImportError.unsupportedFormat }
+        }
+    }
+
+    private static func withStatement<T>(_ database: OpaquePointer, sql: String, body: (OpaquePointer) throws -> T) throws -> T {
+        var statement: OpaquePointer?
+        guard sqlite3_prepare_v2(database, sql, -1, &statement, nil) == SQLITE_OK, let statement = statement else {
+            sqlite3_finalize(statement)
+            throw UltraSessionImportError.invalidFormat
+        }
+        defer { sqlite3_finalize(statement) }
+        guard sqlite3_stmt_readonly(statement) != 0 else { throw UltraSessionImportError.invalidFormat }
+        return try body(statement)
+    }
+
+    private static func integer(_ statement: OpaquePointer, column: Int32) throws -> Int64 {
+        guard sqlite3_column_type(statement, column) == SQLITE_INTEGER else { throw UltraSessionImportError.invalidFormat }
+        return sqlite3_column_int64(statement, column)
+    }
+
+    private static func text(_ statement: OpaquePointer, column: Int32) throws -> String {
+        guard sqlite3_column_type(statement, column) == SQLITE_TEXT,
+              sqlite3_column_bytes(statement, column) <= 4096,
+              let value = sqlite3_column_text(statement, column),
+              let text = String(data: Data(bytes: value, count: Int(sqlite3_column_bytes(statement, column))), encoding: .utf8) else { throw UltraSessionImportError.invalidFormat }
+        return text
+    }
+
+    private static func key(_ statement: OpaquePointer, column: Int32) throws -> Data {
+        guard sqlite3_column_type(statement, column) == SQLITE_BLOB, sqlite3_column_bytes(statement, column) == 256,
+              let bytes = sqlite3_column_blob(statement, column) else { throw UltraSessionImportError.invalidKey }
+        return Data(bytes: bytes, count: 256)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraTDataFormat.swift b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraTDataFormat.swift
new file mode 100644
index 00000000..357bedb3
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraTDataFormat.swift
@@ -0,0 +1,202 @@
+import Foundation
+import CryptoKit
+import CommonCrypto
+
+/// Read-only subset of the default Telegram Desktop store. Not a migration or a Desktop runtime.
+/// Wire layout verified against tdesktop 7381fb1df75d863eb3463fdddef57a2ac51f1d56.
+enum UltraTDataFormat {
+    static let maximumFileBytes = 1024 * 1024
+    typealias Decrypt = (_ ciphertext: Data, _ key: Data, _ iv: Data) -> Data?
+
+    private struct Reader {
+        let data: Data
+        var offset = 0
+        var remaining: Int { return self.data.count - self.offset }
+
+        mutating func bytes(_ count: Int) throws -> Data {
+            guard count >= 0, count <= self.remaining else { throw UltraSessionImportError.invalidFormat }
+            let start = self.data.startIndex + self.offset
+            self.offset += count
+            return Data(self.data[start ..< start + count])
+        }
+        mutating func number(_ count: Int = 4, littleEndian: Bool = false) throws -> UInt64 {
+            let bytes = try self.bytes(count)
+            var value: UInt64 = 0
+            for byte in (littleEndian ? Array(bytes.reversed()) : Array(bytes)) { value = value << 8 | UInt64(byte) }
+            return value
+        }
+        mutating func byteArray() throws -> Data {
+            let count = try self.number()
+            if count == UInt64(UInt32.max) { return Data() } // Qt null QByteArray.
+            guard count <= UInt64(UltraTDataFormat.maximumFileBytes) else { throw UltraSessionImportError.invalidFormat }
+            return try self.bytes(Int(count))
+        }
+    }
+
+    static func envelope(_ file: Data) throws -> Data {
+        guard file.count >= 24, file.count <= self.maximumFileBytes, file.starts(with: Array("TDF$".utf8)) else { throw UltraSessionImportError.invalidFormat }
+        var reader = Reader(data: file)
+        _ = try reader.bytes(4)
+        let version = try reader.bytes(4)
+        var versionReader = Reader(data: version)
+        let numericVersion = try versionReader.number(littleEndian: true)
+        guard numericVersion > 0, numericVersion <= UInt64(Int32.max) else { throw UltraSessionImportError.unsupportedFormat }
+        let payload = try reader.bytes(reader.remaining - 16)
+        let checksum = try reader.bytes(16)
+        var signed = payload
+        let size = UInt32(payload.count)
+        for shift in stride(from: 0, to: 32, by: 8) { signed.append(UInt8(truncatingIfNeeded: size >> shift)) }
+        signed.append(version)
+        signed.append(contentsOf: "TDF$".utf8)
+        guard self.equal(Data(Insecure.MD5.hash(data: signed)), checksum) else { throw UltraSessionImportError.invalidFormat }
+        return payload
+    }
+
+    static func localKey(passcode: Data, salt: Data) throws -> Data {
+        guard passcode.count <= 256, salt.count == 32 else { throw UltraSessionImportError.invalidFormat }
+        var hashed = Data(SHA512.hash(data: salt + passcode + salt))
+        defer { hashed.resetBytes(in: 0 ..< hashed.count) }
+        var result = Data(count: 256)
+        let rounds: UInt32 = passcode.isEmpty ? 1 : 100000
+        let status = hashed.withUnsafeBytes { passwordBytes in
+            salt.withUnsafeBytes { saltBytes in
+                result.withUnsafeMutableBytes { output in
+                    return CCKeyDerivationPBKDF(CCPBKDFAlgorithm(kCCPBKDF2), passwordBytes.baseAddress!.assumingMemoryBound(to: Int8.self), hashed.count,
+                        saltBytes.baseAddress!.assumingMemoryBound(to: UInt8.self), salt.count,
+                        CCPseudoRandomAlgorithm(kCCPRFHmacAlgSHA512), rounds,
+                        output.baseAddress!.assumingMemoryBound(to: UInt8.self), 256)
+                }
+            }
+        }
+        guard status == kCCSuccess else { throw UltraSessionImportError.authorizationFailed }
+        return result
+    }
+
+    static func decrypted(_ encrypted: Data, key: Data, decrypt: Decrypt) throws -> Data {
+        guard key.count == 256, encrypted.count >= 32, encrypted.count <= self.maximumFileBytes,
+              encrypted.count % 16 == 0 else { throw UltraSessionImportError.invalidFormat }
+        let messageKey = Data(encrypted.prefix(16))
+        let keyBytes = Array(key)
+        func part(_ from: Int, _ to: Int) -> Data { return Data(keyBytes[from ..< to]) }
+        let a = Data(Insecure.SHA1.hash(data: messageKey + part(8, 40)))
+        let b = Data(Insecure.SHA1.hash(data: part(40, 56) + messageKey + part(56, 72)))
+        let c = Data(Insecure.SHA1.hash(data: part(72, 104) + messageKey))
+        let d = Data(Insecure.SHA1.hash(data: messageKey + part(104, 136)))
+        let aesKey = Data(a[0 ..< 8]) + Data(b[8 ..< 20]) + Data(c[4 ..< 16])
+        let iv = Data(a[8 ..< 20]) + Data(b[0 ..< 8]) + Data(c[16 ..< 20]) + Data(d[0 ..< 8])
+        guard var plaintext = decrypt(Data(encrypted.dropFirst(16)), aesKey, iv), plaintext.count == encrypted.count - 16 else { throw UltraSessionImportError.invalidPasscodeOrData }
+        defer { plaintext.resetBytes(in: 0 ..< plaintext.count) }
+        guard self.equal(Data(Insecure.SHA1.hash(data: plaintext).prefix(16)), messageKey) else { throw UltraSessionImportError.invalidPasscodeOrData }
+        var reader = Reader(data: plaintext)
+        let count = try reader.number(littleEndian: true)
+        guard count >= 4, count <= UInt64(plaintext.count), UInt64(plaintext.count) - count < 16 else { throw UltraSessionImportError.invalidFormat }
+        return try reader.bytes(Int(count) - 4)
+    }
+
+    static func accountFileName(index: UInt64) throws -> String {
+        guard index < 32 else { throw UltraSessionImportError.invalidFormat }
+        let name = index == 0 ? "data" : "data#\(index + 1)"
+        let digits = Array("0123456789ABCDEF".utf8)
+        var output: [UInt8] = []
+        for byte in Insecure.MD5.hash(data: Data(name.utf8)).prefix(8) {
+            output.append(digits[Int(byte & 15)])
+            output.append(digits[Int(byte >> 4)])
+        }
+        return String(decoding: output, as: UTF8.self) + "s"
+    }
+
+    static func read(passcode: Data, loadFile: (String) throws -> Data, decrypt: Decrypt) throws -> [UltraSessionImportData] {
+        guard passcode.count <= 256 else { throw UltraSessionImportError.invalidFormat }
+        var keyData = Reader(data: try self.envelope(loadFile("key_datas")))
+        let salt = try keyData.byteArray()
+        let encryptedKey = try keyData.byteArray()
+        let encryptedInfo = try keyData.byteArray()
+        guard salt.count == 32, encryptedKey.count == 288 else {
+            if encryptedKey.isEmpty { throw UltraSessionImportError.unsupportedProtection }
+            throw UltraSessionImportError.invalidFormat
+        }
+        if keyData.remaining != 0 {
+            var trailer = Reader(data: try keyData.byteArray())
+            guard keyData.remaining == 0, try trailer.number() == 0x4b443200,
+                  try trailer.number() == 2 else { throw UltraSessionImportError.unsupportedFormat }
+            _ = try trailer.number() // Committed passcode generation, not an allocation size.
+            let wraps = try trailer.number()
+            // Modern Argon2/scrypt app-lock wraps are intentionally not guessed or weakened.
+            guard wraps == 0, passcode.isEmpty else { throw UltraSessionImportError.unsupportedProtection }
+            guard trailer.remaining == 0 else { throw UltraSessionImportError.invalidFormat }
+        }
+        var wrappingKey = try self.localKey(passcode: passcode, salt: salt)
+        defer { wrappingKey.resetBytes(in: 0 ..< wrappingKey.count) }
+        var localKey = try self.decrypted(encryptedKey, key: wrappingKey, decrypt: decrypt)
+        defer { localKey.resetBytes(in: 0 ..< localKey.count) }
+        guard localKey.count == 256 else { throw UltraSessionImportError.invalidFormat }
+        var info = Reader(data: try self.decrypted(encryptedInfo, key: localKey, decrypt: decrypt))
+        let count = try info.number()
+        guard count > 0, count <= 32 else { throw UltraSessionImportError.invalidFormat }
+        var indexes: [UInt64] = []
+        for _ in 0 ..< Int(count) {
+            let index = try info.number()
+            guard index < 32, !indexes.contains(index) else { throw UltraSessionImportError.invalidFormat }
+            indexes.append(index)
+        }
+        if info.remaining == 4 {
+            guard indexes.contains(try info.number()) else { throw UltraSessionImportError.invalidFormat }
+        }
+        guard info.remaining == 0 else { throw UltraSessionImportError.invalidFormat }
+        var result: [UltraSessionImportData] = []
+        for index in indexes {
+            let file = try self.envelope(loadFile(self.accountFileName(index: index)))
+            var fileReader = Reader(data: file)
+            let encrypted = try fileReader.byteArray()
+            guard fileReader.remaining == 0 else { throw UltraSessionImportError.unsupportedFormat }
+            var contents = Reader(data: try self.decrypted(encrypted, key: localKey, decrypt: decrypt))
+            guard try contents.number() == 0x4b else { throw UltraSessionImportError.unsupportedFormat }
+            let authorization = try contents.byteArray()
+            guard contents.remaining == 0 else { throw UltraSessionImportError.unsupportedFormat }
+            result.append(try self.authorization(authorization))
+        }
+        return result
+    }
+
+    private static func authorization(_ data: Data) throws -> UltraSessionImportData {
+        var reader = Reader(data: data)
+        let prefix = try reader.number(8)
+        let userId: UInt64
+        let datacenter: UInt64
+        if prefix == UInt64.max {
+            userId = try reader.number(8)
+            datacenter = try reader.number()
+        } else {
+            userId = prefix >> 32
+            datacenter = prefix & UInt64(UInt32.max)
+            guard userId <= UInt64(Int32.max) else { throw UltraSessionImportError.invalidFormat }
+        }
+        guard userId > 0, userId <= UInt64(Int64.max), datacenter >= 1, datacenter <= 5 else { throw UltraSessionImportError.invalidFormat }
+        let count = try reader.number()
+        guard count > 0, count <= 32 else { throw UltraSessionImportError.invalidFormat }
+        var selected: Data?
+        var datacenters = Set<UInt64>()
+        for _ in 0 ..< Int(count) {
+            let id = try reader.number()
+            let key = try reader.bytes(256)
+            guard datacenters.insert(id).inserted else { throw UltraSessionImportError.invalidFormat }
+            if id == datacenter { selected = key }
+        }
+        let destroying = try reader.number()
+        guard destroying <= 32 else { throw UltraSessionImportError.invalidFormat }
+        for _ in 0 ..< Int(destroying) {
+            _ = try reader.number()
+            let key = try reader.bytes(256)
+            guard key != selected else { throw UltraSessionImportError.invalidKey }
+        }
+        guard reader.remaining == 0, let selected = selected else { throw UltraSessionImportError.invalidFormat }
+        return try UltraSessionImportData(format: .tdata, datacenterId: Int32(datacenter), testingEnvironment: false, claimedUserId: Int64(userId), authKey: selected)
+    }
+
+    private static func equal(_ lhs: Data, _ rhs: Data) -> Bool {
+        guard lhs.count == rhs.count else { return false }
+        var difference: UInt8 = 0
+        for (a, b) in zip(lhs, rhs) { difference |= a ^ b }
+        return difference == 0
+    }
+}
