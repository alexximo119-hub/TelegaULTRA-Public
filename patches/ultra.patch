+++ b/submodules/TelegramUIPreferences/Sources/UltraLocalGiftGalleryStore.swift
@@ -0,0 +1,48 @@
+import Foundation
+import TelegramCore
+
+/// Public gift metadata selected for an explicitly local showcase. No ownership or payment state is modified.
+public enum UltraLocalGiftGalleryStore {
+    public static let limit = 100
+    private static func key(_ accountId: Int64) -> String { return "ultra.localGiftGallery.v1.\(accountId)" }
+    private static func load(accountId: Int64, defaults: UserDefaults) throws -> [StarGift] {
+        guard let data = defaults.data(forKey: self.key(accountId)) else { return [] }
+        guard data.count <= 2 * 1024 * 1024 else { throw CocoaError(.fileReadTooLarge) }
+        let gifts = try JSONDecoder().decode([StarGift].self, from: data)
+        guard gifts.count <= self.limit else { throw CocoaError(.fileReadCorruptFile) }
+        return gifts
+    }
+    public static func current(accountId: Int64, defaults: UserDefaults = .standard) -> [StarGift] {
+        return (try? self.load(accountId: accountId, defaults: defaults)) ?? []
+    }
+    public static func count(accountId: Int64, defaults: UserDefaults = .standard) -> Int {
+        let key = self.key(accountId) + ".count"
+        if let count = defaults.object(forKey: key) as? Int, (0 ... self.limit).contains(count) { return count }
+        let count = self.current(accountId: accountId, defaults: defaults).count
+        defaults.set(count, forKey: key)
+        return count
+    }
+    public static func id(_ gift: StarGift) -> String {
+        switch gift { case let .generic(value): return "generic:\(value.id)"; case let .unique(value): return "unique:\(value.id)" }
+    }
+    public static func add(_ gift: StarGift, accountId: Int64, defaults: UserDefaults = .standard) throws {
+        var gifts = try self.load(accountId: accountId, defaults: defaults)
+        gifts.removeAll(where: { self.id($0) == self.id(gift) })
+        guard gifts.count < self.limit else { throw CocoaError(.fileWriteOutOfSpace) }
+        gifts.insert(gift, at: 0)
+        let data = try JSONEncoder().encode(gifts)
+        guard data.count <= 2 * 1024 * 1024 else { throw CocoaError(.fileWriteOutOfSpace) }
+        defaults.set(data, forKey: self.key(accountId))
+        defaults.set(gifts.count, forKey: self.key(accountId) + ".count")
+    }
+    public static func remove(_ gift: StarGift, accountId: Int64, defaults: UserDefaults = .standard) throws {
+        var gifts = try self.load(accountId: accountId, defaults: defaults)
+        gifts.removeAll(where: { self.id($0) == self.id(gift) })
+        defaults.set(try JSONEncoder().encode(gifts), forKey: self.key(accountId))
+        defaults.set(gifts.count, forKey: self.key(accountId) + ".count")
+    }
+    public static func reset(accountId: Int64, defaults: UserDefaults = .standard) {
+        defaults.removeObject(forKey: self.key(accountId))
+        defaults.removeObject(forKey: self.key(accountId) + ".count")
+    }
+}
