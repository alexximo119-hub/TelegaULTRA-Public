+import XCTest
+import Postbox
+@testable import TelegramCore
+
+final class UltraInputActivityFilterTests: XCTestCase {
+    private let peer = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(12345))
+
+    func testNativeTypingAndBothRecordersAreFilteredBeforeRequests() {
+        let space = PeerActivitySpace(peerId: self.peer, category: .global)
+        let actions: [PeerInputActivity] = [.typingText, .choosingSticker, .recordingVoice, .recordingInstantVideo]
+        let records = actions.enumerated().map { (self.peer, PeerInputActivityRecord(activity: $0.element, updateId: Int32($0.offset))) }
+        let result = ultraFilteredLocalInputActivities([space: records], policy: AccountInputActivityPolicy(hideTyping: true, hideRecording: true))
+        XCTAssertEqual(result[space]?.count, 0)
+    }
+
+    func testHiddenFirstActivityDoesNotHideAnAllowedCallOrUploadBehindIt() {
+        let space = PeerActivitySpace(peerId: self.peer, category: .thread(123))
+        let actions: [PeerInputActivity] = [.typingText, .speakingInGroupCall(timestamp: 123), .uploadingFile(progress: 50)]
+        let records = actions.enumerated().map { (self.peer, PeerInputActivityRecord(activity: $0.element, updateId: Int32($0.offset))) }
+        let result = ultraFilteredLocalInputActivities([space: records], policy: AccountInputActivityPolicy(hideTyping: true, hideRecording: true))
+        XCTAssertEqual(result[space]?.map({ $0.1.activity }), Array(actions.dropFirst()))
+    }
+
+    func testDefaultPolicyPreservesNativePriorityAndUpdateIds() {
+        let space = PeerActivitySpace(peerId: self.peer, category: .global)
+        let records = [(self.peer, PeerInputActivityRecord(activity: .recordingVoice, updateId: 5)), (self.peer, PeerInputActivityRecord(activity: .typingText, updateId: 6))]
+        let result = ultraFilteredLocalInputActivities([space: records], policy: AccountInputActivityPolicy())
+        XCTAssertEqual(result[space]?.map({ $0.1 }), records.map({ $0.1 }))
+    }
+}
