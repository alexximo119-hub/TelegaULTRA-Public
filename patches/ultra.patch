@@ -0,0 +1,106 @@
+import Foundation
+import Photos
+import SwiftSignalKit
+import TelegramCore
+import TelegramUIPreferences
+import AccountContext
+
+/// Observes an existing viewer's resource. It never starts a network fetch or changes consumption/expiry.
+public enum UltraViewOnceMediaSaver {
+    public static func saveAvailable(context: AccountContext, message: EngineMessage) -> Disposable {
+        guard context.sharedContext.immediateExperimentalUISettings.ultra.saveViewOnceMedia else { return EmptyDisposable }
+        let message = message._asMessage()
+        let isViewOnce = message.autoclearAttribute?.timeout == viewOnceTimeout || message.autoremoveAttribute?.timeout == viewOnceTimeout
+        guard UltraViewOnceSavePolicy.isEligible(isViewOnce: isViewOnce, isSecretChat: message.id.peerId.namespace == Namespaces.Peer.SecretChat, hasPaidMedia: message.media.contains(where: { $0 is TelegramMediaPaidContent || $0 is TelegramMediaInvoice }), isSensitive: message.isSensitiveContent(platform: "ios")) else { return EmptyDisposable }
+        var selected: (EngineMediaResource, Bool, String)?
+        for media in message.media {
+            if let image = media as? TelegramMediaImage, let representation = largestImageRepresentation(image.representations) {
+                selected = (EngineMediaResource(representation.resource), false, "jpg")
+                break
+            } else if let file = media as? TelegramMediaFile, file.isVideo {
+                selected = (EngineMediaResource(file.resource), true, file.mimeType == "video/quicktime" ? "mov" : "mp4")
+                break
+            }
+        }
+        guard let selected else { return EmptyDisposable }
+        let operation = UltraViewOnceSaveOperation(context: context, resource: selected.0, isVideo: selected.1, fileExtension: selected.2)
+        Queue.mainQueue().justDispatch { operation.start() }
+        return ActionDisposable { Queue.mainQueue().justDispatch { operation.cancel() } }
+    }
+}
+
+private final class UltraViewOnceSaveOperation {
+    private let context: AccountContext
+    private let resource: EngineMediaResource
+    private let isVideo: Bool
+    private let fileExtension: String
+    private let watching = MetaDisposable()
+    private var file: EngineTempBoxFile?
+    private var awaitingPhotos = false
+    private var finished = false
+
+    init(context: AccountContext, resource: EngineMediaResource, isVideo: Bool, fileExtension: String) {
+        self.context = context
+        self.resource = resource
+        self.isVideo = isVideo
+        self.fileExtension = fileExtension
+    }
+    deinit {
+        self.watching.dispose()
+        if let file = self.file { EngineTempBox.shared.dispose(file) }
+    }
+    func start() {
+        guard !self.finished else { return }
+        self.watching.set((self.context.engine.resources.data(resource: self.resource)
+        |> filter { $0.isComplete }
+        |> take(1)
+        |> map { data -> EngineMediaResource.ResourceData? in return data }
+        |> timeout(20, queue: .mainQueue(), alternate: .single(nil))
+        |> deliverOnMainQueue).start(next: { [weak self] data in self?.prepare(data) }, completed: { [weak self] in
+            guard let self, !self.finished, !self.awaitingPhotos else { return }
+            self.finish(.viewOnceMediaUnavailable)
+        }))
+    }
+    func cancel() {
+        self.watching.set(nil)
+        // Once Photos owns a pending transaction, its hard link must live until that transaction completes.
+        if !self.awaitingPhotos {
+            self.finished = true
+            self.cleanFile()
+        }
+    }
+    private func prepare(_ data: EngineMediaResource.ResourceData?) {
+        guard !self.finished else { return }
+        guard let data, UltraViewOnceSavePolicy.canSaveCompleteData(isComplete: data.isComplete, availableSize: data.availableSize) else {
+            self.finish(.viewOnceMediaUnavailable)
+            return
+        }
+        let file = EngineTempBox.shared.file(path: data.path, fileName: "ULTRA-view-once.\(self.fileExtension)")
+        self.file = file
+        guard FileManager.default.fileExists(atPath: file.path) else { self.finish(.viewOnceMediaUnavailable); return }
+        self.awaitingPhotos = true
+        PHPhotoLibrary.requestAuthorization(for: .addOnly) { status in
+            Queue.mainQueue().async {
+                guard status == .authorized || status == .limited else { self.finish(.viewOnceMediaPermissionDenied); return }
+                PHPhotoLibrary.shared().performChanges({
+                    let options = PHAssetResourceCreationOptions()
+                    options.shouldMoveFile = false
+                    PHAssetCreationRequest.forAsset().addResource(with: self.isVideo ? .video : .photo, fileURL: URL(fileURLWithPath: file.path), options: options)
+                }, completionHandler: { success, _ in
+                    Queue.mainQueue().async { self.finish(success ? .viewOnceMediaSaved : .viewOnceMediaFailed) }
+                })
+            }
+        }
+    }
+    private func finish(_ event: UltraDiagnosticsStore.Event) {
+        guard !self.finished else { return }
+        self.finished = true
+        self.awaitingPhotos = false
+        self.watching.set(nil)
+        UltraDiagnosticsStore.shared.record(event)
+        self.cleanFile()
+    }
+    private func cleanFile() {
+        if let file = self.file { EngineTempBox.shared.dispose(file); self.file = nil }
+    }
+}
