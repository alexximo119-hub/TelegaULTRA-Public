diff --git a/submodules/ChatListUI/Sources/UltraFolderTabsLayout.swift b/submodules/ChatListUI/Sources/UltraFolderTabsLayout.swift
new file mode 100644
index 00000000..0b2027ad
--- /dev/null
+++ b/submodules/ChatListUI/Sources/UltraFolderTabsLayout.swift
@@ -0,0 +1,17 @@
+import Foundation
+
+struct UltraFolderTabsLayout {
+    let frame: CGRect
+    let reservedHeight: CGFloat
+
+    static func calculate(size: CGSize, leftInset: CGFloat, rightInset: CGFloat, bottomInset: CGFloat, tabsHeight: CGFloat, topClearance: CGFloat) -> UltraFolderTabsLayout? {
+        let values = [size.width, size.height, leftInset, rightInset, bottomInset, tabsHeight, topClearance]
+        guard values.allSatisfy({ $0.isFinite }), size.width > 0, size.height > 0, tabsHeight > 0 else { return nil }
+        let left = max(0, leftInset)
+        let width = size.width - left - max(0, rightInset)
+        let reserved = tabsHeight + 8
+        let y = size.height - max(0, bottomInset) - reserved
+        guard width > 0, y >= max(0, topClearance) else { return nil }
+        return UltraFolderTabsLayout(frame: CGRect(x: left, y: y, width: width, height: tabsHeight), reservedHeight: reserved)
+    }
+}
