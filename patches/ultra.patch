+        self.presenceMode = (try container.decodeIfPresent(Int32.self, forKey: .presenceMode)).flatMap(UltraPresenceMode.init(rawValue:)) ?? .automatic
+        self.highQualityVideos = try container.decodeIfPresent(Bool.self, forKey: .highQualityVideos) ?? false
+        self.revealMediaSpoilers = try container.decodeIfPresent(Bool.self, forKey: .revealMediaSpoilers) ?? false
