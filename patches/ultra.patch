+    private func updateControls() {
+        let reviewing = self.candidate != nil
+        self.format.isEnabled = !self.busy && !reviewing
+        self.input.isHidden = self.format.selectedSegmentIndex >= 2 || reviewing
+        self.input.isEditable = !self.busy
+        self.dcInput.isHidden = self.format.selectedSegmentIndex != 1 || reviewing
+        self.dcInput.isEnabled = !self.busy
+        self.passwordInput.isHidden = self.format.selectedSegmentIndex != 3 || reviewing
+        self.passwordInput.isEnabled = !self.busy
+        self.paste.isHidden = self.format.selectedSegmentIndex >= 2 || reviewing
+        self.paste.isEnabled = !self.busy
+        self.file.isHidden = self.format.selectedSegmentIndex < 2 || reviewing
+        self.file.setTitle(self.format.selectedSegmentIndex == 3 ? "Выбрать закрытую папку TData" : "Выбрать .session в Файлах", for: .normal)
+        self.file.isEnabled = !self.busy
+        self.prepare.isHidden = self.format.selectedSegmentIndex >= 2 || reviewing
+        self.prepare.isEnabled = !self.busy
+        self.confirm.isHidden = !reviewing
+        self.confirm.isEnabled = !self.busy
+    }
+
+    func textView(_ textView: UITextView, shouldChangeTextIn range: NSRange, replacementText text: String) -> Bool {
+        return textView.text.utf16.count - range.length + text.utf16.count <= 4096
+    }
+
+    private func reset() {
+        self.generation += 1
+        self.disposable.set(nil)
+        self.candidate = nil
+        self.input.text = ""
+        self.dcInput.text = ""
+        self.passwordInput.text = ""
+        self.busy = false
+        self.status.text = self.testingEnvironment ? "Тестовая среда Telegram. Сессия обычного аккаунта здесь не подойдёт." : "Обычная среда Telegram. Тестовые сессии здесь не подойдут."
+        self.updateControls()
+    }
+
+    private func prepareInput() {
+        guard !self.busy else { return }
+        self.view.endEditing(true)
+        do {
+            let candidate: UltraSessionImportData
+            if self.format.selectedSegmentIndex == 1 {
+                guard let dc = Int32(self.dcInput.text ?? "") else { throw UltraSessionImportError.invalidDatacenter }
+                candidate = try UltraSessionImportData.parseAuthKey(self.input.text ?? "", datacenterId: dc, testingEnvironment: self.testingEnvironment)
+            } else {
+                candidate = try UltraSessionImportData.parseStringSession(self.input.text ?? "", testingEnvironment: self.testingEnvironment)
+            }
+            self.review(candidate)
+        } catch {
+            self.fail(error as? UltraSessionImportError ?? .invalidFormat)
+        }
+    }
+
+    private func review(_ candidate: UltraSessionImportData) {
+        self.input.text = ""
+        self.dcInput.text = ""
+        self.passwordInput.text = ""
+        self.candidate = candidate
+        self.busy = false
+        let identity = candidate.claimedUserId.map { "ID из экспорта: \($0)\n" } ?? ""
+        self.status.text = "Формат: \(candidate.format.rawValue)\nDC: \(candidate.datacenterId)\n\(identity)Проверен только формат. Действительность ключа и аккаунт проверит Telegram после подтверждения. Отмена после принятия входа сервером не удаляет уже созданную сессию; ей можно управлять в разделе «Устройства»."
+        self.updateControls()
+    }
+
+    private func pickFile() {
+        guard !self.busy else { return }
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: self.format.selectedSegmentIndex == 3 ? [.folder] : [.item], asCopy: false)
+        picker.allowsMultipleSelection = false
+        picker.delegate = self
+        self.present(picker, animated: true)
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard !self.finished, let url = urls.first, urls.count == 1 else { return }
+        self.busy = true
+        self.generation += 1
+        let generation = self.generation
+        let testing = self.testingEnvironment
+        let tdata = self.format.selectedSegmentIndex == 3
+        let password = self.passwordInput.text ?? ""
+        self.passwordInput.text = ""
+        self.status.text = "Чтение закрытого файла…"
+        self.updateControls()
+        Queue.concurrentDefaultQueue().async { [weak self] in
+            let access = url.startAccessingSecurityScopedResource()
+            defer { if access { url.stopAccessingSecurityScopedResource() } }
+            var result: Result<[UltraSessionImportData], UltraSessionImportError> = .failure(.fileUnavailable)
+            var coordinationError: NSError?
+            NSFileCoordinator().coordinate(readingItemAt: url, options: [], error: &coordinationError) { coordinatedURL in
+                do {
+                    if tdata {
+                        result = .success(try UltraTDataReader.read(at: coordinatedURL, passcode: password, testingEnvironment: testing))
+                    } else {
+                        result = .success([try UltraSessionSQLiteReader.read(at: coordinatedURL, testingEnvironment: testing)])
+                    }
+                }
+                catch { result = .failure(error as? UltraSessionImportError ?? .fileUnavailable) }
+            }
+            if coordinationError != nil { result = .failure(.fileUnavailable) }
+            let finalResult = result
+            Queue.mainQueue().async { [weak self] in
+                guard let self = self, !self.finished, self.generation == generation else { return }
+                switch finalResult {
+                case let .success(candidates): self.reviewCandidates(candidates)
+                case let .failure(error): self.fail(error)
+                }
+            }
+        }
+    }
+
+    private func reviewCandidates(_ candidates: [UltraSessionImportData]) {
+        guard !candidates.isEmpty else { self.fail(.invalidFormat); return }
+        if candidates.count == 1 {
+            self.review(candidates[0])
+            return
+        }
+        self.busy = false
+        self.updateControls()
+        let selector = UIAlertController(title: "Аккаунты в TData", message: "Выберите одну запись. Действительность ключа и аккаунт проверит Telegram после подтверждения входа.", preferredStyle: .alert)
+        for (index, candidate) in candidates.enumerated() {
+            let identity = candidate.claimedUserId.map { "ID \($0)" } ?? "DC \(candidate.datacenterId)"
+            selector.addAction(UIAlertAction(title: "Запись \(index + 1) · \(identity)", style: .default, handler: { [weak self] _ in self?.review(candidate) }))
+        }
+        selector.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: { [weak self] _ in self?.reset() }))
+        self.present(selector, animated: true)
+    }
+
+    private func startImport() {
+        guard !self.busy, let candidate = self.candidate, let importSession = self.importSession else { return }
+        self.view.endEditing(true)
+        self.busy = true
+        self.status.text = "Telegram проверяет сессию и подтверждает новый вход… Ограничение ожидания — 60 секунд."
+        self.updateControls()
+        self.disposable.set((importSession(candidate) |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self = self, !self.finished else { return }
+            self.candidate = nil
+            self.imported(result)
+            self.finish()
+        }, error: { [weak self] error in self?.fail(error) }))
+    }
+
+    private func fail(_ error: UltraSessionImportError) {
+        self.reset()
+        switch error {
+        case .invalidFormat: self.status.text = "Некорректный формат. Данные не использованы для входа."
+        case .unsupportedFormat: self.status.text = "Формат или версия не поддерживаются. Для .session нужен закрытый, полностью записанный SQLite-файл без WAL. Можно экспортировать StringSession в исходной программе."
+        case .invalidDatacenter: self.status.text = "Неверный номер DC для выбранной среды Telegram."
+        case .environmentMismatch: self.status.text = "Тестовая и обычная среды Telegram не совпадают."
+        case .botAccount: self.status.text = "Сессии ботов не поддерживаются."
+        case .invalidKey: self.status.text = "Нужен непустой ключ auth_key длиной 256 байт (512 hex-знаков)."
+        case .accountMismatch: self.status.text = "Аккаунт на сервере не совпадает с ID в файле. Импорт остановлен."
+        case .alreadyAdded: self.status.text = "Этот аккаунт уже добавлен. Повторный вход не выполнен."
+        case .authorizationFailed: self.status.text = "Telegram не подтвердил вход. Сессия могла истечь или быть отозвана. Проверьте доступ к сети; можно использовать обычный вход или QR."
+        case .limitExceeded: self.status.text = "Telegram ограничил частоту запросов. Повторите позже."
+        case .timedOut: self.status.text = "Истекло время ожидания. Ввод очищен. Если Telegram уже принял вход, проверьте раздел «Устройства» перед повтором."
+        case .fileUnavailable: self.status.text = "Не удалось прочитать экспорт. Для .session нужен обычный файл до 16 МБ. Для TData — полностью скопированная закрытая папка с key_datas и файлами авторизаций с окончанием s. Исходник не изменён."
+        case .unsupportedProtection: self.status.text = "Защищённая TData нового формата пока не поддерживается. Исходник не изменён. Используйте StringSession, .session либо обычный вход."
+        case .invalidPasscodeOrData: self.status.text = "Локальный пароль TData не подошёл или экспорт повреждён. Исходник не изменён, импорт остановлен."
+        }
+    }
+
+    private func finish() {
+        guard !self.finished else { return }
+        self.finished = true
+        self.reset()
+        self.closed()
+        self.dismiss(animated: true)
+    }
+
+    func presentationControllerDidDismiss(_ presentationController: UIPresentationController) { self.finish() }
+
+    override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        if self.isBeingDismissed || self.presentingViewController == nil { self.finish() }
+    }
+}
