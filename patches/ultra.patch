new file mode 100644
index 00000000..959bcb13
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Auth/UltraTDataReader.swift
@@ -0,0 +1,36 @@
+import Foundation
+import MtProtoKit
+
+public enum UltraTDataReader {
+    /// Default closed Desktop store with safe-suffix files. Never reads chat databases or scripts.
+    public static func read(at directory: URL, passcode: String, testingEnvironment: Bool) throws -> [UltraSessionImportData] {
+        guard !testingEnvironment else { throw UltraSessionImportError.environmentMismatch }
+        guard directory.isFileURL, passcode.utf8.count <= 256 else { throw UltraSessionImportError.invalidFormat }
+        do {
+            let values = try directory.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey])
+            guard values.isDirectory == true, values.isSymbolicLink != true else { throw UltraSessionImportError.fileUnavailable }
+            var password = Data(passcode.utf8)
+            defer { password.resetBytes(in: 0 ..< password.count) }
+            return try UltraTDataFormat.read(passcode: password, loadFile: { name in
+                let url = directory.appendingPathComponent(name, isDirectory: false)
+                let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+                guard values.isRegularFile == true, values.isSymbolicLink != true,
+                      let size = values.fileSize, size >= 24, size <= UltraTDataFormat.maximumFileBytes else { throw UltraSessionImportError.fileUnavailable }
+                let file = try FileHandle(forReadingFrom: url)
+                defer { try? file.close() }
+                var data = Data()
+                while data.count <= UltraTDataFormat.maximumFileBytes {
+                    let chunk = try file.read(upToCount: min(65536, UltraTDataFormat.maximumFileBytes + 1 - data.count)) ?? Data()
+                    if chunk.isEmpty { break }
+                    data.append(chunk)
+                }
+                guard data.count <= UltraTDataFormat.maximumFileBytes else { throw UltraSessionImportError.fileUnavailable }
+                return data
+            }, decrypt: { data, key, iv in return MTAesDecrypt(data, key, iv) })
+        } catch let error as UltraSessionImportError {
+            throw error
+        } catch {
+            throw UltraSessionImportError.fileUnavailable
+        }
+    }
+}
