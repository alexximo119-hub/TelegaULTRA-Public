+import Foundation
+import XCTest
+@testable import UltraHistoryModels
+
+final class UltraLocalHistoryModelsTests: XCTestCase {
+    private let now: Int64 = 5_000_000
+    private func record(_ text: String = "text", messageId: Int32 = 1, at: Int64 = 5_000_000, kind: UltraLocalHistoryRecord.Kind = .received) -> UltraLocalHistoryRecord {
+        return UltraLocalHistoryRecord(peerId: 1, messageId: messageId, authorId: 2, messageTimestamp: 42, capturedAt: at, kind: kind, text: text)
+    }
+
+    func testDefaultPolicyDoesNotCaptureAndExcludesOwn() {
+        let policy = UltraLocalHistoryPolicy()
+        XCTAssertFalse(policy.isEnabled)
+        XCTAssertTrue(policy.excludeOwn)
+        XCTAssertTrue(policy.strikeOriginals)
+        XCTAssertFalse(policy.inlineEdits)
+    }
+
+    func testUnicodeTextIsBoundedWithoutReplacementCharacters() {
+        let text = String(repeating: "🙂", count: 5000) + "я"
+        let value = self.record(text)
+        XCTAssertLessThanOrEqual(value.text.utf8.count, 16 * 1024)
+        XCTAssertTrue(text.hasPrefix(value.text))
+        XCTAssertFalse(value.text.contains("�"))
+        XCTAssertTrue(value.truncated)
+        XCTAssertFalse(self.record("кириллица🙂").truncated)
+    }
+
+    func testRepeatedServerEventsAreDeduplicated() {
+        var contents = UltraLocalHistoryContents()
+        contents.append(self.record("old", kind: .deleted), now: self.now)
+        contents.append(self.record("old", kind: .deleted), now: self.now)
+        XCTAssertEqual(contents.records.count, 1)
+    }
+
+    func testEditingRetainsVersionsAndSupersedesOnlyReceivedSnapshot() {
+        var contents = UltraLocalHistoryContents()
+        contents.append(self.record("old"), now: self.now)
+        contents.append(self.record("old", kind: .edited), now: self.now)
+        contents.append(self.record("new"), now: self.now)
+        XCTAssertEqual(contents.records.map(\.text), ["old", "new"])
+        XCTAssertEqual(contents.records.map(\.kind), [.edited, .received])
+    }
+
+    func testMessageIdentitySeparatesDeduplication() {
+        var contents = UltraLocalHistoryContents()
+        contents.append(self.record("same", messageId: 1), now: self.now)
+        contents.append(self.record("same", messageId: 2), now: self.now)
+        XCTAssertEqual(contents.records.count, 2)
+    }
+
+    func testReturningToEarlierTextPreservesRevisionOrderAndStillDeduplicatesRetries() {
+        var contents = UltraLocalHistoryContents()
+        for text in ["A", "B", "A", "A"] { contents.append(self.record(text, kind: .edited), now: self.now) }
+        XCTAssertEqual(contents.records.map(\.text), ["A", "B", "A"])
+    }
+
+    func testMessageFilterSeparatesChatsAndKeepsAvailabilityAndPolicy() {
+        var policy = UltraLocalHistoryPolicy()
+        policy.edited = true
+        let otherChat = UltraLocalHistoryRecord(peerId: 2, messageId: 1, authorId: 3, messageTimestamp: 42, capturedAt: self.now, kind: .edited, text: "Other chat")
+        let selected = self.record("Selected", kind: .edited)
+        let snapshot = UltraLocalHistorySnapshot(policy: policy, records: [otherChat, self.record(messageId: 2), selected], unavailable: true)
+        XCTAssertEqual(snapshot.filtered(peerId: 1, messageId: 1).records, [selected])
+        XCTAssertEqual(snapshot.filtered(peerId: 1).records.count, 2)
+        XCTAssertTrue(snapshot.filtered(peerId: 999).records.isEmpty)
+        XCTAssertTrue(snapshot.filtered(peerId: 1).unavailable)
+        XCTAssertEqual(snapshot.filtered(peerId: 1).policy, policy)
+    }
+
+    func testLocalSearchCombinesWithMessageScopeAndHandlesUnicodeAndWhitespace() {
+        let records = [self.record("Привет 🙂", messageId: 42), self.record("Different", messageId: 43)]
+        let snapshot = UltraLocalHistorySnapshot(policy: UltraLocalHistoryPolicy(), records: records, unavailable: false)
+        XCTAssertEqual(snapshot.searching(" ПРИВЕТ ").records, [records[0]])
+        XCTAssertEqual(snapshot.searching("🙂").records, [records[0]])
+        XCTAssertEqual(snapshot.searching("42").records, [records[0]])
+        XCTAssertEqual(snapshot.searching(" \n ").records, records)
+        XCTAssertTrue(snapshot.filtered(peerId: 99).searching("Привет").records.isEmpty)
+        XCTAssertTrue(snapshot.searching("No match").records.isEmpty)
+    }
+
+    func testFormattingRangesCannotSplitEmojiOrOverflowUTF16Bounds() {
+        let valid = UltraLocalHistoryTextSpan(offset: 1, length: 2, style: .bold)
+        let invalid = [
+            UltraLocalHistoryTextSpan(offset: 2, length: 1, style: .italic),
+            UltraLocalHistoryTextSpan(offset: 1, length: 1, style: .code),
+            UltraLocalHistoryTextSpan(offset: -1, length: 1, style: .underline),
+            UltraLocalHistoryTextSpan(offset: Int.max, length: Int.max, style: .quote),
+            UltraLocalHistoryTextSpan(offset: 0, length: Int.max, style: .pre),
+            UltraLocalHistoryTextSpan(offset: 0, length: 0, style: .strikethrough)
+        ]
+        let record = UltraLocalHistoryRecord(peerId: 1, messageId: 1, authorId: nil, messageTimestamp: 42, capturedAt: self.now, kind: .edited, text: "A🙂Б", spans: [valid] + invalid)
+        XCTAssertEqual(record.validatedSpans, [valid])
+    }
+
+    func testFormattingOnlyEditsRemainDistinctButIdenticalRetriesDoNot() {
+        var contents = UltraLocalHistoryContents()
+        let bold = UltraLocalHistoryRecord(peerId: 1, messageId: 1, authorId: 2, messageTimestamp: 42, capturedAt: self.now, kind: .edited, text: "same", spans: [UltraLocalHistoryTextSpan(offset: 0, length: 4, style: .bold)])
+        contents.append(self.record("same", kind: .edited), now: self.now)
+        contents.append(bold, now: self.now)
+        contents.append(bold, now: self.now)
+        XCTAssertEqual(contents.records.count, 2)
+        XCTAssertNil(contents.records.first?.spans)
+        XCTAssertEqual(contents.records.last?.spans, bold.spans)
+    }
+
+    func testLegacyVersionOneRecordsWithoutFormattingStillDecode() throws {
+        let legacy = Data(#"{"id":"legacy-synthetic","peerId":1,"messageId":2,"messageTimestamp":3,"capturedAt":4,"kind":"edited","text":"Legacy","truncated":false}"#.utf8)
+        let record = try JSONDecoder().decode(UltraLocalHistoryRecord.self, from: legacy)
+        XCTAssertEqual(record.text, "Legacy")
+        XCTAssertNil(record.spans)
+        XCTAssertTrue(record.validatedSpans.isEmpty)
+        XCTAssertEqual(try JSONDecoder().decode(UltraLocalHistoryRecord.self, from: JSONEncoder().encode(record)), record)
+    }
+
+    func testFormattingCountAndEncodedBudgetRemainBounded() throws {
+        let spans = [UltraLocalHistoryTextSpan](repeating: UltraLocalHistoryTextSpan(offset: 0, length: 1, style: .strikethrough), count: 400)
+        var contents = UltraLocalHistoryContents()
+        contents.records = (1 ... 1000).map { id in
+            return UltraLocalHistoryRecord(peerId: 1, messageId: Int32(id), authorId: nil, messageTimestamp: 42, capturedAt: self.now, kind: .edited, text: "A", spans: spans)
+        }
+        XCTAssertEqual(contents.records.first?.spans?.count, 256)
+        contents.prune(now: self.now)
+        XCTAssertFalse(contents.records.isEmpty)
+        XCTAssertLessThanOrEqual(try JSONEncoder().encode(contents).count, 2 * 1024 * 1024)
+    }
+
+    func testTruncationDropsFormattingOutsideTheRetainedText() {
+        let source = String(repeating: "🙂", count: 5000)
+        let spans = [UltraLocalHistoryTextSpan(offset: 0, length: 2, style: .italic), UltraLocalHistoryTextSpan(offset: 9000, length: 2, style: .bold)]
+        let record = UltraLocalHistoryRecord(peerId: 1, messageId: 1, authorId: nil, messageTimestamp: 42, capturedAt: self.now, kind: .edited, text: source, spans: spans)
+        XCTAssertTrue(record.truncated)
+        XCTAssertEqual(record.validatedSpans, [spans[0]])
+    }
+
+    func testExpiryAndUnexpectedFutureDatesAreRemoved() {
+        var contents = UltraLocalHistoryContents()
+        contents.records = [self.record(at: self.now - 30 * 86400 - 1), self.record(at: self.now + 301), self.record(at: self.now)]
+        contents.prune(now: self.now)
+        XCTAssertEqual(contents.records.count, 1)
+        XCTAssertEqual(contents.records.first?.capturedAt, self.now)
+    }
+
+    func testEntryLimitKeepsMostRecentMessages() {
+        var contents = UltraLocalHistoryContents()
+        contents.records = (1 ... 1100).map { self.record(messageId: Int32($0)) }
+        contents.prune(now: self.now)
+        XCTAssertEqual(contents.records.count, 1000)
+        XCTAssertEqual(contents.records.first?.messageId, 101)
+        XCTAssertEqual(contents.records.last?.messageId, 1100)
+    }
+
+    func testByteBudgetAndCodableRoundTrip() throws {
+        var contents = UltraLocalHistoryContents()
+        contents.records = (1 ... 1000).map { self.record(String(repeating: "x", count: 16 * 1024), messageId: Int32($0)) }
+        contents.prune(now: self.now)
+        XCTAssertLessThanOrEqual(contents.records.reduce(0, { $0 + $1.text.utf8.count + 256 }), 2 * 1024 * 1024)
+        let encoded = try JSONEncoder().encode(contents)
+        XCTAssertLessThanOrEqual(encoded.count, 2 * 1024 * 1024)
+        XCTAssertEqual(try JSONDecoder().decode(UltraLocalHistoryContents.self, from: encoded), contents)
+    }
+
+    func testControlCharactersDoNotExceedSerializedBudget() throws {
+        var contents = UltraLocalHistoryContents()
+        contents.records = (1 ... 1000).map { self.record(String(repeating: "\u{0000}", count: 16 * 1024), messageId: Int32($0)) }
+        contents.prune(now: self.now)
+        XCTAssertLessThanOrEqual(try JSONEncoder().encode(contents).count, 2 * 1024 * 1024)
+        XCTAssertFalse(contents.records.isEmpty)
+    }
+}
