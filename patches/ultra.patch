+import Foundation
+
+public enum AccountUploadMode: Int32 {
+    case automatic = 0
+    case three = 3
+    case six = 6
+    case twelve = 12
+
+    public func parallelPartsOverride(isEncrypted: Bool) -> Int? {
+        guard !isEncrypted, self != .automatic else { return nil }
+        return Int(self.rawValue)
+    }
+    public static func boundedPartCount(_ override: Int?, nativeFast: Bool) -> Int {
+        guard let override else { return nativeFast ? 30 : 3 }
+        return max(1, min(30, override))
+    }
+}
