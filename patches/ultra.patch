+++ b/submodules/SettingsUI/Sources/UltraDiagnosticsController.swift
@@ -0,0 +1,205 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import AccountContext
+import DebugSettingsUI
+import CrashReporting
+import PresentationDataUtils
+
+private enum UltraDiagnosticAction: Int32 {
+    case exportLogs
+    case viewCrashes
+    case exportCrashes
+    case clear
+
+    var title: String {
+        switch self {
+        case .exportLogs: return "Сохранить журнал ULTRA"
+        case .viewCrashes: return "Просмотреть отчёты о сбоях"
+        case .exportCrashes: return "Сохранить отчёты о сбоях"
+        case .clear: return "Очистить журнал ULTRA"
+        }
+    }
+}
+
+private final class UltraDiagnosticsArguments {
+    let context: AccountContext
+    var present: (ViewController) -> Void = { _ in }
+    var push: (ViewController) -> Void = { _ in }
+    var refresh: () -> Void = {}
+    private var busy = false
+    private let queue = DispatchQueue(label: "app.telegaultra.diagnostic-export", qos: .utility)
+
+    init(context: AccountContext) {
+        self.context = context
+    }
+
+    func alert(_ text: String) {
+        self.present(textAlertController(context: self.context, title: "Диагностика ULTRA", text: text, actions: [
+            TextAlertAction(type: .defaultAction, title: self.context.sharedContext.currentPresentationData.with { $0 }.strings.Common_OK, action: {})
+        ]))
+    }
+
+    func updateRecording(_ value: Bool) {
+        do {
+            try UltraDiagnosticsStore.shared.setEnabled(value)
+        } catch {
+            self.alert("Не удалось изменить запись журнала. Можно попробовать очистить журнал и повторить действие.")
+        }
+        self.refresh()
+    }
+
+    func run(_ action: UltraDiagnosticAction) {
+        switch action {
+        case .viewCrashes:
+            self.push(crashReportsController(sharedContext: self.context.sharedContext, context: self.context))
+        case .clear:
+            self.present(textAlertController(context: self.context, title: "Очистить журнал?", text: "Будут удалены только локальные события ULTRA. Системные отчёты о сбоях управляются отдельно в их списке.", actions: [
+                TextAlertAction(type: .genericAction, title: self.context.sharedContext.currentPresentationData.with { $0 }.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .destructiveAction, title: "Очистить", action: { [weak self] in
+                    do {
+                        try UltraDiagnosticsStore.shared.clear()
+                        self?.alert("Журнал ULTRA очищен.")
+                    } catch {
+                        self?.alert("Не удалось очистить журнал.")
+                    }
+                    self?.refresh()
+                })
+            ]))
+        case .exportLogs:
+            self.export(crashes: false)
+        case .exportCrashes:
+            self.present(textAlertController(context: self.context, title: "Экспорт отчётов iOS", text: "Файл содержит доступные отчёты MetricKit: сведения об устройстве, время и стек вызовов. Сначала их можно просмотреть в списке отчётов. Передача выполняется только через выбранное вами действие.", actions: [
+                TextAlertAction(type: .genericAction, title: self.context.sharedContext.currentPresentationData.with { $0 }.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .defaultAction, title: "Продолжить", action: { [weak self] in self?.export(crashes: true) })
+            ]))
+        }
+    }
+
+    private func export(crashes: Bool) {
+        guard !self.busy else { return }
+        self.busy = true
+        let version = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? "unknown"
+        let build = Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "unknown"
+        let header = "ULTRA \(version) (\(build))\niOS \(UIDevice.current.systemVersion)\n\n"
+        self.queue.async {
+            let directory = FileManager.default.temporaryDirectory.appendingPathComponent("ULTRA-Export", isDirectory: true)
+            let file = directory.appendingPathComponent(crashes ? "ULTRA-crash-reports.txt" : "ULTRA-diagnostics.txt")
+            do {
+                var data = Data(header.utf8)
+                if crashes {
+                    let reports = try CrashReportStore.shared.reports()
+                    guard !reports.isEmpty else {
+                        DispatchQueue.main.async {
+                            self.busy = false
+                            self.alert("Отчётов пока нет. iOS передаёт отчёты с задержкой и не для каждого закрытия приложения.")
+                        }
+                        return
+                    }
+                    for report in reports.prefix(10) {
+                        let text = Data((report.text + "\n\n").utf8)
+                        guard data.count + text.count <= 10 * 1024 * 1024 else { throw CocoaError(.fileReadTooLarge) }
+                        data.append(text)
+                    }
+                } else {
+                    data.append(try UltraDiagnosticsStore.shared.export())
+                }
+                try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+                // Fixed filenames bound leftover temporary exports if iOS terminates the share sheet.
+                try data.write(to: file, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+                DispatchQueue.main.async {
+                    let activity = UIActivityViewController(activityItems: [file], applicationActivities: nil)
+                    if let window = self.context.sharedContext.applicationBindings.getTopWindow() {
+                        activity.popoverPresentationController?.sourceView = window
+                        activity.popoverPresentationController?.sourceRect = CGRect(x: window.bounds.midX, y: window.bounds.maxY - 1, width: 1, height: 1)
+                    }
+                    activity.completionWithItemsHandler = { _, _, _, _ in
+                        self.queue.async { try? FileManager.default.removeItem(at: file) }
+                        self.busy = false
+                    }
+                    self.context.sharedContext.applicationBindings.presentNativeController(activity)
+                }
+            } catch {
+                try? FileManager.default.removeItem(at: file)
+                DispatchQueue.main.async {
+                    self.busy = false
+                    self.alert("Не удалось подготовить файл. Попробуйте очистить журнал или экспортировать отчёты отдельно.")
+                }
+            }
+        }
+    }
+}
+
+private enum UltraDiagnosticsEntry: ItemListNodeEntry {
+    case recording(Bool)
+    case note(Int32, Int32, String)
+    case action(UltraDiagnosticAction)
+
+    var stableId: Int32 {
+        switch self {
+        case .recording: return 0
+        case let .note(id, _, _): return id
+        case let .action(action): return 10 + action.rawValue
+        }
+    }
+
+    var section: ItemListSectionId {
+        switch self {
+        case .recording: return 0
+        case let .note(_, section, _): return section
+        case .action(.exportLogs): return 1
+        case .action(.viewCrashes), .action(.exportCrashes): return 2
+        case .action(.clear): return 3
+        }
+    }
+
+    static func < (lhs: UltraDiagnosticsEntry, rhs: UltraDiagnosticsEntry) -> Bool {
+        if lhs.section != rhs.section { return lhs.section < rhs.section }
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraDiagnosticsArguments
+        switch self {
+        case let .recording(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Записывать журнал ULTRA", value: value, sectionId: self.section, style: .blocks, updated: { arguments.updateRecording($0) })
+        case let .note(_, _, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .action(action):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: action.title, kind: action == .clear ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.run(action) })
+        }
+    }
+}
+
+func ultraDiagnosticsController(context: AccountContext) -> ViewController {
+    let arguments = UltraDiagnosticsArguments(context: context)
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    arguments.refresh = { revision.set(0) }
+    let signal = combineLatest(context.sharedContext.presentationData, revision.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let enabled = (try? UltraDiagnosticsStore.shared.isEnabled()) ?? false
+        let build = Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "unknown"
+        let entries: [UltraDiagnosticsEntry] = [
+            .recording(enabled),
+            .note(1, 0, "Только этапы запуска, сворачивание, предупреждения о памяти и использование настроек ULTRA. Без переписки, телефонов и ключей. Хранится до 3 дней, не более 500 событий / 64 КБ. Выключение записи сохраняет старые события до очистки или истечения срока."),
+            .action(.exportLogs),
+            .action(.viewCrashes),
+            .action(.exportCrashes),
+            .note(20, 2, "Отчёты iOS могут появиться позже и не охватывают каждое завершение приложения. Автоматической отправки нет."),
+            .action(.clear),
+            .note(30, 3, "Сборка \(build) · iOS \(UIDevice.current.systemVersion)\nСохранить файл можно через «Сохранить в Файлы» в системном меню.")
+        ]
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Диагностика"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    arguments.push = { [weak controller] in controller?.push($0) }
+    arguments.present = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
