+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramUIPreferences
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import PresentationDataUtils
+
+private enum UltraLocalDisplayAction: Int32, CaseIterable {
+    case save = 10, catalog, gallery, fetchNFT, reset
+    var title: String {
+        switch self {
+        case .save: return "Сохранить локальные значения"
+        case .catalog: return "Добавить подарок из каталога"
+        case .gallery: return "Открыть локальную витрину"
+        case .fetchNFT: return "Добавить NFT по ссылке или slug"
+        case .reset: return "Сбросить локальное отображение"
+        }
+    }
+}
+private final class UltraLocalDisplayArguments {
+    var input: (Int32, String) -> Void = { _, _ in }
+    var enabled: (Bool) -> Void = { _ in }
+    var run: (UltraLocalDisplayAction) -> Void = { _ in }
+    let request = MetaDisposable()
+    deinit { self.request.dispose() }
+}
+private enum UltraLocalDisplayEntry: ItemListNodeEntry {
+    case input(Int32, String, String)
+    case enabled(Bool)
+    case action(UltraLocalDisplayAction)
+    case footer(String)
+    var stableId: Int32 {
+        switch self {
+        case let .input(id, _, _): return id
+        case .enabled: return 3
+        case let .action(action): return action.rawValue
+        case .footer: return 100
+        }
+    }
+    var section: ItemListSectionId { return self.stableId < 10 ? 0 : 1 }
+    static func < (lhs: UltraLocalDisplayEntry, rhs: UltraLocalDisplayEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraLocalDisplayArguments
+        switch self {
+        case let .input(id, text, placeholder):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: placeholder, type: .regular(capitalization: false, autocorrection: false), clearType: .always, maxLength: id == 0 ? 64 : 256, sectionId: self.section, textUpdated: { arguments.input(id, $0) }, action: {})
+        case let .enabled(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Показывать локальные поля в моём профиле", value: value, sectionId: self.section, style: .blocks, updated: arguments.enabled)
+        case let .action(action):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: action.title, kind: action == .reset ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.run(action) })
+        case let .footer(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+func ultraLocalDisplayController(context: AccountContext) -> ViewController {
+    let accountId = context.account.peerId.toInt64()
+    let saved = UltraLocalDisplayStore.current(accountId: accountId)
+    var phone = saved.phone ?? ""
+    var stars = saved.stars.map(String.init) ?? ""
+    var slug = ""
+    var enabled = saved.enabled
+    var busy = false
+    var requestGeneration = 0
+    var status = "Изменения применяются после сохранения и повторного открытия профиля."
+    let arguments = UltraLocalDisplayArguments()
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    var pushImpl: (ViewController) -> Void = { _ in }
+    var presentImpl: (ViewController) -> Void = { _ in }
+    arguments.input = { id, text in
+        switch id { case 0: phone = text; case 1: stars = text; default: slug = text }
+        revision.set(0)
+    }
+    arguments.enabled = { enabled = $0; revision.set(0) }
+    arguments.run = { [weak arguments] action in
+        switch action {
+        case .save:
+            if let value = UltraLocalDisplayValues.make(enabled: enabled, phone: phone, stars: stars) {
+                do {
+                    try UltraLocalDisplayStore.save(value, accountId: accountId)
+                    status = "Сохранено. В профиле появятся отдельные поля с пометкой «локально»."
+                } catch { status = "Не удалось сохранить локальные значения." }
+            } else { status = "Номер — до 64 символов без управляющих знаков; Stars — целое неотрицательное число до 9000000000000000. Пустое поле сбрасывает значение." }
+            revision.set(0)
+        case .catalog:
+            pushImpl(ultraLocalGiftGalleryController(context: context, catalog: true))
+        case .gallery:
+            pushImpl(ultraLocalGiftGalleryController(context: context, catalog: false))
+        case .fetchNFT:
+            guard !busy else { return }
+            guard let value = UltraLocalDisplayStore.giftSlug(slug) else {
+                status = "Укажите публичную ссылку https://t.me/nft/… или slug из букв, цифр и дефисов."
+                revision.set(0)
+                return
+            }
+            busy = true
+            requestGeneration += 1
+            let generation = requestGeneration
+            status = "Получение публичной карточки NFT…"
+            revision.set(0)
+            arguments?.request.set((context.engine.payments.getUniqueStarGift(slug: value) |> timeout(20, queue: .mainQueue(), alternate: .fail(.generic)) |> deliverOnMainQueue).start(next: { gift in
+                guard generation == requestGeneration else { return }
+                busy = false
+                do {
+                    try UltraLocalGiftGalleryStore.add(.unique(gift), accountId: accountId)
+                    status = "Карточка добавлена в локальную витрину. Владение подарком не изменилось."
+                } catch { status = "Не удалось сохранить карточку: проверьте размер и лимит локальной витрины." }
+                revision.set(0)
+            }, error: { _ in
+                guard generation == requestGeneration else { return }
+                busy = false
+                status = "Карточка не получена: проверьте ссылку и подключение. Ничего не куплено и не передано."
+                revision.set(0)
+            }))
+        case .reset:
+            presentImpl(textAlertController(context: context, title: "Сбросить локальное отображение?", text: "Будут удалены только заданные здесь значения и карточки этого аккаунта. Реальный номер, Stars и подарки Telegram не изменятся.", actions: [
+                TextAlertAction(type: .genericAction, title: "Отмена", action: {}),
+                TextAlertAction(type: .destructiveAction, title: "Сбросить", action: { [weak arguments] in
+                    requestGeneration += 1
+                    arguments?.request.set(nil)
+                    busy = false
+                    UltraLocalDisplayStore.reset(accountId: accountId)
+                    UltraLocalGiftGalleryStore.reset(accountId: accountId)
+                    phone = ""; stars = ""; slug = ""; enabled = false
+                    status = "Локальное отображение сброшено."
+                    revision.set(0)
+                })
+            ]))
+        }
+    }
+    let signal = combineLatest(context.sharedContext.presentationData, revision.get()) |> deliverOnMainQueue |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        var entries: [UltraLocalDisplayEntry] = [.input(0, phone, "Локальный номер"), .input(1, stars, "Локальное число Stars"), .input(2, slug, "Ссылка или slug NFT"), .enabled(enabled)]
+        entries.append(contentsOf: UltraLocalDisplayAction.allCases.map(UltraLocalDisplayEntry.action))
+        entries.append(.footer(status + "\n\nЭто отдельное локальное отображение текущего аккаунта. Поля в профиле и витрина всегда помечены как локальные. Реальные баланс, номер, владение, покупки и переводы не меняются; другим людям эти значения не видны. Витрина содержит до \(UltraLocalGiftGalleryStore.limit) публичных карточек, до 2 МБ метаданных. Выбор из каталога не покупает подарок. Сохраняется на устройстве до сброса."))
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Локальное отображение"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    pushImpl = { [weak controller] in controller?.push($0) }
+    presentImpl = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
