+            let properties = ChatMessageBubbleContentProperties(hidesSimpleAuthorHeader: false, headerSpacing: 0.0, hidesBackground: .never, forceFullCorners: false, forceAlignment: .none)
+            return (properties, nil, CGFloat.greatestFiniteMagnitude, { size, _ in
+                let preview = item.attributes.ultraHistoryPreview
+                let incoming = item.message.effectivelyIncoming(item.context.account.peerId)
+                let theme = incoming ? item.presentationData.theme.theme.chat.message.incoming : item.presentationData.theme.theme.chat.message.outgoing
+                let fontSize = max(12.0, item.presentationData.messageFont.pointSize - 2.0)
+                let title = "ULTRA · Редакция ›"
