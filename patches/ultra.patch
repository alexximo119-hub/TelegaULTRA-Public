+++ b/Tests/UltraSettingsTests/UltraAccountLoadPolicyTests.swift
@@ -0,0 +1,60 @@
+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraAccountLoadPolicyTests: XCTestCase {
+    private func records(_ count: Int) -> [UltraAccountLoadRecord] {
+        return (1 ... count).map { UltraAccountLoadRecord(id: Int64($0), order: Int32($0)) }
+    }
+
+    func testFourOrFewerAccountsKeepNativeAllResidentBehavior() {
+        for count in 1 ... 4 {
+            XCTAssertEqual(UltraAccountLoadPolicy.residentIds(records: self.records(count), current: Int64(count), recent: [], protected: [9999]), Set((1 ... count).map(Int64.init)))
+        }
+    }
+
+    func test999RecordDirectoryLoadsCurrentAndThreeRecentAccounts() {
+        let result = UltraAccountLoadPolicy.residentIds(records: self.records(999), current: 600, recent: [599, 598, 597, 596], protected: [])
+        XCTAssertEqual(result, Set<Int64>([600, 599, 598, 597]))
+    }
+
+    func testProtectedWorkCanExceedFourButIsNeverEvictedForTheWindow() {
+        let protected: Set<Int64> = [1, 2, 3, 4, 5, 6]
+        let result = UltraAccountLoadPolicy.residentIds(records: self.records(999), current: 999, recent: [], protected: protected)
+        XCTAssertTrue(protected.isSubset(of: result))
+        XCTAssertEqual(result, protected.union([999]))
+    }
+
+    func testMissingCurrentAndStaleProtectionUseDeterministicValidFallbacks() {
+        let records = self.records(10).reversed().map { UltraAccountLoadRecord(id: $0.id, order: 0) }
+        let result = UltraAccountLoadPolicy.residentIds(records: records, current: 5000, recent: [9999], protected: [5000])
+        XCTAssertEqual(result, Set<Int64>([1, 2, 3, 4]))
+    }
+
+    func testCompletedWorkCanLeaveTheResidentWindow() {
+        let before = UltraAccountLoadPolicy.residentIds(records: self.records(999), current: 999, recent: [998, 997, 996], protected: [1])
+        XCTAssertTrue(before.contains(1))
+        let after = UltraAccountLoadPolicy.residentIds(records: self.records(999), current: 999, recent: [998, 997, 996], protected: [])
+        XCTAssertEqual(after, Set<Int64>([999, 998, 997, 996]))
+        XCTAssertFalse(after.contains(1))
+    }
+
+    func testEmptyDirectoriesAndRepeatedIdsDoNotCreatePhantomAccounts() {
+        XCTAssertTrue(UltraAccountLoadPolicy.residentIds(records: [], current: 1, recent: [1], protected: [1]).isEmpty)
+        let duplicates = [UltraAccountLoadRecord](repeating: UltraAccountLoadRecord(id: 1, order: 0), count: 10)
+        XCTAssertEqual(UltraAccountLoadPolicy.residentIds(records: duplicates, current: 1, recent: [1, 1], protected: []), Set<Int64>([1]))
+    }
+
+    func testUnknownQueuesPendingWorkAndCallsProtectUntilKnownIdle() {
+        XCTAssertTrue(AccountLoadReadiness(initialized: false, hasPending: false).protectsResident(hasOtherWork: false))
+        XCTAssertTrue(AccountLoadReadiness(initialized: true, hasPending: true).protectsResident(hasOtherWork: false))
+        XCTAssertTrue(AccountLoadReadiness(initialized: true, hasPending: false).protectsResident(hasOtherWork: true))
+        XCTAssertFalse(AccountLoadReadiness(initialized: true, hasPending: false).protectsResident(hasOtherWork: false))
+    }
+
+    func testNewResidentsStayProtectedUntilTheirOwnTaskSnapshotArrives() {
+        XCTAssertEqual(UltraAccountLoadPolicy.protectedIds(resident: [1, 2, 3], evaluated: [1, 2], busy: [2]), Set<Int64>([2, 3]))
+        XCTAssertEqual(UltraAccountLoadPolicy.protectedIds(resident: [1, 2, 3], evaluated: [1, 2, 3], busy: [2]), Set<Int64>([2]))
+        // A stale snapshot for an earlier resident set cannot mark a new context idle.
+        XCTAssertEqual(UltraAccountLoadPolicy.protectedIds(resident: [4, 5], evaluated: [1, 2, 3], busy: []), Set<Int64>([4, 5]))
+    }
+}
