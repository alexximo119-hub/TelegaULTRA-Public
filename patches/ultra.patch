+
+private final class UltraGiftCell: UICollectionViewCell {
+    private var preview = ComponentView<Empty>()
+    private var parameters: (AccountContext, PresentationData, StarGift)?
+    override init(frame: CGRect) { super.init(frame: frame); self.isAccessibilityElement = true; self.accessibilityTraits = .button }
+    required init?(coder: NSCoder) { return nil }
+    override func prepareForReuse() {
+        super.prepareForReuse()
+        self.preview.view?.removeFromSuperview()
+        self.preview = ComponentView()
+        self.parameters = nil
+    }
+    func update(context: AccountContext, presentationData: PresentationData, gift: StarGift) {
+        self.parameters = (context, presentationData, gift)
+        self.accessibilityLabel = "Локальная карточка подарка"
+        self.setNeedsLayout()
+    }
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        guard let (context, data, gift) = self.parameters, self.bounds.width > 0 else { return }
+        let subject: GiftItemComponent.Subject
+        switch gift {
+        case let .generic(gift): subject = .starGift(gift: gift, price: "Локально")
+        case let .unique(gift): subject = .uniqueGift(gift: gift, price: nil)
+        }
+        let size = self.preview.update(transition: .immediate, component: AnyComponent(GiftItemComponent(context: context, style: .glass, theme: data.theme, strings: data.strings, subject: subject, label: "Локальный образец", mode: .grid, allowAnimations: false)), environment: {}, containerSize: self.bounds.size)
+        if let view = self.preview.view {
+            if view.superview == nil { self.contentView.addSubview(view) }
+            view.isUserInteractionEnabled = false
+            view.frame = CGRect(origin: CGPoint(x: floor((self.bounds.width - size.width) * 0.5), y: 0), size: size)
+        }
+    }
+}
