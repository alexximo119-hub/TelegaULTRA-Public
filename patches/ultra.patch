+import Foundation
+import XCTest
+@testable import Postbox
+
+final class MessageHistoryRemovalHookTests: XCTestCase {
+    private var fixture: PostboxFixture!
+    private let peerId = MessageHistoryTableFixture.peerId(960)
+    private let otherPeerId = MessageHistoryTableFixture.peerId(961)
+    private let authorId = MessageHistoryTableFixture.peerId(962)
+    private let otherAuthorId = MessageHistoryTableFixture.peerId(963)
+    private let namespace = PostboxFixture.messageNamespace
+
+    override func setUp() {
+        super.setUp()
+        self.fixture = PostboxFixture(name: "MessageHistoryRemovalHookTests")
+    }
+
+    override func tearDown() {
+        self.fixture.close()
+        self.fixture = nil
+        super.tearDown()
+    }
+
+    private func message(_ id: Int32, timestamp: Int32 = 200, threadId: Int64? = nil, peerId: PeerId? = nil, namespace: MessageId.Namespace? = nil, authorId: PeerId? = nil, forwardAuthorId: PeerId? = nil) -> StoreMessage {
+        let forwardInfo = forwardAuthorId.map { StoreMessageForwardInfo(authorId: $0, sourceId: nil, sourceMessageId: nil, date: 100, authorSignature: nil, psaType: nil, flags: []) }
+        return StoreMessage(id: MessageId(peerId: peerId ?? self.peerId, namespace: namespace ?? self.namespace, id: id), customStableId: nil, globallyUniqueId: nil, groupingKey: nil, threadId: threadId, timestamp: timestamp, flags: [.Incoming], tags: [], globalTags: [], localTags: [], forwardInfo: forwardInfo, authorId: authorId, text: "Synthetic \(id)", attributes: [], media: [])
+    }
+
+    private func id(_ value: Int32, peerId: PeerId? = nil, namespace: MessageId.Namespace? = nil) -> MessageId {
+        return MessageId(peerId: peerId ?? self.peerId, namespace: namespace ?? self.namespace, id: value)
+    }
+
+    func testFullClearHookReadsBeforeRemovalAndCanCommitAnIndependentCacheEntry() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(1), self.message(2), self.message(3, peerId: self.otherPeerId), self.message(4, namespace: self.namespace + 1)], location: .Random)
+            let key = ValueBoxKey(length: 1)
+            key.setUInt8(0, value: 1)
+            let entryId = ItemCacheEntryId(collectionId: 120, key: key)
+            var calls = 0
+            transaction.clearHistory(self.peerId, threadId: nil, minTimestamp: nil, maxTimestamp: nil, namespaces: .just(Set([self.namespace])), beforeRemovingMessages: { ids in
+                calls += 1
+                XCTAssertEqual(Set(ids), Set([self.id(1), self.id(2)]))
+                XCTAssertEqual(ids.compactMap { transaction.getMessage($0)?.text }.sorted(), ["Synthetic 1", "Synthetic 2"])
+                if let entry = CodableEntry(["count": ids.count]) {
+                    transaction.putItemCacheEntry(id: entryId, entry: entry)
+                } else { XCTFail("Synthetic cache entry must encode") }
+            }, forEachMedia: nil)
+            XCTAssertEqual(calls, 1)
+            XCTAssertNil(transaction.getMessage(self.id(1)))
+            XCTAssertNil(transaction.getMessage(self.id(2)))
+            XCTAssertNotNil(transaction.getMessage(self.id(3, peerId: self.otherPeerId)))
+            XCTAssertNotNil(transaction.getMessage(self.id(4, namespace: self.namespace + 1)))
+            XCTAssertEqual(transaction.retrieveItemCacheEntry(id: entryId)?.get([String: Int].self), ["count": 2])
+        }
+    }
+
+    func testRangeAndThreadFiltersAreAppliedBeforeTheHookIncludingBothEndpoints() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([
+                self.message(1, timestamp: 199, threadId: 11),
+                self.message(2, timestamp: 200, threadId: 11),
+                self.message(3, timestamp: 300, threadId: 11),
+                self.message(4, timestamp: 301, threadId: 11),
+                self.message(5, timestamp: 200, threadId: 22),
+                self.message(6, timestamp: 200, threadId: 11, peerId: self.otherPeerId),
+                self.message(7, timestamp: 200, threadId: 11, namespace: self.namespace + 1)
+            ], location: .Random)
+            var observed = Set<MessageId>()
+            transaction.clearHistory(self.peerId, threadId: 11, minTimestamp: 200, maxTimestamp: 300, namespaces: .just(Set([self.namespace])), beforeRemovingMessages: { ids in
+                observed = Set(ids)
+                XCTAssertTrue(ids.allSatisfy { transaction.getMessage($0) != nil })
+            }, forEachMedia: nil)
+            XCTAssertEqual(observed, Set([self.id(2), self.id(3)]))
+            for value in [Int32(1), 4, 5] { XCTAssertNotNil(transaction.getMessage(self.id(value))) }
+            for value in [Int32(2), 3] { XCTAssertNil(transaction.getMessage(self.id(value))) }
+            XCTAssertNotNil(transaction.getMessage(self.id(6, peerId: self.otherPeerId)))
+            XCTAssertNotNil(transaction.getMessage(self.id(7, namespace: self.namespace + 1)))
+        }
+    }
+
+    func testAuthorClearHookReceivesOnlyTheRequestedAuthorPeerAndNamespace() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([
+                self.message(1, authorId: self.authorId),
+                self.message(2, authorId: self.otherAuthorId),
+                self.message(3, peerId: self.otherPeerId, authorId: self.authorId),
+                self.message(4, namespace: self.namespace + 1, authorId: self.authorId)
+            ], location: .Random)
+            var observed: [MessageId] = []
+            transaction.removeAllMessagesWithAuthor(self.peerId, authorId: self.authorId, namespace: self.namespace, beforeRemovingMessages: { ids in
+                observed = ids
+                XCTAssertEqual(transaction.getMessage(self.id(1))?.text, "Synthetic 1")
+            }, forEachMedia: nil)
+            XCTAssertEqual(observed, [self.id(1)])
+            XCTAssertNil(transaction.getMessage(self.id(1)))
+            XCTAssertNotNil(transaction.getMessage(self.id(2)))
+            XCTAssertNotNil(transaction.getMessage(self.id(3, peerId: self.otherPeerId)))
+            XCTAssertNotNil(transaction.getMessage(self.id(4, namespace: self.namespace + 1)))
+        }
+    }
+
+    func testFullThreadClearKeepsMessagesFromOtherTopicsAndTheParentChat() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(1, threadId: 11), self.message(2, threadId: 22), self.message(3), self.message(4, timestamp: 400, threadId: 11)], location: .Random)
+            var observed = Set<MessageId>()
+            transaction.clearHistory(self.peerId, threadId: 11, minTimestamp: nil, maxTimestamp: nil, namespaces: .all, beforeRemovingMessages: { ids in
+                observed = Set(ids)
+                XCTAssertTrue(ids.allSatisfy { transaction.getMessage($0)?.threadId == 11 })
+            }, forEachMedia: nil)
+            XCTAssertEqual(observed, Set([self.id(1), self.id(4)]))
+            XCTAssertNil(transaction.getMessage(self.id(1)))
+            XCTAssertNil(transaction.getMessage(self.id(4)))
+            XCTAssertNotNil(transaction.getMessage(self.id(2)))
+            XCTAssertNotNil(transaction.getMessage(self.id(3)))
+        }
+    }
+
+    func testForwardAuthorClearDoesNotConfuseTheSenderWithTheOriginalAuthor() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([
+                self.message(1, authorId: self.otherAuthorId, forwardAuthorId: self.authorId),
+                self.message(2, authorId: self.authorId, forwardAuthorId: self.otherAuthorId),
+                self.message(3, authorId: self.authorId),
+                self.message(4, peerId: self.otherPeerId, forwardAuthorId: self.authorId),
+                self.message(5, namespace: self.namespace + 1, forwardAuthorId: self.authorId)
+            ], location: .Random)
+            var observed: [MessageId] = []
+            transaction.removeAllMessagesWithForwardAuthor(self.peerId, forwardAuthorId: self.authorId, namespace: self.namespace, beforeRemovingMessages: { ids in
+                observed = ids
+                XCTAssertEqual(transaction.getMessage(self.id(1))?.text, "Synthetic 1")
+            }, forEachMedia: nil)
+            XCTAssertEqual(observed, [self.id(1)])
+            XCTAssertNil(transaction.getMessage(self.id(1)))
+            XCTAssertNotNil(transaction.getMessage(self.id(2)))
+            XCTAssertNotNil(transaction.getMessage(self.id(3)))
+            XCTAssertNotNil(transaction.getMessage(self.id(4, peerId: self.otherPeerId)))
+            XCTAssertNotNil(transaction.getMessage(self.id(5, namespace: self.namespace + 1)))
+        }
+    }
+
+    func testMissingHookPreservesDeletionAndEmptyScopeReportsNoAdjacentMessages() {
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(1)], location: .Random)
+            var calls = 0
+            transaction.clearHistory(self.otherPeerId, threadId: nil, minTimestamp: nil, maxTimestamp: nil, namespaces: .all, beforeRemovingMessages: { ids in
+                calls += 1
+                XCTAssertTrue(ids.isEmpty)
+            }, forEachMedia: nil)
+            XCTAssertEqual(calls, 1)
+            XCTAssertNotNil(transaction.getMessage(self.id(1)))
+            transaction.clearHistory(self.peerId, threadId: nil, minTimestamp: nil, maxTimestamp: nil, namespaces: .all, forEachMedia: nil)
+            XCTAssertNil(transaction.getMessage(self.id(1)))
+        }
+    }
+}
