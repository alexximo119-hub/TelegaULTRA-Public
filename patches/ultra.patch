+        ])
+        let result = ultraHistoryRichText(page)
+        XCTAssertEqual(result.text, "Title\nSafe label\nSecond\nQuoted\nQuote caption")
+        XCTAssertFalse(result.truncated)
+        XCTAssertFalse(result.usesEntities)
+        XCTAssertFalse(result.text.contains("example.invalid"))
+    }
+
+    func testUnicodeIsBoundedAtAScalarBoundaryAndIsExplicitlyMarkedPartial() {
+        let original = String(repeating: "🙂я", count: 5000)
+        let result = ultraHistoryRichText(self.page([.paragraph(.plain(original))]))
+        XCTAssertLessThanOrEqual(result.text.utf8.count, 16 * 1024)
+        XCTAssertTrue(original.hasPrefix(result.text))
+        XCTAssertFalse(result.text.contains("�"))
+        XCTAssertTrue(result.truncated)
+    }
+
+    func testWideDocumentCannotConsumeTheHeadingBudgetBeforeItsChildrenAreVisited() {
+        let blocks = (0 ..< 5000).map { InstantPageBlock.paragraph(.plain(String($0))) }
+        let result = ultraHistoryRichText(self.page([.details(title: .plain("Keep heading"), blocks: blocks, expanded: true)]))
+        XCTAssertTrue(result.text.hasPrefix("Keep heading\n0\n1\n2"))
+        XCTAssertTrue(result.truncated)
+        XCTAssertLessThanOrEqual(result.text.utf8.count, 16 * 1024)
+    }
+
+    func testAvailableFullPageIsUsedAndNativeTextFallbackKeepsItsOwnEntityOffsets() {
+        let partial = self.page([.paragraph(.plain("Partial"))], complete: false)
+        let full = self.page([.paragraph(.plain("Full body"))])
+        let attribute = RichTextMessageAttribute(instantPage: partial, fullInstantPage: full)
+        let result = ultraHistoryMessageText(text: "fallback", attributes: [attribute])
+        XCTAssertEqual(result.text, "Full body")
+        XCTAssertFalse(result.usesEntities)
+        XCTAssertFalse(result.truncated)
+        let empty = RichTextMessageAttribute(instantPage: self.page([]), fullInstantPage: nil)
+        let fallback = ultraHistoryMessageText(text: "Native text", attributes: [empty])
+        XCTAssertEqual(fallback.text, "Native text")
+        XCTAssertTrue(fallback.usesEntities)
+    }
+
+    func testIncompleteSourceAndFormattingLabelsNeverPretendToBeAFullDocument() {
+        let result = ultraHistoryRichText(self.page([.paragraph(.concat([.bold(.plain("B")), .textCustomEmoji(fileId: 1, alt: "🙂"), .textSpoiler(text: .plain("S"))]))], complete: false))
+        XCTAssertEqual(result.text, "B🙂S")
+        XCTAssertTrue(result.truncated)
+        let normal = ultraHistoryMessageText(text: "Normal", attributes: [])
+        XCTAssertEqual(normal.text, "Normal")
+        XCTAssertTrue(normal.usesEntities)
+        XCTAssertFalse(normal.truncated)
+    }
+}
