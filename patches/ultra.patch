new file mode 100644
index 00000000..09568fd7
--- /dev/null
+++ b/submodules/TelegramUIPreferences/Sources/UltraLocalDisplayValues.swift
@@ -0,0 +1,50 @@
+import Foundation
+
+public struct UltraLocalDisplayValues: Codable, Equatable {
+    public var enabled: Bool = false
+    public var phone: String?
+    public var stars: Int64?
+    public init() {}
+
+    public static func make(enabled: Bool, phone: String, stars: String) -> UltraLocalDisplayValues? {
+        let phone = phone.trimmingCharacters(in: .whitespacesAndNewlines)
+        let stars = stars.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard phone.count <= 64, phone.utf8.count <= 256, phone.rangeOfCharacter(from: .controlCharacters) == nil else { return nil }
+        var result = UltraLocalDisplayValues()
+        result.enabled = enabled
+        result.phone = phone.isEmpty ? nil : phone
+        if !stars.isEmpty {
+            guard stars.utf8.allSatisfy({ (48 ... 57).contains($0) }), let value = Int64(stars), value <= 9_000_000_000_000_000 else { return nil }
+            result.stars = value
+        }
+        return result
+    }
+}
+
+public enum UltraLocalDisplayStore {
+    private static func key(_ accountId: Int64) -> String { return "ultra.localDisplay.v1.\(accountId)" }
+    public static func current(accountId: Int64, defaults: UserDefaults = .standard) -> UltraLocalDisplayValues {
+        guard let data = defaults.data(forKey: self.key(accountId)), data.count <= 2048,
+              let decoded = try? JSONDecoder().decode(UltraLocalDisplayValues.self, from: data),
+              let checked = UltraLocalDisplayValues.make(enabled: decoded.enabled, phone: decoded.phone ?? "", stars: decoded.stars.map(String.init) ?? "") else { return UltraLocalDisplayValues() }
+        return checked
+    }
+    public static func save(_ values: UltraLocalDisplayValues, accountId: Int64, defaults: UserDefaults = .standard) throws {
+        guard let checked = UltraLocalDisplayValues.make(enabled: values.enabled, phone: values.phone ?? "", stars: values.stars.map(String.init) ?? "") else { throw CocoaError(.coderInvalidValue) }
+        defaults.set(try JSONEncoder().encode(checked), forKey: self.key(accountId))
+    }
+    public static func reset(accountId: Int64, defaults: UserDefaults = .standard) { defaults.removeObject(forKey: self.key(accountId)) }
+
+    public static func giftSlug(_ input: String) -> String? {
+        var slug = input.trimmingCharacters(in: .whitespacesAndNewlines)
+        if slug.contains("://") {
+            guard let url = URL(string: slug), url.scheme?.lowercased() == "https", url.host?.lowercased() == "t.me", url.user == nil, url.password == nil, url.port == nil, url.query == nil, url.fragment == nil else { return nil }
+            let parts = url.path.split(separator: "/")
+            guard parts.count == 2, parts[0] == "nft" else { return nil }
+            slug = String(parts[1])
+        }
+        guard !slug.isEmpty, slug.utf8.count <= 128,
+              slug.utf8.allSatisfy({ (48 ... 57).contains($0) || (65 ... 90).contains($0) || (97 ... 122).contains($0) || $0 == 45 }) else { return nil }
+        return slug
+    }
+}
diff --git a/submodules/TelegramUIPreferences/Sources/UltraLocalGiftGalleryStore.swift b/submodules/TelegramUIPreferences/Sources/UltraLocalGiftGalleryStore.swift
new file mode 100644
