@@ -0,0 +1,31 @@
+import Foundation
+import XCTest
+import Postbox
+@testable import TelegramCore
+
+final class UltraImageUploadSourceTests: XCTestCase {
+    func testEnabledModeWrapsEvenInvalidBytesRatherThanReturningAnUnverifiedSource() {
+        let data = Data("synthetic invalid image".utf8)
+        let source = ultraImageUploadSource(.data(data), privacy: .images, expectedMimeType: "image/png")
+        guard case let .sanitizedImage(.data(payload), expectedMimeType) = source else { return XCTFail("Must go through the sanitizer before any uploader is created") }
+        XCTAssertEqual(payload, data)
+        XCTAssertEqual(expectedMimeType, "image/png")
+        guard case let .data(unchanged) = ultraImageUploadSource(.data(data), privacy: .disabled) else { return XCTFail("Disabled mode must preserve the native source") }
+        XCTAssertEqual(unchanged, data)
+    }
+
+    func testDocumentEligibilityExcludesStickersAndUnrelatedMedia() {
+        XCTAssertEqual(ultraImageUploadDocumentPrivacy(.images, mimeType: "image/png", attributes: []), .images)
+        XCTAssertEqual(ultraImageUploadDocumentPrivacy(.images, mimeType: "image/png", attributes: [.Sticker(displayText: "synthetic", packReference: nil, maskData: nil)]), .disabled)
+        XCTAssertEqual(ultraImageUploadDocumentPrivacy(.images, mimeType: "video/mp4", attributes: []), .disabled)
+        XCTAssertEqual(ultraImageUploadDocumentPrivacy(.disabled, mimeType: "image/jpeg", attributes: []), .disabled)
+    }
+
+    func testReplacingDocumentNamesPreservesDimensionsAndDoesNotMutateTheSource() {
+        let size = TelegramMediaFileAttribute.ImageSize(size: PixelDimensions(width: 16, height: 8))
+        let attributes: [TelegramMediaFileAttribute] = [.FileName(fileName: "synthetic-personal-name.jpg"), size, .FileName(fileName: "another-name.jpg")]
+        XCTAssertEqual(ultraImageUploadFileAttributes(attributes, mimeType: "image/jpeg", privacy: .images), [size, .FileName(fileName: "ULTRA-clean.jpg")])
+        XCTAssertEqual(ultraImageUploadFileAttributes(attributes, mimeType: "image/jpeg", privacy: .disabled), attributes)
+        XCTAssertEqual(attributes.count, 3)
+    }
+}
