@@ -0,0 +1,111 @@
+import Foundation
+import AVFoundation
+import XCTest
+@testable import UltraVideoPreparing
+
+final class UltraVideoPreparationTests: XCTestCase {
+    func testInputLimitsRejectNonFiniteDimensionsDurationAndExtraTracks() {
+        XCTAssertTrue(UltraVideoPreparationPolicy.accepts(duration: 180, width: 3840, height: 2160, videoTracks: 1, audioTracks: 1))
+        for duration in [Double.nan, .infinity, -1, 0, 180.01] {
+            XCTAssertFalse(UltraVideoPreparationPolicy.accepts(duration: duration, width: 100, height: 100, videoTracks: 1, audioTracks: 0))
+        }
+        for width in [Double.nan, .infinity, -1, 0, 4097] {
+            XCTAssertFalse(UltraVideoPreparationPolicy.accepts(duration: 1, width: width, height: 100, videoTracks: 1, audioTracks: 0))
+        }
+        XCTAssertFalse(UltraVideoPreparationPolicy.accepts(duration: 1, width: 4096, height: 4096, videoTracks: 1, audioTracks: 0))
+        XCTAssertFalse(UltraVideoPreparationPolicy.accepts(duration: 1, width: 100, height: 100, videoTracks: 2, audioTracks: 0))
+        XCTAssertFalse(UltraVideoPreparationPolicy.accepts(duration: 1, width: 100, height: 100, videoTracks: 1, audioTracks: 2))
+    }
+
+    func testOutputCannotLoseAudioBeTruncatedOrExceedTheByteLimit() {
+        XCTAssertTrue(UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: 10, duration: 10, bytes: 100, videoTracks: 1, audioTracks: 1, expectedAudioTracks: 1))
+        XCTAssertFalse(UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: 10, duration: 9, bytes: 100, videoTracks: 1, audioTracks: 1, expectedAudioTracks: 1))
+        XCTAssertFalse(UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: 10, duration: 10, bytes: 100, videoTracks: 1, audioTracks: 0, expectedAudioTracks: 1))
+        XCTAssertFalse(UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: 10, duration: 10, bytes: 0, videoTracks: 1, audioTracks: 1, expectedAudioTracks: 1))
+        XCTAssertFalse(UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: 10, duration: 10, bytes: UltraVideoPreparationPolicy.maximumOutputBytes + 1, videoTracks: 1, audioTracks: 1, expectedAudioTracks: 1))
+    }
+
+    func testPrivateInputCopyIsExactDoesNotModifySourceAndRejectsReuse() throws {
+        let source = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-source-\(UUID().uuidString).mov")
+        defer { try? FileManager.default.removeItem(at: source) }
+        let bytes = Data(repeating: 0x42, count: 131073)
+        try bytes.write(to: source)
+        let workspace = try UltraVideoPreparationWorkspace()
+        try workspace.copyInput(from: source, cancelled: { false })
+        XCTAssertEqual(try Data(contentsOf: workspace.input), bytes)
+        XCTAssertEqual(try Data(contentsOf: source), bytes)
+        XCTAssertThrowsError(try workspace.copyInput(from: source, cancelled: { false }))
+    }
+
+    func testCancellationStopsBeforeCopyingAndWorkspaceCleansItsOwnDirectory() throws {
+        let source = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-cancel-\(UUID().uuidString).mov")
+        defer { try? FileManager.default.removeItem(at: source) }
+        try Data([1, 2, 3]).write(to: source)
+        var workspace: UltraVideoPreparationWorkspace? = try UltraVideoPreparationWorkspace()
+        let directory = try XCTUnwrap(workspace?.directory)
+        XCTAssertThrowsError(try workspace?.copyInput(from: source, cancelled: { true }))
+        workspace = nil
+        XCTAssertFalse(FileManager.default.fileExists(atPath: directory.path))
+        XCTAssertEqual(try Data(contentsOf: source), Data([1, 2, 3]))
+    }
+
+    func testSymlinksAndDirectoriesAreRejected() throws {
+        let workspace = try UltraVideoPreparationWorkspace()
+        XCTAssertThrowsError(try workspace.copyInput(from: workspace.directory, cancelled: { false }))
+        let source = workspace.directory.appendingPathComponent("synthetic.mov")
+        try Data([1]).write(to: source)
+        let link = workspace.directory.appendingPathComponent("link.mov")
+        try FileManager.default.createSymbolicLink(at: link, withDestinationURL: source)
+        XCTAssertThrowsError(try workspace.copyInput(from: link, cancelled: { false }))
+    }
+
+    func testAbandonedCleanupPreservesActiveAndUnrelatedDirectories() throws {
+        let active = try UltraVideoPreparationWorkspace()
+        let base = FileManager.default.temporaryDirectory
+        let abandoned = base.appendingPathComponent("ultra-video-\(UUID().uuidString)", isDirectory: true)
+        let unrelated = base.appendingPathComponent("unrelated-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: abandoned, withIntermediateDirectories: false)
+        try FileManager.default.createDirectory(at: unrelated, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: abandoned); try? FileManager.default.removeItem(at: unrelated) }
+        let old = Date(timeIntervalSinceNow: -2 * 86400)
+        for url in [active.directory, abandoned, unrelated] {
+            try FileManager.default.setAttributes([.modificationDate: old], ofItemAtPath: url.path)
+        }
+        UltraVideoPreparationWorkspace.cleanupAbandoned()
+        XCTAssertTrue(FileManager.default.fileExists(atPath: active.directory.path))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: abandoned.path))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: unrelated.path))
+    }
+
+    func testEmptyAndOversizedInputsAreRejectedBeforeCopy() throws {
+        let workspace = try UltraVideoPreparationWorkspace()
+        let empty = workspace.directory.appendingPathComponent("empty.mov")
+        try Data().write(to: empty)
+        XCTAssertThrowsError(try workspace.copyInput(from: empty, cancelled: { false }))
+        let large = workspace.directory.appendingPathComponent("large.mov")
+        XCTAssertTrue(FileManager.default.createFile(atPath: large.path, contents: nil))
+        let writer = try FileHandle(forWritingTo: large)
+        try writer.truncate(atOffset: UInt64(UltraVideoPreparationPolicy.maximumInputBytes + 1))
+        try writer.close()
+        XCTAssertThrowsError(try workspace.copyInput(from: large, cancelled: { false }))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: workspace.input.path))
+    }
+
+    @MainActor func testMalformedAssetDoesNotProduceAReadyOutput() async throws {
+        guard #available(macOS 26.0, iOS 26.0, *) else { throw XCTSkip("Modern AVFoundation export requires macOS/iOS 26") }
+        let workspace = try UltraVideoPreparationWorkspace()
+        try Data("synthetic non-video".utf8).write(to: workspace.input)
+        do {
+            let _ = try await UltraVideoSanitizer.prepare(workspace)
+            XCTFail("Invalid video must not be accepted")
+        } catch { }
+        XCTAssertFalse(FileManager.default.fileExists(atPath: workspace.output.path))
+    }
+
+    func testAssetCannotResolveMediaOutsideItsOwnContainer() throws {
+        guard #available(macOS 26.0, iOS 26.0, *) else { throw XCTSkip("Modern video preparation requires macOS/iOS 26") }
+        let workspace = try UltraVideoPreparationWorkspace()
+        let asset = UltraVideoSanitizer.restrictedAsset(at: workspace.input)
+        XCTAssertEqual(asset.referenceRestrictions, .forbidAll)
+    }
+}
diff --git a/Tests/UltraVideoPreparationTests/UltraVideoUploadPreparationTests.swift b/Tests/UltraVideoPreparationTests/UltraVideoUploadPreparationTests.swift
new file mode 100644
index 00000000..5c16e758
--- /dev/null
+++ b/Tests/UltraVideoPreparationTests/UltraVideoUploadPreparationTests.swift
@@ -0,0 +1,95 @@
+import Foundation
+import XCTest
+@testable import UltraVideoPreparing
+
+private actor UltraVideoExecutionProbe {
+    private var active = 0
+    private(set) var peak = 0
+    func enter() { self.active += 1; self.peak = max(self.peak, self.active) }
+    func leave() { self.active -= 1 }
+}
+
+final class UltraVideoUploadPreparationTests: XCTestCase {
+    func testAutomaticExportCannotSilentlyChangeFrameDimensions() {
+        XCTAssertTrue(UltraVideoPreparationPolicy.preservesGeometry(sourceWidth: 3840, sourceHeight: 2160, width: 3840, height: 2160))
+        XCTAssertFalse(UltraVideoPreparationPolicy.preservesGeometry(sourceWidth: 3840, sourceHeight: 2160, width: 1920, height: 1080))
+        XCTAssertFalse(UltraVideoPreparationPolicy.preservesGeometry(sourceWidth: 1080, sourceHeight: 1920, width: 1920, height: 1080))
+        for value in [Double.nan, .infinity, 0, -1] {
+            XCTAssertFalse(UltraVideoPreparationPolicy.preservesGeometry(sourceWidth: value, sourceHeight: 1080, width: value, height: 1080))
+        }
+    }
+
+    func testInMemorySourceIsCopiedExactlyWithoutOverwritingAnExistingInput() throws {
+        let workspace = try UltraVideoPreparationWorkspace()
+        let bytes = Data((0 ..< 150000).map { UInt8($0 % 251) })
+        try workspace.writeInput(bytes, cancelled: { false })
+        XCTAssertEqual(try Data(contentsOf: workspace.input), bytes)
+        XCTAssertThrowsError(try workspace.writeInput(Data([1]), cancelled: { false }))
+        XCTAssertEqual(try Data(contentsOf: workspace.input), bytes)
+    }
+
+    func testCancelledOrEmptyMemoryInputCannotBecomeAReadyVideo() throws {
+        let empty = try UltraVideoPreparationWorkspace()
+        XCTAssertThrowsError(try empty.writeInput(Data(), cancelled: { false }))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: empty.input.path))
+        let cancelled = try UltraVideoPreparationWorkspace()
+        XCTAssertThrowsError(try cancelled.writeInput(Data([1, 2, 3]), cancelled: { true }))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: cancelled.output.path))
+    }
+
+    func testGateSerializesConcurrentExportWork() async throws {
+        let gate = UltraVideoPreparationGate()
+        let probe = UltraVideoExecutionProbe()
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            for _ in 0 ..< 8 {
+                group.addTask {
+                    try await gate.acquire(UUID())
+                    await probe.enter()
+                    await Task.yield()
+                    await probe.leave()
+                    await gate.release()
+                }
+            }
+            try await group.waitForAll()
+        }
+        let peak = await probe.peak
+        let queued = await gate.queuedCount
+        XCTAssertEqual(peak, 1)
+        XCTAssertEqual(queued, 0)
+    }
+
+    func testCancellingAQueuedJobRemovesItsContinuationAndDoesNotBlockTheNextJob() async throws {
+        let gate = UltraVideoPreparationGate()
+        try await gate.acquire(UUID())
+        let waiter = Task {
+            try await gate.acquire(UUID())
+            await gate.release()
+            try Task.checkCancellation()
+        }
+        var queued = false
+        let queueDeadline = Date(timeIntervalSinceNow: 5)
+        while Date() < queueDeadline {
+            let count = await gate.queuedCount
+            if count == 1 { queued = true; break }
+            await Task.yield()
+        }
+        XCTAssertTrue(queued)
+        waiter.cancel()
+        var removed = false
+        let cancelDeadline = Date(timeIntervalSinceNow: 5)
+        while Date() < cancelDeadline {
+            let count = await gate.queuedCount
+            if count == 0 { removed = true; break }
+            await Task.yield()
+        }
+        XCTAssertTrue(removed)
+        await gate.release()
+        let result = await waiter.result
+        switch result {
+        case .success: XCTFail("Cancelled work must not succeed")
+        case let .failure(error): XCTAssertTrue(error is CancellationError)
+        }
+        try await gate.acquire(UUID())
+        await gate.release()
+    }
+}
