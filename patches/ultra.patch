@@ -0,0 +1,11 @@
+import Foundation
+
+public enum UltraViewOnceSavePolicy {
+    public static let maximumBytes: Int64 = 512 * 1024 * 1024
+    public static func isEligible(isViewOnce: Bool, isSecretChat: Bool, hasPaidMedia: Bool, isSensitive: Bool) -> Bool {
+        return isViewOnce && !isSecretChat && !hasPaidMedia && !isSensitive
+    }
+    public static func canSaveCompleteData(isComplete: Bool, availableSize: Int64) -> Bool {
+        return isComplete && availableSize > 0 && availableSize <= self.maximumBytes
+    }
+}
