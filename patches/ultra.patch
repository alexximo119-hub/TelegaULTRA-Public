diff --git a/build-system/Make/tests/test_unsigned_build.py b/build-system/Make/tests/test_unsigned_build.py
new file mode 100644
index 00000000..2720bfde
--- /dev/null
+++ b/build-system/Make/tests/test_unsigned_build.py
@@ -0,0 +1,61 @@
+import argparse
+from contextlib import redirect_stderr
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+# VM locking uses fcntl on macOS; these tests exercise configuration only.
+if sys.platform == 'win32':
+    with patch.dict(sys.modules, {'TartBuild': Mock()}):
+        import Make
+else:
+    import Make
+
+
+class UnsignedBuildTests(unittest.TestCase):
+    def test_unsigned_does_not_resolve_private_signing_material(self):
+        data = Make.resolve_codesigning(
+            argparse.Namespace(unsigned=True), None, None, None, None
+        )
+        self.assertEqual(data.aps_environment, 'production')
+        self.assertFalse(data.use_xcode_managed_codesigning)
+
+    def test_unsigned_is_exclusive_with_signing_directory(self):
+        parser = argparse.ArgumentParser()
+        Make.add_codesigning_common_arguments(parser)
+        with self.assertRaises(SystemExit), redirect_stderr(io.StringIO()):
+            parser.parse_args([
+                '--configurationPath=config.json', '--unsigned',
+                '--codesigningInformationPath=certificates',
+            ])
+
+    def test_unsigned_configuration_has_own_identity_and_no_profiles(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            configuration = root / 'configuration.json'
+            template = Path(__file__).resolve().parents[2] / 'appstore-configuration.json'
+            settings = json.loads(template.read_text(encoding='utf-8'))
+            settings['bundle_id'] = 'app.telegaultra.client'
+            configuration.write_text(json.dumps(settings), encoding='utf-8')
+            bazel = Mock()
+            bazel.bazel = '/test/bazel'
+            bazel.common_args = []
+            Make.resolve_configuration(
+                str(root), bazel,
+                argparse.Namespace(unsigned=True, configurationPath=str(configuration)),
+                None,
+            )
+            bazel.set_disable_provisioning_profiles.assert_called_once()
+            self.assertIn('--features=disable_legacy_signing', bazel.common_args)
+            output = root / 'build-input' / 'configuration-repository'
+            self.assertIn('app.telegaultra.client', (output / 'variables.bzl').read_text())
+            self.assertEqual(list((output / 'provisioning').glob('*.mobileprovision')), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
