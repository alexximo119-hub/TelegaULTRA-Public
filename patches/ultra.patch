+// Generated synthetic fixtures, never real Telegram session data.
+// Reference: Python hashlib/struct + independent Windows .NET AES ECB/IGE.
+import Foundation
+
+enum UltraSyntheticTData {
+    static let legacy = Data(base64Encoded: "")!
+    static let password = Data(base64Encoded: "")!
+    static let modern = Data(base64Encoded: "")!
+    static let blocked = Data(base64Encoded: "")!
+    static let future = Data(base64Encoded: "")!
+    static let account = Data(base64Encoded: "")!
+    static let emptyKeySHA256 = "d392b2760d13fd232440506d53fd1aa8822ab4a2e342ce7d79d95ea82c0aeb70"
+    static let passwordKeySHA256 = "8318acdc6602cdac0dc46b2ca0ce730fa34630f751c8e3ce741e54f2a15ef3f1"
+    static let vectors: [(cipher: Data, key: Data, iv: Data, plaintext: Data)] = [
+        (Data(base64Encoded: "")!, Data(base64Encoded: "TPC8yHmyWCRDmGC5iIP+JyU7/c5GoVUyT+U5A6X23GM=")!, Data(base64Encoded: "TzRE15nFXTyOvI6GRWQwISv62ZaU1COKdlo+jOZ74is=")!, Data(base64Encoded: "")!),
+        (Data(base64Encoded: "")!, Data(base64Encoded: "OKmzvHvOCLpu97Cpr0rKQVRYKQFf1uipwNDAFJo5rmk=")!, Data(base64Encoded: "8U/A14OJH9/f5jRbcITHNTpYomv7NyQUXaBJd7aTE6w=")!, Data(base64Encoded: "")!),
+        (Data(base64Encoded: "xj2dC99mFyB7yW3UJJY2JA==")!, Data(base64Encoded: "pY1Cxf0+ZC6rESan9TCUm0M5ZJkk+CR46pVwHdgN0Yc=")!, Data(base64Encoded: "IaoVGmlGpD0aUCtcUhWEBdNh1aqSgBx76GGqQ7rEMM0=")!, Data(base64Encoded: "EAAAAAAAAAEAAAAAAAAAAA==")!),
+        (Data(base64Encoded: "")!, Data(base64Encoded: "YxUXRRblj3hfEE+k8ihz64GgG/rNBCej5pha1PuKtbs=")!, Data(base64Encoded: "Hnz923dTmklWHpiIaopuarxvHChz5KxTAyT5fgSiQWw=")!, Data(base64Encoded: "")!),
+    ]
+}
diff --git a/Tests/UltraSessionImportTests/UltraTDataFormatTests.swift b/Tests/UltraSessionImportTests/UltraTDataFormatTests.swift
new file mode 100644
index 00000000..23949e78
--- /dev/null
+++ b/Tests/UltraSessionImportTests/UltraTDataFormatTests.swift
@@ -0,0 +1,103 @@
+import Foundation
+import CryptoKit
+import XCTest
+@testable import UltraSessionFormats
+
+final class UltraTDataFormatTests: XCTestCase {
+    private func decrypt(_ cipher: Data, _ key: Data, _ iv: Data) -> Data? {
+        // These vectors were generated independently with Windows .NET AES, not this parser.
+        return UltraSyntheticTData.vectors.first(where: { $0.cipher == cipher && $0.key == key && $0.iv == iv })?.plaintext
+    }
+
+    private func read(_ root: Data, passcode: String = "") throws -> [UltraSessionImportData] {
+        return try UltraTDataFormat.read(passcode: Data(passcode.utf8), loadFile: { name in
+            switch name {
+            case "key_datas": return root
+            case "D877F783D5D3EF8Cs": return UltraSyntheticTData.account
+            default: throw UltraSessionImportError.fileUnavailable
+            }
+        }, decrypt: self.decrypt)
+    }
+
+    func testLegacyOpenStoreFindsTheWideUserIdAndOnlyTheMainKey() throws {
+        let candidates = try self.read(UltraSyntheticTData.legacy)
+        let candidate = try XCTUnwrap(candidates.first)
+        XCTAssertEqual(candidates.count, 1)
+        XCTAssertEqual(candidate.format, .tdata)
+        XCTAssertEqual(candidate.claimedUserId, 4294967300)
+        XCTAssertEqual(candidate.datacenterId, 2)
+        XCTAssertFalse(candidate.testingEnvironment)
+        XCTAssertEqual(candidate.authKey, Data(repeating: 0x11, count: 256))
+    }
+
+    func testLegacyPasscodeIsUsedAndIncorrectPasscodesFailClosed() throws {
+        XCTAssertEqual(try self.read(UltraSyntheticTData.password, passcode: "synthetic-passcode").count, 1)
+        for passcode in ["", "wrong synthetic passcode"] {
+            XCTAssertThrowsError(try self.read(UltraSyntheticTData.password, passcode: passcode)) { error in
+                XCTAssertEqual(error as? UltraSessionImportError, .invalidPasscodeOrData)
+            }
+        }
+    }
+
+    func testModernOpenStoreWorksButProtectedOrFutureShapesAreRejected() throws {
+        XCTAssertEqual(try self.read(UltraSyntheticTData.modern).count, 1)
+        XCTAssertThrowsError(try self.read(UltraSyntheticTData.blocked)) { error in
+            XCTAssertEqual(error as? UltraSessionImportError, .unsupportedProtection)
+        }
+        XCTAssertThrowsError(try self.read(UltraSyntheticTData.future)) { error in
+            XCTAssertEqual(error as? UltraSessionImportError, .unsupportedFormat)
+        }
+        XCTAssertThrowsError(try self.read(UltraSyntheticTData.modern, passcode: "synthetic-passcode"))
+    }
+
+    func testTDFChecksumMagicAndSizeAreVerifiedBeforeDecryption() {
+        var changed = UltraSyntheticTData.legacy
+        changed[10] ^= 1
+        for data in [Data(), Data("TDF$".utf8), changed, Data(repeating: 0, count: UltraTDataFormat.maximumFileBytes + 1)] {
+            XCTAssertThrowsError(try UltraTDataFormat.envelope(data))
+        }
+    }
+
+    func testPBKDF2MatchesIndependentSHA512ReferenceAndBoundsInputs() throws {
+        let salt = Data((0 ..< 32).map { UInt8($0) })
+        let empty = try UltraTDataFormat.localKey(passcode: Data(), salt: salt)
+        let password = try UltraTDataFormat.localKey(passcode: Data("synthetic-passcode".utf8), salt: salt)
+        XCTAssertEqual(empty.count, 256)
+        XCTAssertEqual(SHA256.hash(data: empty).map({ String(format: "%02x", $0) }).joined(), UltraSyntheticTData.emptyKeySHA256)
+        XCTAssertEqual(SHA256.hash(data: password).map({ String(format: "%02x", $0) }).joined(), UltraSyntheticTData.passwordKeySHA256)
+        XCTAssertThrowsError(try UltraTDataFormat.localKey(passcode: Data(repeating: 1, count: 257), salt: salt))
+        XCTAssertThrowsError(try UltraTDataFormat.localKey(passcode: Data(), salt: Data(repeating: 1, count: 31)))
+    }
+
+    func testDefaultAccountFilenameAndIndexBoundsMatchDesktop() throws {
+        XCTAssertEqual(try UltraTDataFormat.accountFileName(index: 0), "D877F783D5D3EF8Cs")
+        let second = try UltraTDataFormat.accountFileName(index: 1)
+        XCTAssertNotEqual(second, "D877F783D5D3EF8Cs")
+        XCTAssertEqual(second.count, 17)
+        XCTAssertTrue(second.hasSuffix("s"))
+        XCTAssertThrowsError(try UltraTDataFormat.accountFileName(index: 32))
+        XCTAssertThrowsError(try UltraTDataFormat.accountFileName(index: UInt64.max))
+    }
+
+    func testOnlyTheTwoRequiredAuthorizationFilesAreRead() throws {
+        var requested: [String] = []
+        _ = try UltraTDataFormat.read(passcode: Data(), loadFile: { name in
+            requested.append(name)
+            if name == "key_datas" { return UltraSyntheticTData.legacy }
+            if name == "D877F783D5D3EF8Cs" { return UltraSyntheticTData.account }
+            throw UltraSessionImportError.fileUnavailable
+        }, decrypt: self.decrypt)
+        XCTAssertEqual(requested, ["key_datas", "D877F783D5D3EF8Cs"])
+        XCTAssertThrowsError(try UltraTDataFormat.read(passcode: Data(), loadFile: { _ in throw UltraSessionImportError.fileUnavailable }, decrypt: self.decrypt))
+    }
+
+    func testDecryptedLengthAndSHA1CannotBeBypassedByMalformedData() {
+        let key = Data(repeating: 1, count: 256)
+        var invalid = Data(repeating: 0, count: 16)
+        for index in 0 ..< 4 { invalid[index] = 255 }
+        let encrypted = Data(Insecure.SHA1.hash(data: invalid).prefix(16)) + Data(repeating: 0, count: 16)
+        XCTAssertThrowsError(try UltraTDataFormat.decrypted(encrypted, key: key, decrypt: { _, _, _ in invalid }))
+        XCTAssertThrowsError(try UltraTDataFormat.decrypted(encrypted, key: key, decrypt: { _, _, _ in Data(repeating: 0, count: 16) }))
+        XCTAssertThrowsError(try UltraTDataFormat.decrypted(Data(repeating: 0, count: 31), key: key, decrypt: self.decrypt))
+    }
+}
