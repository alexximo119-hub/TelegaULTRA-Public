@@ -0,0 +1,64 @@
+import Foundation
+import XCTest
+@testable import UltraHistoryModels
+
+final class UltraLocalHistoryOwnershipTests: XCTestCase {
+    func testReceivedSnapshotUpdatesWhenAnIncompleteSourceBecomesComplete() {
+        let partial = UltraLocalHistoryRecord(peerId: 100, messageId: 1, authorId: 7, messageTimestamp: 1000, capturedAt: 1000, kind: .received, text: "Same body", sourceTruncated: true)
+        let full = UltraLocalHistoryRecord(peerId: 100, messageId: 1, authorId: 7, messageTimestamp: 1000, capturedAt: 1001, kind: .received, text: "Same body")
+        var contents = UltraLocalHistoryContents()
+        contents.append(partial, now: 1001)
+        contents.append(full, now: 1001)
+        XCTAssertEqual(contents.records.count, 1)
+        XCTAssertFalse(contents.records[0].truncated)
+        XCTAssertEqual(contents.records[0].capturedAt, 1001)
+    }
+    private func record(_ id: Int32, author: Int64?, own: Bool?, kind: UltraLocalHistoryRecord.Kind = .deleted) -> UltraLocalHistoryRecord {
+        return UltraLocalHistoryRecord(peerId: 100, messageId: id, authorId: author, messageTimestamp: 1000, capturedAt: 1000, kind: kind, text: "Synthetic \(id)", isOwn: own)
+    }
+
+    func testEnablingExclusionHidesPreviouslySavedOwnCopiesWithoutErasingThem() {
+        let records = [self.record(1, author: 42, own: true), self.record(2, author: 100, own: true), self.record(3, author: 7, own: false), self.record(4, author: nil, own: nil)]
+        var policy = UltraLocalHistoryPolicy()
+        policy.excludeOwn = false
+        let visible = UltraLocalHistorySnapshot(policy: policy, records: records, unavailable: false)
+        XCTAssertEqual(visible.hidingOwn(accountPeerId: 42).records, records)
+        policy.excludeOwn = true
+        let hidden = UltraLocalHistorySnapshot(policy: policy, records: records, unavailable: true).hidingOwn(accountPeerId: 42)
+        XCTAssertEqual(hidden.records.map(\.messageId), [3, 4])
+        XCTAssertTrue(hidden.unavailable)
+        XCTAssertEqual(hidden.policy, policy)
+        XCTAssertEqual(visible.records.count, 4)
+    }
+
+    func testLegacyRecordsWithoutOutgoingFlagUseOnlyKnownAuthorIdentity() throws {
+        let original = self.record(1, author: 42, own: nil)
+        let decoded = try JSONDecoder().decode(UltraLocalHistoryRecord.self, from: JSONEncoder().encode(original))
+        XCTAssertNil(decoded.isOwn)
+        let other = self.record(2, author: 7, own: nil)
+        let snapshot = UltraLocalHistorySnapshot(policy: UltraLocalHistoryPolicy(), records: [decoded, other], unavailable: false)
+        XCTAssertEqual(snapshot.hidingOwn(accountPeerId: 42).records, [other])
+        XCTAssertEqual(snapshot.hidingOwn(accountPeerId: 9).records, [decoded, other])
+    }
+
+    func testOwnRevisionsAreHiddenBeforeSearchAndInlinePreview() {
+        var policy = UltraLocalHistoryPolicy()
+        policy.inlineEdits = true
+        let own = self.record(1, author: nil, own: true, kind: .edited)
+        let other = self.record(2, author: 7, own: false, kind: .edited)
+        let snapshot = UltraLocalHistorySnapshot(policy: policy, records: [own, other], unavailable: false).hidingOwn(accountPeerId: 42)
+        XCTAssertTrue(snapshot.searching("Synthetic 1").records.isEmpty)
+        XCTAssertNil(snapshot.inlinePreviews(peerId: 100, now: 1000)[1])
+        XCTAssertEqual(snapshot.inlinePreviews(peerId: 100, now: 1000)[2]?.text, other.text)
+    }
+
+    func testNewOwnershipFlagSurvivesCodingAndDoesNotChangeTextOrFormatting() throws {
+        for own in [false, true] {
+            let record = self.record(1, author: nil, own: own)
+            let decoded = try JSONDecoder().decode(UltraLocalHistoryRecord.self, from: JSONEncoder().encode(record))
+            XCTAssertEqual(decoded, record)
+            XCTAssertEqual(decoded.isOwn, own)
+            XCTAssertEqual(decoded.text, "Synthetic 1")
+        }
+    }
+}
diff --git a/Tests/UltraHistoryTests/UltraLocalHistoryPolicyTests.swift b/Tests/UltraHistoryTests/UltraLocalHistoryPolicyTests.swift
new file mode 100644
index 00000000..d7711e3d
--- /dev/null
+++ b/Tests/UltraHistoryTests/UltraLocalHistoryPolicyTests.swift
@@ -0,0 +1,88 @@
+import Foundation
+import XCTest
+@testable import UltraHistoryModels
+
+final class UltraLocalHistoryPolicyTests: XCTestCase {
+    func testAllKindsAreDisabledByDefaultForBothOriginsAndAuthors() {
+        let policy = UltraLocalHistoryPolicy()
+        XCTAssertFalse(policy.localDeletions)
+        for kind in [UltraLocalHistoryRecord.Kind.deleted, .edited, .received] {
+            for isOwn in [false, true] {
+                for locallyDeleted in [false, true] {
+                    XCTAssertFalse(policy.allowsCapture(kind: kind, isOwn: isOwn, locallyDeleted: locallyDeleted))
+                }
+            }
+        }
+    }
+
+    func testLocalDeletionRequiresBothIndependentRecordingFlags() {
+        for deleted in [false, true] {
+            for local in [false, true] {
+                var policy = UltraLocalHistoryPolicy()
+                policy.deleted = deleted
+                policy.localDeletions = local
+                XCTAssertEqual(policy.allowsCapture(kind: .deleted, isOwn: false, locallyDeleted: true), deleted && local)
+                XCTAssertEqual(policy.allowsCapture(kind: .deleted, isOwn: false), deleted)
+            }
+        }
+    }
+
+    func testOwnMessageExclusionAppliesToEveryKindAndDeletionOrigin() {
+        var policy = UltraLocalHistoryPolicy()
+        policy.deleted = true
+        policy.edited = true
+        policy.received = true
+        policy.localDeletions = true
+        for kind in [UltraLocalHistoryRecord.Kind.deleted, .edited, .received] {
+            XCTAssertFalse(policy.allowsCapture(kind: kind, isOwn: true))
+            XCTAssertTrue(policy.allowsCapture(kind: kind, isOwn: false))
+        }
+        XCTAssertFalse(policy.allowsCapture(kind: .deleted, isOwn: true, locallyDeleted: true))
+        policy.excludeOwn = false
+        for kind in [UltraLocalHistoryRecord.Kind.deleted, .edited, .received] {
+            XCTAssertTrue(policy.allowsCapture(kind: kind, isOwn: true))
+        }
+        XCTAssertTrue(policy.allowsCapture(kind: .deleted, isOwn: true, locallyDeleted: true))
+    }
+
+    func testLocalDeletionFlagDoesNotTurnOnOtherRecordingOrEdits() {
+        var policy = UltraLocalHistoryPolicy()
+        policy.localDeletions = true
+        XCTAssertFalse(policy.isEnabled)
+        XCTAssertFalse(policy.allowsCapture(kind: .deleted, isOwn: false, locallyDeleted: true))
+        policy.edited = true
+        policy.received = true
+        XCTAssertFalse(policy.allowsCapture(kind: .edited, isOwn: false, locallyDeleted: true))
+        XCTAssertFalse(policy.allowsCapture(kind: .received, isOwn: false, locallyDeleted: true))
+        XCTAssertTrue(policy.allowsCapture(kind: .edited, isOwn: false))
+        XCTAssertTrue(policy.allowsCapture(kind: .received, isOwn: false))
+    }
+
+    func testLegacyRecordingPolicyDoesNotSilentlyEnableLocalDeletionCopies() throws {
+        let data = Data(#"{"deleted":true,"edited":true,"excludeOwn":false,"inlineEdits":true}"#.utf8)
+        let policy = try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: data)
+        XCTAssertFalse(policy.localDeletions)
+        XCTAssertTrue(policy.allowsCapture(kind: .deleted, isOwn: true))
+        XCTAssertFalse(policy.allowsCapture(kind: .deleted, isOwn: false, locallyDeleted: true))
+        XCTAssertTrue(policy.inlineEdits)
+        XCTAssertTrue(policy.edited)
+    }
+
+    func testLocalDeletionPolicyRoundTripPreservesIndependentOptions() throws {
+        var policy = UltraLocalHistoryPolicy()
+        policy.localDeletions = true
+        policy.deleted = true
+        policy.excludeOwn = false
+        let decoded = try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: JSONEncoder().encode(policy))
+        XCTAssertEqual(decoded, policy)
+        XCTAssertFalse(decoded.edited)
+        XCTAssertFalse(decoded.received)
+    }
+
+    func testMalformedLocalDeletionFlagFailsClosed() {
+        for value in [#""true""#, "1", "[]", "{}"] {
+            let data = Data("{\"deleted\":true,\"localDeletions\":\(value)}".utf8)
+            XCTAssertThrowsError(try JSONDecoder().decode(UltraLocalHistoryPolicy.self, from: data))
+        }
+    }
+}
