+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import PresentationDataUtils
+
+private final class UltraFontsArguments: NSObject, UIDocumentPickerDelegate {
+    let context: AccountContext
+    var present: (ViewController) -> Void = { _ in }
+    var refresh: () -> Void = {}
+    private var busy = false
+    private let queue = DispatchQueue(label: "app.telegaultra.font-import", qos: .utility)
+
+    init(context: AccountContext) {
+        self.context = context
+        super.init()
+    }
+
+    func alert(_ text: String) {
+        self.present(textAlertController(context: self.context, title: "Шрифты ULTRA", text: text, actions: [
+            TextAlertAction(type: .defaultAction, title: self.context.sharedContext.currentPresentationData.with { $0 }.strings.Common_OK, action: {})
+        ]))
+    }
+
+    func selectFile() {
+        guard !self.busy else { return }
+        self.busy = true
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.font, .data], asCopy: true)
+        picker.allowsMultipleSelection = false
+        picker.delegate = self
+        self.context.sharedContext.applicationBindings.presentNativeController(picker)
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        self.busy = false
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard let url = urls.first else { self.busy = false; return }
+        self.queue.async {
+            let scoped = url.startAccessingSecurityScopedResource()
+            defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+            let success: Bool
+            do {
+                try UltraFontRegistry.shared.importFont(from: url)
+                success = true
+            } catch {
+                success = false
+            }
+            DispatchQueue.main.async {
+                self.busy = false
+                self.refresh()
+                self.alert(success ? "Шрифт сохранён. Полностью закройте ULTRA и откройте снова для применения." : "Не удалось импортировать шрифт. Нужен корректный одиночный TTF/OTF до 10 МБ с уникальным именем. Системные шрифты не заменяются файлами с тем же именем.")
+            }
+        }
+    }
+
+    func reset() {
+        guard !self.busy else { return }
+        self.present(textAlertController(context: self.context, title: "Вернуть системный шрифт?", text: "Импортированный файл будет удалён. Изменение вступит в силу после полного перезапуска ULTRA.", actions: [
+            TextAlertAction(type: .genericAction, title: self.context.sharedContext.currentPresentationData.with { $0 }.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: "Сбросить", action: { [weak self] in
+                guard let self else { return }
+                do {
+                    try UltraFontRegistry.shared.reset()
+                    self.refresh()
+                    self.alert("Системный шрифт выбран. Перезапустите ULTRA.")
+                } catch {
+                    self.alert("Не удалось удалить импортированный файл.")
+                }
+            })
+        ]))
+    }
+}
+
+private enum UltraFontsEntry: ItemListNodeEntry {
+    case current(String)
+    case importFile
+    case reset
+    case footer
+
+    var stableId: Int32 {
+        switch self {
+        case .current: return 0
+        case .importFile: return 1
+        case .reset: return 2
+        case .footer: return 3
+        }
+    }
+    var section: ItemListSectionId { return 0 }
+    static func < (lhs: UltraFontsEntry, rhs: UltraFontsEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraFontsArguments
+        switch self {
+        case let .current(name):
+            return ItemListTextItem(presentationData: presentationData, text: .plain("После перезапуска: \(name)"), sectionId: self.section)
+        case .importFile:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Импортировать TTF / OTF", kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.selectFile() })
+        case .reset:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Вернуть системный шрифт", kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: { arguments.reset() })
+        case .footer:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Одиночный TTF/OTF до 10 МБ. Применяется к обычным шрифтам интерфейса и сообщений после перезапуска. Код, иконки, специальные начертания и встроенные веб-страницы могут использовать собственные шрифты. При недоступном или некорректном файле используется системный шрифт. Размеры текста сохраняются; проверьте переносы строк и читаемость выбранного шрифта."), sectionId: self.section)
+        }
+    }
+}
+
+func ultraFontsController(context: AccountContext) -> ViewController {
+    let arguments = UltraFontsArguments(context: context)
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    arguments.refresh = { revision.set(0) }
+    let signal = combineLatest(context.sharedContext.presentationData, revision.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let entries: [UltraFontsEntry] = [.current(UltraFontRegistry.shared.selectedName() ?? "Системный"), .importFile, .reset, .footer]
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Шрифты"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    arguments.present = { [weak controller] in controller?.present($0, in: .window(.root)) }
+    return controller
+}
diff --git a/submodules/SettingsUI/Sources/UltraImageSanitizerController.swift b/submodules/SettingsUI/Sources/UltraImageSanitizerController.swift
