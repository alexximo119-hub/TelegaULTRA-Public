+import Foundation
+
+public enum UltraProfileDatePolicy {
+    /// The API supplies MM.YYYY, never a registration day or an estimate derived from the user id.
+    public static func registrationMonth(_ value: String, now: Date = Date()) -> String? {
+        let parts = value.split(separator: ".", omittingEmptySubsequences: false)
+        guard parts.count == 2, (1 ... 2).contains(parts[0].count), parts[1].count == 4,
+              parts.allSatisfy({ $0.utf8.allSatisfy({ (48 ... 57).contains($0) }) }),
+              let month = Int(parts[0]), let year = Int(parts[1]), (1 ... 12).contains(month), year >= 2013 else { return nil }
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+        let current = calendar.dateComponents([.year, .month], from: now)
+        guard let currentYear = current.year, let currentMonth = current.month,
+              year < currentYear || (year == currentYear && month <= currentMonth) else { return nil }
+        return String(format: "%02d.%04d", month, year)
+    }
+
+    public static func date(_ timestamp: Int32, now: Date = Date()) -> Date? {
+        guard timestamp > 0, Double(timestamp) <= now.timeIntervalSince1970 + 86400 else { return nil }
+        return Date(timeIntervalSince1970: Double(timestamp))
+    }
+}
