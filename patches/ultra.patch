diff --git a/Tests/UltraAppStorageTests/UltraAppStorageTests.swift b/Tests/UltraAppStorageTests/UltraAppStorageTests.swift
new file mode 100644
index 00000000..2db2f509
--- /dev/null
+++ b/Tests/UltraAppStorageTests/UltraAppStorageTests.swift
@@ -0,0 +1,42 @@
+import Foundation
+import XCTest
+@testable import UltraStartupPolicy
+
+final class UltraAppStorageTests: XCTestCase {
+    private let sharedURL = URL(fileURLWithPath: "/test/shared")
+    private let localURL = URL(fileURLWithPath: "/test/local")
+
+    func testNewInstallationUsesAvailableAppGroup() throws {
+        let result = try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: nil, allowLocalStorage: true)
+        XCTAssertEqual(result.mode, .shared)
+        XCTAssertEqual(result.url, self.sharedURL)
+    }
+
+    func testMissingGroupRequiresExplicitLocalConsent() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: nil, allowLocalStorage: true)) { error in
+            guard case UltraAppStorageError.localStorageConsentRequired = error else {
+                return XCTFail("Expected local storage consent, got \(error)")
+            }
+        }
+    }
+
+    func testSharedInstallationNeverSilentlySwitchesToEmptyLocalStore() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: "shared", allowLocalStorage: true)) { error in
+            guard case UltraAppStorageError.sharedContainerUnavailable = error else {
+                return XCTFail("Expected unavailable shared storage, got \(error)")
+            }
+        }
+    }
+
+    func testLocalChoiceStaysLocalAfterSigningChanges() throws {
+        let result = try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: "local", allowLocalStorage: true)
+        XCTAssertEqual(result.mode, .local)
+        XCTAssertEqual(result.url, self.localURL)
+    }
+
+    func testInvalidModeAndUnavailableLocalDirectoryFailClosed() {
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: self.sharedURL, localURL: self.localURL, savedMode: "unknown", allowLocalStorage: true))
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: nil, savedMode: "local", allowLocalStorage: true))
+        XCTAssertThrowsError(try UltraAppStorage.resolve(sharedURL: nil, localURL: self.localURL, savedMode: "local", allowLocalStorage: false))
+    }
+}
diff --git a/Tests/UltraDiagnosticsTests/UltraDiagnosticsTests.swift b/Tests/UltraDiagnosticsTests/UltraDiagnosticsTests.swift
new file mode 100644
index 00000000..c7e21eda
--- /dev/null
+++ b/Tests/UltraDiagnosticsTests/UltraDiagnosticsTests.swift
@@ -0,0 +1,132 @@
+import Foundation
+import XCTest
+@testable import UltraDiagnostics
+
+final class UltraDiagnosticsTests: XCTestCase {
+    private var directory: URL!
+
+    override func setUpWithError() throws {
+        self.directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    }
+
+    override func tearDownWithError() throws {
+        if FileManager.default.fileExists(atPath: self.directory.path) {
+            try FileManager.default.removeItem(at: self.directory)
+        }
+    }
+
+    private func text(_ store: UltraDiagnosticsStore) throws -> String {
+        return String(decoding: try store.export(), as: UTF8.self)
+    }
+
+    func testDisabledByDefaultAndDoesNotRecord() throws {
+        let store = UltraDiagnosticsStore(directory: self.directory)
+        XCTAssertFalse(try store.isEnabled())
+        store.record(.startupBegan)
+        XCTAssertFalse(try self.text(store).contains("startupBegan"))
+    }
+
+    func testConsentAndEventsSurviveRelaunch() throws {
+        let first = UltraDiagnosticsStore(directory: self.directory)
+        try first.setEnabled(true)
+        first.record(.startupBegan)
+        let next = UltraDiagnosticsStore(directory: self.directory)
+        XCTAssertTrue(try next.isEnabled())
+        XCTAssertTrue(try self.text(next).contains("startupBegan"))
+    }
+
+    func testDisableRetainsOldEventsButStopsNewOnes() throws {
+        let store = UltraDiagnosticsStore(directory: self.directory)
+        try store.setEnabled(true)
+        store.record(.startupBegan)
+        try store.setEnabled(false)
+        store.record(.memoryWarning)
+        let text = try self.text(store)
+        XCTAssertTrue(text.contains("startupBegan"))
+        XCTAssertFalse(text.contains("memoryWarning"))
+    }
+
+    func testRotationBoundsDiskAndKeepsLatestEvents() throws {
+        let store = UltraDiagnosticsStore(directory: self.directory)
+        try store.setEnabled(true)
+        for _ in 0 ..< 700 { store.record(.foreground) }
+        store.record(.background)
+        let text = try self.text(store)
+        XCTAssertEqual(text.components(separatedBy: "\n").filter { $0.contains(" foreground") }.count, 499)
+        XCTAssertTrue(text.hasSuffix("background"))
+        let size = try self.directory.appendingPathComponent("events.json").resourceValues(forKeys: [.fileSizeKey]).fileSize!
+        XCTAssertLessThanOrEqual(size, 65536)
+    }
+
+    func testOldEventsExpireEvenWhenRecordingDisabled() throws {
+        var now = Date(timeIntervalSince1970: 1_800_000_000)
+        let store = UltraDiagnosticsStore(directory: self.directory, now: { now })
+        try store.setEnabled(true)
+        store.record(.startupBegan)
+        try store.setEnabled(false)
+        now.addTimeInterval(4 * 24 * 60 * 60)
+        store.record(.startupReady)
+        XCTAssertFalse(try self.text(store).contains("startupBegan"))
+        XCTAssertFalse(try self.text(store).contains("startupReady"))
+        let state = try String(contentsOf: self.directory.appendingPathComponent("events.json"), encoding: .utf8)
+        XCTAssertFalse(state.contains("startupBegan"))
+    }
+
+    func testClockRollbackDoesNotKeepFarFutureEvents() throws {
+        var now = Date(timeIntervalSince1970: 1_800_000_000)
+        let store = UltraDiagnosticsStore(directory: self.directory, now: { now })
+        try store.setEnabled(true)
+        store.record(.background)
+        now.addTimeInterval(-24 * 60 * 60)
+        XCTAssertFalse(try self.text(store).contains("background"))
+    }
+
+    func testClearPreservesConsentAndRemovesEvents() throws {
+        let store = UltraDiagnosticsStore(directory: self.directory)
+        try store.setEnabled(true)
+        store.record(.startupBlocked)
+        try store.clear()
+        XCTAssertTrue(try store.isEnabled())
+        XCTAssertFalse(try self.text(store).contains("startupBlocked"))
+        store.record(.startupReady)
+        XCTAssertTrue(try self.text(store).contains("startupReady"))
+    }
+
+    func testUnknownFieldsCannotBeExported() throws {
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+        let fake = "SYNTHETIC_SESSION_SECRET_FOR_TEST_ONLY"
+        let input: [String: Any] = ["enabled": false, "entries": [], "api_hash": fake, "phone": "+0000000000", "message": fake]
+        try JSONSerialization.data(withJSONObject: input).write(to: self.directory.appendingPathComponent("events.json"))
+        let output = try self.text(UltraDiagnosticsStore(directory: self.directory))
+        XCTAssertFalse(output.contains(fake))
+        XCTAssertFalse(output.contains("+0000000000"))
+        XCTAssertFalse(output.contains("api_hash"))
+    }
+
+    func testCorruptOrOversizedFileCanBeClearedWithoutCrashingStartup() throws {
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+        let file = self.directory.appendingPathComponent("events.json")
+        let store = UltraDiagnosticsStore(directory: self.directory)
+        for data in [Data("invalid json".utf8), Data(repeating: 65, count: 65537)] {
+            try data.write(to: file)
+            store.record(.startupBegan)
+            XCTAssertThrowsError(try store.export())
+            try store.clear()
+            XCTAssertFalse(try store.isEnabled())
+            XCTAssertFalse(try self.text(store).contains("startupBegan"))
+        }
+    }
+
+    func testUnknownEventFailsClosedAndDoesNotExportArbitraryText() throws {
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true)
+        let input: [String: Any] = ["enabled": true, "entries": [["time": 0, "event": "SYNTHETIC_KEY_NOT_AN_EVENT"]]]
+        try JSONSerialization.data(withJSONObject: input).write(to: self.directory.appendingPathComponent("events.json"))
+        XCTAssertThrowsError(try UltraDiagnosticsStore(directory: self.directory).export())
+    }
+
+    func testStartupStagesUseClosedAllowlist() {
+        XCTAssertEqual(UltraDiagnosticsStore.Event(rawValue: "STORAGE_LOCAL"), .storageLocal)
+        XCTAssertEqual(UltraDiagnosticsStore.Event(rawValue: "AUTH_UI_READY"), .authUIReady)
+        XCTAssertNil(UltraDiagnosticsStore.Event(rawValue: "SYNTHETIC_PRIVATE_CONTENT"))
+    }
+}
