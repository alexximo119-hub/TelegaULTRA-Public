+import Foundation
+
+public enum AccountInputActivityKind {
+    case typing
+    case recording
+    case other
+}
+
+public struct AccountInputActivityPolicy: Equatable {
+    public let hideTyping: Bool
+    public let hideRecording: Bool
+
+    public init(hideTyping: Bool = false, hideRecording: Bool = false) {
+        self.hideTyping = hideTyping
+        self.hideRecording = hideRecording
+    }
+
+    public func permits(_ kind: AccountInputActivityKind) -> Bool {
+        switch kind {
+        case .typing: return !self.hideTyping
+        case .recording: return !self.hideRecording
+        case .other: return true
+        }
+    }
+}
