diff --git a/submodules/PasscodeCore/Tests/PasscodeCoreTests/PasscodeStandaloneTests.swift b/submodules/PasscodeCore/Tests/PasscodeCoreTests/PasscodeStandaloneTests.swift
new file mode 100644
index 00000000..d7594752
--- /dev/null
+++ b/submodules/PasscodeCore/Tests/PasscodeCoreTests/PasscodeStandaloneTests.swift
@@ -0,0 +1,33 @@
+import XCTest
+@testable import PasscodeCore
+
+final class PasscodeStandaloneTests: XCTestCase {
+    func testSharedModeRetainsOriginalAccessGroup() throws {
+        let environment = PasscodeEnvironment()
+        try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .mainApp), privateAccessGroup: { "TEAM.app.telegaultra.client" })
+        XCTAssertEqual(try environment.sharedAccessGroup(), "group.app.telegaultra.client")
+    }
+
+    func testLocalModeUsesPrivateKeychainWithoutRecursiveLock() throws {
+        let environment = PasscodeEnvironment()
+        try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .mainApp, usePrivateKeychain: true), privateAccessGroup: { "TEAM.app.telegaultra.client" })
+        XCTAssertEqual(try environment.sharedAccessGroup(), "TEAM.app.telegaultra.client")
+    }
+
+    func testExtensionsCannotOptIntoMainAppKeychain() {
+        let environment = PasscodeEnvironment()
+        XCTAssertThrowsError(try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .appExtension, usePrivateKeychain: true)))
+    }
+
+    func testMissingPrivateGroupDoesNotDowngradeToSharedOrUnprotectedStorage() throws {
+        let environment = PasscodeEnvironment()
+        try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .mainApp, usePrivateKeychain: true), privateAccessGroup: { nil })
+        XCTAssertThrowsError(try environment.sharedAccessGroup())
+    }
+
+    func testStorageModeCannotBeChangedAfterConfiguration() throws {
+        let environment = PasscodeEnvironment()
+        try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .mainApp), privateAccessGroup: { "TEAM.app.telegaultra.client" })
+        XCTAssertThrowsError(try environment.configure(PasscodeConfiguration(appGroupIdentifier: "group.app.telegaultra.client", processRole: .mainApp, usePrivateKeychain: true), privateAccessGroup: { "TEAM.app.telegaultra.client" }))
+    }
+}
