--- /dev/null
+++ b/submodules/TelegramCore/Sources/Network/UltraPreparedImageUpload.swift
@@ -0,0 +1,93 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+// Limit expensive raster decoding to one job, independently of file upload concurrency.
+private let ultraImageUploadWorkers = ThreadPool(threadCount: 1, threadPriority: 0.2)
+
+private enum UltraImageUploadInput {
+    case data(Data)
+    case file(URL)
+}
+
+func ultraImageUploadSource(_ source: MultipartUploadSource, privacy: AccountImageUploadPrivacy, expectedMimeType: String? = nil) -> MultipartUploadSource {
+    guard privacy.isEnabled else { return source }
+    return .sanitizedImage(source, expectedMimeType: expectedMimeType)
+}
+
+/// Complete input -> bounded decode/re-encode -> verification. No original bytes reach an uploader.
+func ultraPreparedImageUpload(postbox: Postbox, source: MultipartUploadSource, expectedMimeType: String?) -> Signal<Data, MultipartUploadError> {
+    func resourceInput(_ data: MediaResourceData) -> Signal<UltraImageUploadInput, MultipartUploadError> {
+        guard data.offset == 0, data.size > 0, data.size <= Int64(UltraImageSanitizer.maximumSourceBytes) else { return .fail(.generic) }
+        return .single(.file(URL(fileURLWithPath: data.path)))
+    }
+    let input: Signal<UltraImageUploadInput, MultipartUploadError>
+    switch source {
+    case let .data(data):
+        input = .single(.data(data))
+    case let .tempFile(file):
+        input = .single(.file(URL(fileURLWithPath: file.path)))
+    case let .custom(data):
+        input = data |> filter { $0.complete } |> take(1) |> castError(MultipartUploadError.self) |> mapToSignal(resourceInput)
+    case let .resource(reference):
+        input = Signal { subscriber in
+            let disposables = DisposableSet()
+            disposables.add((postbox.mediaBox.resourceData(reference.resource, option: .complete(waitUntilFetchStatus: true))
+            |> filter { $0.complete } |> take(1) |> castError(MultipartUploadError.self) |> mapToSignal(resourceInput)).start(next: subscriber.putNext, error: subscriber.putError, completed: subscriber.putCompletion))
+            disposables.add(fetchedMediaResource(mediaBox: postbox.mediaBox, userLocation: .other, userContentType: .image, reference: reference).start(error: { _ in subscriber.putError(.generic) }))
+            return disposables
+        }
+    case .sanitizedImage, .sanitizedVideo:
+        // Wrapping an already wrapped source is a programming error, never an unclean fallback.
+        return .fail(.generic)
+    }
+    return input
+    |> timeout(120.0, queue: .concurrentDefaultQueue(), alternate: .fail(.generic))
+    |> mapToSignal { input -> Signal<Data, MultipartUploadError> in
+        return Signal { subscriber in
+            let queue = ThreadPoolQueue(threadPool: ultraImageUploadWorkers)
+            let task = ThreadPoolTask { state in
+                autoreleasepool {
+                    guard !state.cancelled.with({ $0 }) else { return }
+                    do {
+                        let data: Data
+                        switch input {
+                        case let .data(value): data = value
+                        case let .file(url): data = try UltraImageSanitizer.read(at: url)
+                        }
+                        guard !state.cancelled.with({ $0 }) else { return }
+                        let image = try UltraImageSanitizer.sanitizeForUpload(data, expectedMimeType: expectedMimeType)
+                        guard !state.cancelled.with({ $0 }) else { return }
+                        subscriber.putNext(image.data)
+                        subscriber.putCompletion()
+                    } catch {
+                        subscriber.putError(.generic)
+                    }
+                }
+            }
+            queue.addTask(task)
+            return ActionDisposable {
+                // Retain a TempBoxFile (if present) until preparation is disposed.
+                withExtendedLifetime(source) { task.cancel() }
+            }
+        }
+    }
+}
+
+func ultraImageUploadPrivacy(network: Network, peerId: PeerId) -> AccountImageUploadPrivacy {
+    guard peerId.namespace != Namespaces.Peer.SecretChat else { return .disabled }
+    return network.ultraImageUploadPrivacy.with { $0 }
+}
+
+func ultraImageUploadDocumentPrivacy(_ privacy: AccountImageUploadPrivacy, mimeType: String, attributes: [TelegramMediaFileAttribute]) -> AccountImageUploadPrivacy {
+    guard privacy.sanitizesDocument(mimeType: mimeType), !attributes.contains(where: { if case .Sticker = $0 { return true }; return false }) else { return .disabled }
+    return privacy
+}
+
+func ultraImageUploadFileAttributes(_ attributes: [TelegramMediaFileAttribute], mimeType: String, privacy: AccountImageUploadPrivacy) -> [TelegramMediaFileAttribute] {
+    guard let name = privacy.neutralFileName(mimeType: mimeType) else { return attributes }
+    return attributes.filter { attribute in
+        if case .FileName = attribute { return false }
+        return true
+    } + [.FileName(fileName: name)]
+}
diff --git a/submodules/TelegramCore/Sources/Network/UltraPreparedVideoUpload.swift b/submodules/TelegramCore/Sources/Network/UltraPreparedVideoUpload.swift
