index 00000000..143b5503
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PendingMessages/UltraImageSanitizer.swift
@@ -0,0 +1,128 @@
+import Foundation
+import CoreGraphics
+import ImageIO
+import UniformTypeIdentifiers
+
+public enum UltraImageSanitizerError: Error {
+    case unavailable
+    case unsupported
+    case tooLarge
+    case conversionFailed
+    case verificationFailed
+}
+
+public struct UltraSanitizedImage {
+    public let data: Data
+    public let fileName: String
+    public let mimeType: String
+    public let width: Int
+    public let height: Int
+}
+
+/// Bounded raster re-encoding. Never falls back to the source when sanitization fails.
+public enum UltraImageSanitizer {
+    public static let maximumSourceBytes = 32 * 1024 * 1024
+    public static let maximumOutputBytes = 64 * 1024 * 1024
+    public static let maximumPixels = 20_000_000
+
+    public static func read(at url: URL) throws -> Data {
+        guard url.isFileURL else { throw UltraImageSanitizerError.unavailable }
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard values.isRegularFile == true, values.isSymbolicLink != true,
+              let size = values.fileSize, size > 0 else { throw UltraImageSanitizerError.unavailable }
+        guard size <= self.maximumSourceBytes else { throw UltraImageSanitizerError.tooLarge }
+        let handle = try FileHandle(forReadingFrom: url)
+        defer { try? handle.close() }
+        var data = Data()
+        while data.count <= self.maximumSourceBytes {
+            let chunk = try handle.read(upToCount: min(65536, self.maximumSourceBytes + 1 - data.count)) ?? Data()
+            if chunk.isEmpty { break }
+            data.append(chunk)
+        }
+        guard !data.isEmpty, data.count <= self.maximumSourceBytes else { throw UltraImageSanitizerError.tooLarge }
+        return data
+    }
+
+    public static func sanitize(_ input: Data, allowOtherRasterFormats: Bool = false) throws -> UltraSanitizedImage {
+        guard !input.isEmpty else { throw UltraImageSanitizerError.unsupported }
+        guard input.count <= self.maximumSourceBytes else { throw UltraImageSanitizerError.tooLarge }
+        guard let source = CGImageSourceCreateWithData(input as CFData, [kCGImageSourceShouldCache as String: false] as CFDictionary),
+              let type = CGImageSourceGetType(source) as String?,
+              allowOtherRasterFormats || type == UTType.jpeg.identifier || type == UTType.png.identifier,
+              CGImageSourceGetCount(source) == 1,
+              CGImageSourceGetStatus(source) == .statusComplete,
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any] else { throw UltraImageSanitizerError.unsupported }
+        guard let width = (properties[kCGImagePropertyPixelWidth as String] as? NSNumber)?.intValue,
+              let height = (properties[kCGImagePropertyPixelHeight as String] as? NSNumber)?.intValue,
+              width > 0, height > 0, width <= 16384, height <= 16384,
+              width * height <= self.maximumPixels else { throw UltraImageSanitizerError.tooLarge }
+        let orientation = (properties[kCGImagePropertyOrientation as String] as? NSNumber)?.intValue ?? 1
+        guard (1 ... 8).contains(orientation),
+              let image = CGImageSourceCreateImageAtIndex(source, 0, [kCGImageSourceShouldCache as String: false] as CFDictionary),
+              image.width == width, image.height == height,
+              let colorSpace = CGColorSpace(name: CGColorSpace.sRGB),
+              let context = CGContext(data: nil, width: width, height: height, bitsPerComponent: 8, bytesPerRow: width * 4, space: colorSpace, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { throw UltraImageSanitizerError.conversionFailed }
+        // Render pixels into a new standard color space. No source dictionaries, ICC profile,
+        // auxiliary image, filename, EXIF thumbnail or compressed source segment is copied.
+        context.draw(image, in: CGRect(x: 0, y: 0, width: CGFloat(width), height: CGFloat(height)))
+        guard let raster = context.makeImage() else { throw UltraImageSanitizerError.conversionFailed }
+        let outputType = type == UTType.png.identifier ? UTType.png.identifier : UTType.jpeg.identifier
+        let output = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(output as CFMutableData, outputType as CFString, 1, nil) else { throw UltraImageSanitizerError.conversionFailed }
+        let options: [String: Any] = [
+            kCGImagePropertyOrientation as String: orientation,
+            kCGImageDestinationLossyCompressionQuality as String: 1.0,
+            kCGImageDestinationEmbedThumbnail as String: false
+        ]
+        CGImageDestinationAddImage(destination, raster, options as CFDictionary)
+        guard CGImageDestinationFinalize(destination), output.length > 0, output.length <= self.maximumOutputBytes else { throw UltraImageSanitizerError.conversionFailed }
+        let data = output as Data
+        guard self.verify(data, type: outputType, width: width, height: height, orientation: orientation) else { throw UltraImageSanitizerError.verificationFailed }
+        let jpeg = outputType == UTType.jpeg.identifier
+        return UltraSanitizedImage(data: data, fileName: jpeg ? "ULTRA-clean.jpg" : "ULTRA-clean.png", mimeType: jpeg ? "image/jpeg" : "image/png", width: width, height: height)
+    }
+
+    public static func sanitizeForUpload(_ input: Data, expectedMimeType: String?) throws -> UltraSanitizedImage {
+        let output = try self.sanitize(input, allowOtherRasterFormats: expectedMimeType == nil)
+        guard expectedMimeType == nil || output.mimeType == expectedMimeType else { throw UltraImageSanitizerError.verificationFailed }
+        return output
+    }
+
+    private static func verify(_ data: Data, type: String, width: Int, height: Int, orientation: Int) -> Bool {
+        guard let source = CGImageSourceCreateWithData(data as CFData, [kCGImageSourceShouldCache as String: false] as CFDictionary),
+              CGImageSourceGetType(source) as String? == type, CGImageSourceGetCount(source) == 1,
+              CGImageSourceGetStatus(source) == .statusComplete,
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any],
+              (properties[kCGImagePropertyPixelWidth as String] as? NSNumber)?.intValue == width,
+              (properties[kCGImagePropertyPixelHeight as String] as? NSNumber)?.intValue == height,
+              ((properties[kCGImagePropertyOrientation as String] as? NSNumber)?.intValue ?? 1) == orientation else { return false }
+        let allowed = Set([
+            kCGImagePropertyPixelWidth, kCGImagePropertyPixelHeight, kCGImagePropertyColorModel,
+            kCGImagePropertyDepth, kCGImagePropertyOrientation, kCGImagePropertyDPIWidth,
+            kCGImagePropertyDPIHeight, kCGImagePropertyProfileName, kCGImagePropertyHasAlpha,
+            kCGImagePropertyFileSize, kCGImagePropertyJFIFDictionary, kCGImagePropertyPNGDictionary,
+            kCGImagePropertyTIFFDictionary, kCGImagePropertyExifDictionary
+        ].map { $0 as String })
+        guard Set(properties.keys).isSubset(of: allowed) else { return false }
+        let safeExif = Set([kCGImagePropertyExifColorSpace, kCGImagePropertyExifPixelXDimension, kCGImagePropertyExifPixelYDimension, kCGImagePropertyExifVersion, kCGImagePropertyExifFlashPixVersion, kCGImagePropertyExifComponentsConfiguration].map { $0 as String })
+        let safeTIFF = Set([kCGImagePropertyTIFFOrientation, kCGImagePropertyTIFFXResolution, kCGImagePropertyTIFFYResolution, kCGImagePropertyTIFFResolutionUnit].map { $0 as String })
+        for (key, safe) in [(kCGImagePropertyExifDictionary, safeExif), (kCGImagePropertyTIFFDictionary, safeTIFF)] {
+            if let dictionary = properties[key as String] {
+                guard let dictionary = dictionary as? [String: Any], Set(dictionary.keys).isSubset(of: safe), dictionary.values.allSatisfy({ self.isNumeric($0) }) else { return false }
+            }
+        }
+        // Generated PNG/JFIF structural properties may contain numeric arrays, never textual chunks.
+        for key in [kCGImagePropertyPNGDictionary, kCGImagePropertyJFIFDictionary] {
+            if let dictionary = properties[key as String] {
+                guard let dictionary = dictionary as? [String: Any], dictionary.values.allSatisfy({ self.isNumeric($0) }) else { return false }
+            }
+        }
+        return true
+    }
+
+    private static func isNumeric(_ value: Any) -> Bool {
+        if value is NSNumber { return true }
+        if let values = value as? [NSNumber] { return values.count <= 32 }
+        return false
+    }
+}
diff --git a/submodules/TelegramCore/Sources/PendingMessages/UltraVideoPreparationPolicy.swift b/submodules/TelegramCore/Sources/PendingMessages/UltraVideoPreparationPolicy.swift
new file mode 100644
index 00000000..54d1ae1f
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PendingMessages/UltraVideoPreparationPolicy.swift
@@ -0,0 +1,151 @@
+import Foundation
+
+public enum UltraVideoPreparationError: Error {
+    case unavailable, unsupported, limits, verificationFailed
+}
+
+public enum UltraVideoPreparationPolicy {
+    public static let maximumInputBytes: Int64 = 128 * 1024 * 1024
+    public static let maximumOutputBytes: Int64 = 256 * 1024 * 1024
+    public static let maximumDuration: Double = 180
+    public static var isAvailable: Bool {
+        if #available(iOS 26.0, macOS 26.0, *) { return true }
+        return false
+    }
+
+    static func preservesGeometry(sourceWidth: Double, sourceHeight: Double, width: Double, height: Double) -> Bool {
+        return [sourceWidth, sourceHeight, width, height].allSatisfy { $0.isFinite && $0 > 0 }
+            && sourceWidth == width && sourceHeight == height
+    }
+
+    static func accepts(duration: Double, width: Double, height: Double, videoTracks: Int, audioTracks: Int) -> Bool {
+        return duration.isFinite && duration > 0 && duration <= self.maximumDuration
+            && width.isFinite && height.isFinite && width > 0 && height > 0
+            && width <= 4096 && height <= 4096 && width * height <= 8_847_360
+            && videoTracks == 1 && (0 ... 1).contains(audioTracks)
+    }
+
+    static func acceptsOutput(sourceDuration: Double, duration: Double, bytes: Int64, videoTracks: Int, audioTracks: Int, expectedAudioTracks: Int) -> Bool {
+        return sourceDuration.isFinite && sourceDuration > 0 && sourceDuration <= self.maximumDuration && duration.isFinite && duration > 0
+            && abs(duration - sourceDuration) <= 0.25
+            && bytes > 0 && bytes <= self.maximumOutputBytes
+            && videoTracks == 1 && (0 ... 1).contains(expectedAudioTracks) && audioTracks == expectedAudioTracks
+    }
+}
+
+/// One export at a time; a cancelled queued job must never retain a continuation.
+actor UltraVideoPreparationGate {
+    static let shared = UltraVideoPreparationGate()
+    private var busy = false
+    private var waiters: [(UUID, CheckedContinuation<Void, Error>)] = []
+    var queuedCount: Int { return self.waiters.count }
+
+    func acquire(_ id: UUID) async throws {
+        try Task.checkCancellation()
+        if !self.busy { self.busy = true; return }
+        guard self.waiters.count < 16 else { throw UltraVideoPreparationError.limits }
+        try await withTaskCancellationHandler(operation: {
+            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+                self.waiters.append((id, continuation))
+            }
+        }, onCancel: {
+            Task { await self.cancel(id) }
+        })
+    }
+
+    private func cancel(_ id: UUID) {
+        guard let index = self.waiters.firstIndex(where: { $0.0 == id }) else { return }
+        self.waiters.remove(at: index).1.resume(throwing: CancellationError())
+    }
+
+    func release() {
+        if self.waiters.isEmpty { self.busy = false }
+        else { self.waiters.removeFirst().1.resume() }
+    }
+}
+
+/// A private owned directory, kept alive through conversion and the MediaBox copy.
+public final class UltraVideoPreparationWorkspace: @unchecked Sendable {
+    // Paths never change; input creation/copy is serialized before async export.
+    private let inputLock = NSLock()
+    private static let lock = NSLock()
+    private static var active: Set<String> = []
+    public let directory: URL
+    public let input: URL
+    public let output: URL
+    public init() throws {
+        UltraVideoPreparationWorkspace.cleanupAbandoned()
+        self.directory = FileManager.default.temporaryDirectory.appendingPathComponent("ultra-video-\(UUID().uuidString)", isDirectory: true)
+        self.input = self.directory.appendingPathComponent("input.movie")
+        self.output = self.directory.appendingPathComponent("ULTRA-clean.mp4")
+        try FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: false)
+        Self.lock.lock()
+        Self.active.insert(self.directory.lastPathComponent)
+        Self.lock.unlock()
+    }
+    deinit {
+        try? FileManager.default.removeItem(at: self.directory)
+        Self.lock.lock()
+        Self.active.remove(self.directory.lastPathComponent)
+        Self.lock.unlock()
+    }
+
+    static func cleanupAbandoned(now: Date = Date()) {
+        let base = FileManager.default.temporaryDirectory.resolvingSymlinksInPath().standardizedFileURL
+        guard let urls = try? FileManager.default.contentsOfDirectory(at: base, includingPropertiesForKeys: [.isDirectoryKey, .isSymbolicLinkKey, .contentModificationDateKey]) else { return }
+        for url in urls {
+            let name = url.lastPathComponent
+            guard name.hasPrefix("ultra-video-"), UUID(uuidString: String(name.dropFirst(12))) != nil else { continue }
+            Self.lock.lock()
+            let busy = Self.active.contains(name)
+            Self.lock.unlock()
+            guard !busy, let values = try? url.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey, .contentModificationDateKey]),
+                  values.isDirectory == true, values.isSymbolicLink != true,
+                  let modified = values.contentModificationDate, now.timeIntervalSince(modified) > 86400,
+                  url.resolvingSymlinksInPath().standardizedFileURL.deletingLastPathComponent() == base else { continue }
+            try? FileManager.default.removeItem(at: url)
+        }
+    }
+
+    public func copyInput(from url: URL, cancelled: () -> Bool) throws {
+        self.inputLock.lock()
+        defer { self.inputLock.unlock() }
+        guard url.isFileURL, !FileManager.default.fileExists(atPath: self.input.path) else { throw UltraVideoPreparationError.unavailable }
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard url.isFileURL, values.isRegularFile == true, values.isSymbolicLink != true,
+              let size = values.fileSize, size > 0 else { throw UltraVideoPreparationError.unavailable }
+        guard Int64(size) <= UltraVideoPreparationPolicy.maximumInputBytes else { throw UltraVideoPreparationError.limits }
+        guard FileManager.default.createFile(atPath: self.input.path, contents: nil) else { throw UltraVideoPreparationError.unavailable }
+        let reader = try FileHandle(forReadingFrom: url)
+        defer { try? reader.close() }
+        let writer = try FileHandle(forWritingTo: self.input)
+        defer { try? writer.close() }
+        var total: Int64 = 0
+        while true {
+            if cancelled() { throw CancellationError() }
+            let bytes = try reader.read(upToCount: 65536) ?? Data()
+            if bytes.isEmpty { break }
+            total += Int64(bytes.count)
+            guard total <= UltraVideoPreparationPolicy.maximumInputBytes else { throw UltraVideoPreparationError.limits }
+            try writer.write(contentsOf: bytes)
+        }
+        guard total == Int64(size) else { throw UltraVideoPreparationError.unavailable }
+    }
+
+    func writeInput(_ data: Data, cancelled: () -> Bool) throws {
+        self.inputLock.lock()
+        defer { self.inputLock.unlock() }
+        guard !data.isEmpty, Int64(data.count) <= UltraVideoPreparationPolicy.maximumInputBytes,
+              !FileManager.default.fileExists(atPath: self.input.path),
+              FileManager.default.createFile(atPath: self.input.path, contents: nil) else { throw UltraVideoPreparationError.limits }
+        let writer = try FileHandle(forWritingTo: self.input)
+        defer { try? writer.close() }
+        var offset = 0
+        while offset < data.count {
+            if cancelled() { throw CancellationError() }
+            let end = min(offset + 65536, data.count)
+            try writer.write(contentsOf: data.subdata(in: offset ..< end))
+            offset = end
+        }
+    }
+}
