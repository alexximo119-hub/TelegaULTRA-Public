+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraInputActivityPolicyTests: XCTestCase {
+    func testDefaultsPreserveAllActivityKinds() {
+        let policy = AccountInputActivityPolicy()
+        let kinds: [AccountInputActivityKind] = [.typing, .recording, .other]
+        for kind in kinds { XCTAssertTrue(policy.permits(kind)) }
+    }
+    func testTypingAndRecordingSwitchesAreIndependent() {
+        let typing = AccountInputActivityPolicy(hideTyping: true)
+        XCTAssertFalse(typing.permits(.typing))
+        XCTAssertTrue(typing.permits(.recording))
+        let recording = AccountInputActivityPolicy(hideRecording: true)
+        XCTAssertTrue(recording.permits(.typing))
+        XCTAssertFalse(recording.permits(.recording))
+    }
+    func testCallsAndOtherActionsAreNotSilencedByTheseSettings() {
+        let policy = AccountInputActivityPolicy(hideTyping: true, hideRecording: true)
+        XCTAssertTrue(policy.permits(.other))
+        XCTAssertFalse(policy.permits(.typing))
+        XCTAssertFalse(policy.permits(.recording))
+    }
+}
