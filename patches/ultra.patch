+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import AccountContext
+
+private final class UltraPresenceArguments {
+    let update: (UltraPresenceMode) -> Void
+    init(update: @escaping (UltraPresenceMode) -> Void) { self.update = update }
+}
+
+private enum UltraPresenceEntry: ItemListNodeEntry {
+    case mode(UltraPresenceMode, Bool)
+    case footer
+    var stableId: Int32 {
+        switch self {
+        case let .mode(mode, _): return mode.rawValue
+        case .footer: return 100
+        }
+    }
+    var section: ItemListSectionId { return 0 }
+    static func < (lhs: UltraPresenceEntry, rhs: UltraPresenceEntry) -> Bool { return lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! UltraPresenceArguments
+        switch self {
+        case let .mode(mode, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: mode.title, style: .right, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: { arguments.update(mode) })
+        case .footer:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Настройка меняет только запросы статуса этого клиента. Другие устройства, отправка сообщений, прочтения и серверные правила могут раскрывать активность. Режим онлайн относится к выбранному аккаунту и работает лишь пока iOS разрешает выполнение приложения; после выгрузки или потери сети постоянный онлайн не гарантируется. Фоновое выполнение специально не продлевается. Офлайн применяется к загруженным аккаунтам этого клиента."), sectionId: self.section)
+        }
+    }
+}
+
+func ultraPresenceController(context: AccountContext) -> ViewController {
+    let arguments = UltraPresenceArguments(update: { mode in
+        let _ = updateExperimentalUISettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+            var settings = settings
+            settings.ultra.presenceMode = mode
+            return settings
+        }).startStandalone()
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, context.sharedContext.accountManager.sharedData(keys: Set([ApplicationSpecificSharedDataKeys.experimentalUISettings])))
+    |> deliverOnMainQueue
+    |> map { presentationData, sharedData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let settings = sharedData.entries[ApplicationSpecificSharedDataKeys.experimentalUISettings]?.get(ExperimentalUISettings.self) ?? .defaultSettings
+        var entries = UltraPresenceMode.allCases.map { UltraPresenceEntry.mode($0, $0 == settings.ultra.presenceMode) }
+        entries.append(.footer)
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Статус онлайн"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
