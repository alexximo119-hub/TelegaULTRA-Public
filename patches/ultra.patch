+import Foundation
+import XCTest
+@testable import UltraSettingsPolicies
+
+final class UltraLocalDisplayValuesTests: XCTestCase {
+    func testLocalValuesValidateAndNormalize() throws {
+        let values = try XCTUnwrap(UltraLocalDisplayValues.make(enabled: true, phone: " +123 456 ", stars: " 00042 "))
+        XCTAssertEqual(values.phone, "+123 456")
+        XCTAssertEqual(values.stars, 42)
+        XCTAssertNil(UltraLocalDisplayValues.make(enabled: true, phone: "line\nbreak", stars: "0"))
+        XCTAssertNil(UltraLocalDisplayValues.make(enabled: true, phone: String(repeating: "x", count: 65), stars: "0"))
+    }
+    func testFinancialValuesCannotOverflowOrAcceptExpressions() {
+        for text in ["-1", "+1", "1e8", "1.0", "9,000", "١٢", "9000000000000001", "999999999999999999999999999"] {
+            XCTAssertNil(UltraLocalDisplayValues.make(enabled: true, phone: "", stars: text), text)
+        }
+        XCTAssertEqual(UltraLocalDisplayValues.make(enabled: false, phone: "", stars: "")?.stars, nil)
+    }
+    func testLocalValuesStayIsolatedByAccountAndResetDoesNotClearOtherData() throws {
+        let suite = "UltraDisplayTests.\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        defaults.set("preserved", forKey: "unrelated")
+        let values = try XCTUnwrap(UltraLocalDisplayValues.make(enabled: true, phone: "123", stars: "42"))
+        try UltraLocalDisplayStore.save(values, accountId: 1, defaults: defaults)
+        XCTAssertEqual(UltraLocalDisplayStore.current(accountId: 1, defaults: defaults), values)
+        XCTAssertEqual(UltraLocalDisplayStore.current(accountId: 2, defaults: defaults), UltraLocalDisplayValues())
+        UltraLocalDisplayStore.reset(accountId: 1, defaults: defaults)
+        XCTAssertEqual(UltraLocalDisplayStore.current(accountId: 1, defaults: defaults), UltraLocalDisplayValues())
+        XCTAssertEqual(defaults.string(forKey: "unrelated"), "preserved")
+    }
+    func testGiftLookupAllowsOnlySlugOrPublicTelegramNFTURL() {
+        XCTAssertEqual(UltraLocalDisplayStore.giftSlug("ExampleGift-42"), "ExampleGift-42")
+        XCTAssertEqual(UltraLocalDisplayStore.giftSlug("https://t.me/nft/ExampleGift-42"), "ExampleGift-42")
+        for value in ["", "https://example.com/nft/Gift-42", "https://t.me@evil.test/nft/Gift-42", "file:///tmp/key", "https://t.me/nft/Gift-42?secret=1", "../Gift", "Gif\nt-42"] {
+            XCTAssertNil(UltraLocalDisplayStore.giftSlug(value), value)
+        }
+    }
+}
