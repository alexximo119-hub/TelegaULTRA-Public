+
+private func ultraSettingsController(context: AccountContext, category: UltraCategory?) -> ViewController {
+    var pushImpl: ((ViewController) -> Void)?
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    let arguments = UltraSettingsArguments(open: { category in
+        if category == .diagnostics {
+            pushImpl?(ultraDiagnosticsController(context: context))
+        } else if category == .fonts {
+            pushImpl?(ultraFontsController(context: context))
+        } else if category == .localDisplay {
+            pushImpl?(ultraLocalDisplayController(context: context))
+        } else if category == .accounts {
+            pushImpl?(ultraAccountsController(context: context))
+        } else {
+            pushImpl?(ultraSettingsController(context: context, category: category))
+        }
+    }, update: { option, value in
+        UltraDiagnosticsStore.shared.record(.optionChanged)
+        let _ = updateExperimentalUISettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+            var settings = settings
+            settings[keyPath: option.keyPath] = value
+            return settings
+        }).startStandalone()
+    })
+    arguments.openDeviceIdentity = {
+        pushImpl?(ultraDeviceIdentityController(context: context, updated: { revision.set(0) }))
+    }
+    arguments.openPresence = { pushImpl?(ultraPresenceController(context: context)) }
+    arguments.openHistory = { pushImpl?(ultraLocalHistoryController(context: context)) }
+    arguments.openLocation = { pushImpl?(ultraLocationController(context: context)) }
+    arguments.openStickers = { pushImpl?(ultraLocalStickersController(context: context)) }
+    arguments.openUpload = { pushImpl?(ultraUploadController(context: context)) }
+    arguments.openImageSanitizer = { pushImpl?(ultraImageSanitizerController(context: context)) }
+    arguments.openVideoSanitizer = { pushImpl?(ultraVideoSanitizerController(context: context)) }
+
+    let signal = combineLatest(
+        context.sharedContext.presentationData,
+        context.sharedContext.accountManager.sharedData(keys: Set([ApplicationSpecificSharedDataKeys.experimentalUISettings])),
+        revision.get()
+    )
+    |> deliverOnMainQueue
+    |> map { presentationData, sharedData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let settings = sharedData.entries[ApplicationSpecificSharedDataKeys.experimentalUISettings]?.get(ExperimentalUISettings.self) ?? .defaultSettings
+        let presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        var entries: [UltraSettingsEntry] = []
+        if let category {
+            for option in UltraOption.allCases where option.category == category {
+                if case .sanitizeUploadedVideos = option, !UltraVideoPreparationPolicy.isAvailable { continue }
+                entries.append(.toggle(option, settings[keyPath: option.keyPath]))
+            }
+            switch category {
+            case .messages:
+                entries.append(.history)
+                entries.append(.footer("Счётчик отображается в поле ввода. Двойной тап открывает штатный редактор своего доступного сообщения. Сохранение одноразовых фото/видео пробует добавить полностью загруженный файл в «Фото» при открытии; нужен доступ к фототеке. До 512 МБ, без секретных чатов, платных и возрастных оверлеев. Голосовые в фототеку не сохраняются. Истёкшие или не успевшие загрузиться файлы не восстанавливаются. Потребление/удаление сообщения и штатные уведомления не отключаются. Результат можно увидеть в журнале диагностики, если запись включена."))
+            case .camera:
+                entries.append(.imageSanitizer)
+                entries.append(.videoSanitizer)
+                entries.append(.footer("Задняя камера — для историй и видеосообщений. HD-фото и высокое качество видео применяются к отправке из галереи и увеличивают размер и расход трафика. Явно выбранное качество видео, GIF и отправка файлом сохраняют штатное поведение. Исходное разрешение не увеличивается. Камеру можно переключить вручную."))
+            case .ghost:
+                entries.append(.presence(settings.ultra.presenceMode))
+                entries.append(.deviceIdentity(UltraDeviceIdentity.current() ?? "Системное"))
+                entries.append(.location)
+                entries.append(.footer("Настройки действуют на этом устройстве. Набор текста и выбор стикера, запись голоса и кружка фильтруются в общем обработчике исходящих активностей; переключатели независимы. Загрузка файлов, emoji-взаимодействия и статус речи в групповом звонке ими не скрываются. Уже отправленный статус может оставаться видимым до истечения на сервере. Другие ваши клиенты могут отправлять статусы и отметки прочтения. Открытие медиа и историй не гарантирует невидимость."))
+            case .privacy:
+                entries.append(.footer("Подтверждение относится к исходящим личным звонкам. Можно раскрывать обычные текстовые и медиаспойлеры. Платные превью, одноразовые медиа и проверка возраста сохраняют штатное поведение. Настройка чатов пропускает только локальное правило платформы iOS; общие правила Telegram, бан и серверный запрет доступа она не отменяет. После изменения переоткройте чат."))
+            case .additional:
+                entries.append(.stickers)
+                entries.append(.upload(settings.ultra.uploadMode))
+                entries.append(.footer("Очистка новых загрузок изображений выключена по умолчанию. Включайте её до выбора вложений: обрабатывается основное облачное фото или новый файл JPEG/PNG, до 32 МБ и 20 MP. Создаётся sRGB-копия без исходных EXIF/GPS/профиля; разрешение и ориентация сохраняются, цвет и размер могут измениться. JPEG кодируется повторно. Имя JPEG/PNG-файла для облачной отправки заменяется на ULTRA-clean.\n\nПри ошибке оригинал не отправляется. Анимация и слишком большие изображения блокируются. Обложки и миниатюры новых облачных загрузок тоже обрабатываются. Секретные чаты, пересылка готовых облачных медиа, аватары/истории и уже начатые загрузки этой опцией не охвачены. Видимые надписи на картинке не удаляются. Предварительная загрузка новых вложений временно отключается; подготовка может замедлить отправку.\n\nНа iOS 26+ доступна отдельная автоматическая подготовка новых MP4: до 128 МБ и 3 минут, 1 видео- и до 1 аудиодорожки, до 4K. Проверяются распознаваемые метаданные, длительность, сохранение размеров и ориентации. Видео кодируется заново, звук/HDR/цвет и размер могут измениться. Подготовка идёт по одному файлу, до 16 ожидают очереди; общий предел ожидания — 15 минут. Неизвестные форматы, анимация, стикеры и готовые облачные копии не обрабатываются автоматически. При ошибке подготовка MP4 блокирует отправку исходника. Внутренние сведения кодека, надписи, лица и речь эта функция не удаляет.\n\nПанель форматирования появляется при выделении текста, если место не занято ответом, ссылкой или другим штатным действием. Онлайн у аватара показывается только при доступном статусе Telegram; скрытая активность не вычисляется. Перевод предлагается при доступном сервисе; секретные чаты исключены. Скрытие бизнес-бота не отключает его на сервере. Скрываются только sponsored messages Telegram. После изменения переоткройте чат."))
+            case .diagnostics:
+                break
+            case .fonts:
+                break
+            case .localDisplay:
+                break
+            case .accounts:
+                break
+            case .appearance:
+                entries.append(.footer("Панель папок располагается над нижней панелью вкладок при наличии нескольких папок. Во время поиска, работы клавиатуры и массовых действий используется штатное верхнее расположение. Если изменение сразу не видно, перезапустите ULTRA."))
+            case .information:
+                entries.append(.footer("ID можно скопировать нажатием в профиле. DC относится к фотографии. Дата обычной группы — создание; дата канала Telegram может означать вступление, поэтому она не всегда является датой создания. Месяц регистрации показывается только из ответа Telegram, без вычислений по ID; точного дня нет. Взаимный контакт показывается только при подтверждении Telegram. После изменения переоткройте профиль или чат."))
+            }
+        } else {
+            entries = UltraCategory.allCases.map { .category($0) }
+            entries.append(.footer("ULTRA — неофициальный клиент Telegram. Настройки сохраняются на этом устройстве для всех добавленных аккаунтов."))
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(category?.title ?? "ULTRA"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    pushImpl = { [weak controller] next in
+        controller?.push(next)
+    }
+    return controller
+}
diff --git a/submodules/SettingsUI/Sources/UltraUploadController.swift b/submodules/SettingsUI/Sources/UltraUploadController.swift
