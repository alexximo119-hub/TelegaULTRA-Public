new file mode 100644
index 00000000..2720bfde
--- /dev/null
+++ b/build-system/Make/tests/test_unsigned_build.py
@@ -0,0 +1,61 @@
+import argparse
+from contextlib import redirect_stderr
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+# VM locking uses fcntl on macOS; these tests exercise configuration only.
+if sys.platform == 'win32':
+    with patch.dict(sys.modules, {'TartBuild': Mock()}):
+        import Make
+else:
+    import Make
+
+
+class UnsignedBuildTests(unittest.TestCase):
+    def test_unsigned_does_not_resolve_private_signing_material(self):
+        data = Make.resolve_codesigning(
+            argparse.Namespace(unsigned=True), None, None, None, None
+        )
+        self.assertEqual(data.aps_environment, 'production')
+        self.assertFalse(data.use_xcode_managed_codesigning)
+
+    def test_unsigned_is_exclusive_with_signing_directory(self):
+        parser = argparse.ArgumentParser()
+        Make.add_codesigning_common_arguments(parser)
+        with self.assertRaises(SystemExit), redirect_stderr(io.StringIO()):
+            parser.parse_args([
+                '--configurationPath=config.json', '--unsigned',
+                '--codesigningInformationPath=certificates',
+            ])
+
+    def test_unsigned_configuration_has_own_identity_and_no_profiles(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            configuration = root / 'configuration.json'
+            template = Path(__file__).resolve().parents[2] / 'appstore-configuration.json'
+            settings = json.loads(template.read_text(encoding='utf-8'))
+            settings['bundle_id'] = 'app.telegaultra.client'
+            configuration.write_text(json.dumps(settings), encoding='utf-8')
+            bazel = Mock()
+            bazel.bazel = '/test/bazel'
+            bazel.common_args = []
+            Make.resolve_configuration(
+                str(root), bazel,
+                argparse.Namespace(unsigned=True, configurationPath=str(configuration)),
+                None,
+            )
+            bazel.set_disable_provisioning_profiles.assert_called_once()
+            self.assertIn('--features=disable_legacy_signing', bazel.common_args)
+            output = root / 'build-input' / 'configuration-repository'
+            self.assertIn('app.telegaultra.client', (output / 'variables.bzl').read_text())
+            self.assertEqual(list((output / 'provisioning').glob('*.mobileprovision')), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/docs/state-sync.md b/docs/state-sync.md
index 40fcdcd4..348e3a38 100644
--- a/docs/state-sync.md
+++ b/docs/state-sync.md
@@ -1112,3 +1112,14 @@ gets a shrunk test before its fix. The comparison with master, and every model r
   `docs/superpowers/specs/2026-10-15-difference-too-long-design.md` (the differenceTooLong rules).
 - `docs/superpowers/plans/`: the stage plans, kept as history.
 - `docs/superpowers/plans/2026-10-14-state-sync-foundation/followups.md`: what each stage parked.
+## ULTRA local archive integration
+
+The fork's `ReplayContext.ultraHistory` belongs to one synchronous replay and never
+escapes its Postbox transaction. `StateReplay+Messages` reads optional text before
+confirmed cloud deletes/edits and after adds; the server mutations and the native
+recent-edit reconciliation remain unchanged. A single archive commit follows
+`context.finalize()` and precedes the result. No sync retry, ordering, queue or
+network behavior depends on archive availability. Secret/TTL/ephemeral data stays
+excluded. The fork cache uses signed collection -128; native `cachedAgent` keeps 63.
+The earlier collection-63 archive was an unpublished development draft, absent
+from delivered build 16. It is not automatically interpreted as native agent data.
