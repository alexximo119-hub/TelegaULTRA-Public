index 00000000..34eaecbb
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Messages/UltraLocalHistoryModels.swift
@@ -0,0 +1,199 @@
+import Foundation
+
+public struct UltraLocalHistoryPolicy: Codable, Equatable {
+    public var deleted: Bool = false
+    public var edited: Bool = false
+    public var received: Bool = false
+    public var excludeOwn: Bool = true
+    public var strikeOriginals: Bool = true
+    public var inlineEdits: Bool = false
+    public var localDeletions: Bool = false
+    public init() {}
+    public var isEnabled: Bool { return self.deleted || self.edited || self.received }
+
+    private enum CodingKeys: String, CodingKey { case deleted, edited, received, excludeOwn, strikeOriginals, inlineEdits, localDeletions }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        self.deleted = try values.decodeIfPresent(Bool.self, forKey: .deleted) ?? false
+        self.edited = try values.decodeIfPresent(Bool.self, forKey: .edited) ?? false
+        self.received = try values.decodeIfPresent(Bool.self, forKey: .received) ?? false
+        self.excludeOwn = try values.decodeIfPresent(Bool.self, forKey: .excludeOwn) ?? true
+        self.strikeOriginals = try values.decodeIfPresent(Bool.self, forKey: .strikeOriginals) ?? true
+        self.inlineEdits = try values.decodeIfPresent(Bool.self, forKey: .inlineEdits) ?? false
+        self.localDeletions = try values.decodeIfPresent(Bool.self, forKey: .localDeletions) ?? false
+    }
+
+    func allowsCapture(kind: UltraLocalHistoryRecord.Kind, isOwn: Bool, locallyDeleted: Bool = false) -> Bool {
+        guard !self.excludeOwn || !isOwn else { return false }
+        switch kind {
+        case .deleted: return self.deleted && (!locallyDeleted || self.localDeletions)
+        case .edited: return self.edited && !locallyDeleted
+        case .received: return self.received && !locallyDeleted
+        }
+    }
+}
+
+/// Presentation-only data. Never becomes a Postbox message or a message attribute.
+public struct UltraLocalHistoryInlinePreview: Equatable {
+    public let recordId: String
+    public let peerId: Int64
+    public let messageId: Int32
+    public let text: String
+    public let truncated: Bool
+    public let strike: Bool
+
+    init(record: UltraLocalHistoryRecord, strike: Bool) {
+        self.recordId = record.id
+        self.peerId = record.peerId
+        self.messageId = record.messageId
+        self.text = String(record.text.prefix(400))
+        self.truncated = record.truncated || self.text != record.text
+        self.strike = strike
+    }
+}
+
+public struct UltraLocalHistoryTextSpan: Codable, Equatable {
+    public enum Style: String, Codable { case bold, italic, code, pre, underline, strikethrough, quote }
+    public let offset: Int
+    public let length: Int
+    public let style: Style
+    public init(offset: Int, length: Int, style: Style) {
+        self.offset = offset; self.length = length; self.style = style
+    }
+
+    static func validated(_ spans: [UltraLocalHistoryTextSpan], text: String) -> [UltraLocalHistoryTextSpan] {
+        let units = Array(text.utf16)
+        return spans.prefix(256).filter { span in
+            guard span.offset >= 0, span.offset < units.count, span.length > 0,
+                  span.length <= units.count - span.offset else { return false }
+            let end = span.offset + span.length
+            // NSAttributedString uses UTF-16 ranges; never split a surrogate pair.
+            if (0xdc00 ... 0xdfff).contains(units[span.offset]) { return false }
+            if end < units.count && (0xdc00 ... 0xdfff).contains(units[end]) { return false }
+            return true
+        }
+    }
+}
+
+public struct UltraLocalHistoryRecord: Codable, Equatable {
+    public enum Kind: String, Codable { case received, deleted, edited }
+    public let id: String
+    public let peerId: Int64
+    public let messageId: Int32
+    public let authorId: Int64?
+    public let isOwn: Bool?
+    public let messageTimestamp: Int32
+    public let capturedAt: Int64
+    public var kind: Kind
+    public let text: String
+    public let truncated: Bool
+    // Optional for backward-compatible decoding of the existing version-1 archive.
+    public let spans: [UltraLocalHistoryTextSpan]?
+    public var validatedSpans: [UltraLocalHistoryTextSpan] {
+        return UltraLocalHistoryTextSpan.validated(self.spans ?? [], text: self.text)
+    }
+
+    public init(peerId: Int64, messageId: Int32, authorId: Int64?, messageTimestamp: Int32, capturedAt: Int64, kind: Kind, text: String, spans: [UltraLocalHistoryTextSpan] = [], isOwn: Bool? = nil, sourceTruncated: Bool = false) {
+        self.id = UUID().uuidString
+        self.peerId = peerId
+        self.messageId = messageId
+        self.authorId = authorId
+        self.isOwn = isOwn
+        self.messageTimestamp = messageTimestamp
+        self.capturedAt = capturedAt
+        self.kind = kind
+        // Prefix at a Unicode-scalar boundary; keep a strict byte limit even for emoji.
+        let bytes = Array(text.utf8.prefix(16 * 1024))
+        var end = bytes.count
+        var bounded = String(bytes: bytes, encoding: .utf8)
+        while bounded == nil && end > 0 {
+            end -= 1
+            bounded = String(bytes: bytes.prefix(end), encoding: .utf8)
+        }
+        self.text = bounded ?? ""
+        self.truncated = sourceTruncated || text.utf8.count > end
+        let validated = UltraLocalHistoryTextSpan.validated(spans, text: self.text)
+        self.spans = validated.isEmpty ? nil : validated
+    }
+}
+
+public struct UltraLocalHistorySnapshot: Equatable {
+    public let policy: UltraLocalHistoryPolicy
+    public let records: [UltraLocalHistoryRecord]
+    public let unavailable: Bool
+
+    func hidingOwn(accountPeerId: Int64) -> UltraLocalHistorySnapshot {
+        guard self.policy.excludeOwn else { return self }
+        return UltraLocalHistorySnapshot(policy: self.policy, records: self.records.filter {
+            $0.isOwn != true && $0.authorId != accountPeerId
+        }, unavailable: self.unavailable)
+    }
+
+    public func inlinePreviews(peerId: Int64, now: Int64) -> [Int32: UltraLocalHistoryInlinePreview] {
+        guard self.policy.inlineEdits, !self.unavailable else { return [:] }
+        let now = min(max(0, now), Int64.max - 300)
+        let minimum = max(0, now - 30 * 24 * 60 * 60)
+        var result: [Int32: UltraLocalHistoryInlinePreview] = [:]
+        // Snapshot order is newest first. Show the earliest retained edit, not an
+        // assertion that the client has the message's very first server revision.
+        for record in self.records.reversed() where record.peerId == peerId && record.messageId > 0 && record.kind == .edited && record.capturedAt >= minimum && record.capturedAt <= now + 300 {
+            if result[record.messageId] == nil, !record.text.isEmpty {
+                result[record.messageId] = UltraLocalHistoryInlinePreview(record: record, strike: self.policy.strikeOriginals)
+            }
+        }
+        return result
+    }
+
+    public func filtered(peerId: Int64, messageId: Int32? = nil) -> UltraLocalHistorySnapshot {
+        return UltraLocalHistorySnapshot(policy: self.policy, records: self.records.filter { record in
+            return record.peerId == peerId && (messageId == nil || record.messageId == messageId)
+        }, unavailable: self.unavailable)
+    }
+
+    /// Searches only decrypted local copies; never performs a server search.
+    public func searching(_ query: String) -> UltraLocalHistorySnapshot {
+        let query = String(query.trimmingCharacters(in: .whitespacesAndNewlines).prefix(64))
+        if query.isEmpty { return self }
+        return UltraLocalHistorySnapshot(policy: self.policy, records: self.records.filter { record in
+            return record.text.localizedCaseInsensitiveContains(query) || String(record.peerId).contains(query) || String(record.messageId).contains(query)
+        }, unavailable: self.unavailable)
+    }
+}
+
+struct UltraLocalHistoryContents: Codable, Equatable {
+    var version: Int = 1
+    var records: [UltraLocalHistoryRecord] = []
+
+    @discardableResult
+    mutating func prune(now: Int64) -> Bool {
+        let previousCount = self.records.count
+        let minimum = max(0, now - 30 * 24 * 60 * 60)
+        self.records.removeAll(where: { $0.capturedAt < minimum || $0.capturedAt > now + 300 })
+        if self.records.count > 1000 { self.records = Array(self.records.suffix(1000)) }
+        var bytes = 0
+        var count = 0
+        for record in self.records.reversed() {
+            // JSON may expand each control byte into a six-byte escape. Bound the
+            // serialized envelope conservatively, not only its visible text.
+            let size = record.text.utf8.count * 6 + (record.spans?.count ?? 0) * 96 + 512
+            if bytes + size > 2 * 1024 * 1024 { break }
+            bytes += size
+            count += 1
+        }
+        if count < self.records.count { self.records = Array(self.records.suffix(count)) }
+        return previousCount != self.records.count
+    }
+
+    @discardableResult
+    mutating func append(_ record: UltraLocalHistoryRecord, now: Int64) -> Bool {
+        let pruned = self.prune(now: now)
+        // Deduplicate retries against the latest version of this kind, not the entire
+        // history: A -> B -> A is a real third revision and must retain its place.
+        if let latest = self.records.last(where: { $0.peerId == record.peerId && $0.messageId == record.messageId && $0.kind == record.kind }), latest.text == record.text, latest.spans == record.spans, latest.isOwn == record.isOwn, latest.truncated == record.truncated { return pruned }
+        // A received snapshot is superseded, while previous edits remain separate versions.
+        self.records.removeAll(where: { $0.peerId == record.peerId && $0.messageId == record.messageId && $0.kind == .received })
+        self.records.append(record)
+        self.prune(now: now)
+        return true
+    }
+}
