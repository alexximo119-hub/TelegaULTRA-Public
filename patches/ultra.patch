+                let suggestedWidth = max(title.size.width, text.size.width) + left + right + 8.0
+                return (suggestedWidth, { boundingWidth in
+                    return (CGSize(width: boundingWidth, height: height), { [weak self] _, _, _ in
+                        guard let self = self else { return }
+                        self.item = item
+                        let _ = applyTitle()
+                        let _ = applyText()
+                        self.titleNode.frame = CGRect(origin: CGPoint(x: left + 8.0, y: 6.0), size: title.size)
+                        self.bodyNode.frame = CGRect(origin: CGPoint(x: left + 8.0, y: 10.0 + title.size.height), size: text.size)
+                        self.lineNode.backgroundColor = theme.accentTextColor.withAlphaComponent(0.5)
+                        self.lineNode.cornerRadius = 1.0
+                        self.lineNode.frame = CGRect(x: left, y: 6.0, width: 2.0, height: max(0, height - 10.0))
+                        self.accessibilityLabel = titleText.string + ". Локальная копия. " + body
+                    })
+                })
+            })
+        }
+    }
+
+    override public func tapActionAtPoint(_ point: CGPoint, gesture: TapLongTapOrDoubleTapGesture, isEstimating: Bool) -> ChatMessageBubbleContentTapAction {
+        guard self.bounds.contains(point) else { return ChatMessageBubbleContentTapAction(content: .none) }
+        guard case .tap = gesture, let item = self.item, let open = item.controllerInteraction.openUltraHistory else { return ChatMessageBubbleContentTapAction(content: .ignore) }
+        return ChatMessageBubbleContentTapAction(content: .custom({ open(item.message.id) }), hasLongTapAction: false)
+    }
+
+    override public func accessibilityActivate() -> Bool {
+        guard let item = self.item, let open = item.controllerInteraction.openUltraHistory else { return false }
+        open(item.message.id)
+        return true
+    }
+}
