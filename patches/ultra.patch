--- /dev/null
+++ b/submodules/TelegramCore/Sources/PendingMessages/UltraVideoSanitizer.swift
@@ -0,0 +1,79 @@
+import Foundation
+import AVFoundation
+
+/// Explicit, bounded MP4 export. No original-file or passthrough fallback.
+@available(iOS 26.0, macOS 26.0, *)
+public enum UltraVideoSanitizer {
+    static func restrictedAsset(at url: URL) -> AVURLAsset {
+        return AVURLAsset(url: url, options: [
+            AVURLAssetReferenceRestrictionsKey: NSNumber(value: AVAssetReferenceRestrictions.forbidAll.rawValue),
+            AVURLAssetShouldSupportAliasDataReferencesKey: false
+        ])
+    }
+
+    @MainActor public static func prepare(_ workspace: UltraVideoPreparationWorkspace, preserveDimensions: Bool = false) async throws -> Int64 {
+        try Task.checkCancellation()
+        let inputValues = try workspace.input.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard inputValues.isRegularFile == true, inputValues.isSymbolicLink != true,
+              let inputSize = inputValues.fileSize, inputSize > 0,
+              Int64(inputSize) <= UltraVideoPreparationPolicy.maximumInputBytes else { throw UltraVideoPreparationError.limits }
+        let source = self.restrictedAsset(at: workspace.input)
+        let duration = try await source.load(.duration)
+        let tracks = try await source.load(.tracks)
+        let video = tracks.filter { $0.mediaType == .video }
+        let audio = tracks.filter { $0.mediaType == .audio }
+        guard let originalVideo = video.first else { throw UltraVideoPreparationError.unsupported }
+        let size = try await originalVideo.load(.naturalSize)
+        guard UltraVideoPreparationPolicy.accepts(duration: duration.seconds, width: Double(size.width), height: Double(size.height), videoTracks: video.count, audioTracks: audio.count) else { throw UltraVideoPreparationError.limits }
+        try Task.checkCancellation()
+        let composition = AVMutableComposition()
+        let fullRange = CMTimeRange(start: .zero, duration: duration)
+        for original in video + audio {
+            guard let target = composition.addMutableTrack(withMediaType: original.mediaType, preferredTrackID: kCMPersistentTrackID_Invalid) else { throw UltraVideoPreparationError.unsupported }
+            let range = CMTimeRangeGetIntersection(try await original.load(.timeRange), fullRange)
+            guard range.duration.seconds.isFinite, range.duration.seconds > 0 else { throw UltraVideoPreparationError.unsupported }
+            try target.insertTimeRange(range, of: original, at: range.start)
+            if original.mediaType == .video {
+                let transform = try await original.load(.preferredTransform)
+                guard [transform.a, transform.b, transform.c, transform.d, transform.tx, transform.ty].allSatisfy({ $0.isFinite && abs($0) <= 65536 }) else { throw UltraVideoPreparationError.unsupported }
+                target.preferredTransform = transform
+            }
+        }
+        let preset = preserveDimensions ? AVAssetExportPresetHighestQuality : AVAssetExportPreset1920x1080
+        guard let exporter = AVAssetExportSession(asset: composition, presetName: preset) else { throw UltraVideoPreparationError.unsupported }
+        exporter.metadata = []
+        exporter.shouldOptimizeForNetworkUse = true
+        exporter.fileLengthLimit = UltraVideoPreparationPolicy.maximumOutputBytes
+        try await exporter.export(to: workspace.output, as: .mp4)
+        try Task.checkCancellation()
+        let output = self.restrictedAsset(at: workspace.output)
+        let resultDuration = try await output.load(.duration)
+        let resultTracks = try await output.load(.tracks)
+        let resultVideo = resultTracks.filter { $0.mediaType == .video }
+        let resultAudio = resultTracks.filter { $0.mediaType == .audio }
+        guard let renderedVideo = resultVideo.first else { throw UltraVideoPreparationError.verificationFailed }
+        let renderedSize = try await renderedVideo.load(.naturalSize)
+        guard renderedSize.width.isFinite, renderedSize.height.isFinite,
+              renderedSize.width > 0, renderedSize.height > 0 else { throw UltraVideoPreparationError.verificationFailed }
+        if preserveDimensions {
+            let renderedTransform = try await renderedVideo.load(.preferredTransform)
+            guard UltraVideoPreparationPolicy.preservesGeometry(sourceWidth: Double(size.width), sourceHeight: Double(size.height), width: Double(renderedSize.width), height: Double(renderedSize.height)),
+                  renderedTransform == (try await originalVideo.load(.preferredTransform)) else { throw UltraVideoPreparationError.verificationFailed }
+        } else {
+            guard renderedSize.width <= 1920, renderedSize.height <= 1920 else { throw UltraVideoPreparationError.verificationFailed }
+        }
+        let values = try workspace.output.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard values.isRegularFile == true, values.isSymbolicLink != true, let fileSize = values.fileSize,
+              resultTracks.count == resultVideo.count + resultAudio.count,
+              UltraVideoPreparationPolicy.acceptsOutput(sourceDuration: duration.seconds, duration: resultDuration.seconds, bytes: Int64(fileSize), videoTracks: resultVideo.count, audioTracks: resultAudio.count, expectedAudioTracks: audio.count),
+              try await output.load(.metadata).isEmpty else { throw UltraVideoPreparationError.verificationFailed }
+        for format in try await output.load(.availableMetadataFormats) {
+            guard try await output.loadMetadata(for: format).isEmpty else { throw UltraVideoPreparationError.verificationFailed }
+        }
+        for track in resultTracks {
+            guard try await track.load(.metadata).isEmpty else { throw UltraVideoPreparationError.verificationFailed }
+        }
+        try Task.checkCancellation()
+        return Int64(fileSize)
+    }
+}
